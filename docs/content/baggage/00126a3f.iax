tateid="11" disabledstateid="12" id="7"/></textbuttonstyles><creditsdialogdata bodystyleid="18" titlestyleid="17"><dialogtitle>&lt;html&gt;Créditos&lt;/html&gt;</dialogtitle><text/></creditsdialogdata><colors><color r="137" g="51" b="204" id="1"/><color r="142" g="142" b="142" id="2"/><color r="255" g="255" b="255" id="3"/><color r="50" g="50" b="50" id="4"/><color r="0" g="0" b="0" id="5"/><color r="224" g="224" b="228" id="6"/><color r="160" g="160" b="164" id="7"/><color r="227" g="227" b="227" id="8"/><color r="198" g="198" b="198" id="9"/><color r="128" g="128" b="128" id="10"/><color r="90" g="16" b="148" id="11"/><color r="224" g="88" b="21" id="12"/><color r="234" g="145" b="35" id="13"/><color r="73" g="67" b="57" id="14"/><color r="207" g="207" b="207" id="15"/><color r="150" g="150" b="150" id="16"/><color r="252" g="87" b="26" id="17"/><color r="255" g="151" b="0" id="18"/><color r="255" g="116" b="0" id="19"/><color r="250" g="208" b="54" id="20"/><color r="242" g="25" b="20" id="21"/><color r="182" g="51" b="204" id="22"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="5" bgcolorid="3" graphiccolorid="12" id="1"/><tcbuttonstate outlinecolorid="5" bgcolorid="3" graphiccolorid="13" id="2"/><tcbuttonstate outlinecolorid="5" bgcolorid="3" graphiccolorid="4" id="3"/><tcbuttonstate outlinecolorid="14" bgcolorid="5" graphiccolorid="5" id="4"/><tcbuttonstate outlinecolorid="14" bgcolorid="15" graphiccolorid="4" id="5"/><tcbuttonstate outlinecolorid="14" bgcolorid="15" graphiccolorid="5" id="6"/><tcbuttonstate outlinecolorid="5" bgcolorid="16" graphiccolorid="4" id="7"/><tcbuttonstate outlinecolorid="14" bgcolorid="16" graphiccolorid="4" id="8"/><tcbuttonstate outlinecolorid="17" bgcolorid="18" graphiccolorid="3" id="9"/><tcbuttonstate outlinecolorid="19" bgcolorid="20" graphiccolorid="3" id="10"/><tcbuttonstate outlinecolorid="21" bgcolorid="17" graphiccolorid="3" id="11"/><tcbuttonstate outlinecolorid="11" bgcolorid="22" graphiccolorid="3" id="12"/><tcbuttonstate outlinecolorid="14" bgcolorid="15" graphiccolorid="3" id="13"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="8" rollstateid="5" downstateid="13" selectedstateid="8" disabledstateid="8" id="1"/></twocolorbuttonstyles></iai>