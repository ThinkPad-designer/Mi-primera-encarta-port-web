<?xml version="1.0"?><iai friendlyname="Kids: Pulleys" id="0016d746" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="1" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Una polea tiene dos partes: una rueda con un surco o guía y una cuerda o cable que se acopla en el surco. Tirando de un extremo de la cuerda puedes levantar un objeto que cuelga del otro extremo de la misma.&lt;/html&gt;</body><title>&lt;html&gt;Partes de una polea&lt;/html&gt;</title><image/><imagerefid/></caption><image>0016d746_Slide1.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="43" y="106"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>37</x><y>0</y></point></points><origin><x>90</x><y>116</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>1</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Rueda&lt;/html&gt;</labeltext><audiorefid/><bgrct x="39" y="107" w="51" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="194" y="160"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-19</x><y>-13</y></point></points><origin><x>190</x><y>178</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>1</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Surco o&lt;br&gt;guía&lt;/html&gt;</labeltext><audiorefid/><bgrct x="190" y="161" w="67" h="33"/></label><label labelid="2" action="static" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="335" y="198"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-26</x><y>0</y></point></points><origin><x>331</x><y>208</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>1</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cuerda&lt;/html&gt;</labeltext><audiorefid/><bgrct x="331" y="199" w="58" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Partes de una polea&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="2" sequence="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Muchas máquinas utilizan poleas. Una grúa usa un sistema de poleas para elevar objetos pesados. Un teleférico utiliza poleas para subir y bajar de una montaña. Las poleas bajo los escalones de las escaleras mecánicas permiten subir y bajar de un piso a otro.&lt;/html&gt;</body><title>&lt;html&gt;Algunas poleas&lt;/html&gt;</title><image/><imagerefid/></caption><image>0016d746_Slide2.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="5" y="2"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Your caption here.&lt;/html&gt;</body><title>&lt;html&gt;Crane&lt;/html&gt;</title><image/><imagerefid>1B8279C7</imagerefid></caption><audiofile/><hotarea><point><x>0</x><y>1</y></point><point><x>0</x><y>377</y></point><point><x>211</x><y>379</y></point><point><x>211</x><y>1</y></point><point><x>0</x><y>1</y></point></hotarea><labeltarget>2</labeltarget><picon height="225" width="149" showwireframe="0" showimage="0" colorid="3"><pos x="29" y="14"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Grúa&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="342" y="2"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Your caption here.&lt;/html&gt;</body><title>&lt;html&gt;Cable car&lt;/html&gt;</title><image/><imagerefid>1B824A98</imagerefid></caption><audiofile/><hotarea><point><x>213</x><y>1</y></point><point><x>213</x><y>189</y></point><point><x>417</x><y>189</y></point><point><x>417</x><y>1</y></point><point><x>213</x><y>1</y></point></hotarea><labeltarget>2</labeltarget><picon height="158" width="178" showwireframe="0" showimage="0" colorid="3"><pos x="211" y="15"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Teleférico&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="214" y="341"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Your caption here.&lt;/html&gt;</body><title>&lt;html&gt;Escalator&lt;/html&gt;</title><image/><imagerefid>1B82529A</imagerefid></caption><audiofile/><hotarea><point><x>213</x><y>192</y></point><point><x>213</x><y>378</y></point><point><x>417</x><y>378</y></point><point><x>417</x><y>192</y></point><point><x>213</x><y>192</y></point