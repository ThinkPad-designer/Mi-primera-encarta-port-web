 g="150" b="150" id="14"/><color r="207" g="207" b="207" id="15"/><color r="252" g="87" b="26" id="16"/><color r="255" g="151" b="0" id="17"/><color r="255" g="116" b="0" id="18"/><color r="250" g="208" b="54" id="19"/><color r="242" g="25" b="20" id="20"/><color r="182" g="51" b="204" id="21"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="6" bgcolorid="3" graphiccolorid="10" id="1"/><tcbuttonstate outlinecolorid="6" bgcolorid="3" graphiccolorid="12" id="2"/><tcbuttonstate outlinecolorid="13" bgcolorid="14" graphiccolorid="10" id="3"/><tcbuttonstate outlinecolorid="13" bgcolorid="15" graphiccolorid="10" id="4"/><tcbuttonstate outlinecolorid="13" bgcolorid="15" graphiccolorid="3" id="5"/><tcbuttonstate outlinecolorid="16" bgcolorid="17" graphiccolorid="3" id="6"/><tcbuttonstate outlinecolorid="18" bgcolorid="19" graphiccolorid="3" id="7"/><tcbuttonstate outlinecolorid="20" bgcolorid="16" graphiccolorid="3" id="8"/><tcbuttonstate outlinecolorid="11" bgcolorid="21" graphiccolorid="3" id="9"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="3" rollstateid="4" downstateid="5" selectedstateid="3" disabledstateid="3" id="1"/></twocolorbuttonstyles></iai>