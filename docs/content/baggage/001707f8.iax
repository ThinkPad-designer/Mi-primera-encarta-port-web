el labelid="4" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="337" y="145"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-68</x><y>0</y></point></points><origin><x>333</x><y>163</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Aurícula izquierda&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>2</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Aurícula&lt;br&gt;izquierda&lt;/html&gt;</labeltext><audiorefid/><bgrct x="333" y="146" w="73" h="33"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Diástole inicial&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="4" sequence="3"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Hacia la mitad de la diástole, el aumento de presión en las aurículas abre la válvula mitral y la válvula tricúspide y la sangre pasa a los ventrículos.&lt;/html&gt;</body><title>&lt;html&gt;Diástole media&lt;/html&gt;</title><image/><imagerefid/></caption><image>001707f8_3.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="20" y="243"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>93</x><y>0</y></point></points><origin><x>97</x><y>261</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><