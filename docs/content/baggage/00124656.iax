<?xml version="1.0"?><iai friendlyname="Kids: Dinosaurs" id="00124656" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="kidsWhite" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Hace millones y millones de años, mucho antes de la aparición de los seres humanos, los dinosaurios poblaban la Tierra. Los dinosaurios eran reptiles. Los dinosaurios de mayor tamaño han sido los animales terrestres más grandes que ha habido nunca. Los pequeños tenían más o menos el tamaño de un pollo.&lt;/html&gt;</body><title>&lt;html&gt;Dinosaurios&lt;/html&gt;</title><image/><imagerefid/></caption><image>00124656_1.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="113" y="282"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;&lt;i&gt;Allosaurus&lt;/i&gt;&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>214</y></point><point><x>1</x><y>376</y></point><point><x>414</x><y>377</y></point><point><x>416</x><y>275</y></point><point><x>260</x><y>329</y></point><point><x>106</x><y>220</y></point><point><x>2</x><y>214</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;&lt;i&gt;Allosaurus&lt;/i&gt;&lt;/html&gt;</labeltext><audiorefid/><bgrct x="109" y="283" w="106" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="53" y="138"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;&lt;i&gt;Apatosaurus&lt;/i&gt;&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>129</x><y>54</y></point><point><x>169</x><y>57</y></point><point><x>195</x><y>103</y></point><point><x>226</x><y>118</y></point><point><x>282</x><y>137</y></point><point><x>296</x><y>155</y></point><point><x>311</x><y>196</y></point><point><x>180</x><y>242</y></point><point><x>129</x><y>54</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;&lt;i&gt;Apatosaurus&lt;/i&gt;&lt;/html&gt;</labeltext><audiorefid/><bgrct x="49" y="139" w="119" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="1" locklabel="0"><pos x="284" y="78"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;&lt;i&gt;Stegosaurus&lt;/i&gt;&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>286</x><y>129</y></point><point><x>304</x><y>160</y></point><point><x>414</x><y>163</y></point><point><x>413</x><y>102</y></point><point><x>311</x><y>110</y></point><point><x>286</x><y>129</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;&lt;i&gt;Stegosaurus&lt;/i&gt;&lt;/html&gt;</labeltext><audiorefid/><bgrct x="280" y="79" w="117" h="17"/></label></labels><keywords/><imagerefid>073FD419</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Dinosaurios&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="2" slideid="2"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La mayoría de los dinosaurios se alimentaba de plantas. Estos gigantescos &lt;i&gt;Brachiosaurus&lt;/i&gt; eran tan altos como un edificio de cuatro plantas y pesaban tanto como 15 elefantes. Tenían cuellos largos que les permitían comer las hojas de las ramas más altas, a las que otros dinosaurios no podían llegar.&lt;/html&gt;</body><title>&lt;html&gt;Herbívoros&lt;/html&gt;</title><image/><imagerefid/></caption><image>00124656_2.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="92" y="8"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;&lt;i&gt;Brachiosaurus&lt;/i&gt; comiendo hojas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>0</y></point><point><x>414</x><y>0</y></point><point><x>415</x><y>375</y></point><point><x>2</x><y>377</y></point><point><x>1</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;&lt;i&gt;Brachiosaurus&lt;/i&gt; comiendo hojas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="88" y="9" w="241" h="17"/></label></labels><keywords/><imagerefid>1B823D79</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Herbívoros&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="3" slideid="3"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Algunos dinosaurios se alimentaban de otros animales, incluyendo otros dinosaurios. El &lt;i&gt;Tyrannosaurus&lt;/i&gt; ha sido uno de los carnívoros más grandes y terribles que ha habido sobre la Tierra. Sus afilados dientes y sus poderosas mandíbulas le permitían triturar los huesos con facilidad.&lt;/html&gt;</body><title>&lt;html&gt;Carnívoros&lt;/html&gt;</title><image/><imagerefid/></caption><image>00124656_3.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="150" y="350"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;&lt;i&gt;Tyrannosaurus&lt;/i&gt;&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>0</y></point><point><x>416</x><y>0</y></point><point><x>416</x><y>376</y></point><point><x>1</x><y>376</y></point><point><x>1</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;&lt;i&gt;Tyrannosaurus&lt;/i&gt;&lt;/html&gt;</labeltext><audiorefid/><bgrct x="146" y="351" w="135" h="17"/></label></labels><keywords/><imagerefid>29D2916D</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Carnívoros&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="4" slideid="4"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Muchos dinosaurios ponían huevos. Las hembras de dinosaurio  depositaban los huevos en nidos construidos en el suelo. Algunos dinosaurios cuidaban de sus crías, alimentándolas y protegiéndolas hasta que dejaban el nido. Otros las abandonaban a su suerte.&lt;/html&gt;</body><title>&lt;html&gt;Crías de dinosaurio&lt;/html&gt;</title><image/><imagerefid/></caption><image>00124656_4.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="159" y="11"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Nidos y crías&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>0</y></point><point><x>416</x><y>0</y></point><point><x>416</x><y>377</y></point><point><x>0</x><y>375</y></point><point><x>1</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Nidos y crías&lt;/html&gt;</labeltext><audiorefid/><bgrct x="155" y="12" w="94" h="17"/></label></labels><keywords/><imagerefid>29D2916E</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Crías de dinosaurio&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="5" slideid="5"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Uno de los grandes misterios que rodean a los dinosaurios es por qué se extinguieron o desaparecieron hace unos 65 millones de años. Muchos científicos creen que un gran asteroide o cometa procedente del espacio chocó con la Tierra en ese momento. El polvo producido por el impacto habría impedido el paso de la luz del Sol y las plantas habrían dejado de crecer. Los dinosaurios habrían muerto de hambre.&lt;/html&gt;</body><title>&lt;html&gt;La muerte de los dinosaurios&lt;/html&gt;</title><image/><imagerefid/></caption><image>00124656_5.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="87" y="6"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Asteroide colisionando con la Tierra&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>0</y></point><point><x>416</x><y>0</y></point><point><x>416</x><y>378</y></point><point><x>0</x><y>377</y></point><point><x>1</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Asteroide colisionando con la Tierra&lt;/html&gt;</labeltext><audiorefid/><bgrct x="83" y="7" w="253" h="17"/></label></labels><keywords/><imagerefid>29D2916F</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;La muerte de los dinosaurios&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="3" textdividerbarcolorid="3" creditsbuttonstyleid="4" resetbuttonstyleid="5" navbuttonstyleid="1" numbermenuitems="0" showpop="0" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="3" progresscolorid="3" guttercolorid="3" graphiccolorid="2" outlinecolorid="3" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" rolloutlinecolorid="4" displaybgcolorid="2" listbgcolorid="2" listoutlinecolorid="4" displayoutlinecolorid="4" popbuttonstyleid="1"><scrollbarstyle guttercolorid="4" thumbbasecolorid="5" thumbrollcolorid="6" thumbdowncolorid="6" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="4" thumbbasecolorid="5" thumbrollcolorid="6" thumbdowncolorid="6" buttonstyleid="1"/><creditsbuttonte