titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Mar Caribe&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Mar&lt;br&gt;Caribe&lt;/html&gt;</labeltext><audiorefid/><bgrct x="486" y="217" w="55" h="33"/></label><label labelid="5" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="441" y="122"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Tulum&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>482</x><y>127</y></point><point><x>488</x><y>127</y></point><point><x>491</x><y>121</y></point><point><x>487</x><y>113</y></point><point><x>478</x><y>112</y></point><point><x>472</x><y>122</y></point><point><x>482</x><y>127</y></point></hotarea><labeltarget>10</labeltarget><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tulum&lt;/html&gt;</labeltext><audiorefid/><bgrct x="437" y="123" w="52" h="17"/></label><label labelid="6" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="430" y="221"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Tikal&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>417</x><y>216</y></point><point><x>422</x><y>222</y></point><point><x>433</x><y>222</y></point><point><x>437</x><y>213</y></point><point><x>429</x><y>207</y></point><point><x>419</x><y>210</y></point><point><x>417</x><y>216</y></point></hotarea><labeltarget>9</labeltarget><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tikal&lt;/html&gt;</labeltext><audiorefid/><bgrct x="426" y="222" w="43" h="17"/></label><label labelid="7" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="310" y="227"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Bonampak&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>386</x><y>229</y></point><point><x>394</x><y>231</y></point><point><x>398</x><y>238</y></point><point><x>393</x><y>246</y></point><point><x>382</x><y>246</y></point><point><x>377</x><y>232</y></point><point><x>386</x><y>229</y></point></hotarea><labeltarget>2</labeltarget><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Bonampak&lt;/html&gt;</labeltext><audiorefid/><bgrct x="306" y="228" w="79" h="17"/></label><label labelid="8" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="453" y="86"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Chichén Itzá&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>443</x><y>105</y></point><point><x>447</x><y>115</y></point><point><x>458</x><y>113</y></point><point><x>464</x><y>106</y></point><point><x>457</x><y>103</y></point><point><x>445</x><y>103</y></point><point><x>443</x><y>105</y></point></hotarea><labeltarget>4</labeltarget><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Chichén Itzá&lt;/html&gt;</labeltext><audiorefid/><bgrct x="449" y="87" w="93" h="17"/></label><label labelid="9" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="393" y="288"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Copán&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>436</x><y>291</y><