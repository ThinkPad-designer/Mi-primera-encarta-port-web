 y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Civilización maya&lt;/html&gt;</labeltext><audiorefid/><bgrct x="352" y="357" w="101" h="13"/></label><label labelid="15" action="static" usepicon="0" useleader="0" textbuttonstyleid="5" usehotarea="0" locklabel="0"><pos x="230" y="356"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Imperio azteca&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Imperio azteca&lt;/html&gt;</labeltext><audiorefid/><bgrct x="226" y="357" w="88" h="13"/></label><label labelid="16" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="101" y="356"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;kilómetros&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;kilómetros&lt;/html&gt;</labeltext><audiorefid/><bgrct x="97" y="357" w="62" h="13"/></label><label labelid="17" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="9" y="357"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;250&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;250&lt;/html&gt;</labeltext><audiorefid/><bgrct x="5" y="358" w="26" h="13"/></label><label labelid="18" action="static" usepicon="0" useleader="0" textbuttonstyleid="7" usehotarea="0" locklabel="0"><pos x="10" y="380"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;New Caption&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Haz clic sobre los nombres del mapa si quieres saber cómo eran estas ciudades.&lt;/html&gt;</labeltext><audiorefid/><bgrct x="6" y="381" w="548" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>556</imagewidth><listtitle>&lt;html&gt;Base Map&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Hace trece siglos, los antiguos mayas pintaron en las paredes de la ciudad de Bonampak unos hermosos murales que nos cuentan cómo era su vida y sus costumbres. Gracias a estos dibujos, muy parecidos a las modernas tiras cómicas, conocemos mejor nuestro pasado.&lt;/html&gt;</body><title>&lt;html&gt;Bonampak&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_01.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D95246</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>347</imagewidth><listtitle>&lt;html&gt;Bonampak&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="4"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Chichén Itzá fue una de las ciudades más importantes de la civilización maya y su nombre significa &apos;La boca de los Cenotes de Itzá&apos;. Tenía numerosos edificios. El que ves en esta fotografía se llama el Caracol por la escalera en forma de espiral que tiene dentro. Los historiadores creen que servía de observatorio astronómico.&lt;/html&gt;</body><title>&lt;html&gt;Chichén Itzá&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_02.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D95247</imagerefid><audiorefid/><imageheight>274</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Chichén Itzá&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La ciudad de Copán era el lugar donde los astrónomos mayas se reunían para discutir y poner en común sus descubrimientos. En la plaza central levantaron la escalera de los Jeroglíficos, un monumento en forma de pirámide que los artistas decoraron con numerosas inscripciones. Gracias a esas inscripciones, hoy día sabemos que los mayas tenían un gran conocimiento de los astros.&lt;/html&gt;</body><title>&lt;html&gt;Copán&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_03.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D95248</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>311</imagewidth><listtitle>&lt;html&gt;Copán&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las dos construcciones más importantes de la ciudad maya de Palenque son el Palacio y el  templo de las Inscripciones. El Palacio tenía numerosas habitaciones, corredores y patios. El templo era la tumba del rey Pacal el Grande. Bajando por unas escaleras se llega a la cripta donde estaba enterrado. Unas inscripciones grabadas sobre la lápida nos enseñan cómo el rey desciende al mundo de los muertos convertido en dios.&lt;/html&gt;</body><title>&lt;html&gt;Palenque&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_04.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D95249</imagerefid><audiorefid/><imageheight>277</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Palenque&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="7"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La ciudad maya de Quiriguá es famosa por sus esculturas. En ella se encuentra la piedra más grande tallada por los mayas, conocida como la estela E. Su peso es de 65 toneladas, que equivale al peso de 10 elefantes.&lt;/html&gt;</body><title>&lt;html&gt;Quiriguá&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_05.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9524A</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>222</imagewidth><listtitle>&lt;html&gt;Quiriguá&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="8"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Tenochtitlán era la capital del imperio azteca y una de las ciudades más hermosas que jamás han existido. En el centro, los habitantes construyeron un recinto sagrado lleno de templos donde celebraban los ritos religiosos. A la cima del templo Mayor, una enorme construcción en forma de pirámide, se subía por dos empinadas escaleras. En lo alto estaban los altares de dos deidades: Tláloc, dios de la lluvia, y Huitzilopochtli, dios de la guerra y el Sol.&lt;/html&gt;</body><title>&lt;html&gt;Tenochtitlán&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_06.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9524B</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>276</imagewidth><listtitle>&lt;html&gt;Tenochtitlán&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="9"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En medio de la selva tropical el antiguo pueblo maya construyó un gigantesco centro ceremonial conocido como Tikal, que llegó a ser una de sus ciudades más importantes. En este lugar las pirámides son tan altas que sobresalen por encima de los árboles. Parece que los constructores hubiesen querido ganar una competición a la madre naturaleza.&lt;/html&gt;</body><title>&lt;html&gt;Tikal&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_07.jpg</image><audiofile/><labels/><keywords/><imagerefid>1B82A28B</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>347</imagewidth><listtitle>&lt;html&gt;Tikal&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="10"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La ciudad maya de Tulum se encuentra situada al borde del mar Caribe, junto a un acantilado. Estaba rodeada de murallas y tenía varios puertos desde los cuales los barcos partían para comprar y vender mercancías en otras ciudades.&lt;/html&gt;</body><title>&lt;html&gt;Tulum&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_08.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9524C</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Tulum&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="10" slideid="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Si paseas por las calles de esta ciudad maya verás que casi todas las construcciones tienen forma de caja. Aunque las paredes son lisas, en lo alto, los artistas hicieron un hermoso trabajo tallando en la piedra serpientes de dos cabezas, caracoles y máscaras de Chac, el dios de la lluvia. El palacio del Gobernador es uno de los edificios más impresionantes de la ciudad. Mide casi 100 metros de largo, la longitud de un campo de fútbol.&lt;/html&gt;</body><title>&lt;html&gt;Uxmal&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102a8b_09.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9524D</imagerefid><audiorefid/><imageheight>263</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Uxmal&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="3" textdividerbarcolorid="3" creditsbuttonstyleid="8" resetbuttonstyleid="9" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="3" progresscolorid="3" guttercolorid="3" graphiccolorid="3" outlinecolorid="3" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" rolloutlinecolorid="3" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="3" displayoutlinecolorid="3" popbuttonstyleid="1"><scrollbarstyle guttercolorid="3" thumbbasecolorid="4" thumbrollcolorid="5" thumbdowncolorid="3" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="3" thumbbasecolorid="3" thumbrollcolorid="3" thumbdowncolorid="3" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Créditos&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="6"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="3" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="3" align="left" id="2"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="3" id="3" align="left"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="3" id="4" align="left"/><textstyle size="11" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="3" align="left" id="5"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="6" align="left" id="6"/><textstyle size="14" font="Trebuchet MS" bold="1"