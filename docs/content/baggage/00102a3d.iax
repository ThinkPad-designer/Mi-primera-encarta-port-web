<?xml version="1.0"?><iai friendlyname="Kids: Mammals" id="00102a3d" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="kidsWhite" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;¿Algunas vez te has preguntado qué tienen en común una ballena, un murciélago y un elefante? Todos pertenecen a un grupo de animales llamados mamíferos. ¿Sabías que tú también eres un mamífero?&lt;/html&gt;</body><title>&lt;html&gt;Mamíferos&lt;/html&gt;</title><image/><imagerefid>25A4088F,1B8284DA,25A4086B</imagerefid></caption><image>00102a3d_1.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="132" y="359"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Elefantes africanos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>190</y></point><point><x>416</x><y>191</y></point><point><x>415</x><y>379</y></point><point><x>0</x><y>377</y></point><point><x>2</x><y>190</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Elefantes africanos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="128" y="360" w="138" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="45" y="1"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Ballena jorobada&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>0</y></point><point><x>207</x><y>0</y></point><point><x>208</x><y>188</y></point><point><x>1</x><y>188</y></point><point><x>0</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Ballena jorobada&lt;/html&gt;</labeltext><audiorefid/><bgrct x="41" y="2" w="123" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="276" y="1"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Murciélago&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>210</x><y>0</y></point><point><x>415</x><y>0</y></point><point><x>416</x><y>187</y></point><point><x>210</x><y>186</y></point><point><x>210</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Murciélago&lt;/html&gt;</labeltext><audiorefid/><bgrct x="272" y="2" w="82" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Mamíferos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="2" slideid="2"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los mamíferos son los únicos animales que tienen pelo. Los mamíferos que viven en lugares fríos, como el oso polar, tienen un pelaje muy espeso que les ayuda a mantenerse calientes.&lt;/html&gt;</body><title>&lt;html&gt;Animales con pelo&lt;/html&gt;</title><image/><imagerefid>25A4088A</imagerefid></caption><image>00102a3d_2.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="172" y="1"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Oso polar&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>1</y></point><point><x>417</x><y>1</y></point><point><x>415</x><y>377</y></point><point><x>1</x><y>378</y></point><point><x>0</x><y>1</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Oso polar&lt;/html&gt;</labeltext><audiorefid/><bgrct x="168" y="2" w="73" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Animales con pelo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="3" slideid="3"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;A diferencia de los animales que ponen huevos, casi todos los mamíferos paren crías vivas. Después del nacimiento, los recién nacidos necesitan alimentarse de la leche de la madre para sobrevivir y crecer. Los mamíferos son los únicos animales que producen leche para alimentar a sus crías.&lt;/html&gt;</body><title>&lt;html&gt;Crías de mamíferos&lt;/html&gt;</title><image/><imagerefid>1B8298DB</imagerefid></caption><image>00102a3d_3.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="133" y="1"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Una yegua y su potro&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>0</y></point><point><x>416</x><y>1</y></point><point><x>416</x><y>377</y></point><point><x>0</x><y>377</y></point><point><x>0</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Una yegua y su potro&lt;/html&gt;</labeltext><audiorefid/><bgrct x="129" y="2" w="151" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Crías de mamíferos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="4" slideid="4"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Seguro que alguna vez has visto a un perro jugueteando. En ese caso sabes que los mamíferos son muy inteligentes. Los mamíferos son mucho más inteligentes que cualquier otro grupo de animales. Eso se debe a que tienen cerebros grandes. El chimpancé que puedes ver en la fotografía ha aprendido a usar una roca para partir nueces.&lt;/html&gt;</body><title>&lt;html&gt;Cerebros grandes&lt;/html&gt;</title><image/><imagerefid>1B829A1E</imagerefid></caption><image>00102a3d_4.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="160" y="1"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Chimpancé&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>0</y></point><point><x>415</x><y>0</y></point><point><x>416</x><y>377</y></point><point><x>0</x><y>378</y></point><point><x>0</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Chimpancé&lt;/html&gt;</labeltext><audiorefid/><bgrct x="156" y="2" w="84" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Cerebros grandes&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="5" slideid="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Todos los mamíferos tienen que respirar aire para vivir. Hasta los mamíferos que viven en el agua, como las ballenas y los delfines, deben subir a la superficie para respirar. En la cabeza tienen un orificio, llamado espiráculo, que abren cuando quieren respirar.&lt;/html&gt;</body><title>&lt;html&gt;Respiración&lt;/html&gt;</title><image/><imagerefid>29D22CED</imagerefid></caption><image>00102a3d_5.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="149" y="68"/><leaderline forecolorid="3" bgcolorid="2"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-56</x><y>50</y></point></points><origin><x>145</x><y>78</y></origin></leaderline><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Espiráculo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Espiráculo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="145" y="69" w="79" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Respiración&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="6" sequence="6"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;El ornitorrinco y el equidna son los únicos mamíferos que ponen huevos. Las madres mantienen calientes los huevos con sus cuerpos, hasta que las crías están listas para romper el cascarón.&lt;/html&gt;</body><title>&lt;html&gt;Mamíferos raros&lt;/html&gt;</title><image/><imagerefid>1B8275BA,25A411B7</imagerefid></caption><image>00102a3d_6.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="149" y="171"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Ornitorrinco&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>4</y></point><point><x>4</x><y>185</y></point><point><x>412</x><y>183</y></point><point><x>413</x><y>4</y></point><point><x>2</x><y>4</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Ornitorrinco&lt;/html&gt;</labeltext><audiorefid/><bgrct x="145" y="172" w="93" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="169" y="361"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Equidna&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>193</y></point><point><x>4</x><y>371</y></point><point><x>412</x><y>374</y></point><point><x>412</x><y>194</y></point><point><x>2</x><y>193</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Equidna&lt;/html&gt;</labeltext><audiorefid/><bgrct x="165" y="362" w="64" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Mamíferos raros&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="3" resetbuttonstyleid="4" navbuttonstyleid="1" numbermenuitems="0" showpop="0" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="4" progresscolorid="4" guttercolorid="4" graphiccolorid="2" outlinecolorid="4" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" rolloutlinecolorid="4" displaybgcolorid="4" listbgcolorid="2" listoutlinecolorid="5" displayoutlinecolorid="5" popbuttonstyleid="1"><scrollbarstyle guttercolorid="5" thumbbasecolorid="6" thumbrollcolorid="7" thumbdowncolorid="7" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="5" thumbbasecolorid="6" thumbrollcolorid="7" thumbdowncolorid="7" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="6"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="8" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="8" align="lef