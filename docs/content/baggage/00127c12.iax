><color r="207" g="207" b="207" id="15"/><color r="252" g="87" b="26" id="16"/><color r="255" g="151" b="0" id="17"/><color r="255" g="116" b="0" id="18"/><color r="250" g="208" b="54" id="19"/><color r="242" g="25" b="20" id="20"/><color r="182" g="51" b="204" id="21"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="2" bgcolorid="3" graphiccolorid="2" id="1"/><tcbuttonstate outlinecolorid="2" bgcolorid="3" graphiccolorid="11" id="2"/><tcbuttonstate outlinecolorid="2" bgcolorid="3" graphiccolorid="12" id="3"/><tcbuttonstate outlinecolorid="13" bgcolorid="14" graphiccolorid="9" id="4"/><tcbuttonstate outlinecolorid="13" bgcolorid="15" graphiccolorid="9" id="5"/><tcbuttonstate outlinecolorid="13" bgcolorid="15" graphiccolorid="2" id="6"/><tcbuttonstate outlinecolorid="16" bgcolorid="17" graphiccolorid="2" id="7"/><tcbuttonstate outlinecolorid="18" bgcolorid="19" graphiccolorid="2" id="8"/><tcbuttonstate outlinecolorid="20" bgcolorid="16" graphiccolorid="2" id="9"/><tcbuttonstate outlinecolorid="10" bgcolorid="21" graphiccolorid="2" id="10"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="1"/></twocolorbuttonstyles></iai>