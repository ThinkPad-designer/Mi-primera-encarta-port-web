eader="0" textbuttonstyleid="5" usehotarea="0" locklabel="0"><pos x="41" y="115"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano&lt;br&gt;Atlántico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="37" y="116" w="69" h="28"/></label><label labelid="16" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="352" y="134"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tajo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="348" y="135" w="29" h="12"/></label><label labelid="17" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="228" y="195"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Guadiana&lt;/html&gt;</labeltext><audiorefid/><bgrct x="224" y="196" w="52" h="12"/></label><label labelid="18" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="327" y="197"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Guadalquivir&lt;/html&gt;</labeltext><audiorefid/><bgrct x="323" y="198" w="68" h="12"/></label><label labelid="19" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="280" y="72"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Duero&lt;/html&gt;</labeltext><audiorefid/><bgrct x="276" y="73" w="36" h="12"/></label><label labelid="20" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="348" y="32"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Ebro&lt;/html&gt;</labeltext><audiorefid/><bgrct x="344" y="33" w="29" h="12"/></label><label labelid="21" action="static" usepicon="0" useleader="0" textbuttonstyleid="7" usehotarea="0" locklabel="0"><pos x="467" y="286"/><leaderline forecolorid="2" bgcolorid="3"/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;200              km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="463" y="287" w="86" h="11"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>556</imagewidth><listtitle>&lt;html&gt;Parques nacionales españoles &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 30 de mayo de 1995 (anteriormente constituía el Parque nacional de la Montaña de Covadonga, declarado el 22 de Julio de 1918).&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 64.660 hectáreas.&lt;br&gt;&lt;b&gt;Provincias&lt;/b&gt;: Asturias, León y Santander.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Zona de Especial Protección para las Aves (ZEPA) y Reserva de la Biosfera (2003).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: El Parque nacional Picos de Europa presenta un paisaje tortuoso donde las altas montañas se alternan con profundas gargantas y cañones. En la fotografía, se observa el macizo Central, el más abrupto de los que componen el parque. Los hayedos forman el bosque principal de Picos de Europa, así como los bosques mixtos de robles y avellanos. En el parque viven distintas aves, entre las que se encuentra el urogallo, que es la más representativa de ellas. Entre los diferentes mamíferos que habitan por sus valles, se pueden encontrar lobos, corzos y rebecos, entre otros.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional Picos de Europa&lt;/html&gt;</title><image/><imagerefid/></caption><image>127B5C5F.jpg</image><audiofile/><labels/><keywords/><imagerefid>0206CC96</imagerefid><audiorefid/><imageheight>250</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional Picos de Europa&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="3"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 16 de agosto de 1918.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 15.608 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Huesca.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Reserva de la Biosfera (1977), Zona de Especial Protección para las Aves (1988) y Patrimonio Mundial de la Humanidad (1997).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: El Parque nacional de Ordesa y Monte Perdido se encuentra en los Pirineos, sistema montañoso que separa España de Francia. El glaciarismo cuaternario, que tuvo lugar tras la orogenia alpina, contribuyó decisivamente a la formación de los perfiles que se pueden contemplar en la actualidad, excavando profundos valles y creando circos, así como otras formas de erosión glaciar. En la alta montaña habita el rebeco y sobre las cornisas y paredes sobrevuelan el quebrantahuesos y el águila real. El conocido edelweis, una flor aterciopelada de color blanquecino, se puede encontrar en las cimas altas del parque.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Ordesa y Monte Perdido&lt;/html&gt;</title><image/><imagerefid/></caption><image>T002614C.JPG</image><audiofile/><labels/><keywords/><imagerefid>1B822546</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Ordesa y Monte Perdido&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="4"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 21 de octubre de 1955.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 14.119 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Lleida.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Zona de Especial Protección para las Aves (ZEPA), 1988.&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Este parque nacional, situado en la comunidad autónoma de Cataluña, alberga una red hidrográfica de más de 200 lagos de origen glaciar (denominados &lt;i&gt;estanys&lt;/i&gt;), ríos, torrentes, humedales y cascadas, lo que facilita la existencia de una vegetación de pino silvestre, pino negro, abeto y pastizales y una fauna que incluye sarrios, corzos, águilas reales, quebrantahuesos y marmotas, entre otros.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Aigüestortes i Estany de Sant Maurici&lt;/html&gt;</title><image/><imagerefid/></caption><image>T060450A.JPG</image><audiofile/><labels/><keywords/><imagerefid>1B828D41</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Aigüestortes i Estany de Sant Maurici&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 29 de abril de 1991.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 10.021 hectáreas (8.703 marítimas y 1.318 terrestres).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Este parque nacional, situado en la comunidad autónoma de Baleares, al sur de la isla de Mallorca, engloba el archipiélago de Cabrera y su entorno marino. Estas islas e islotes calcáreos cobijan numerosas especies de aves marinas, como las pardelas y las gaviotas, y los fondos marinos, de aguas limpias y transparentes, albergan una rica fauna con gran número de invertebrados.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional del Archipiélago de Cabrera&lt;/html&gt;</title><image/><imagerefid/></caption><image>000f0bfc.swf</image><audiofile/><labels/><keywords/><imagerefid>42D8D686</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional del Archipiélago de Cabrera&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 28 de junio de 1973.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 1.928 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Ciudad Real.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Reserva de la Biosfera (1981). Humedal de Importancia Internacional (1982) y Zona de Especial Protección para las Aves (ZEPA), 1988.&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Este humedal, declarado de importancia internacional por el convenio Ramsar, es un lugar de invernada y nidificación para una gran variedad de aves ligadas al medio acuático. El pato colorado, símbolo del parque nacional, el ánade azulón, la cerceta común o el pato cuchara son algunas de las aves que habitan en las Tablas de Daimiel. Entre la flora, destacan las plantas acuáticas, como las praderas de carofitos, constituidas por especies del género &lt;i&gt;Chara&lt;/i&gt;.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de las Tablas de Daimiel&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFF4B.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D5F3</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de las Tablas de Daimiel&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="7"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 20 de noviembre de 1995.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 39.000 hectáreas.&lt;br&gt;&lt;b&gt;Provincias&lt;/b&gt;: Ciudad Real y Toledo.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Zona de Especial Protección para las Aves (ZEPA).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Los montes y laderas están ocupados por bosque y matorral mediterráneo donde destacan especies como las encinas, los alcornoques, las jaras, los brezos, los madroños o los romeros. El paisaje de Cabañeros se compone también de extensas ‘rañas’ o llanuras con ricos pastos estacionales que ofrecen alimento a multitud de animales. En este parque nacional habitan más de 200 especies de aves y mamíferos como el ciervo, el jabalí o el corzo.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional Cabañeros&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFF43.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D5F1</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional Cabañeros&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="8"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 11 de enero de 1999.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 86.208 hectáreas.&lt;br&gt;&lt;b&gt;Provincias&lt;/b&gt;: Granada y Almería.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Reserva de la Biosfera (1986).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: El Parque nacional de Sierra Nevada representa un ecosistema de media y alta montaña mediterránea, en el que habitan más de 2.000 especies vegetales y una numerosa entomofauna, con abundantes endemismos. Dentro de los mamíferos, la cabra montés, propia de las altas cumbres, es la especie más emblemática del parque.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Sierra Nevada&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFF4F.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D5F4</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Sierra Nevada&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="9"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 16 de octubre de 1969.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 54.252 hectáreas.&lt;br&gt;&lt;b&gt;Provincias&lt;/b&gt;: Huelva y Sevilla.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Reserva de la Biosfera (1981), Zona de Especial Protección para las Aves (1988) y Patrimonio de la Humanidad (1994).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Doñana agrupa un conjunto de ecosistemas que dotan al parque de una extraordinaria riqueza biológica. La marisma es el espacio natural de mayor extensión, y constituye el lugar de invernada de gran número de aves acuáticas y de otras que realizan sus rutas migratorias entre Europa y África. El Parque nacional de Doñana constituye un importante refugio de especies en peligro de extinción, como el lince ibérico y el águila imperial ibérica.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Doñana&lt;/html&gt;</title><image/><imagerefid/></caption><image>T062844A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FBE02</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Doñana&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="10"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 9 de agosto de 1974.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 5.107 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Las Palmas.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Reserva de la Biosfera (1993) y Zona de Especial Protección para las Aves (1994).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Extensas coladas de lava, también denominadas malpaíses, surcan la superficie del Parque nacional del Timanfaya, en la isla canaria de Lanzarote. Los suelos, que evidencian los restos de la que ha sido una importante actividad volcánica, han sido colonizados por algunas especies vegetales capaces de adaptarse a las adversas condiciones ambientales presentes en el parque. En Timanfaya se albergan especies faunísticas como la musaraña canaria, el lagarto de Haría, la pardela cenicienta y la paloma bravía, así como más de un centenar de invertebrados.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional Timanfaya&lt;/html&gt;</title><image/><imagerefid/></caption><image>T287829A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FDCAC</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional Timanfaya&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 22 de enero de 1954.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 18.990 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Santa Cruz de Tenerife.&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: El parque nacional del Teide es el más antiguo de los parques canarios y el de mayor extensión. El Teide, que aparece al fondo de la imagen, es la cumbre más elevada del archipiélago canario y de España, y domina todo este espacio protegido. Entre las especies vegetales más características se encuentran las retamas del Teide, los codesos, los tajinastes y la violeta del Teide, que vive por encima de los 2.200 m y es la única especie que sobrevive en las cumbres. Lo más interesante de la fauna del parque, en cuanto a número de especies y endemismos, son los invertebrados.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional del Teide&lt;/html&gt;</title><image/><imagerefid/></caption><image>147C1.JPG</image><audiofile/><labels/><keywords/><imagerefid>42D988B8</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>399</imagewidth><listtitle>&lt;html&gt;Parque nacional del Teide&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="12"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 6 de Octubre de 1954.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 4.690 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Santa Cruz de Tenerife.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Zona de Especial Protección para las Aves (ZEPA).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: La caldera de Taburiente constituye una depresión de gran extensión, una de las mayores del mundo, y de origen erosivo, situada en la parte central de la isla canaria de La Palma. El parque presenta un paisaje escarpado con casi 2.000 metros de desnivel. La presencia de abundante agua, un rasgo diferenciador de este parque respecto al resto de las áreas protegidas del archipiélago canario evidenciado en forma de riachuelos y cascadas, ha permitido el desarrollo de especies arbóreas y animales diferenciadas.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de la Caldera de Taburiente&lt;/html&gt;</title><image/><imagerefid/></caption><image>0018A2CA.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9872D</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>354</imagewidth><listtitle>&lt;html&gt;Parque nacional de la Caldera de Taburiente&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="13"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 25 de marzo de 1981.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 3.984 hectáreas.&lt;br&gt;&lt;b&gt;Provincia&lt;/b&gt;: Tenerife.&lt;br&gt;&lt;b&gt;Redes supranacionales&lt;/b&gt;: Patrimonio Mundial de la Humanidad (1986) y Zona de Especial Protección para las Aves (ZEPA).&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: Situado en la isla canaria de La Gomera, Garajonay es un claro exponente del bosque de laurisilva, formación subtropical que cubrió durante la era terciaria la cuenca mediterránea. Las especies vegetales más representativas del parque, muchas de las cuales están cubiertas de musgos y líquenes, son las fayas, los brezos, los loros o laureles, los viñátigos, los acebiños y los madroños. Desde el punto de vista faunístico destacan las aves, especialmente la paloma rabiche y la paloma turqué. Hay que señalar también la importancia de los invertebrados, con gran número de endemismos.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Garajonay&lt;/html&gt;</title><image/><imagerefid/></caption><image>T060461A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FBCBE</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Garajonay&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="15" slideid="14"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración&lt;/b&gt;: 1 de julio de 2002.&lt;br&gt;&lt;b&gt;Superficie&lt;/b&gt;: 1.194 hectáreas terrestres y 7.138 hectáreas marítimas.&lt;br&gt;&lt;b&gt;Características&lt;/b&gt;: El Parque nacional marítimo-terrestre de las Islas Atlánticas de Galicia ha sido el último en incorporarse a la Red de Parques nacionales españoles y en él se incluyen los archipiélagos de las islas Cíes, Ons y Onza, Sálvora e islotes de su entorno y la isla de Cortegada, Malveires y otras islas próximas. El parque destaca por sus costas, abruptas y con numerosos acantilados, sus dunas y sus playas. Posee, además, una gran riqueza faunística, destacando, sobre todo, la presencia de importantes colonias de aves marinas. El medio marino, que se caracteriza por la claridad de las aguas, es hábitat de más de 200 especies de algas, que dan cobijo a gran número de invertebrados y gran cantidad de peces.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional marítimo-terrestre de las Islas Atlánticas de Galicia&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFF47.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D5F2</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional marítimo-terrestre de las Islas Atlánticas de Galicia&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="15" sequence="15"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" vrslide="0" useswfctrl="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Fecha de declaración:&lt;/b&gt; 2 de marzo de 2007.&lt;br&gt;&lt;b&gt;Superficie:&lt;/b&gt; 18.396 hectáreas.&lt;br&gt;&lt;b&gt;Provincia:&lt;/b&gt; Cáceres.&lt;br&gt;&lt;b&gt;Redes supranacionales:&lt;/b&gt; Zona de Especial Protección para las Aves (ZEPA, 1979, ampliada en 2003), Lugar de Importancia Comunitaria (LIC, 2000) y Reserva de la Biosfera (2003).&lt;br&gt;&lt;b&gt;Características:&lt;/b&gt; El río Tajo constituye el eje articulador del parque, de carácter agreste y aserrado, en el que predomina el monte y matorral mediterráneo. Destacan las encinas, alcornoques y quejigos, con una vegetación arbustiva compuesta por jaras, madroños y brezos. En Monfragüe habitan mamíferos como los ciervos, los linces, los jabalíes, los gatos monteses y los meloncillos, y aves como el buitre negro y el buitre leonado, el águila imperial, la cigüeña negra o el alimoche.&lt;/html&gt;</body><title>&lt;html&gt;Parque nacional de Monfragüe&lt;/html&gt;</title><image/><imagerefid/></caption><image>127B5C61.jpg</image><audiofile/><labels/><keywords/><imagerefid>0206CC97</imagerefid><audiorefid/><imageheight>265</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Parque nacional de Monfragüe&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="5" textdividerbarcolorid="5" creditsbuttonstyleid="8" resetbuttonstyleid="9" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="6" progresscolorid="5" guttercolorid="6" graphiccolorid="3" outlinecolorid="7" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="8" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="8" displayoutlinecolorid="8" popbuttonstyleid="1"><scrollbarstyle guttercolorid="8" thumbbasecolorid="9" thumbrollcolorid="10" thumbdowncolorid="10" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="8" thumbbasecolorid="9" thumbrollcolorid="10" thumbdowncolorid="10" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Créditos&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="4" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="4" align="left" id="2"/><textstyle size="11" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="4" align="left" id="3"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="11" alig