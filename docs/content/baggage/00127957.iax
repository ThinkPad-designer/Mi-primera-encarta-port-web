<?xml version="1.0"?><iai friendlyname="Kids - Spanish national parks" id="00127957" height="339" width="556" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="0" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Parques nacionales españoles &lt;/html&gt;</title><image/><imagerefid/></caption><image>00127957.swf</image><audiofile/><labels><label labelid="2" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="340" y="46"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>3</labeltarget><picon height="15" width="15" showwireframe="1" showimage="1" colorid="3"><pos x="418" y="35"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Ordesa y&lt;br&gt;Monte Perdido&lt;/html&gt;</labeltext><audiorefid/><bgrct x="330" y="47" w="108" h="33"/></label><label labelid="3" action="popUp" useleader="0" textbuttonstyleid="2" usehotarea="0" usepicon="1" locklabel="0"><pos x="458" y="56"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>4</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="454" y="48"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Aigüestortes &lt;br&gt;i Estany de &lt;br&gt;Sant Maurici&lt;/html&gt;</labeltext><audiorefid/><bgrct x="454" y="57" w="105" h="50"/></label><label labelid="4" action="popUp" useleader="0" textbuttonstyleid="2" usehotarea="0" usepicon="1" locklabel="0"><pos x="464" y="172"/><leaderline forecolorid="2" bgcolor