	<SYNC Start=0>
		<P Class=ENUSCC ID=Source>Creedence Clearwater Revival</P>
		<P Class=ENUSCC align=left>Some folks are born made to wave the flag</P>
	</SYNC>
	<SYNC Start=4400>
		<P Class=ENUSCC align=left>Whoo, they're red, white and blue</P>
	</SYNC>
	<SYNC Start=7966>
		<P Class=ENUSCC align=left>And when the band plays "Hail to the Chief"</P>
	</SYNC>
	<SYNC Start=11400>
		<P Class=ENUSCC align=left>Ooh, they point the cannon at you, Lord.</P>
	</SYNC>
	<SYNC Start=15166>
		<P Class=ENUSCC align=left>It ain't me</P>
	</SYNC>
	<SYNC Start=17033>
		<P Class=ENUSCC align=left>It ain't me</P>
	</SYNC>
	<SYNC Start=18600>
		<P Class=ENUSCC align=left>I ain't no senator's son, son</P>
	</SYNC>
	<SYNC Start=22200>
		<P Class=ENUSCC align=left>It ain't me</P>
	</SYNC>
	<SYNC Start=24166>
		<P Class=ENUSCC align=left>It ain't me</P>
	</SYNC>
	<SYNC Start=25766>
		<P Class=ENUSCC align=left>I ain't no fortunate one, no.</P>
	</SYNC>
	<SYNC Start=29100>
		<P Class=ENUSCC>&nbsp;</P>
	</SYNC>
</Body>
