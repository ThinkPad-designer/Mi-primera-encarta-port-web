owbg="1" showoutline="1" basestyleid="13" rollstyleid="13" downstyleid="13" selectedstyleid="13" disabledstyleid="13" basestateid="12" rollstateid="13" downstateid="14" selectedstateid="14" disabledstateid="15" id="10"/></textbuttonstyles><creditsdialogdata bodystyleid="15" titlestyleid="14"><dialogtitle>&lt;html&gt;Créditos&lt;/html&gt;</dialogtitle><text>&lt;html&gt;&lt;b&gt;La orquesta&lt;/b&gt;&lt;br&gt;Archive Photos/LDE&lt;br&gt;&lt;br&gt;&quot;Sinfonía nº 5 (final)&quot; compuesta por Ludwig van Beethoven, interpretada por Nicolaus Esterhazy Sinfonia, en The Instruments of the Orchestra. (Naxos 8.558040-46). (c) &#38; (p) 2002 HNH International Ltd. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Instrumentos de cuerda&lt;/b&gt;&lt;br&gt;Dorling Kindersley/Dorling Kindersley/Dorling Kindersley/Getty Images/Jules Frazier&lt;br&gt;&lt;br&gt;&quot;Sinfonía nº 2 (final)&quot; compuesta por Felix Mendelssohn, interpretada por la Northern Chamber Orchestra, en The Instruments of the Orchesta. (Naxos 8.558040-46) (c) &#38; (p) 2002 HNH International Ltd. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Instrumentos de viento-madera&lt;/b&gt;&lt;br&gt;Dorling Kindersley/Dorling Kindersley/Boosey and Hawkes Musical Instruments, Inc./PNI/Spencer Grant/PhotoEdit&lt;br&gt;&lt;br&gt;&quot;Quinteto para cuerda en la menor, variación 7&quot; compuesto por Antonin Reicha, interpretado por Michael Thompson Wind Quintet, en The Instruments of the Orchestra. (Naxos 8.558040-46) (c) &#38; (p) 2002 HNH International Ltd. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Instrumentos de viento-metal&lt;/b&gt;&lt;br&gt;Dorling Kindersley/The Shrine to Music Museum University of South Dakota/S.R.H. Spicer/Dorling Kindersley/Dorling Kindersley&lt;br&gt;&lt;br&gt;&quot;Canzon 28&quot; compuesta por Giovanni Gabrieli, interpretada por la London Symphony Orchestra Brass, de The Instruments of the Orchestra. (Naxos 8.558040-46) (c) &#38; (p) 2002 HNH International Ltd. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Instrumentos de percusión&lt;/b&gt;&lt;br&gt;Premier Percussion USA, Inc./Dorling Kindersley/Dorling Kindersley/Dorling Kindersley/PhotoDisc, Inc.&lt;br&gt;&lt;br&gt;&quot;Percussion&quot; de Classical Cats: A Children&apos;s Introduction to the Orchestra. (Chesky CD158) (c) &#38; (p) 1997 Chesky Records. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;El director de orquesta&lt;/b&gt;&lt;br&gt;THE BETTMANN ARCHIVE/UPI&lt;br&gt;&lt;br&gt;&quot;Sinfonía nº 5 (final)&quot; compuesta por Ludwig van Beethoven, interpretada por Nicolaus Esterhazy Sinfonia, en The Instruments of the Orchestra. (Naxos 8.558040-46). (c) &#38; (p) 2002 HNH International Ltd. Reservados todos los derechos.&lt;/html&gt;</text></creditsdialogdata><colors><color r="137" g="51" b="204" id="1"/><color r="255" g="255" b="255" id="2"/><color r="224" g="224" b="228" id="3"/><color r="160" g="160" b="164" id="4"/><color r="0" g="0" b="0" id="5"/><color r="227" g="227" b="227" id="6"/><color r="198" g="198" b="198" id="7"/><color r="128" g="128" b="128" id="8"/><color r="50" g="50" b="50" id="9"/><color r="90" g="16" b="148" id="10"/><color r="234" g="145" b="35" id="11"/><color r="224" g="88" b="21" id="12"/><color r="186" g="0" b="255" id="13"/><color r="254" g="215" b="40" id="14"/><color r="182" g="230" b="0" id="15"/><color r="228" g="99" b="143" id="16"/><color r="0" g="160" b="198" id="17"/><color r="73" g="67" b="57" id="18"/><color r="150" g="150" b="150" id="19"/><color r="207" g="207" b="207" id="20"/><color r="252" g="87" b="26" id="21"/><color r="255" g="151" b="0" id="22"/><color r="255" g="116" b="0" id="23"/><color r="250" g="208" b="54" id="24"/><color r="242" g="25" b="20" id="25"/><color r="182" g="51" b="204" id="26"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="5" bgcolorid="13" graphiccolorid="9" id="1"/><tcbuttonstate outlinecolorid="5" bgcolorid="2" graphiccolorid="11" id="2"/><tcb