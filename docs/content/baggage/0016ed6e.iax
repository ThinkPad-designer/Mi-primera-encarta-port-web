<?xml version="1.0"?><iai friendlyname="Kids Animal Migration" id="0016ed6e" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="kidsGray" skinlib="kids1"><slides><slide type="standard" slideid="3" sequence="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En otoño, millones de mariposas monarcas migran desde el norte de los Estados Unidos hasta México, ¡recorriendo más de 1.600 kilómetros! En primavera empiezan el viaje de vuelta hacia el norte.&lt;/html&gt;</body><title>&lt;html&gt;Mariposa monarca&lt;/html&gt;</title><image>0016ed6e_monarch .jpg</image><imagerefid>1B82F12F</imagerefid></caption><image>0016ed6e_1.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="6" y="379"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>2</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Haz clic en una foto para ver otra ruta migratoria&lt;/html&gt;</labeltext><audiorefid/><bgrct x="2" y="380" w="320" h="16"/></label><label labelid="1" action="newSlide" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="1" locklabel="0"><pos x="0" y="0"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>109</x><y>309</y></point><point><x>207</x><y>310</y></point><point><x>207</x><y>379</y></point><point><x>107</x><y>379</y></point><point><x>109</x><y>309</y></point></hotarea><labeltarget>5</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altima