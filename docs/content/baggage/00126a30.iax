<?xml version="1.0"?><iai friendlyname="Kids – Inca Empire" id="00126a30" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Haz clic sobre los nombres del mapa si quieres saber más de estos lugares.&lt;/html&gt;</body><title>&lt;html&gt;Imperio inca&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a30.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="55" y="258"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;New Caption&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano Pacífico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="51" y="259" w="119" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="298" y="10"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;New Caption&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano Atlántico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="294" y="11" w="127" h="17"/></label><label labelid="2" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="171" y="80"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title