<?xml version="1.0"?><iai friendlyname="Kids: Fish" id="00127987" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="kidsWhite" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los peces presentan más colores, formas y tamaños de los que puedas imaginar. Algunos son tan diminutos como tu uña. Otros tienen el tamaño de un autobús escolar. Los peces viven en el agua salada del océano y en el agua dulce de los lagos, arroyos y ríos.&lt;/html&gt;</body><title>&lt;html&gt;Peces&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_1.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="172" y="354"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Pez payaso&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>4</x><y>0</y></point><point><x>415</x><y>2</y></point><point><x>415</x><y>377</y></point><point><x>2</x><y>376</y></point><point><x>4</x><y>0</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pez payaso&lt;/html&gt;</labeltext><audiorefid/><bgrct x="168" y="355" w="84" h="17"/></label></labels><keywords/><imagerefid>25A41232</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Peces&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="2" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La mayoría de los peces tiene ciertos rasgos comunes. Respiran a través de las branquias, que capturan el oxígeno del agua. Sus cuerpos están protegidos por duras escamas. Las aletas les permiten nadar y desplazarse en el agua.&lt;/html&gt;</body><title>&lt;html&gt;El cuerpo de los peces&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_2.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="27" y="235"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>28</x><y>-22</y></point></points><origin><x>74</x><y>245</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Aletas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Aletas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="23" y="236" w="51" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="309" y="101"/><leaderline forecolorid="3" bgcolorid="2"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-29</x><y>23</y></point></points><origin><x>305</x><y>111</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Escamas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escamas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="305" y="102" w="65" h="17"/></label><label labelid="4" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="158" y="324"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>58</x><y>-52</y></point></points><origin><x>230</x><y>334</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Branquias&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Branquias&lt;/html&gt;</labeltext><audiorefid/><bgrct x="154" y="325" w="76" h="17"/></label><label labelid="0" action="static" usepicon="0" useleader="1" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="48" y="45"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>47</x><y>41</y></point></points><origin><x>95</x><y>55</y></origin></leaderline><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Aletas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Aletas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="44" y="46" w="51" h="17"/></label></labels><keywords/><imagerefid>29D29334</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;El cuerpo de los peces&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="3" slideid="3"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Algunos de los peces más bonitos viven en las aguas cálidas y poco profundas que rodean los arrecifes de coral. Este pez mandarín tiene tonos brillantes de azul, amarillo y naranja.&lt;/html&gt;</body><title>&lt;html&gt;Peces de los arrecifes de coral&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_3.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="160" y="13"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Pez mandarín&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>0</y></point><point><x>415</x><y>1</y></point><point><x>417</x><y>379</y></point><point><x>1</x><y>376</y></point><point><x>1</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pez mandarín&lt;/html&gt;</labeltext><audiorefid/><bgrct x="156" y="14" w="102" h="17"/></label></labels><keywords/><imagerefid>29D29335</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Peces de los arrecifes de coral&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="4" slideid="4"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Algunos de los peces más extraños viven en las profundidades del océano y en una completa oscuridad. Este rape de las profundidades tiene una boca grande y unos dientes afilados semejantes a colmillos. Un señuelo luminoso brilla en su cabeza para atraer a otros peces, que el rape atrapa y devora.&lt;/html&gt;</body><title>&lt;html&gt;Peces de las profundidades&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_4.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="126" y="11"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Rape de las profundidades&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>414</x><y>1</y></point><point><x>414</x><y>1</y></point><point><x>1</x><y>0</y></point><point><x>0</x><y>377</y></point><point><x>416</x><y>377</y></point><point><x>414</x><y>1</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Rape de las profundidades&lt;/html&gt;</labeltext><audiorefid/><bgrct x="122" y="12" w="187" h="17"/></label></labels><keywords/><imagerefid>29D29336</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Peces de las profundidades&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="5" slideid="5"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los tiburones también son peces. Nadan deprisa y la mayoría de ellos son excelentes cazadores. Se alimentan principalmente de otros peces, pero los tiburones más grandes atacan a las focas, a los delfines y a las ballenas. A pesar de su reputación, la mayoría de los tiburones no son peligrosos para los seres humanos.&lt;/html&gt;</body><title>&lt;html&gt;Tiburones&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_5.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="164" y="9"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Tiburón azul&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>2</y></point><point><x>415</x><y>1</y></point><point><x>415</x><y>377</y></point><point><x>0</x><y>378</y></point><point><x>2</x><y>2</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tiburón azul&lt;/html&gt;</labeltext><audiorefid/><bgrct x="160" y="10" w="95" h="17"/></label></labels><keywords/><imagerefid>1B82A52C</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Tiburones&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="6" slideid="6"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los peces tienen muchas formas de defenderse cuando son atacados. Los peces pequeños suelen nadar en grupos llamados bancos, que giran y se mueven deprisa para confundir a sus agresores. El pez globo se hincha hasta convertirse en una pelota espinosa cuando se siente amenazado. Otros peces, como la platija, se esconden confundiéndose con el suelo.&lt;/html&gt;</body><title>&lt;html&gt;Defensas de los peces&lt;/html&gt;</title><image/><imagerefid/></caption><image>00127987_6.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="1" locklabel="0"><pos x="161" y="4"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Banco de peces&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>0</y></point><point><x>416</x><y>1</y></point><point><x>415</x><y>186</y></point><point><x>1</x><y>188</y></point><point><x>0</x><y>0</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Banco de peces&lt;/html&gt;</labeltext><audiorefid/><bgrct x="157" y="5" w="114" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="1" locklabel="0"><pos x="68" y="199"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Pez globo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>190</y></point><point><x>206</x><y>190</y></point><point><x>206</x><y>378</y></point><point><x>0</x><y>377</y></point><point><x>0</x><y>190</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pez globo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="64" y="200" w="75" h="17"/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="1" locklabel="0"><pos x="284" y="198"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Platija&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>209</x><y>190</y></point><point><x>416</x><y>190</y></point><point><x>416</x><y>378</y></point><point><x>210</x><y>377</y></point><point><x>209</x><y>190</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Platija&lt;/html&gt;</labeltext><audiorefid/><bgrct x="280" y="199" w="53" h="17"/></label></labels><keywords/><imagerefid>1B82301E, 1B823434, 1B8269A8</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Defensas de los peces&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="5" resetbuttonstyleid="6" navbuttonstyleid="1" numbermenuitems="0" showpop="0" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="6" guttercolorid="5" graphiccolorid="2" outlinecolorid="4" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" rolloutlinecolorid="7" displaybgcolorid="2" listbgcolorid="2" listoutlinecolorid="7" displayoutlinecolorid="7" popbuttonstyleid="1"><scrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="6"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="10" align="left" id="2"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" id="3" align="left"/><textstyle size