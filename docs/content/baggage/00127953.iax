<?xml version="1.0"?><iai friendlyname="Kids - Roman legacy in Spain" id="00127953" height="339" width="556" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="0" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><image>000f0cb6.swf</image><audiofile/><labels><label labelid="1" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="182" y="18"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>2</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="170" y="30"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Muralla de Lugo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="178" y="19" w="116" h="17"/></label><label labelid="2" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="214" y="39"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>3</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="201" y="46"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Minas de Las Médulas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="210" y="40" w="153" h="17"/></label><label labelid="3" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="252" y="69"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>4</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="319" y="72"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Numancia&lt;/html&gt;</labeltext><audiorefid/><bgrct x="248" y="70" w="76" h="17"/></label><label labelid="4" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="391" y="46"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>5</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="463" y="62"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Yacimiento de Empúries&lt;/html&gt;</labeltext><audiorefid/><bgrct x="387" y="47" w="173" h="17"/></label><label labelid="5" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="124" y="94"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="263" y="110"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Acueducto de Segovia&lt;/html&gt;</labeltext><audiorefid/><bgrct x="120" y="95" w="157" h="17"/></label><label labelid="6" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="336" y="81"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="408" y="96"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Arco de Bará, Tarragona&lt;/html&gt;</labeltext><audiorefid/><bgrct x="332" y="82" w="174" h="17"/></label><label labelid="7" action="popUp" useleader="0" textbuttonstyleid="2" usehotarea="0" usepicon="0" locklabel="0"><pos x="130" y="117"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>8</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="240" y="132"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Calzadas de la&lt;br&gt;sierra de Gredos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="120" y="118" w="121" h="33"/></label><label labelid="8" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="322" y="120"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>9</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="313" y="135"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Anfiteatro de Segóbriga&lt;/html&gt;</labeltext><audiorefid/><bgrct x="318" y="121" w="169" h="17"/></label><label labelid="9" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="377" y="145"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>10</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="368" y="156"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Teatro de Sagunto&lt;/html&gt;</labeltext><audiorefid/><bgrct x="373" y="146" w="133" h="17"/></label><label labelid="10" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="209" y="167"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>11</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="199" y="177"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Teatro de Mérida&lt;/html&gt;</labeltext><audiorefid/><bgrct x="205" y="168" w="125" h="17"/></label><label labelid="11" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="170" y="226"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>12</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="212" y="231"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Itálica&lt;/html&gt;</labeltext><audiorefid/><bgrct x="166" y="227" w="51" h="17"/></label><label labelid="12" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="0" locklabel="0"><pos x="259" y="216"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>13</labeltarget><picon height="10" width="10" showwireframe="1" showimage="1" colorid="3"><pos x="247" y="220"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Puente de Córdoba&lt;/html&gt;</labeltext><audiorefid/><bgrct x="255" y="217" w="139" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>556</imagewidth><listtitle>&lt;html&gt;Viaja a la Hispania romana&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;¿Sabías que Lugo fue llamada Lucus Augusta por los romanos? Aproximadamente a finales del siglo II, o comienzos del siglo III d.C., los romanos construyeron en esta ciudad gallega la muralla que ves en la imagen.&lt;/html&gt;</body><title>&lt;html&gt;Muralla de Lugo&lt;/html&gt;</title><image/><imagerefid/></caption><image>1848A.jpg</image><audiofile/><labels/><keywords/><imagerefid>25A4AF76</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Muralla de Lugo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="3"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Durante los siglos I y II d.C., los romanos explotaron las minas de oro que había en Las Médulas (en la comarca leonesa de El Bierzo). En la fotografía puedes ver el espectacular paisaje que nos ha quedado como recuerdo de aquellas minas.&lt;/html&gt;</body><title>&lt;html&gt;Minas de Las Médulas&lt;/html&gt;</title><image/><imagerefid/></caption><image>T287936A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FDCDC</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Minas de Las Médulas&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="4"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;A 8 km de Soria se encuentran los restos de una antigua ciudad (los puedes ver en la imagen). La construyeron los romanos sobre las ruinas de Numancia, una ciudad en la que vivía un pueblo celtibérico: los arévacos. En el siglo II a.C., los habitantes de Numancia resistieron durante 10 años los ataques de las legiones romanas. Al final, rodeados, enfermos y sin alimentos, los numantinos decidieron quitarse la vida antes que ser sometidos por Roma.&lt;/html&gt;</body><title>&lt;html&gt;Numancia&lt;/html&gt;</title><image/><imagerefid/></caption><image>T062734A.jpg</image><audiofile/><labels/><keywords/><imagerefid>1B828EC8</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Numancia&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En torno a los siglos VI y V a.C., los griegos fundaron en la península Ibérica una colonia comercial: Emporion. En el siglo III a.C., las legiones romanas desembarcaron en aquel lugar al iniciarse la segunda Guerra Púnica (que enfrentaba a los romanos y a los cartagineses). Tras la victoria romana, Emporion se convirtió en una colonia de Roma y pasó a llamarse Emporiae. En la fotografía puedes ver unos suelos romanos, hechos con mosaicos, que están en el yacimiento arqueológico de Empúries (Ampurias). ¿Te has dado cuenta, a través de este relato, de cómo evolucionan las palabras a lo largo de la historia? Emporion (en griego), Emporiae (en latín), Ampurias (en español), Empúries (en catalán)…&lt;/html&gt;</body><title>&lt;html&gt;Yacimiento de Empúries&lt;/html&gt;</title><image/><imagerefid/></caption><image>T062868A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FBE0B</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Yacimiento de Empúries&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;A mediados del siglo I d.C, los romanos construyeron en Segovia este impresionante acueducto. Gracias a él, los habitantes de la ciudad disponían de agua (que llegaba a Segovia desde la cercana sierra de Guadarrama). Como ves, los romanos fueron unos extraordinarios ingenieros.&lt;/html&gt;</body><title>&lt;html&gt;Acueducto de Segovia&lt;/html&gt;</title><image/><imagerefid/></caption><image>00176803.jpg</image><audiofile/><labels/><keywords/><imagerefid>381EE792</imagerefid><audiorefid/><imageheight>246</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Acueducto de Segovia&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="7"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En esta fotografía puedes ver el arco de Bará. Lo construyeron los romanos en tiempos del emperador Augusto (27 a.C.-14 d.C.). Se encuentra a unos 20 km de Tarragona. Esta ciudad catalana se llamaba entonces Tarraco, y era la capital de la Tarraconense, una de las provincias en que estaba dividida la Hispania romana.&lt;/html&gt;</body><title>&lt;html&gt;Arco de Bará, Tarragona&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFFBB.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D60F</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>357</imagewidth><listtitle>&lt;html&gt;Arco de Bará, Tarragona&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="8"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los romanos construyeron calzadas en todas las provincias de su imperio. Las calzadas se convirtieron en una red de comunicaciones fundamental. Éstas que ves se encuentran en la sierra de Gredos.&lt;/html&gt;</body><title>&lt;html&gt;Calzadas de la sierra de Gredos&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFFBF.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D610</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>318</imagewidth><listtitle>&lt;html&gt;Calzadas de la sierra de Gredos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="9"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Segóbriga fue una importante ciudad de la Hispania romana. Todavía hoy puedes ver sus restos, que se encuentran en la provincia de Cuenca. El teatro, las murallas, el foro, la basílica o tribunal, el templo, las termas y el anfiteatro, eran algunas de las principales construcciones de Segóbriga (al igual que en otras ciudades romanas). En la fotografía estás viendo el anfiteatro. Podían acudir a él ¡5.000 personas!&lt;/html&gt;</body><title>&lt;html&gt;Anfiteatro de Segóbriga&lt;/html&gt;</title><image/><imagerefid/></caption><image>000f256b.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D793</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Anfiteatro de Segóbriga&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="10"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En la imagen, el teatro romano de Sagunto, construido en el siglo I d.C. Los romanos llamaron Saguntum a esta ciudad, que hoy pertenece a la Comunidad Valenciana.&lt;/html&gt;</body><title>&lt;html&gt;Teatro de Sagunto&lt;/html&gt;</title><image/><imagerefid/></caption><image>T060324A.JPG</image><audiofile/><labels/><keywords/><imagerefid>0C049F03</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Teatro de Sagunto&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Se cree que la construcción del teatro de Mérida finalizó en el año 8 a.C. Mérida, hoy capital de la comunidad autónoma española de Extremadura, fue llamada Emerita Augusta por los romanos. Imagina por un momento que el teatro que estás viendo estuviera cubierto: sería muy parecido a los teatros de la actualidad. Si alguna vez visitas un teatro romano, habla desde su escenario. No es necesario que lo hagas en voz alta. Si algún familiar o amigo tuyo se sitúa en las partes altas de la grada, te escuchará perfectamente.&lt;/html&gt;</body><title>&lt;html&gt;Teatro de Mérida&lt;/html&gt;</title><image/><imagerefid/></caption><image>T060040A.JPG</image><audiofile/><labels/><keywords/><imagerefid>0C049DEC</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Teatro de Mérida&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="12"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En el año 206 a.C., tras derrotar a los cartagineses, el general romano Publio Cornelio Escipión fundó Itálica. Esta ciudad estaba situada muy cerca de la actual Sevilla. En Itálica nacieron dos emperadores romanos: Adriano y Trajano. Todavía hoy se pueden ver numerosos restos que nos hablan del esplendor de Itálica: el teatro, el anfiteatro, las termas o las viviendas.&lt;/html&gt;</body><title>&lt;html&gt;Itálica&lt;/html&gt;</title><image/><imagerefid/></caption><image>000EFFD3.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D8D615</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Itálica&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="13" slideid="13"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Corduba (la actual Córdoba) se convirtió a partir del siglo I a.C. en una de las principales ciudades romanas de Hispania. Estaba situada en la provincia de la Bética. En la imagen aparece el puente que los romanos construyeron en Córdoba sobre el río Guadalquivir.&lt;/html&gt;</body><title>&lt;html&gt;Puente de Córdoba&lt;/html&gt;</title><image/><imagerefid/></caption><image>T287909A.JPG</image><audiofile/><labels/><keywords/><imagerefid>073FDCCF</imagerefid><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Puente de Córdoba&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="3" resetbuttonstyleid="4" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="4" guttercolorid="5" graphiccolorid="3" outlinecolorid="6" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="7" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="7" displayoutlinecolorid="7" popbuttonstyleid="1"><scrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Créditos&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" align="left" id