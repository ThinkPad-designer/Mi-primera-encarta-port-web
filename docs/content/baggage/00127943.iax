<?xml version="1.0"?><iai friendlyname="Kids - Áreas nat. protegidas de México" id="00127943" height="339" width="556" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="0" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Principales Áreas naturales protegidas de México &lt;/html&gt;</title><image/><imagerefid/></caption><image>000f0bfa.swf</image><audiofile/><labels><label labelid="1" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="198" y="162"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>2</labeltarget><picon height="5" width="7" showwireframe="1" showimage="1" colorid="3"><pos x="199" y="176"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;1&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="2" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="235" y="195"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>3</labeltarget><picon height="5" width="7" showwireframe="1" showimage="1" colorid="3"><pos x="226" y="205"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;2&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="3" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="209" y="172"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>4</labeltarget><picon height="5" width="5" showwireframe="1" showimage="1" colorid="3"><pos x="205" y="184"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;3&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="4" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="48" y="32"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>5</labeltarget><picon height="15" width="15" showwireframe="1" showimage="1" colorid="3"><pos x="33" y="22"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;4&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="5" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="341" y="150"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="5" width="5" showwireframe="1" showimage="1" colorid="3"><pos x="351" y="163"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;5&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="6" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="216" y="196"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="5" width="5" showwireframe="1" showimage="1" colorid="3"><pos x="208" y="200"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;6&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="7" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="0" usepicon="1" locklabel="0"><pos x="227" y="226"/><leaderline forecolorid="2" bg