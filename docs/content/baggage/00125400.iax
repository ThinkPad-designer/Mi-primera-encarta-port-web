<?xml version="1.0"?><iai friendlyname="Kids: Birds" id="00125400" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="kidsWhite" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Vivas donde vivas, seguro que ves aves todos los días. Las aves están por todas partes, volando por el cielo, posadas en las ramas de los árboles, saltando por el suelo o nadando por el agua. Hay miles de aves diferentes.&lt;/html&gt;</body><title>&lt;html&gt;Aves&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_1.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="20" y="127"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Rabijunco colirrojo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>150</y></point><point><x>172</x><y>151</y></point><point><x>172</x><y>0</y></point><point><x>0</x><y>0</y></point><point><x>0</x><y>150</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Rabijunco colirrojo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="16" y="128" w="139" h="17"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="251" y="217"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Trepador azul&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>416</x><y>0</y></point><point><x>414</x><y>1</y></point><point><x>177</x><y>0</y></point><point><x>176</x><y>240</y></point><point><x>416</x><y>239</y></point><point><x>416</x><y>0</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Trepador azul&lt;/html&gt;</labeltext><audiorefid/><bgrct x="247" y="218" w="104" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="46" y="353"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Búho chico&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>154</y></point><point><x>173</x><y>154</y></point><point><x>173</x><y>377</y></point><point><x>1</x><y>377</y></point><point><x>0</x><y>154</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Búho chico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="42" y="354" w="84" h="17"/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="258" y="356"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Ibis escarlata&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>176</x><y>244</y></point><point><x>416</x><y>244</y></point><point><x>416</x><y>377</y></point><point><x>177</x><y>377</y></point><point><x>176</x><y>244</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Ibis escarlata&lt;/html&gt;</labeltext><audiorefid/><bgrct x="254" y="357" w="98" h="17"/></label></labels><keywords/><imagerefid>1B8275FA</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Aves&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="2" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las aves son los únicos animales con plumas. Las plumas largas y lisas de las aves les permiten volar, y las plumas blandas y mullidas de sus cuerpos conservan el calor. &lt;/html&gt;</body><title>&lt;html&gt;Plumas&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_2.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="8" y="56"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>77</x><y>71</y></point></points><origin><x>112</x><y>74</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Plumas largas&lt;br&gt;para volar&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Plumas largas&lt;br&gt;para volar&lt;/html&gt;</labeltext><audiorefid/><bgrct x="4" y="57" w="108" h="33"/></label><label labelid="2" action="static" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="302" y="287"/><leaderline forecolorid="3" bgcolorid="2"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>-136</y></point></points><origin><x>298</x><y>313</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Plumas blandas&lt;br&gt;para conservar el calor&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Plumas blandas&lt;br&gt;para conservar&lt;br&gt;el calor&lt;/html&gt;</labeltext><audiorefid/><bgrct x="298" y="288" w="120" h="50"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Plumas&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="3" slideid="3"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las aves dominan el aire. Vuelan batiendo las alas. Las aves de gran tamaño como las águilas baten sus alas lentamente, y pueden planear a una gran altura durante varias horas. Las aves más pequeñas, como los colibríes, baten las alas muy deprisa,  ¡entre 20 y 70 veces por segundo!&lt;/html&gt;</body><title>&lt;html&gt;Vuelo&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_3.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="153" y="4"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Águila calva&lt;br&gt;americana&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>2</x><y>0</y></point><point><x>3</x><y>187</y></point><point><x>415</x><y>188</y></point><point><x>417</x><y>0</y></point><point><x>2</x><y>0</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Águila calva&lt;br&gt;americana&lt;/html&gt;</labeltext><audiorefid/><bgrct x="149" y="5" w="97" h="33"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="182" y="195"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Colibrí&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>3</x><y>193</y></point><point><x>2</x><y>376</y></point><point><x>413</x><y>378</y></point><point><x>416</x><y>194</y></point><point><x>3</x><y>193</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Colibrí&lt;/html&gt;</labeltext><audiorefid/><bgrct x="178" y="196" w="54" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Vuelo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="4" slideid="5"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Todas las aves tienen alas, pero no todas las aves pueden volar. Los pingüinos utilizan las alas como aletas para nadar debajo del agua. El avestruz, el ave más grande que existe, es demasiado pesada para volar. Sin embargo, tiene patas poderosas y puede correr tan rápido como un caballo.&lt;/html&gt;</body><title>&lt;html&gt;Nadar y correr&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_4.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="74" y="4"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Pingüino&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>2</y></point><point><x>2</x><y>376</y></point><point><x>205</x><y>376</y></point><point><x>205</x><y>2</y></point><point><x>1</x><y>2</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pingüino&lt;/html&gt;</labeltext><audiorefid/><bgrct x="70" y="5" w="68" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="288" y="4"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Avestruz&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>212</x><y>0</y></point><point><x>212</x><y>374</y></point><point><x>414</x><y>376</y></point><point><x>414</x><y>4</y></point><point><x>212</x><y>0</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Avestruz&lt;/html&gt;</labeltext><audiorefid/><bgrct x="284" y="5" w="69" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Nadar y correr&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="5" slideid="6"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los picos de las aves tienen muchas formas y tamaños. El águila utiliza su pico afilado y ganchudo para arrancar la carne de los animales de los que se alimenta. El tucán usa su largo pico para coger las frutas que crecen en los árboles.&lt;/html&gt;</body><title>&lt;html&gt;Picos&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_5.jpg</image><audiofile/><labels><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="79" y="356"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Águila&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>3</x><y>2</y></point><point><x>2</x><y>378</y></point><point><x>205</x><y>375</y></point><point><x>206</x><y>1</y></point><point><x>3</x><y>2</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Águila&lt;/html&gt;</labeltext><audiorefid/><bgrct x="75" y="357" w="51" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="1" locklabel="0"><pos x="289" y="356"/><leaderline forecolorid="3" bgcolorid="2"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Tucán&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>214</x><y>1</y></point><point><x>215</x><y>377</y></point><point><x>413</x><y>376</y></point><point><x>415</x><y>1</y></point><point><x>214</x><y>1</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tucán &lt;/html&gt;</labeltext><audiorefid/><bgrct x="285" y="357" w="55" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Picos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="6" slideid="7"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las aves ponen huevos. Muchas aves depositan sus huevos en un nido construido en un árbol. Luego se acurrucan sobre los huevos para mantenerlos calientes. Cuando los polluelos rompen el cascarón, los padres los alimentan hasta que son lo suficientemente mayores como para cuidar de sí mismos.&lt;/html&gt;</body><title>&lt;html&gt;Crías de las aves&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_6.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="176" y="4"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Tacuarita&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>0</x><y>0</y></point><point><x>415</x><y>0</y></point><point><x>416</x><y>377</y></point><point><x>1</x><y>377</y></point><point><x>0</x><y>0</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Tacuarita&lt;/html&gt;</labeltext><audiorefid/><bgrct x="172" y="5" w="74" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Crías de las aves&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="7" slideid="4"><standardslide locklabelson="0" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los machos de muchas aves tienen plumas de colores brillantes para atraer a las hembras. El pavo real despliega su hermoso plumaje para impresionar a la hembra.&lt;/html&gt;</body><title>&lt;html&gt;Aves de colores brillantes&lt;/html&gt;</title><image/><imagerefid/></caption><image>00125400_7.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="1" locklabel="0"><pos x="178" y="4"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;Pavo real&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>1</x><y>1</y></point><point><x>415</x><y>0</y></point><point><x>417</x><y>377</y></point><point><x>0</x><y>377</y></point><point><x>1</x><y>1</y></point></hotarea><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pavo real&lt;/html&gt;</labeltext><audiorefid/><bgrct x="174" y="5" w="72" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Aves de colores brillantes&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="5" creditsbuttonstyleid="4" resetbuttonstyleid="5" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="5" guttercolorid="5" graphiccolorid="2" outlinecolorid="5" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" ro