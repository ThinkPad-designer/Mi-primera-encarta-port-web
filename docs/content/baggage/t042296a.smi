	<SYNC Start=0>
		<P Class=ENUSCC ID=Source>Elvis Presley singing</P>
		<P Class=ENUSCC align=center>Well, since my baby left me</P>
	</SYNC>
	<SYNC Start=2733>
		<P Class=ENUSCC align=center>Well, I found a new place to dwell</P>
	</SYNC>
	<SYNC Start=5266>
		<P Class=ENUSCC align=center>Well, it's down at the end of lonely street</P>
	</SYNC>
	<SYNC Start=8066>
		<P Class=ENUSCC align=center>at Heartbreak Hotel</P>
	</SYNC>
	<SYNC Start=9966>
		<P Class=ENUSCC align=center>Well, I'm... I'm so lonely, baby</P>
	</SYNC>
	<SYNC Start=13600>
		<P Class=ENUSCC align=center>Well, I'm so lonely</P>
	</SYNC>
	<SYNC Start=16433>
		<P Class=ENUSCC align=center>I'm so lonely, I could die.</P>
	</SYNC>
