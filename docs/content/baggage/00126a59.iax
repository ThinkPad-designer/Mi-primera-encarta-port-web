<?xml version="1.0"?><iai friendlyname="Kids – Industrial Revolution: concepts" id="00126a59" height="411" width="574" hasaudio="0" hascredits="1" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Haz clic sobre cada uno de los términos si quieres saber lo que significan.&lt;/html&gt;</body><title>&lt;html&gt;La Revolución Industrial&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a59_base.jpg</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="31" y="20"/><leaderline/><caption titlestyleid="3" bodystyleid="4"><body/><title>&lt;html&gt;¿Sabes el significado de los siguientes conceptos?&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;¿Sabes el significado de los siguientes conceptos?&lt;/html&gt;</labeltext><audiorefid/><bgrct x="27" y="21" w="342" h="17"/></label><label labelid="1" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="35" y="55"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Bienes de consumo&lt;/html&gt;</title><image>00126a59_1.jpg</image><imagerefid/></caption><audiofile/><hotarea/><labeltarget>2</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Bienes de consumo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="31" y="56" w="139" h="17"/></label><label labelid="2" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="35" y="90"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;División del trabajo&lt;/html&gt;</title><image>00126A59_2.swf</image><imagerefid/></caption><audiofile/><hotarea/><labeltarget>3</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;División del trabajo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="31" y="91" w="141" h="17"/></label><label labelid="3" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="35" y="125"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Explotación infantil&lt;/html&gt;</title><image>00126a59_3.jpg</image><imagerefid/></caption><audiofile/><hotarea/><labeltarget>4</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Explotación infantil&lt;/html&gt;</labeltext><audiorefid/><bgrct x="31" y="126" w="141" h="17"/></label><label labelid="4" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="250" y="55"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Máquina de vapor&lt;/html&gt;</title><image>00126a59_4.jpg</image><imagerefid/></caption><audiofile/><hotarea/><labeltarget>5</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Máquina de vapor&lt;/html&gt;</labeltext><audiorefid/><bgrct x="246" y="56" w="129" h="17"/></label><label labelid="5" action="popUp" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="250" y="90"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Proletariado&lt;/html&gt;</title><image>00126a59_5.jpg</image><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Proletariado&lt;/html&gt;</labeltext><audiorefid/><bgrct x="246" y="91" w="93" h="17"/></label></labels><keywords/><imagerefid>1B82E26A</imagerefid><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;La Revolución Industrial&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="2" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;Los bienes de consumo son los bienes que compramos para consumo final, que no se utilizan para producir otra cosa (por ejemplo, un lápiz). Hay algunos que no pueden tocarse ni comerse: la electricidad, por ejemplo, es un bien de consumo cuando la utilizamos para iluminar nuestra casa por las noches, y un bien de producción cuando sirve para que funcione una fábrica de coches.&lt;/html&gt;</body><title>&lt;html&gt;Bienes de consumo&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a59_1.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9892D</imagerefid><audiorefid/><imageheight>281</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Bienes de consumo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="3" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;La división del trabajo existe desde la antigüedad. Pero la Revolución Industrial aceleró el proceso, al surgir las fábricas. Cuando el trabajo se divide, cada persona realiza una tarea diferente: eso permite que cada vez se produzca más. Imagínate que una sola persona tenga que realizar las cinco fases de fabricación de un producto: sólo podrá acabar uno al día. En cambio, si hay un trabajador especializado en cada fase, se pueden terminar diez productos en un día.&lt;/html&gt;</body><title>&lt;html&gt;División del trabajo&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126A59_2.swf</image><audiofile/><labels/><keywords/><imagerefid>42D9527B</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;División del trabajo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="4" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;La Revolución Industrial no trajo sólo progresos. Uno de sus graves inconvenientes fue la explotación de los niños. En algunos lugares, niños de cinco y seis años llegaban a trabajar entre trece y dieciséis horas al día, en fábricas sucias y frías. La mayoría se ponían enfermos. Muchos morían. Sin embargo, la primera ley inglesa de protección infantil no se dictó hasta 1878. Aunque en los países ricos ese maltrato acabó a principios del siglo pasado, todavía sigue existiendo en muchos países pobres.&lt;/html&gt;</body><title>&lt;html&gt;Explotación infantil&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a59_3.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9527C</imagerefid><audiorefid/><imageheight>284</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Explotación infantil&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="5" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;La máquina de vapor sirve para convertir el vapor de agua en energía. Su invención en 1769 fue el primer gran avance tecnológico de la Revolución Industrial. Antes de su aparición, las fábricas tenían que estar cerca de los ríos. En esta ilustración puedes ver las partes de una máquina de vapor. El ferrocarril y los barcos de vapor aparecerían poco después, y su importancia fue fundamental.&lt;/html&gt;</body><title>&lt;html&gt;Máquina de vapor&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a59_4.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9527D</imagerefid><audiorefid/><imageheight>332</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Máquina de vapor&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="6" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="3" bodystyleid="4"><body>&lt;html&gt;La Revolución Industrial produjo un crecimiento de las ciudades, al aumentar la emigración de los campesinos hacia los centros urbanos. También apareció una nueva clase social, la clase obrera, y los primeros proletarios. Los obreros comenzaron a exigir que se reconocieran sus derechos, y así surgieron teorías como el socialismo y asociaciones como los sindicatos. Por cierto, ‘proletario’ es una palabra que usaron los primeros socialistas: la utilizaban para referirse a los obreros que sólo tenían su propia fuerza (de trabajo) para sobrevivir en la nueva sociedad industrial.&lt;/html&gt;</body><title>&lt;html&gt;Proletariado&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a59_5.jpg</image><audiofile/><labels/><keywords/><imagerefid>42D9527E</imagerefid><audiorefid/><imageheight>309</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Proletariado&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="3" textdividerbarcolorid="3" creditsbuttonstyleid="3" resetbuttonstyleid="4" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="4" progresscolorid="3" guttercolorid="4" graphiccolorid="2" outlinecolorid="5" buttonstyleid="1"/><popmenustyle listtextstyleid="5" displaytextstyleid="5" selectedlisttextstyleid="5" rolllisttextstyleid="5" downlisttextstyleid="5" rolloutlinecolorid="6" displaybgcolorid="2" listbgcolorid="2" listoutlinecolorid="6" displayoutlinecolorid="6" popbuttonstyleid="1"><scrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="6"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="9" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="9" align="left" id="2"/><t