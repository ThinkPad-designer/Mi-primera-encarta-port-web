disabledstyleid="12" basestateid="3" rollstateid="2" downstateid="2" selectedstateid="2" disabledstateid="1" id="2"/><textbuttonstyle showbg="0" showoutline="0" basestyleid="13" rollstyleid="13" downstyleid="14" selectedstyleid="13" disabledstyleid="13" basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="3"/><textbuttonstyle showbg="1" showoutline="1" basestyleid="15" rollstyleid="15" downstyleid="15" selectedstyleid="15" disabledstyleid="15" basestateid="7" rollstateid="8" downstateid="9" selectedstateid="9" disabledstateid="10" id="4"/></textbuttonstyles><creditsdialogdata bodystyleid="17" titlestyleid="16"><dialogtitle>&lt;html&gt;Créditos&lt;/html&gt;</dialogtitle><text>&lt;html&gt;&lt;b&gt;La Revolución Industrial&lt;/b&gt;&lt;br&gt;Hulton Deutsch&lt;br&gt;&lt;br&gt;&lt;b&gt;Bienes de consumo&lt;/b&gt;&lt;br&gt;Corbis/Pierre Vauthey/Sygma&lt;br&gt;&lt;br&gt;&lt;b&gt;División del trabajo&lt;/b&gt;&lt;br&gt;© Microsoft Corporation. Reservados todos los derechos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Explotación infantil&lt;/b&gt;&lt;br&gt;Hulton Getty Picture Collection&lt;br&gt;&lt;br&gt;&lt;b&gt;Máquina de vapor&lt;/b&gt;&lt;br&gt;Dorling Kindersley&lt;br&gt;&lt;br&gt;&lt;b&gt;Proletariado&lt;/b&gt;&lt;br&gt;Bridgeman Art Library, London/New York/Museo de Orsay. París, Francia/Reunion des Musees Nationaux&lt;/html&gt;</text></creditsdialogdata><colors><color r="137" g="51" b="204" id="1"/><color r="255" g="255" b="255" id="2"/><color r="224" g="224" b="228" id="3"/><color r="160" g="160" b="164" id="4"/><color r="0" g="0" b="0" id="5"/><color r="227" g="227" b="227" id="6"/><color r="198" g="198" b="198" id="7"/><color r="128" g="128" b="128" id="8"/><color r="50" g="50" b="50" id="9"/><color r="90" g="16" b="148" id="10"/><color r="234" g="145" b="35" id="11"/><color r="224" g="88" b="21" id="12"/><color r="73" g="67" b="57" id="13"/><color r="150" g="150" b="150" id="14"/><color r="207" g="207" b="207" id="15"/><color r="252" g="