	<SYNC Start=0>
		<P Class=ENUSCC ID=Source>John Young</P>
		<P Class=ENUSCC align=left>Ah, this is going to be some kind of different ride.</P>
	</SYNC>
	<SYNC Start=4666>
		<P Class=ENUSCC ID=Source>Charles Duke</P>
		<P Class=ENUSCC align=left>Well, Tony, that's your "house rock" right there.</P>
	</SYNC>
	<SYNC Start=7933>
		<P Class=ENUSCC ID=Source>Anthony England</P>
		<P Class=ENUSCC align=left>Very good.</P>
	</SYNC>
	<SYNC Start=8700>
		<P Class=ENUSCC ID=Source>Harrison Schmitt</P>
		<P Class=ENUSCC align=left>...down to about, uh...  three centimeters, is in bag 569.</P>
	</SYNC>
	<SYNC Start=15266>
		<P Class=ENUSCC ID=Source>Eugene Cernan</P>
		<P Class=ENUSCC align=left>Hippity-hoppity, hippity-hoppity, hippity-hopping over hill and dale.</P>
	</SYNC>
	<SYNC Start=21066 Duration=33>
		<P Class=ENUSCC>&nbsp;</P>
	</SYNC>
