d="0" italic="0" underline="0" colorid="3" align="center" id="16"/><textstyle size="14" font="Tahoma" bold="1" italic="0" underline="0" colorid="4" align="left" id="17"/></textstyles><textbuttonstyles><textbuttonstyle showbg="0" showoutline="0" basestyleid="5" rollstyleid="6" downstyleid="7" selectedstyleid="8" disabledstyleid="5" basestateid="1" rollstateid="2" downstateid="3" selectedstateid="3" disabledstateid="1" id="1"/><textbuttonstyle showbg="0" showoutline="0" basestyleid="5" rollstyleid="9" downstyleid="8" selectedstyleid="8" disabledstyleid="5" basestateid="1" rollstateid="2" downstateid="3" selectedstateid="3" disabledstateid="1" id="2"/><textbuttonstyle showbg="0" showoutline="0" basestyleid="10" rollstyleid="11" downstyleid="12" selectedstyleid="13" disabledstyleid="10" basestateid="1" rollstateid="2" downstateid="3" selectedstateid="3" disabledstateid="1" id="3"/><textbuttonstyle showbg="0" showoutline="0" basestyleid="14" rollstyleid="14" downstyleid="15" selectedstyleid="14" disabledstyleid="14" basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="4"/><textbuttonstyle showbg="1" showoutline="0" basestyleid="16" rollstyleid="16" downstyleid="16" selectedstyleid="16" disabledstyleid="16" basestateid="7" rollstateid="8" downstateid="9" selectedstateid="9" disabledstateid="10" id="5"/></textbuttonstyles><creditsdialogdata bodystyleid="2" titlestyleid="17"><dialogtitle>&lt;html&gt;Créditos&lt;/html&gt;</dialogtitle><text/></creditsdialogdata><colors><color r="122" g="152" b="206" id="1"/><color r="128" g="128" b="128" id="2"/><color r="255" g="255" b="255" id="3"/><color r="0" g="0" b="0" id="4"/><color r="224" g="224" b="228" id="5"/><color r="160" g="160" b="164" id="6"/><color r="227" g="227" b="227" id="7"/><color r="198" g="198" b="198" id="8"/><color r="50" g="50" b="50" id="9"/><color r="234" g="145" b="35" id="10"/><color r="234" g="112" b="24" id="11"/><color r="73" g="67" b="57" id="12"/><color r="150" g="150" b="150" id="13"/><color r="207" g="207" b="207" id="14"/><color r="249" g="175" b="33" id="15"/><color r="250" g="208" b="54" id="16"/><color r="232" g="111" b="43" id="17"/><color r="182" g="190" b="200" id="18"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="4" bgcolorid="3" graphiccolorid="9" id="1"/><tcbuttonstate outlinecolorid="4" bgcolorid="3" graphiccolorid="10" id="2"/><tcbuttonstate outlinecolorid="4" bgcolorid="3" graphiccolorid="11" id="3"/><tcbuttonstate outlinecolorid="12" bgcolorid="13" graphiccolorid="9" id="4"/><tcbuttonstate outlinecolorid="12" bgcolorid="14" graphiccolorid="9" id="5"/><tcbuttonstate outlinecolorid="12" bgcolorid="14" graphiccolorid="3" id="6"/><tcbuttonstate outlinecolorid="15" bgcolorid="15" graphiccolorid="3" id="7"/><tcbuttonstate outlinecolorid="16" bgcolorid="16" graphiccolorid="3" id="8"/><tcbuttonstate outlinecolorid="17" bgcolorid="17" graphiccolorid="3" id="9"/><tcbuttonstate outlinecolorid="18" bgcolorid="18" graphiccolorid="3" id="10"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="1"/></twocolorbuttonstyles></iai>