<?xml version="1.0"?><quiz type="multichoice" id="2514" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes instrumentos sería más apropiado para interpretar una melodía?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La batería&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El gong&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El clarinete&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El clarinete.&lt;br&gt;&lt;br&gt;Con los otros dos, al ser instrumentos de percusión de altura indeterminada, sería imposible realizar una melodía propiamente dicha.

&lt;/html&gt;</text><image w="149" h="132">T051232A.jpg</image><imagerefid>1B827A7C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE</rewardcredits></quiz>