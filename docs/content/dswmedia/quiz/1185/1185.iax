&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="149" h="99">T025357A.jpg</image><imagerefid>1B8236C8</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T043368A.jpg</image><imagerefid>1B825DC6</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T025344A.jpg</image><imagerefid>1B8236BB</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="153" h="136">T043364A.jpg</image><imagerefid>1B825DC2</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El collie es un perro grande, muy popular como mascota, con pelo largo y liso.
