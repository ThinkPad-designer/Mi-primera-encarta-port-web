<?xml version="1.0"?><quiz type="multichoice" id="1041" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animales vuelven a la playa en la que nacieron, después de reproducirse, para enterrar en la arena los huevos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Las langostas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los salmones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las ranas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las tortugas marinas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las tortugas marinas. &lt;br&gt;&lt;br&gt;Las tortugas marinas ponen hasta 200 huevos en la arena. Cuando las tortugas nacen, se dirigen enseguida hacia el mar.
&lt;/html&gt;</text><image w="149" h="133">T010607A.jpg</image><imagerefid>1B8227F0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Jany Sauvanet</rewardcredits></quiz>