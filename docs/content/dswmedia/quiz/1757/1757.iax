<?xml version="1.0"?><quiz type="multichoice" id="1757" lang="E" hascredits="1"><question><text>&lt;html&gt;Which of the following European countries does &lt;b&gt;not&lt;/b&gt; border Russia?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Finland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Germany&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Norway&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ukraine&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Germany.&lt;br&gt;&lt;br&gt;Germany is more than 200 miles (300 kilometers) away from Russian territory.
