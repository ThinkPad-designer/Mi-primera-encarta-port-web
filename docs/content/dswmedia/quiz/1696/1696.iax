<?xml version="1.0"?><quiz type="multichoice" id="1696" lang="E" hascredits="1"><question><text>&lt;html&gt;How tall is Kilimanjaro, the tallest mountain in Africa?&lt;/html&gt;</text><image w="153" h="136">T029358A.jpg</image><imagerefid>29D29858</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;16,427 feet (5,007 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;19,341 feet  (5,895 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;22,057 feet (6,723 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;26,660 feet (8,121 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;19,341 feet (5,895 meters). &lt;br&gt;&lt;br&gt;Kilimanjaro is located in Tanzania in East Africa.
&lt;/html&gt;</text><image w="153" h="136">T029358A.jpg</image><imagerefid>29D29858</imagerefid><audio/><audiorefid/></reward><credits>Leo de Wys, Inc./Fridmar Damm</credits><rewardcredits>Leo de Wys, Inc./Fridmar Damm</rewardcredits></quiz>