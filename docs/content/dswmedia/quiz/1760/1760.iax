<?xml version="1.0"?><quiz type="multichoice" id="1760" lang="E" hascredits="0"><question><text>&lt;html&gt;Which lies farthest south: Australia or New Zealand?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Australia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;New Zealand&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;New Zealand.&lt;br&gt;&lt;br&gt;The southern end of New Zealand’s South Island stretches farther south than Australia.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>