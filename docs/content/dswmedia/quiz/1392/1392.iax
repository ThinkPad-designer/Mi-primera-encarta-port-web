<?xml version="1.0"?><quiz type="multichoice" id="1392" lang="E" hascredits="1"><question><text>&lt;html&gt;Una de las mayores ciudades del occidente africano es Lagos. Verdadero o falso: Lagos es la capital de Nigeria.
&lt;/html&gt;</text><image w="149" h="99">T790934A.jpg</image><imagerefid>1B82B60C</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso.&lt;br&gt;&lt;br&gt;Lagos fue la capital de Nigeria, hasta que en 1991 el gobierno trasladó la capital a la ciudad de Abuja.
&lt;/html&gt;</text><image w="149" h="99">T790934A.jpg</image><imagerefid>1B82B60C</imagerefid><audio/><audiorefid/></reward><credits>Hutchison Library/Anna Tully</credits><rewardcredits>Hutchison Library/Anna Tully</rewardcredits></quiz>