<?xml version="1.0"?><quiz type="multichoice" id="1004" lang="E" hascredits="1"><question><text>&lt;html&gt;Este extraño pez vive en humedales pero también puede sobrevivir fuera del agua. ¿Sabes cómo se llama?
&lt;/html&gt;</text><image w="149" h="149">T040643A.jpg</image><imagerefid>1B82550D</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Saltarín del fango&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Carpín dorado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tiburón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Esturión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Saltarín del fango. &lt;br&gt;&lt;br&gt;Los saltarines del fango viven en zonas húmedas en las costas tropicales de los océanos Índico y Pacífico. Pueden permanecer fuera del agua durante varios días.
&lt;/html&gt;</text><image w="149" h="149">T040643A.jpg</image><imagerefid>1B82550D</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Zig Leszczynski</credits><rewardcredits>Animals Animals/Zig Leszczynski</rewardcredits></quiz>