<?xml version="1.0"?><quiz type="multichoice" id="1349" lang="E" hascredits="0"><question><text>&lt;html&gt;Durante cientos de años, era habitual cruzar el Sahara para establecer relaciones comerciales. ¿Con qué palabra nos referimos al grupo de comerciantes que cruza un desierto, o cualquier otro lugar más o menos inhóspito, en sus vehículos o animales?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Caracol&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cartapacio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Caravana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Camarada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Caravana.&lt;br&gt;&lt;br&gt;Los principales productos comerciales que atravesaban el Sahara eran el oro y los esclavos hacia el norte, y la sal, las conchas de cauri y las armas hacia el sur. Las caravanas también transportaban artículos de lujo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>