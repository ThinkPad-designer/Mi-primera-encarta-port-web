<?xml version="1.0"?><quiz type="multichoice" id="1303" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Por qué los cerdos se revuelcan en el barro?&lt;/html&gt;</text><image w="149" h="132">T049816A.jpg</image><imagerefid>1B827546</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Para refrescarse&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Para que les crezca el pelo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Para atraer a las hembras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Para hacer ejercicio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Para refrescarse. &lt;br&gt;&lt;br&gt;Los cerdos no pueden sudar. Se revuelcan en el barro para enfriarse. El barro también les protege de las quemaduras y las picaduras de los insectos.&lt;/html&gt;</text><image w="149" h="132">T049816A.jpg</image><imagerefid>1B827546</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Mark Hamblin</credits><rewardcredits>Oxford Scientific Films/Mark Hamblin</rewardcredits></quiz>