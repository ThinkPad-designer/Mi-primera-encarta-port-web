<?xml version="1.0"?><quiz type="multichoice" id="1765" lang="E" hascredits="1"><question><text>&lt;html&gt;Which of the following Asian countries is on an &lt;i&gt;archipelago&lt;/i&gt;?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Japan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mongolia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;South Korea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Thailand&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Japan.&lt;br&gt;&lt;br&gt;An &lt;i&gt;archipelago&lt;/i&gt; is a chain of islands. 
