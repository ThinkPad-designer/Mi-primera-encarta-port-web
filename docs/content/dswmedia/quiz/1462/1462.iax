<?xml version="1.0"?><quiz type="multichoice" id="1462" lang="E" hascredits="0"><question><text>&lt;html&gt;Verdadero o falso: el Kalahari es el desierto más grande de África.
&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso.&lt;br&gt;&lt;br&gt;El desierto del Sahara, en el norte de África, es el más grande del mundo. El segundo desierto más grande de África es el de Kalahari.&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>