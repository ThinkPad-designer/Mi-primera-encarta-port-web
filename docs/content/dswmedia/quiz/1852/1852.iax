<?xml version="1.0"?><quiz type="multichoice" id="1852" lang="E" hascredits="0"><question><text>&lt;html&gt;Las tres grandes familias de instrumentos musicales son:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Cuerda, viento y percusión.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cuerda gorda, cuerda fina y sin cuerdas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Electrónicos, de madera y de corcho.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>