<?xml version="1.0"?><quiz type="multichoice" id="1862" lang="E" hascredits="0"><question><text>&lt;html&gt;El siglo XX se caracterizó en música por una de las siguientes afirmaciones:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Se volvió a componer como en la Edad Media.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Surgieron muchas formas distintas de componer y los músicos quisieron innovar continuamente.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Se abandonaron los instrumentos clásicos y únicamente se compuso con instrumentos electrónicos.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>