<?xml version="1.0"?><quiz type="multichoice" id="1656" lang="E" hascredits="0"><question><text>&lt;html&gt;En béisbol, ¿qué es un &lt;i&gt;home run&lt;/i&gt;?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Recorrer todas las bases sin ser eliminado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Conseguir todas las bases con un único bateo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Batear la pelota con el brazo izquierdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Agarrar la pelota en el aire desde las gradas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Conseguir todas las bases con un único bateo. &lt;br&gt;&lt;br&gt;El beisbolista dominicano Sammy Sosa, entre los más grandes bateadores de las Grandes Ligas en la década de 1990, llegó en 2003 a sumar 500 &lt;i&gt;home runs&lt;/i&gt; obtenidos desde su debut en 1989.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>