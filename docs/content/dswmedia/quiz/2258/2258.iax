<?xml version="1.0"?><quiz type="multichoice" id="2258" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales es una medusa?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="149" h="99">T014084A.jpg</image><imagerefid>42D95D3A</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="99">T172898A.jpg</image><imagerefid>42D95D0D</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">00127c38.jpg</image><imagerefid>42D95529</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="149">00127c68.jpg</image><imagerefid>42D95535</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las medusas son invertebrados marinos de cuerpos casi transparentes. Tienen forma de campana, de la que cuelgan varios tentáculos. Muchas son venenosas.&lt;/html&gt;</text><image w="149" h="149">00127c68.jpg</image><imagerefid>42D95535</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Pam and Willy Kemp&lt;br&gt;&lt;br&gt;Minden Pictures/Flip Nicklin&lt;br&gt;&lt;br&gt;Corbis/Brandon D. Cole&lt;br&gt;&lt;br&gt;Digital Vision</credits><rewardcredits>Digital Vision</rewardcredits></quiz>