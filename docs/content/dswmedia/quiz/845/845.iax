<?xml version="1.0"?><quiz type="multichoice" id="845" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué órganos filtran tu sangre unas 300 veces cada día?&lt;/html&gt;</text><image w="149" h="149"/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Riñones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ojos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Páncreas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los riñones. &lt;br&gt;&lt;br&gt;Los riñones son dos órganos que filtran la sangre y forman la orina. La orina está compuesta por agua y otras sustancias inútiles o perjudiciales para nuestro cuerpo. 
&lt;/html&gt;</text><image w="149" h="149">00102385.jpg</image><imagerefid>29D22C24</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>