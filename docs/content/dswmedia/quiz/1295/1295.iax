<?xml version="1.0"?><quiz type="multichoice" id="1295" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuántos huevos puede poner una gallina en un año?
&lt;/html&gt;</text><image w="149" h="133">T050446A.jpg</image><imagerefid>1B8277B6</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;75&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;130&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;280&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;430&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;280. &lt;br&gt;&lt;br&gt;El número de huevos que ponen las gallinas depende de varios factores, como la temperatura, el tipo de alimento y la cantidad de luz.&lt;/html&gt;</text><image w="149" h="133">T050446A.jpg</image><imagerefid>1B8277B6</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films</credits><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>