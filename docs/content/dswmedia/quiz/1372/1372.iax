<?xml version="1.0"?><quiz type="multichoice" id="1372" lang="E" hascredits="0"><question><text>&lt;html&gt;Cerca de la costa occidental africana se halla el archipiélago de Madeira. ¿Sabrías decir a qué país pertenece ese conjunto de islas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;A España&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;A Reino Unido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;A Guinea Ecuatorial&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;A Portugal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A Portugal.&lt;br&gt;&lt;br&gt;El archipiélago de Madeira es una de las dos regiones autónomas portuguesas. La otra es la del archipiélago de Azores. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>