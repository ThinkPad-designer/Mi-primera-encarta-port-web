<?xml version="1.0"?><quiz type="multichoice" id="1174" lang="E" hascredits="1"><question><text>&lt;html&gt;La raza de gato Sphynx es poco corriente porque…
&lt;/html&gt;</text><image w="149" h="132">T054575A.jpg</image><imagerefid>1B8284DE</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Es nocturno.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Casi no tiene pelo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ladra como un perro.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Puede cambiar de color.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Casi no tiene pelo. &lt;br&gt;&lt;br&gt;Su piel, a menudo arrugada, tiene un tacto cálido y suave, parecido al ante.&lt;/html&gt;</text><image w="149" h="132">T054575A.jpg</image><imagerefid>1B8284DE</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Henry Ausloos</credits><rewardcredits>Animals Animals/Henry Ausloos</rewardcredits></quiz>