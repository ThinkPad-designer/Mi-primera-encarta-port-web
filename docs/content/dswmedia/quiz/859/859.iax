<?xml version="1.0"?><quiz type="multichoice" id="859" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué aparato utilizamos para saber si un hueso está roto?&lt;/html&gt;</text><image w="149" h="132">T047673A.jpg</image><imagerefid>1B826D9E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Ordenador&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Rayos X&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Incineradora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Centrifugadora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Rayos X. &lt;br&gt;&lt;br&gt;Los rayos X pasan con facilidad a través de los tejidos blandos de los órganos pero &lt;i&gt;no&lt;/i&gt; atraviesan los huesos. En las radiografías los huesos se ven de color blanco y los tejidos blandos de color gris.
&lt;/html&gt;</text><image w="149" h="133">T012515A.jpg</image><imagerefid>1B822E85</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Scott Camazine</credits><rewardcredits>Photo Researchers, Inc./Biophoto Associates/Science Source</rewardcredits></quiz>