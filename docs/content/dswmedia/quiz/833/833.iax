<?xml version="1.0"?><quiz type="multichoice" id="833" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes cuál es el órgano que te permite recibir sensaciones como el frío, el calor y el dolor?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Hígado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Riñones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Piel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Piel. &lt;br&gt;&lt;br&gt;La piel es también una barrera que te defiende de los gérmenes, ayuda a controlar la temperatura del organismo y forma la vitamina  D.
&lt;/html&gt;</text><image w="149" h="133">T012339A.jpg</image><imagerefid>1B822E09</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>