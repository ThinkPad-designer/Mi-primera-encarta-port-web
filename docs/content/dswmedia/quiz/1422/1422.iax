<?xml version="1.0"?><quiz type="multichoice" id="1422" lang="E" hascredits="1"><question><text>&lt;html&gt;¿En qué país se halla el Parque nacional Serengeti?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;En Tanzania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En Sudán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Libia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Tanzania.&lt;br&gt;&lt;br&gt;Tanzania está en el sureste del continente africano. El Serengeti se halla en el noroeste tanzano.&lt;/html&gt;</text><image w="149" h="132">T235396a.jpg</image><imagerefid>1B8291b0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Bildarchiv Okapia</rewardcredits></quiz>