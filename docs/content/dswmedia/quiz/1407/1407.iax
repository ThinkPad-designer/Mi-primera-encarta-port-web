<?xml version="1.0"?><quiz type="multichoice" id="1407" lang="E" hascredits="0"><question><text>&lt;html&gt;Una de estas palabras relacionadas con la aventura proviene de la lengua swahili. ¿Sabrías decir cuál de ellas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Puenting&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kayak&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Safari &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rafting&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Safari.&lt;br&gt;&lt;br&gt;Originalmente, esa palabra swahili se refería solo a la caza mayor llevada a cabo en África. Hoy se llama también safari a &apos;cualquier excursión para ver o fotografiar animales salvajes, efectuada en África o en otros territorios&apos;.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>