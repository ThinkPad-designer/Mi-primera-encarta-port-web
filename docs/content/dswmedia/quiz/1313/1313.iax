<?xml version="1.0"?><quiz type="multichoice" id="1313" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué país es el que tiene mayor número de vacas?

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Argentina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;España&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;India&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;India. &lt;br&gt;&lt;br&gt;El ganado vacuno tiene mucha importancia en la India. Las vacas se utilizan para tirar de los carros, arar los campos y obtener leche y otros productos derivados.
&lt;/html&gt;</text><image w="153" h="136">T058804A.jpg</image><imagerefid>1B82899D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Mathias Oppersdorff</rewardcredits></quiz>