<?xml version="1.0"?><quiz type="multichoice" id="2260" lang="E" hascredits="1"><question><text>&lt;html&gt;Estos invertebrados se cultivan en todo el mundo porque son considerados un manjar exquisito. Son animales marinos pertenecientes al grupo de los moluscos. ¿Sabes de qué animales se trata?&lt;/html&gt;</text><image w="149" h="132">T025828A.jpg</image><imagerefid>1B82382D</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Las langostas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los percebes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las ostras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los erizos de mar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El cultivo de ostras se conoce desde la antigüedad y, en la actualidad, se practica en muchos países.&lt;/html&gt;</text><image w="149" h="149">00127c44.jpg</image><imagerefid>42D959E8</imagerefid><audio/><audiorefid/></reward><credits>Tony Stone Images/Paul Harris</credits><rewardcredits>Peter Arnold, Inc./Jodi Jacobson</rewardcredits></quiz>