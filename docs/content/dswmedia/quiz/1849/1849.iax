<?xml version="1.0"?><quiz type="multichoice" id="1849" lang="E" hascredits="0"><question><text>&lt;html&gt;Tres de los grandes compositores del clasicismo musical fueron:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Ludwig van Beethoven, Antonio Vivaldi y Johannes Brahms.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Wolfgang Amadeus Mozart, Ludwig van Beethoven y Joseph Haydn.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Joseph Haydn, Claude Debussy y Wolfgang Amadeus Mozart.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>