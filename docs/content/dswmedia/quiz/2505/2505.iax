<?xml version="1.0"?><quiz type="multichoice" id="2505" lang="E" hascredits="0"><question><text>&lt;html&gt;El compositor Carl Orff compuso en el siglo XX una colección muy famosa de piezas para coro y orquesta, que habrás escuchado varias veces en el cine. Se llama:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Carmina Burana&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Impromptus&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Danzas eslavas&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Carmina Burana&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Está basada en colecciones de canciones, llamadas cancioneros, pertenecientes a la edad media.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>