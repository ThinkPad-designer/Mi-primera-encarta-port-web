<?xml version="1.0"?><quiz type="multichoice" id="1399" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de estos países &lt;b&gt;no&lt;/b&gt; forma parte de la costa swahili?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Australia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mozambique&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tanzania  &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Australia.&lt;br&gt;&lt;br&gt;La costa swahili se extiende por Somalia, Kenia, Tanzania y Mozambique. Australia se encuentra al otro lado del océano Índico.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>