<?xml version="1.0"?><quiz type="multichoice" id="863" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué músculo hace latir el corazón?
&lt;/html&gt;</text><image w="149" h="149">00102565.jpg</image><imagerefid>29D22C2C</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Músculo recto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Músculo cardiaco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Músculos pectorales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Diafragma&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El músculo cardiaco. &lt;br&gt;&lt;br&gt;El músculo cardiaco es un músculo involuntario que se contrae de forma automática. ¡No necesitas pensar que tiene que latir! 
&lt;/html&gt;</text><image w="149" h="149">00102565.jpg</image><imagerefid>29D22C2C</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>