<?xml version="1.0"?><quiz type="multichoice" id="2330" lang="E" hascredits="0"><question><text>&lt;html&gt;Las tres grandes familias de instrumentos musicales son:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Cuerda, viento y percusión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cuerda gorda, cuerda fina y sin cuerdas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Electrónicos, de madera y de corcho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cuerda, viento y percusión.&lt;br&gt;&lt;br&gt;Dentro de cada familia, se encuentran infinidad de instrumentos distintos, pero relacionados entre sí en la forma de producir el sonido.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>