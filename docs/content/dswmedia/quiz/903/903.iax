<?xml version="1.0"?><quiz type="multichoice" id="903" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánto tiempo debe durar el cepillado de los dientes? 


&lt;/html&gt;</text><image w="149" h="99">00176594.jpg</image><imagerefid>42D97811</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;20 minutos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1 hora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;3 minutos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Todo el día&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;3 minutos.&lt;br&gt;&lt;br&gt;Después de cada comida debes lavarte los dientes durante unos 3 minutos. Los dientes deben cepillarse en la dirección de su crecimiento, desde la encía hacia la punta.
&lt;/html&gt;</text><image w="149" h="99">00176594.jpg</image><imagerefid>42D97811</imagerefid><audio/><audiorefid/></reward><credits>Digital Vision Ltd.</credits><rewardcredits>Digital Vision Ltd.</rewardcredits></quiz>