<?xml version="1.0"?><quiz type="multichoice" id="2824" lang="E" hascredits="0"><question><text>&lt;html&gt;Les migrations de la rive sud de la Méditerranée vers la rive nord sont principalement motivées par&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;des raisons démographiques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;des raisons économiques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;des raisons politiques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Les pays de la rive sud de la Méditerranée sont surtout des pays émetteurs de migrants économiques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>