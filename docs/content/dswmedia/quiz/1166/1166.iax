<?xml version="1.0"?><quiz type="multichoice" id="1166" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: el cuerpo de un gato contiene más huesos que el de los seres humanos.

&lt;/html&gt;</text><image w="149" h="99">T047367A.jpg</image><imagerefid>1B826C81</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero. &lt;br&gt;&lt;br&gt;A pesar de que son más pequeños, los gatos tienen más de 230 huesos, mientras que los seres humanos solo tenemos 206.&lt;/html&gt;</text><image w="149" h="99">T047367A.jpg</image><imagerefid>1B826C81</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley/Jerry Young</credits><rewardcredits>Dorling Kindersley/Jerry Young</rewardcredits></quiz>