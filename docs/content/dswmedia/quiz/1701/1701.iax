<?xml version="1.0"?><quiz type="multichoice" id="1701" lang="E" hascredits="1"><question><text>&lt;html&gt;What European mountain range stretches from southeastern France, across Switzerland and northern Italy, to western Austria?
&lt;/html&gt;</text><image w="98" h="150">00189f2b.jpg</image><imagerefid>42D98969</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Cumbrian Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Caucasus Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Alps&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pyrenees&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Alps.&lt;br&gt;&lt;br&gt;The word &lt;i&gt;alpine,&lt;/i&gt; meaning “relating to high mountains,” comes from the name of this mountain range.
&lt;/html&gt;</text><image w="98" h="150">00189f2b.jpg</image><imagerefid>42D98969</imagerefid><audio/><audiorefid/></reward><credits>eStock Photo/SIME s.a.s</credits><rewardcredits>eStock Photo/SIME s.a.s</rewardcredits></quiz>