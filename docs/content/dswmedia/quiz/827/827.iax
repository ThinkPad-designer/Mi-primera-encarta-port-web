<?xml version="1.0"?><quiz type="multichoice" id="827" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes a que velocidad viajan las señales nerviosas?
&lt;/html&gt;</text><image w="149" h="149">001025a9.jpg</image><imagerefid>29D22C7C</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;24 kilómetros por hora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;160 kilómetros por hora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;400 kilómetros por hora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;770 kilómetros por hora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;400 kilómetros por hora.&lt;br&gt;&lt;br&gt;Las señales nerviosas viajan por tu organismo a más velocidad que los coches de carreras.
&lt;/html&gt;</text><image w="149" h="149">001025a9.jpg</image><imagerefid>29D22C7C</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>