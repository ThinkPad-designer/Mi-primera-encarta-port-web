<?xml version="1.0"?><quiz type="multichoice" id="839" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánta saliva produce un adulto al día?
&lt;/html&gt;</text><image w="149" h="149">0007760a.jpg</image><imagerefid>29D02594</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;0,5 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1,5 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;4 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;8 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;1,5 litros. &lt;br&gt;&lt;br&gt;La saliva se produce en las glándulas salivares. Este líquido humedece la boca, ablanda la comida y ayuda a realizar la digestión.
 

&lt;/html&gt;</text><image w="149" h="149">0007760a.jpg</image><imagerefid>29D02594</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>