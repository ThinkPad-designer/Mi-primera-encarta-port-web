<?xml version="1.0"?><quiz type="multichoice" id="1820" lang="E" hascredits="0"><question><text>&lt;html&gt;What European country’s three official languages are French, German, and Italian?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Austria&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Belgium&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Luxembourg&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Switzerland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Switzerland.&lt;br&gt;&lt;br&gt;Switzerland is located right in the middle of France, Germany, and Italy.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>