<?xml version="1.0"?><quiz type="multichoice" id="1301" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de los siguientes &lt;b&gt;no&lt;/b&gt; es un producto que obtengamos de las ovejas?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;La leche&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cuero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La lana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La penicilina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La penicilina. &lt;br&gt;&lt;br&gt;La penicilina es una medicina que se obtiene de un hongo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>