<?xml version="1.0"?><quiz type="multichoice" id="1329" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de estos dioses &lt;b&gt;no&lt;/b&gt; era un dios para los antiguos egipcios?
&lt;/html&gt;</text><image w="149" h="133">T045164A.jpg</image><imagerefid>42D97805</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Ra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Set&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Zeus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Horus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Zeus.&lt;br&gt;&lt;br&gt;Para los antiguos egipcios, Ra era el dios Sol, Set el dios de la oscuridad y Horus el del cielo y la luz. Zeus pertenecía a la mitología griega y era el dios del cielo, el soberano de los dioses olímpicos.
&lt;/html&gt;</text><image w="149" h="133">T045164A.jpg</image><imagerefid>42D97805</imagerefid><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York</credits><rewardcredits>Bridgeman Art Library, London/New York</rewardcredits></quiz>