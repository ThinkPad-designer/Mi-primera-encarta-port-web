<?xml version="1.0"?><quiz type="multichoice" id="1196" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Es cierto que los gatos tienen siete vidas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Sí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;No&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;No. &lt;br&gt;&lt;br&gt;Se dice que los gatos tienen siete vidas porque cuando se caen, incluso desde una gran altura, suelen caer de pie. Tienen un gran sentido del equilibrio.&lt;/html&gt;</text><image w="149" h="99">T047367A.jpg</image><imagerefid>1B826C81</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley/Jerry Young</rewardcredits></quiz>