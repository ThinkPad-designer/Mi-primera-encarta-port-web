<?xml version="1.0"?><quiz type="multichoice" id="1675" lang="E" hascredits="1"><question><text>&lt;html&gt;Manuel Estiarte ha sido uno de los más sobresalientes deportistas españoles. ¿En qué deporte destacó Estiarte hasta el punto de ser campeón olímpico y del mundo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En papiroflexia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En fútbol&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En waterpolo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En motociclismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En waterpolo. &lt;br&gt;&lt;br&gt;Estiarte participó en seis Juegos Olímpicos, en cuatro de los cuales fue el máximo goleador. También fue máximo anotador en tres Campeonatos del Mundo y en seis Campeonatos de Europa.&lt;/html&gt;</text><image w="149" h="132">T062934A.jpg</image><imagerefid>04dcab00</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Allsport/Tony Duffy</rewardcredits></quiz>