<?xml version="1.0"?><quiz type="multichoice" id="1751" lang="E" hascredits="1"><question><text>&lt;html&gt;What country has the largest population in Asia?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;India&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Indonesia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pakistan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;China.&lt;br&gt;&lt;br&gt;China has the largest population in the world (but India is gaining fast). More than one out of every five people on Earth lives in China.
&lt;/html&gt;</text><image w="149" h="149">00123d67.jpg</image><imagerefid>29D26492</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>