<?xml version="1.0"?><quiz type="multichoice" id="1045" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales se pega a las rocas en las zonas costeras y es utilizado como alimento?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El mejillón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La anémona de mar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La langosta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El cangrejo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El mejillón. &lt;br&gt;&lt;br&gt;Los mejillones se adhieren fuertemente a las rocas. Cuando baja la marea, cierran la concha para no perder agua.
&lt;/html&gt;</text><image w="149" h="132">T058518A.jpg</image><imagerefid>1B828881</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tom Stack and Associates/David M. Dennis</rewardcredits></quiz>