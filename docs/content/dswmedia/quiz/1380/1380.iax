<?xml version="1.0"?><quiz type="multichoice" id="1380" lang="E" hascredits="0"><question><text>&lt;html&gt;Los comerciantes europeos llamaron a parte del litoral occidental africano Costa de Marfil. El nombre oficial de ese país es una expresión en lengua francesa. ¿Cuál es?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Côte d’Azur&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Côte d’Ivoire&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Pays de la Loire&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Poitou-Charentes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Côte d’Ivoire.&lt;br&gt;&lt;br&gt;Significa Costa de Marfil, en francés. La razón de que esa denominación sea en lengua francesa es que Francia colonizó esos territorios desde mediados del siglo XIX hasta mediados del siglo XX.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>