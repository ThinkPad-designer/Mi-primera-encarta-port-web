<?xml version="1.0"?><quiz type="multichoice" id="2784" lang="E" hascredits="0"><question><text>&lt;html&gt;Pour régler les problèmes mondiaux...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;l&apos;ONU est seule décisionnaire.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;les organismes internationaux cherchent à favoriser les accords entre États.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;il n&apos;y aucune solution actuelle.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Les États restent souverains pour les questions internationales. L&apos;ONU ne peut imposer de solutions sans l&apos;accord des grandes puissances. Elle prend rarement des décisions contraignantes envers un État.&lt;br&gt;Mais l&apos;ONU et les différentes instances internationales sont des lieux de discussion où s&apos;élaborent, très lentement il est vrai, des solutions aux problèmes de la planète.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>