<?xml version="1.0"?><quiz type="multichoice" id="1658" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué nadador estadounidense ganó ocho medallas en los Juegos Olímpicos de 2004?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Ian Thorpe&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Michael Phelps&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;George W. Bush&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mark Spitz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Michael Phelps. &lt;br&gt;&lt;br&gt;En los Juegos Olímpicos de Atenas, celebrados en 2004, ganó ocho medallas en total, seis de ellas de oro y dos de bronce.&lt;/html&gt;</text><image w="99" h="149">00174c72.jpg</image><imagerefid>29D32532</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Getty Images/Tim Clary/AFP</rewardcredits></quiz>