<?xml version="1.0"?><quiz type="multichoice" id="917" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabrías decir cuál de estos procesos mentales &lt;b&gt;no&lt;/b&gt; está controlado por la parte izquierda de tu cerebro?

&lt;/html&gt;</text><image w="149" h="132">T012861A.jpg</image><imagerefid>1B822F80</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Habilidad numérica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Habilidad científica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Razonamiento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Imaginación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Imaginación. &lt;br&gt;&lt;br&gt;La parte izquierda de tu cerebro se ocupa de las operaciones lógicas y el razonamiento, mientras que la parte derecha controla la imaginación y la creatividad.
&lt;/html&gt;</text><image w="149" h="132">T012861A.jpg</image><imagerefid>1B822F80</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>