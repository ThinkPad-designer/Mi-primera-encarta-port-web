<?xml version="1.0"?><quiz type="multichoice" id="1202" lang="E" hascredits="1"><question><text>&lt;html&gt;En los roedores, como los hámsters, los ratones o los conejillos de Indias, ¿qué parte del cuerpo crece durante toda la vida?&lt;/html&gt;</text><image w="153" h="136">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;La oreja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El hocico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las patas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los dientes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los dientes. &lt;br&gt;&lt;br&gt;A los roedores les crecen los dientes durante toda la vida. Por eso, si tienes uno como mascota, es importante que le proporciones alimentos duros o algo que morder para que desgasten los dientes.&lt;/html&gt;</text><image w="153" h="136">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./H. Reinhard</credits><rewardcredits>Bruce Coleman, Inc./H. Reinhard</rewardcredits></quiz>