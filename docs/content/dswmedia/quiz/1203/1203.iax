<?xml version="1.0"?><quiz type="multichoice" id="1203" lang="E" hascredits="1"><question><text>&lt;html&gt;¿A cuál de las siguientes mascotas puedes contagiarle tu resfriado?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Al gato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Al loro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Al hámster&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Al carpín dorado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Al hámster. &lt;br&gt;&lt;br&gt;El hámster es uno de los pocos mamíferos de pequeño tamaño capaz de coger un resfriado.&lt;/html&gt;</text><image w="153" h="136">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bruce Coleman, Inc./H. Reinhard</rewardcredits></quiz>