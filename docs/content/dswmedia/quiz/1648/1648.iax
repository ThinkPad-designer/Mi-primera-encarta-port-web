<?xml version="1.0"?><quiz type="multichoice" id="1648" lang="E" hascredits="1"><question><text>&lt;html&gt;Uno de los siguientes nombres corresponde a un jugador de baloncesto campeón olímpico. ¿Cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Emiliano Rodríguez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Ruperto Herrera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Emanuel Ginobili&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Michel Platini&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Emanuel Ginobili. &lt;br&gt;&lt;br&gt;El baloncestista argentino Emanuel Ginobili ganó la medalla olímpica de oro con su selección nacional en 2004. Dos años antes había logrado la plata en el Campeonato del Mundo.&lt;/html&gt;</text><image w="99" h="149">0010199a.jpg</image><imagerefid>42D95200</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Reuters NewMedia Inc.</rewardcredits></quiz>