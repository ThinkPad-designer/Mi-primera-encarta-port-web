<?xml version="1.0"?><quiz type="multichoice" id="871" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es la composición de la sangre?&lt;/html&gt;</text><image w="149" h="132">T012440A.jpg</image><imagerefid>1B822E4D</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Sales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bilis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Linfa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Plasma y células sanguíneas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Plasma y células sanguíneas.&lt;br&gt;&lt;br&gt;Las células sanguíneas son los glóbulos rojos, los glóbulos blancos y las plaquetas. El plasma es un líquido amarillento que contiene agua, proteínas, hidratos de carbono, grasas, vitaminas, minerales y otras sustancias. 
