<?xml version="1.0"?><quiz type="multichoice" id="2533" lang="E" hascredits="1"><question><text>&lt;html&gt;¿A cuál de los siguientes compositores pertenecen la &lt;i&gt;Sinfonía india&lt;/i&gt;, la &lt;i&gt;Sinfonía proletaria&lt;/i&gt;  y &lt;i&gt;Xochipilli, Macuilxóchitl&lt;/i&gt;?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Isaac Albéniz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Carlos Chávez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Manuel de Falla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Carlos Chávez.&lt;br&gt;&lt;br&gt;Carlos Chávez fue una figura importantísima en el desarrollo de la música mexicana.&lt;/html&gt;</text><image w="149" h="132">T060158A.jpg</image><imagerefid>073FBC09</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis</rewardcredits></quiz>