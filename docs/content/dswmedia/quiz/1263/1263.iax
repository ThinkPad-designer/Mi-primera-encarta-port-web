<?xml version="1.0"?><quiz type="multichoice" id="1263" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales se hincha con agua o aire y hace ruido cuando se siente amenazado?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text/><image w="149" h="132">T014476A.jpg</image><imagerefid>1B823434</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="99">06A4D.jpg</image><imagerefid>25A41E8B</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="102" h="153">0005c5da.jpg</image><imagerefid>289EDF4C</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T049988A.jpg</image><imagerefid>1B8275F0</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El pez globo infla su cuerpo con agua o aire cuando se siente en peligro.
&lt;/html&gt;</text><image w="149" h="132">T014476A.jpg</image><imagerefid>1B823434</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./J.W. Mowbray&lt;br&gt;&lt;br&gt;Animals Animals/Don and Lolly Skillman&lt;br&gt;&lt;br&gt;AP/Wide World Photos/Eric Draper&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Mike Kraetsch</credits><rewardcredits>Photo Researchers, Inc./J.W. Mowbray</rewardcredits></quiz>