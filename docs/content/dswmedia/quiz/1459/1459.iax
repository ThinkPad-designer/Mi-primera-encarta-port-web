<?xml version="1.0"?><quiz type="multichoice" id="1459" lang="E" hascredits="1"><question><text>&lt;html&gt;Los bosquimanos habitan en el desierto de Kalahari. Históricamente, este pueblo ha vivido en este territorio dedicándose a la caza y a la recogida de plantas y frutos. ¿Con qué término se denomina a esa clase de sociedades?
&lt;/html&gt;</text><image w="149" h="132">T041062A.jpg</image><imagerefid>1B8256B0</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Agrícolas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Artesanales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cazadores-recolectoras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tecnócratas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cazadores-recolectoras&lt;br&gt;&lt;br&gt;Esas sociedades de cazadores-recolectores subsisten gracias a la caza y a la recolección de alimentos silvestres, sin llegar a desarrollar apenas o en absoluto ni la agricultura ni la ganadería.&lt;/html&gt;</text><image w="149" h="132">T041062A.jpg</image><imagerefid>1B8256B0</imagerefid><audio/><audiorefid/></reward><credits>Woodfin Camp and Associates, Inc./Marvin E. Newman</credits><rewardcredits>Woodfin Camp and Associates, Inc./Marvin E. Newman</rewardcredits></quiz>