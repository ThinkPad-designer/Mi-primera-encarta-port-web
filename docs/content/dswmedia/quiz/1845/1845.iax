<?xml version="1.0"?><quiz type="multichoice" id="1845" lang="E" hascredits="0"><question><text>&lt;html&gt;El instrumento que más se utilizaba en la antigua Grecia se llamaba lira y era parecido a:
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Un pequeño piano pero sin las teclas negras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un arpa pequeña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una flauta, pero hecha de hueso de carnero.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>