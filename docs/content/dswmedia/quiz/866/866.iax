<?xml version="1.0"?><quiz type="multichoice" id="866" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cómo se trasmiten las características hereditarias de generación en generación?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Máquina del tiempo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Genes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Glóbulos rojos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Antena de televisión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Genes. &lt;br&gt;&lt;br&gt;Los genes determinan los rasgos físicos que los organismos heredan, como la forma de las hojas de los árboles, los dibujos de la piel de los animales o el color del pelo de las personas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>