<?xml version="1.0"?><quiz type="multichoice" id="1781" lang="E" hascredits="1"><question><text>&lt;html&gt;Which of the following Pacific Island nations is located north of the equator?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Palau&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Samoa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tonga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tuvalu&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Palau.&lt;br&gt;&lt;br&gt;Palau is in the island chain called Micronesia, which is largely north of the equator. Samoa, Tonga, and Tuvalu are all in the island grouping called Polynesia, which lies mostly south of the equator.
&lt;/html&gt;</text><image w="153" h="136">T025855A.jpg</image><imagerefid>42D9670C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tony Stone Images/Stuart Westmorland</rewardcredits></quiz>