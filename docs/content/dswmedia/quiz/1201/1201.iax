<?xml version="1.0"?><quiz type="multichoice" id="1201" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes mascotas &lt;b&gt;no&lt;/b&gt; es un roedor?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="149" h="99">T050432A.jpg</image><imagerefid>1B8277A8</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T045640A.jpg</image><imagerefid>1B826647</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T013516A.jpg</image><imagerefid>1B823176</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los conejos, como el que ves en la fotografía, no pertenecen al grupo de los roedores.&lt;/html&gt;</text><image w="149" h="132">T045640A.jpg</image><imagerefid>1B826647</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Michael Leach&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Avril Ramage&lt;br&gt;&lt;br&gt;Bruce Coleman, Inc./H. Reinhard&lt;br&gt;&lt;br&gt;Dorling Kindersley</credits><rewardcredits>Oxford Scientific Films/Avril Ramage</rewardcredits></quiz>