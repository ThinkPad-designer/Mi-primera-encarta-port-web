<?xml version="1.0"?><quiz type="multichoice" id="1645" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué piloto de automovilismo debutó en el Campeonato del Mundo de Fórmula 1, en 2001, y acabó sexto al final de la temporada? Una pista, nació en 1975 en la ciudad colombiana de Santafé de Bogotá.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Fernando Alonso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;LeBron James&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Juan Pablo Montoya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Carlos Alberto Reutemann&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Juan Pablo Montoya. &lt;br&gt;&lt;br&gt;El colombiano Juan Pablo Montoya debutó en Fórmula 1 en 2001, acabó sexto y ganó su primer gran premio ese mismo año en Italia.&lt;/html&gt;</text><image w="149" h="149">001708bf.jpg</image><imagerefid>42D96F21</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Reuters</rewardcredits></quiz>