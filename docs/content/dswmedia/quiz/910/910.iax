<?xml version="1.0"?><quiz type="multichoice" id="910" lang="E" hascredits="1"><question><text>&lt;html&gt;En el ejercicio aeróbico trabajan un gran número de músculos al mismo tiempo y se consume mucho oxígeno. ¿Cuál de los siguientes &lt;b&gt;no&lt;/b&gt; es un ejercicio aeróbico?
&lt;/html&gt;</text><image w="149" h="149">0018a27e.jpg</image><imagerefid>42D97F8A</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Correr&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Jugar al baloncesto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Levantar pesas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Nadar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Levantar pesas. &lt;br&gt;&lt;br&gt;El levantamiento de pesas no es un ejercicio aeróbico porque no necesita mucho oxígeno, ya que solo realizan ejercicio unos pocos músculos al mismo tiempo.
&lt;/html&gt;</text><image w="149" h="99">0018a302.jpg</image><imagerefid>42D97FAB</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Tim de Waele</credits><rewardcredits>Getty Images/Karim Jaafar/AFP</rewardcredits></quiz>