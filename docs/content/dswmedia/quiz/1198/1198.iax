<?xml version="1.0"?><quiz type="multichoice" id="1198" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Los pájaros se bañan?&lt;/html&gt;</text><image w="149" h="149">000fb3b5.jpg</image><imagerefid>29D2BC97</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Sí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;No&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sí. &lt;br&gt;&lt;br&gt;Si tienes un pájaro en tu casa, tienes que ponerle dos cacharritos con agua en su jaula. Uno es para beber y otro para bañarse.

&lt;/html&gt;</text><image w="149" h="149">000fb3b5.jpg</image><imagerefid>29D2BC97</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Eric and David Hosking</credits><rewardcredits>Corbis/Eric and David Hosking</rewardcredits></quiz>