<?xml version="1.0"?><quiz type="multichoice" id="1855" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué compositor romántico escribió la canción &lt;i&gt;El rey de los Elfos&lt;/i&gt;, basada en un poema del escritor alemán Goethe?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Robert Schumann&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Claude Debussy&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Franz Schubert&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>