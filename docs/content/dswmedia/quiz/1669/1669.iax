<?xml version="1.0"?><quiz type="multichoice" id="1669" lang="E" hascredits="1"><question><text>&lt;html&gt;Solo uno de los siguientes nombres corresponde al de un futbolista mexicano. ¿Sabes cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Alejandro Cárdenas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Raúl Alcalá&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Rafael Márquez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rafael Osuna&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Rafael Márquez. &lt;br&gt;&lt;br&gt;Cárdenas ha cosechado triunfos en el atletismo, Alcalá fue un gran ciclista y Osuna practicó con éxito mundial el tenis.
