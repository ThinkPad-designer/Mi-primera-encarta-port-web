<?xml version="1.0"?><quiz type="multichoice" id="1472" lang="E" hascredits="1"><question><text>&lt;html&gt;Una de estas situaciones es habitual en el desierto de Kalahari. ¿Cuál de ellas?&lt;/html&gt;</text><image w="149" h="132">T041062A.jpg</image><imagerefid>1b8256b0</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La nieve&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Las tormentas de arena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El granizo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El París-Dakar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las tormentas de arena.&lt;br&gt;&lt;br&gt;No es extraño que el viento que sopla en el desierto de Kalahari, y en otros espacios similares, acabe por formar tormentas de arena.&lt;/html&gt;</text><image w="149" h="99">T232205A.jpg</image><imagerefid>073fc8bd</imagerefid><audio/><audiorefid/></reward><credits>Woodfin Camp and Associates, Inc./Marvin E. Newman</credits><rewardcredits>Corbis/Peter Lillie/ABPL</rewardcredits></quiz>