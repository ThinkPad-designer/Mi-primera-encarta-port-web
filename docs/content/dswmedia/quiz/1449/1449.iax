<?xml version="1.0"?><quiz type="multichoice" id="1449" lang="E" hascredits="1"><question><text>&lt;html&gt;Madagascar es conocida entre otras cosas por sus distintos tipos de lémures. Dado que los lémures viven en los árboles, entonces diremos que son...&lt;/html&gt;</text><image w="102" h="153">T628215A.jpg</image><imagerefid>29D32169</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Arboricidas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Arboricultores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Arborícolas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Arboriformes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Arborícolas.&lt;br&gt;&lt;br&gt;Los arboricidas son &apos;los que destruyen los árboles&apos;. Arboricultores se refiere a &apos;los que cultivan, o enseñan a cultivar, árboles&apos;. Arboriformes significa &apos;los que tienen forma de árbol&apos;.&lt;/html&gt;</text><image w="102" h="153">T628215A.jpg</image><imagerefid>29D32169</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Howard Uible</credits><rewardcredits>Photo Researchers, Inc./Howard Uible</rewardcredits></quiz>