<?xml version="1.0"?><quiz type="multichoice" id="2245" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuántos tentáculos tienen los pulpos?&lt;/html&gt;</text><image w="149" h="132">T044207A.jpg</image><imagerefid>1B8260EF</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Cuatro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Seis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ocho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Diez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Ocho.&lt;br&gt;&lt;br&gt;Los pulpos tienen el cuerpo blando con ocho tentáculos, cada uno de los cuales posee dos filas de ventosas.&lt;/html&gt;</text><image w="149" h="132">T044207A.jpg</image><imagerefid>1B8260EF</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./Jane Burton</credits><rewardcredits>Bruce Coleman, Inc./Jane Burton</rewardcredits></quiz>