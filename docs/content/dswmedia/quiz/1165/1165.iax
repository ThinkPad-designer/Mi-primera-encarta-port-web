<?xml version="1.0"?><quiz type="multichoice" id="1165" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes por qué se pega el gato a tu pierna, además de para mostrarte su cariño?&lt;/html&gt;</text><image w="149" h="149">T058600A.jpg</image><imagerefid>1B8288D1</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Para &apos;perfumarte&apos; con su olor.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Para hacerte cosquillas. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Para limpiarse.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Para golpearte.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Para impregnarte con su olor. &lt;br&gt;&lt;br&gt;Tu gato quiere dejar claro a los demás gatos que tú eres su dueño. 
&lt;/html&gt;</text><image w="149" h="149">T058600A.jpg</image><imagerefid>1B8288D1</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley/Marc Henrie</credits><rewardcredits>Dorling Kindersley/Marc Henrie</rewardcredits></quiz>