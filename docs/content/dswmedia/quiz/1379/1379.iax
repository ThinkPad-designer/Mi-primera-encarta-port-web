<?xml version="1.0"?><quiz type="multichoice" id="1379" lang="E" hascredits="1"><question><text>&lt;html&gt;En la costa occidental africana se encuentra Liberia. ¿Cuál es la capital de ese país?&lt;/html&gt;</text><image w="153" h="153"/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Accra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lagos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Monrovia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Uagadugú&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Monrovia.&lt;br&gt;&lt;br&gt;La ciudad fue fundada en la segunda década del siglo XIX y recibió ese nombre en honor del presidente estadounidense James Monroe.
&lt;/html&gt;</text><image w="149" h="133">T014081A.jpg</image><imagerefid>42D97784</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>