<?xml version="1.0"?><quiz type="multichoice" id="2324" lang="E" hascredits="0"><question><text>&lt;html&gt;A continuación aparecen ordenadas cronológicamente, de más antigua a más moderna,  cuatro épocas históricas fundamentales en el desarrollo de la historia de la música occidental. ¿Cuál de las opciones es la correcta?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Clasicismo, renacimiento, barroco y romanticismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Renacimiento, barroco, clasicismo y romanticismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Romanticismo, clasicismo, barroco y renacimiento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Renacimiento, barroco, clasicismo y romanticismo.&lt;br&gt;&lt;br&gt;Estas cuatro épocas abarcan aproximadamente desde el siglo XV hasta finales del XIX, casi 500 años.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>