<?xml version="1.0"?><quiz type="multichoice" id="1267" lang="E" hascredits="0"><question><text>&lt;html&gt;Uno de los alimentos más caros es el caviar. ¿Sabes lo qué es exactamente?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Ojos de los peces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Huevos de los peces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tripas de los peces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Aletas de los peces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Huevos de los peces. &lt;br&gt;&lt;br&gt;El caviar son los huevos de un pez llamado esturión.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>