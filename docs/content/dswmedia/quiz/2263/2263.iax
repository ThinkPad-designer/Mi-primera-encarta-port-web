<?xml version="1.0"?><quiz type="multichoice" id="2263" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Dónde viven las estrellas de mar?&lt;/html&gt;</text><image w="149" h="132">T049749A.jpg</image><imagerefid>1B827506</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;En los ríos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En los océanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En los desiertos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En la selva&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En los océanos.&lt;br&gt;&lt;br&gt;Las estrellas de mar son animales invertebrados que viven en el mar y se alimentan de moluscos y crustáceos.&lt;/html&gt;</text><image w="149" h="132">T049749A.jpg</image><imagerefid>1B827506</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./Jeffrey L. Rotman</credits><rewardcredits>Peter Arnold, Inc./Jeffrey L. Rotman</rewardcredits></quiz>