<?xml version="1.0"?><quiz type="multichoice" id="1706" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the longest river in North America?
&lt;/html&gt;</text><image w="153" h="136">T054491A.jpg</image><imagerefid>42D96720</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Colorado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Columbia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mississippi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rio Grande&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mississippi.&lt;br&gt;&lt;br&gt;The Mississippi River is 2,340 miles (3,770 kilometers) long from its headstreams in Minnesota to its delta in Louisiana. 
&lt;/html&gt;</text><image w="153" h="136">T054491A.jpg</image><imagerefid>42D96720</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Ned Haines</credits><rewardcredits>Photo Researchers, Inc./Ned Haines</rewardcredits></quiz>