<?xml version="1.0"?><quiz type="textAnswer" id="1324" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Quién era el dios sol para los antiguos egipcios?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers><answer>ra</answer><answer/></answers><reward><text>&lt;html&gt;Ra&lt;br&gt;&lt;br&gt;Ra era en el antiguo Egipto el dios sol, creador y regidor del Universo. Se le representaba con cuerpo humano y cabeza de halcón, a veces tocado por el disco solar.&lt;/html&gt;</text><image w="149" h="132">T641644A.jpg</image><imagerefid>073ff620</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bridgeman Art Library, London/New York/Fitzwilliam Museum, University of Cambridge</rewardcredits></quiz>