<?xml version="1.0"?><quiz type="multichoice" id="2336" lang="E" hascredits="0"><question><text>&lt;html&gt;Claude Debussy y Maurice Ravel fueron dos grandes compositores franceses que pertenecieron a un movimiento artístico nacido a finales del siglo XIX, y que se llamó:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Canto gregoriano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Impresionismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Ars Antiqua&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Impresionismo.&lt;br&gt;&lt;br&gt;Otros compositores relacionados con este movimiento artístico fueron los franceses Paul Dukas y Erik Satie.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>