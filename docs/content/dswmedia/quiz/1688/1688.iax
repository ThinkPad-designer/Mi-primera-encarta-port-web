<?xml version="1.0"?><quiz type="multichoice" id="1688" lang="E" hascredits="1"><question><text>&lt;html&gt;How tall is Mount McKinley, the tallest mountain in North America?
&lt;/html&gt;</text><image w="153" h="136">T041037A.jpg</image><imagerefid>42D966E7</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;14,494 feet (4,418 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;17,887 feet (5,452 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;20,320 feet (6,194 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;22,572 feet (6,880 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;20,320 feet (6,194 meters).&lt;br&gt;&lt;br&gt;Mount McKinley is located in Alaska.
&lt;/html&gt;</text><image w="153" h="136">T041037A.jpg</image><imagerefid>42D966E7</imagerefid><audio/><audiorefid/></reward><credits>ALLSTOCK, INC./Ken Graham</credits><rewardcredits>ALLSTOCK, INC./Ken Graham</rewardcredits></quiz>