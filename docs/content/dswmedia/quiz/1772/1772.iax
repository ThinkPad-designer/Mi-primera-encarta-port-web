<?xml version="1.0"?><quiz type="multichoice" id="1772" lang="E" hascredits="0"><question><text>&lt;html&gt;Which of these Southeast Asian countries is &lt;i&gt;landlocked,&lt;/i&gt; meaning that it does not touch an ocean?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Cambodia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Laos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Thailand&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vietnam&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Laos.&lt;br&gt;&lt;br&gt;Laos is the only landlocked Southeast Asian country.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>