<?xml version="1.0"?><quiz type="multichoice" id="958" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes invertebrados cultiva su propia comida?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El caracol&lt;/html&gt;</text><image w="149" h="99">T172748A.jpg</image><imagerefid>42D95D08</imagerefid><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La anémona&lt;/html&gt;</text><image w="149" h="99">T172898A.jpg</image><imagerefid>42D95D0D</imagerefid><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La hormiga cortadora de hojas&lt;/html&gt;</text><image w="150" h="98">0018a3e6.jpg</image><imagerefid>42D986D0</imagerefid><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La garrapata&lt;/html&gt;</text><image w="149" h="132">T013133A.jpg</image><imagerefid>1B82304C</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La hormiga cortadora de hojas.&lt;br&gt;&lt;br&gt;Estas hormigas cultivan en el hormiguero unos hongos, que sirven de alimento a toda la colonia. Cortan las hojas de las plantas y las llevan a sus hormigueros. Sobre las hojas crecen los hongos.&lt;/html&gt;</text><image w="150" h="98">0018a3e6.jpg</image><imagerefid>42D986D0</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./W. Stoy&lt;br&gt;&lt;br&gt;Minden Pictures/Flip Nicklin&lt;br&gt;&lt;br&gt;Photo Researchers, Inc./Gary Retherford&lt;br&gt;&lt;br&gt;Oxford Scientific Films/London Scientific Films</credits><rewardcredits>Photo Researchers, Inc./Gary Retherford</rewardcredits></quiz>