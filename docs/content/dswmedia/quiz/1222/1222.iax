<?xml version="1.0"?><quiz type="multichoice" id="1222" lang="E" hascredits="1"><question><text>&lt;html&gt;Este mono, que vive en Sudamérica, se alimenta por la noche y duerme durante el día. ¿Sabes cómo se llama?&lt;/html&gt;</text><image w="99" h="149">T628204A.jpg</image><imagerefid>1B82A534</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Tití&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mono capuchino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mono de noche&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mono aullador&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mono de noche. &lt;br&gt;&lt;br&gt;Sus ojos grandes están adaptados para ver en la oscuridad.
&lt;/html&gt;</text><image w="99" h="149">T628204A.jpg</image><imagerefid>1B82A534</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./Luiz C. Marigo</credits><rewardcredits>Peter Arnold, Inc./Luiz C. Marigo</rewardcredits></quiz>