<?xml version="1.0"?><quiz type="multichoice" id="878" lang="E" hascredits="0"><question><text>&lt;html&gt;Cuando una persona ha perdido mucha sangre necesita recibir sangre de otras. ¿Cómo se llama este procedimiento?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Recuento sanguíneo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Transfusión sanguínea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Análisis de sangre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Anticoagulación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Transfusión de sangre. &lt;br&gt;&lt;br&gt;Los donantes de sangre ofrecen de forma voluntaria su sangre a los hospitales. Para poder donar sangre hay que ser mayor de edad y estar sano. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>