<?xml version="1.0"?><quiz type="multichoice" id="1713" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the largest lake in North America?
&lt;/html&gt;</text><image w="153" h="137">T000245A.jpg</image><imagerefid>42D96737</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Lake Michigan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lake Huron&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Superior&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Great Slave Lake&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Superior.&lt;br&gt;&lt;br&gt;Lake Superior, located between the United States and Canada, is also the largest freshwater lake in the world.
&lt;/html&gt;</text><image w="153" h="137">T000245A.jpg</image><imagerefid>42D96737</imagerefid><audio/><audiorefid/></reward><credits>Wisconsin Tourism Dev.</credits><rewardcredits>Wisconsin Tourism Dev.</rewardcredits></quiz>