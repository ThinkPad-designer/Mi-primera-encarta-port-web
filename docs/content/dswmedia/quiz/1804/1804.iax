<?xml version="1.0"?><quiz type="multichoice" id="1804" lang="E" hascredits="1"><question><text>&lt;html&gt;Who was the captain of the first ship to cross the Antarctic Circle?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Fabian Gottlieb von Bellingshausen&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;James Cook&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Robert Falcon Scott&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ernest Shackleton&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;James Cook.&lt;br&gt;&lt;br&gt;In 1773 Captain Cook’s second major voyage of exploration took him farther south than any person had ever been before.
&lt;/html&gt;</text><image w="149" h="132">T011358A.jpg</image><imagerefid>1B822A88</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>