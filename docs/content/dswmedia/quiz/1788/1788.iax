<?xml version="1.0"?><quiz type="multichoice" id="1788" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the capital of South Africa?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Bloemfontein&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cape Town&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Pretoria&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;All of the above&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;All of the above.&lt;br&gt;&lt;br&gt;South Africa has three capitals, one for each of the three branches of the government. Bloemfontein is the judicial capital, Cape Town is the legislative capital, and Pretoria is the executive capital.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>