<?xml version="1.0"?><quiz type="multichoice" id="1834" lang="E" hascredits="0"><question><text>&lt;html&gt;La obra que compuso Johann Sebastian Bach para ayudar a un noble que tenía problemas de insomnio se llama:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Tocata nº1.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Concierto de Brandemburgo nº 3.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Variaciones Goldberg.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>