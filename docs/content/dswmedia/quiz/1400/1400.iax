<?xml version="1.0"?><quiz type="multichoice" id="1400" lang="E" hascredits="1"><question><text>&lt;html&gt;El nombre swahili proviene de una palabra árabe que significa ...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Costa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Selva&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Montaña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Río&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Costa.&lt;br&gt;&lt;br&gt;La palabra swahili proviene del árabe &lt;i&gt;sawail&lt;/i&gt;, que es el plural de &lt;i&gt;sahil&lt;/i&gt; o &lt;i&gt;sahel&lt;/i&gt;; en español, &apos;costa&apos;. Es el nombre de un pueblo del oriente africano y el de una lengua del grupo bantú.
&lt;/html&gt;</text><image w="149" h="99">T166138A.jpg</image><imagerefid>25A440FB</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Christine Osborne Pictures</rewardcredits></quiz>