<?xml version="1.0"?><quiz type="multichoice" id="2516" lang="E" hascredits="1"><question><text>&lt;html&gt;Una de las siguientes opciones nos muestra a tres grandes guitarristas españoles… ¿Cuál de ellas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Jimmy Hendrix, B.B. King y Eric Clapton&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Julio Cortázar, Victor Ullate y Antonio Gades&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Andrés Segovia, Narciso Yepes y Paco de Lucía&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Andrés Segovia, Narciso Yepes y Paco de Lucía.&lt;br&gt;&lt;br&gt;Los dos primeros se centraron en el repertorio clásico, mientras que Paco de Lucía se ha formado en el flamenco, que luego ha fusionado con otras tendencias musicales.&lt;/html&gt;</text><image w="99" h="149">T287601A.jpg</image><imagerefid>42D96B2B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Elke Stolzenberg</rewardcredits></quiz>