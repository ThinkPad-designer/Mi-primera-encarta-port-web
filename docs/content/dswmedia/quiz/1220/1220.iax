<?xml version="1.0"?><quiz type="multichoice" id="1220" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué hacen generalmente los mapaches con la comida antes de comérsela?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Partirla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Calentarla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lavarla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Echarle miel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lavarla.&lt;br&gt;&lt;br&gt;Los mapaches generalmente mojan la comida en el agua antes de comerla, por eso reciben también el nombre de ositos lavadores.&lt;/html&gt;</text><image w="99" h="149">T172690A.jpg</image><imagerefid>25A411AE</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Peter Arnold, Inc./S. J. Krasemann</rewardcredits></quiz>