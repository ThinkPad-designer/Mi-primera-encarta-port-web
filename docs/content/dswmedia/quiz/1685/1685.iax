<?xml version="1.0"?><quiz type="multichoice" id="1685" lang="E" hascredits="1"><question><text>&lt;html&gt;Nadia Comaneci fue una famosa...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Patinadora sobre hielo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gimnasta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tenista&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Futbolista&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Gimnasta. &lt;br&gt;&lt;br&gt;La rumana Nadia Comaneci fue la primera que consiguió la calificación máxima en gimnasia: un 10. Lo hizo en 1976, en los Juegos Olímpicos de Montreal, en los que obtuvo cinco medallas, tres de ellas de oro.&lt;/html&gt;</text><image w="149" h="132">T054591A.jpg</image><imagerefid>1B8284EE</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE/UPI</rewardcredits></quiz>