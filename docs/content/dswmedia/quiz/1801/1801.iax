<?xml version="1.0"?><quiz type="multichoice" id="1801" lang="E" hascredits="1"><question><text>&lt;html&gt;This Asian city is an independent country. What city is it?
&lt;/html&gt;</text><image w="150" h="98">0018a6d2.jpg</image><imagerefid>42D98340</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Hong Kong&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Jakarta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Macao&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Singapore&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Singapore.&lt;br&gt;&lt;br&gt;Singapore is a city-state on the very tip of the Malay Peninsula of Southeast Asia.
&lt;/html&gt;</text><image w="150" h="98">0018a6d2.jpg</image><imagerefid>42D98340</imagerefid><audio/><audiorefid/></reward><credits>Masterfile/R. Ian Lloyd</credits><rewardcredits>Masterfile/R. Ian Lloyd</rewardcredits></quiz>