<?xml version="1.0"?><quiz type="multichoice" id="2517" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de las siguientes obras para piano fue compuesta por el compositor español Manuel de Falla?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;&lt;i&gt;El amor&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;El amor brujo&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Pájaros tristes&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;El amor brujo&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;El amor brujo&lt;/i&gt;, del compositor español Manuel de Falla, es un ballet que narra la historia de amor entre Candela, una gitana poseída por el espíritu de un antiguo pretendiente muerto, y Carmelo. Este se disfraza de espectro para liberar a su amada del embrujo. 
&lt;/html&gt;</text><image w="149" h="132">T035414A.jpg</image><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>