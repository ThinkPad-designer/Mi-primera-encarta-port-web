<?xml version="1.0"?><quiz type="multichoice" id="1803" lang="E" hascredits="1"><question><text>&lt;html&gt;What Australian city is shown here?&lt;/html&gt;</text><image w="149" h="99">T165104B.jpg</image><imagerefid>25A4043F</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Adelaide&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Canberra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Melbourne&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sydney&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sydney.&lt;br&gt;&lt;br&gt;Sydney is located in southeastern Australia. It is the biggest city in the country.
