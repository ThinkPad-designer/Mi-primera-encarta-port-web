<?xml version="1.0"?><quiz type="multichoice" id="1251" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué insectos diminutos, chupadores de sangre, son capaces de dar grandes saltos y alimentarse de la sangre de los perros y otras mascotas?
&lt;/html&gt;</text><image w="149" h="132">T012729B.jpg</image><imagerefid>1B822F1B</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Los gorgojos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Las moscas de la fruta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los pulgones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las pulgas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las pulgas.&lt;br&gt;&lt;br&gt;Estos insectos no tienen alas y utilizan sus largas patas para dar grandes saltos. Se agarran a la piel de perros y otros mamíferos para chupar su sangre. &lt;/html&gt;</text><image w="149" h="132">T012729B.jpg</image><imagerefid>1B822F1B</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/London Scientific Films</credits><rewardcredits>Oxford Scientific Films/London Scientific Films</rewardcredits></quiz>