<?xml version="1.0"?><quiz type="multichoice" id="1403" lang="E" hascredits="1"><question><text>&lt;html&gt;Mombasa, en la actual Kenia, fue un destacado núcleo comercial de la llamada costa swahili. ¿Qué nación europea construyó una fortaleza en el siglo XVI para establecer su dominio en la zona?
&lt;/html&gt;</text><image w="99" h="149">T628695A.jpg</image><imagerefid>1B82A711</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Alemania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Italia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Portugal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;España&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Portugal.&lt;br&gt;&lt;br&gt;Gran parte de la costa oriental africana integró durante el siglo XVI el Imperio portugués.&lt;/html&gt;</text><image w="99" h="149">T628695A.jpg</image><imagerefid>1B82A711</imagerefid><audio/><audiorefid/></reward><credits>Liaison Agency/Wolfgang Kaehler</credits><rewardcredits>Liaison Agency/Wolfgang Kaehler</rewardcredits></quiz>