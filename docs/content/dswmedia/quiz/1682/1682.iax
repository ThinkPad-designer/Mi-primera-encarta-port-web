<?xml version="1.0"?><quiz type="multichoice" id="1682" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: un piloto argentino de automovilismo ganó en cinco ocasiones el Campeonato del Mundo de Fórmula 1.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero. &lt;br&gt;&lt;br&gt;Juan Manuel Fangio ganó cinco ediciones del Campeonato del Mundo de Fórmula 1: en 1951, 1954, 1955, 1956 y 1957. Desde ese último año, tuvo en su poder el récord de victorias hasta que en 2003 lo superó el piloto alemán Michael Schumacher.&lt;/html&gt;</text><image w="149" h="132">T063012A.jpg</image><imagerefid>073fbe37</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Sygma/Keystone</rewardcredits></quiz>