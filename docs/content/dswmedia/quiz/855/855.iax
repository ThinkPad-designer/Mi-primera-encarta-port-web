<?xml version="1.0"?><quiz type="multichoice" id="855" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué mineral necesitan los huesos para estar fuertes?

&lt;/html&gt;</text><image w="149" h="99">T304316A.jpg</image><imagerefid>0C137983</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Magnesio &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Calcio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hierro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Cromo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Calcio. &lt;br&gt;&lt;br&gt;Un 90% del calcio de tu organismo se almacena en los huesos. Este mineral les proporciona su dureza y resistencia. La principal fuente de calcio de los alimentos es la leche y sus derivados.

&lt;/html&gt;</text><image w="149" h="99">T304316A.jpg</image><imagerefid>0C137983</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>