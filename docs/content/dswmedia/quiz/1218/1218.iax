<?xml version="1.0"?><quiz type="multichoice" id="1218" lang="E" hascredits="1"><question><text>&lt;html&gt;Los tigres son animales territoriales: viven solos en territorios grandes e impiden que otros tigres penetren en él. ¿Sabes cómo consiguen ahuyentar a otros tigres?
&lt;/html&gt;</text><image w="149" h="99">001aca8c.jpg</image><imagerefid>42D9D866</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Rugiendo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Marcando el territorio con la orina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Marcando el territorio con las heces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Todas las respuestas anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Todas las respuestas anteriores.&lt;br&gt;&lt;br&gt;Los tigres rugen y marcan su territorio para ahuyentar a los otros tigres.
&lt;/html&gt;</text><image w="149" h="99">001aca8c.jpg</image><imagerefid>42D9D866</imagerefid><audio/><audiorefid/></reward><credits>Photolibrary/Oxford Scientific Films</credits><rewardcredits>Photolibrary/Oxford Scientific Films</rewardcredits></quiz>