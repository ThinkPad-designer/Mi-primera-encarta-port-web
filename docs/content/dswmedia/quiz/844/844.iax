<?xml version="1.0"?><quiz type="multichoice" id="844" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Dónde se produce  la primera fase de la digestión de los alimentos?
&lt;/html&gt;</text><image w="149" h="149">001020e8.jpg</image><imagerefid>29D22A25</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Intestino delgado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Boca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Intestino grueso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Boca&lt;br&gt;&lt;br&gt;La digestión comienza en la boca. Los dientes trocean, desgarran y trituran los alimentos, y la lengua ayuda a mezclarlos con la saliva.

&lt;/html&gt;</text><image w="149" h="149">001605fd.jpg</image><imagerefid>42D97594</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>