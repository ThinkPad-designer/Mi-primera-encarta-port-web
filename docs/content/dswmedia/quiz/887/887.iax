<?xml version="1.0"?><quiz type="multichoice" id="887" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es la causa que se relaciona con más frecuencia con el cáncer de pulmón? 
&lt;/html&gt;</text><image w="153" h="136">T045949A.jpg</image><imagerefid>29D29348</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Gases de combustión de vehículos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tabaco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Polución industrial&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pesticidas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tabaco. &lt;br&gt;&lt;br&gt;El cáncer de pulmón es una enfermedad grave. La gran mayoría de los casos de cáncer de pulmón están relacionados con el tabaco. 
&lt;/html&gt;</text><image w="153" h="136">T045949A.jpg</image><imagerefid>29D29348</imagerefid><audio/><audiorefid/></reward><credits>Phototake NYC/Martin Rotker</credits><rewardcredits>Phototake NYC/Martin Rotker</rewardcredits></quiz>