&lt;/html&gt;</text><image w="153" h="136">T000540B.jpg</image><imagerefid>0C047692</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Brasília&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Recife&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Rio de Janeiro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;São Paulo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Brasília.&lt;br&gt;&lt;br&gt;Brasília is located in the interior of southern Brazil.&lt;/html&gt;</text><image w="153" h="136">T000540B.jpg</image><imagerefid>0C047692</imagerefid><audio/><audiorefid/></reward><credits>Robert Harding Picture Library</credits><rewardcredits>Robert Harding Picture Library</rewardcredits></quiz>