<?xml version="1.0"?><quiz type="multichoice" id="906" lang="E" hascredits="1"><question><text>&lt;html&gt;Sorprendente, aunque saludable... Si no tienes ningún otro alimento, ¿qué comerías para obtener proteínas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Insectos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gusanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ranas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Todos los anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Todas las anteriores.&lt;br&gt;&lt;br&gt;Los gusanos, los insectos y las ranas son una fuente excelente de proteínas. 

&lt;/html&gt;</text><image w="149" h="132">T025635B.jpg</image><imagerefid>1B8237CD</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley/Jerry Young</rewardcredits></quiz>