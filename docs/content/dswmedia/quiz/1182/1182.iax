<?xml version="1.0"?><quiz type="multichoice" id="1182" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes cuántas razas de perro existen?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Unas 10&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Unas 50&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Unas 100&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Unas 300&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Unas 300.&lt;br&gt;&lt;br&gt;Hay más de 300 razas de perros. Algunos perros se han adiestrado para cazar, otros como perros guardianes y, principalmente, como animales de compañía.&lt;/html&gt;</text><image w="149" h="132">T045739A.jpg</image><imagerefid>1B82669E</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Phototake NYC/Yoav Levy</rewardcredits></quiz>