<?xml version="1.0"?><quiz type="multichoice" id="1095" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales no necesita beber agua?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La jirafa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El camello&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El jerbo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El tigre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El jerbo. &lt;br&gt;&lt;br&gt;El jerbo obtiene todo el agua que necesita de las plantas, las semillas y los insectos.
&lt;/html&gt;</text><image w="149" h="132">T054931A.jpg</image><imagerefid>1B828640</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/E.R. Degginger</rewardcredits></quiz>