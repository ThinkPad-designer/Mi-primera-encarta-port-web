<?xml version="1.0"?><quiz type="multichoice" id="1254" lang="E" hascredits="1"><question><text>&lt;html&gt;True or False: Spiders are a type of insect.
&lt;/html&gt;</text><image w="149" h="99">00123ed7.jpg</image><imagerefid>29D26542</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;False. &lt;br&gt;&lt;br&gt;Spiders are arachnids, not insects. Spiders have eight legs and eight eyes, and they don’t have antennae or wings. In contrast, insects have six legs, two eyes, two antennae, and, typically, four wings.
&lt;/html&gt;</text><image w="149" h="99">00123ed7.jpg</image><imagerefid>29D26542</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Joe McDonald</credits><rewardcredits>Corbis/Joe McDonald</rewardcredits></quiz>