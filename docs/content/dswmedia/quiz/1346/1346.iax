<?xml version="1.0"?><quiz type="multichoice" id="1346" lang="E" hascredits="1"><question><text>&lt;html&gt;Seguro que sabes que el Sahara es un desierto, pero ¿podrías decir cuánto llueve sobre él a lo largo de un año, más o menos?&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Nada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Recibe menos de 127 mm de media anual&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Recibe cerca de 1.000 mm de media anual&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Recibe cerca de 10 mm de media anual&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Recibe menos de 127 mm de media anual.&lt;br&gt;&lt;br&gt;La precipitación media anual en el Sahara es inferior a los 127 mm, y en algunos lugares no llueve absolutamente nada durante años.&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></reward><credits>Reuters/David Rouge (MAURITANIA)</credits><rewardcredits>Reuters/David Rouge (MAURITANIA)</rewardcredits></quiz>