<?xml version="1.0"?><quiz type="multichoice" id="2313" lang="E" hascredits="1"><question><text>&lt;html&gt;La obra que compuso Johann Sebastian Bach para ayudar a un noble que tenía problemas de insomnio se llama:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Tocata nº1&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Concierto de Brandeburgo nº 3&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Variaciones Goldberg&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Variaciones Goldberg&lt;/i&gt;&lt;br&gt;&lt;br&gt;Es un conjunto de un tema y 30 variaciones que dura aproximadamente una hora y que se ha convertido en una de las obras maestras para teclado.&lt;/html&gt;</text><image w="149" h="133">T012078A.jpg</image><imagerefid>1B822D2B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>