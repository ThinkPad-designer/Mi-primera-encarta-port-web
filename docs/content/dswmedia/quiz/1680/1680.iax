<?xml version="1.0"?><quiz type="multichoice" id="1680" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En qué ciudad europea tuvieron lugar los Juegos Olímpicos celebrados en el verano de 1992?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En Londres&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En París&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Barcelona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En Berlín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Barcelona. &lt;br&gt;&lt;br&gt;La ciudad española de Barcelona acogió los Juegos Olímpicos de 1992, los segundos que tenían lugar en un país de habla hispana, después de los de 1968, celebrados en la ciudad de México.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>