<?xml version="1.0"?><quiz type="multichoice" id="850" lang="E" hascredits="0"><question><text>&lt;html&gt;¿De que está formado el 60 por ciento de nuestro cuerpo?

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Huesos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Musculos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Agua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sangre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Agua. &lt;br&gt;&lt;br&gt;El agua es el componente principal de nuestro cuerpo. Un 40% del agua es intracelular, está en el interior de las células. El 20% restante es extracelular, está fuera de las células.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>