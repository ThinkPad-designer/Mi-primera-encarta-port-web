<?xml version="1.0"?><quiz type="multichoice" id="1702" lang="E" hascredits="1"><question><text>&lt;html&gt;Nine of the ten tallest mountains in the world are found in what Asian mountain range?
&lt;/html&gt;</text><image w="153" h="135">T054870A.jpg</image><imagerefid>1B828603</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Alai Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Himalayas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hindu Kush&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pamirs&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Himalayas.&lt;br&gt;&lt;br&gt;The tallest mountains in the Himalayas (and the world) are Mount Everest, K2, Kanchenjunga, Dhaulagiri, Nanga Parbat, and Annapurna.
&lt;/html&gt;</text><image w="153" h="135">T054870A.jpg</image><imagerefid>1B828603</imagerefid><audio/><audiorefid/></reward><credits>ALLSTOCK, INC./Christopher Arnesen</credits><rewardcredits>ALLSTOCK, INC./Christopher Arnesen</rewardcredits></quiz>