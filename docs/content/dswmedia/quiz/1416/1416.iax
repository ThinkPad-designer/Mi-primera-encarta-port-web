<?xml version="1.0"?><quiz type="multichoice" id="1416" lang="E" hascredits="1"><question><text>&lt;html&gt;Mozambique está cubierto en buena parte de su superficie por praderas y bosques. ¿Sabrías decir cuál es el clima de este país?
&lt;/html&gt;</text><image w="149" h="99">18384.jpg</image><imagerefid>25A49D04</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El polar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El desértico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El tropical&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El ecuatorial&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El tropical.&lt;br&gt;&lt;br&gt;Mozambique tiene un clima tropical, con una estación seca que dura de abril a octubre.
&lt;/html&gt;</text><image w="149" h="99">18384.jpg</image><imagerefid>25A49D04</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Jon Spaull</credits><rewardcredits>Corbis/Jon Spaull</rewardcredits></quiz>