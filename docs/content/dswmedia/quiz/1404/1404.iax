<?xml version="1.0"?><quiz type="multichoice" id="1404" lang="E" hascredits="1"><question><text>&lt;html&gt;La ciudad keniana de Malindi fue un importantísimo centro comercial swahili. ¿Qué explorador llegó a Malindi antes de convertirse en el primer europeo que arribaba a la India por la ruta que rodea el continente africano?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Cristóbal Colón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Francis Drake&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Vasco da Gama&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Fernando de Magallanes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Vasco da Gama.&lt;br&gt;&lt;br&gt;El navegante portugués Vasco da Gama pasó por el territorio de Malindi en 1498.
&lt;/html&gt;</text><image w="149" h="132">T012767A.jpg</image><imagerefid>1B822F38</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Culver Pictures</rewardcredits></quiz>