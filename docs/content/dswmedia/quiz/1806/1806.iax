<?xml version="1.0"?><quiz type="multichoice" id="1806" lang="E" hascredits="1"><question><text>&lt;html&gt;Who is revered throughout South America as The Liberator?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Francisco Pizarro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Simón Bolívar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Juan Perón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Diego Maradona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Simón Bolívar.&lt;br&gt;&lt;br&gt;Bolívar helped win independence from Spain for Bolivia (named after him), Colombia, Ecuador, Peru, and Venezuela.
&lt;/html&gt;</text><image w="149" h="133">T011423A.jpg</image><imagerefid>1B822AC3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>