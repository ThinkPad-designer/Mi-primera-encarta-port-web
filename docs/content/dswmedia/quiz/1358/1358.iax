<?xml version="1.0"?><quiz type="multichoice" id="1358" lang="E" hascredits="0"><question><text>&lt;html&gt;Si navegas a lo largo del río Níger, ¿cuál de estos países atravesarás en primer lugar?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Níger&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;República de Guinea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Malí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Nigeria&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;República de Guinea.&lt;br&gt;&lt;br&gt;El río Níger comienza en República de Guinea, para continuar su fluir por Malí, Níger y, finalmente, Nigeria.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>