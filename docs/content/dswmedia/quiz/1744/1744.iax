<?xml version="1.0"?><quiz type="multichoice" id="1744" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the smallest country in Asia (by land area)?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Singapore &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kuwait&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Israel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Bhutan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Singapore.&lt;br&gt;&lt;br&gt;Singapore sits on a small island at the very tip of the Malay Peninsula. 
&lt;/html&gt;</text><image w="150" h="98">0018a6d2.jpg</image><imagerefid>42D98340</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Masterfile/R. Ian Lloyd</rewardcredits></quiz>