<?xml version="1.0"?><quiz type="multichoice" id="1795" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Morocco?
&lt;/html&gt;</text><image w="149" h="132">T038563A.jpg</image><imagerefid>1B824D24</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Casablanca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Marrakech&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Rabat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tangier&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Rabat.&lt;br&gt;&lt;br&gt;Rabat is located on the Atlantic Coast of northern Morocco. 
&lt;/html&gt;</text><image w="149" h="132">T038563A.jpg</image><imagerefid>1B824D24</imagerefid><audio/><audiorefid/></reward><credits>Leo de Wys, Inc./Jose Fusta Raga</credits><rewardcredits>Leo de Wys, Inc./Jose Fusta Raga</rewardcredits></quiz>