<?xml version="1.0"?><quiz type="multichoice" id="1851" lang="E" hascredits="0"><question><text>&lt;html&gt;La marimba se trata de un instrumento musical, pero ¿De qué tipo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Instrumento de cuerda frotada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Instumento de viento madera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Instrumento de percusión de altura determinada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>