<?xml version="1.0"?><quiz type="multichoice" id="1661" lang="E" hascredits="0"><question><text>&lt;html&gt;Si hablamos del arte de mantener un control preciso sobre un caballo o de los diferentes modos de manejarlo, ¿a qué deporte hacemos referencia?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;A la equitación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Al &lt;i&gt;rafting&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Al descenso en canoa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Al equinoccio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A la equitación. &lt;br&gt;&lt;br&gt;La palabra proviene del latín, lengua en la que &lt;i&gt;equus&lt;/i&gt; quiere decir &apos;caballo&apos;.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>