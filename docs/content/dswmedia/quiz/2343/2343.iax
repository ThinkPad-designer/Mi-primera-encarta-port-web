<?xml version="1.0"?><quiz type="multichoice" id="2343" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué instrumentos se sitúan a la izquierda del director de una orquesta?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Clarinetes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Violonchelos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Violines&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Violines.&lt;br&gt;&lt;br&gt;Al que está más cerca de él, en primera fila, se le llama concertino, y es el más importante de los violines. Es el que marca la afinación de los demás.&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>