<?xml version="1.0"?><quiz type="multichoice" id="1720" lang="E" hascredits="0"><question><text>&lt;html&gt;What large body of water is almost completely surrounded by Canada?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Barents Sea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gulf of Mexico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hudson Bay&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Michigan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hudson Bay.&lt;br&gt;&lt;br&gt;This huge bay in northeastern Canada borders the provinces of Ontario, Québec, and Manitoba and the territory of Nunavut. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>