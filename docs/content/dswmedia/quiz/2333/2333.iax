<?xml version="1.0"?><quiz type="multichoice" id="2333" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué compositor romántico escribió la canción &lt;i&gt;El rey de los elfos&lt;/i&gt;?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Robert Schumann&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Claude Debussy&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Franz Schubert&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Franz Schubert.&lt;br&gt;&lt;br&gt;Es una obra terriblemente difícil, tanto para el pianista como para el cantante, y cuenta la dramática historia de un caballero que huye de la muerte con su hijo en el regazo, galopando a través del bosque.&lt;/html&gt;</text><image w="99" h="149">000a3c77.jpg</image><imagerefid>479D854A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Archivo Iconografico, S.A.</rewardcredits></quiz>