<?xml version="1.0"?><quiz type="multichoice" id="1641" lang="E" hascredits="1"><question><text>&lt;html&gt;El jugador estadounidense de golf &lt;i&gt;Tiger&lt;/i&gt; Woods dijo cuando era un niño que haría todo lo posible por mejorar todos los récords de un portentoso golfista: &lt;/html&gt;</text><image w="99" h="149">001a9b7c.jpg</image><imagerefid>42D9D79C</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Bobby Jones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Arnold Palmer&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Jack Nicklaus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Adam Sandler&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Jack Nicklaus. &lt;br&gt;&lt;br&gt;El triunfo de Woods en el Masters de Augusta de 1997 le permitió batir dos récords de Nicklaus: el de golpes empleados y el de golpes de ventaja sobre el siguiente clasificado.

&lt;/html&gt;</text><image w="149" h="132">T638265A.jpg</image><imagerefid>1B82B1C8 </imagerefid><audio/><audiorefid/></reward><credits>Corbis/Icon SMI</credits><rewardcredits>SportsChrome-USA/Robert Tringali</rewardcredits></quiz>