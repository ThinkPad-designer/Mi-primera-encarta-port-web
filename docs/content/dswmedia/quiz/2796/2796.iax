<?xml version="1.0"?><quiz type="multichoice" id="2796" lang="E" hascredits="0"><question><text>&lt;html&gt;Le territoire européen...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;est organisé autour de deux métropoles, Paris et Londres.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;s&apos;articule autour de plusieurs régions économiques majeures.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;possède un cœur économique&#38;nbsp;: l&apos;Europe rhénane.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Le territoire européen est aujourd&apos;hui multipolaire. Paris et Londres en sont les pôles urbains les mieux intégrés au niveau mondial, et l&apos;Europe rhénane est un axe majeur pour la puissance européenne. D&apos;autres villes et régions (comme Milan et le pourtour méditerranéen) complètent ce dispositif.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>