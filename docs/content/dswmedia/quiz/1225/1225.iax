<?xml version="1.0"?><quiz type="multichoice" id="1225" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el único lugar dónde puedes encontrar lémures en estado salvaje?
&lt;/html&gt;</text><image w="149" h="99">T172696A.jpg</image><imagerefid>25A411B4</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Lemurlandia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Madagascar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Brasil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Madagascar. &lt;br&gt;&lt;br&gt;Los lémures viven en los bosques de Madagascar, una isla situada frente a la costa este de África. Los seres humanos han talado muchos bosques para construir casas y carreteras, por lo que los lémures se encuentran en peligro de extinción.&lt;/html&gt;</text><image w="149" h="99">T172696A.jpg</image><imagerefid>25A411B4</imagerefid><audio/><audiorefid/></reward><credits>Minden Pictures/Frans Lanting</credits><rewardcredits>Minden Pictures/Frans Lanting</rewardcredits></quiz>