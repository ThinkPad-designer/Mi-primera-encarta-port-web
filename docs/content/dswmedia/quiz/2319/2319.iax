<?xml version="1.0"?><quiz type="multichoice" id="2319" lang="E" hascredits="1"><question><text>&lt;html&gt;El compositor polaco Frédéric Chopin pasó una temporada de descanso en una isla española para curarse de una enfermedad. ¿De qué isla se trata?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Córcega&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tenerife&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mallorca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mallorca.&lt;br&gt;&lt;br&gt;Todavía se conserva el piano Pleyel que ordenó llevar allí y en el que compuso, entre otras cosas, sus maravillosos 24 &lt;i&gt;Preludios, opus 28&lt;/i&gt;.&lt;/html&gt;</text><image w="149" h="132">T037467A.jpg</image><imagerefid>42D9752D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Library of Congress</rewardcredits></quiz>