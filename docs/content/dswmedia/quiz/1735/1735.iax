<?xml version="1.0"?><quiz type="multichoice" id="1735" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the biggest country in South America (by land area)?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Argentina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Brazil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Colombia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Peru&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Brazil.&lt;br&gt;&lt;br&gt;Brazil is the fifth largest country in the world (by land area). It takes up more than half of the total area of South America.
&lt;/html&gt;</text><image w="149" h="149">00123d63.jpg</image><imagerefid>29D26490</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>