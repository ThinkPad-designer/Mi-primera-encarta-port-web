<?xml version="1.0"?><quiz type="multichoice" id="1354" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: en el centro del Sahara hay montañas.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero.&lt;br&gt;&lt;br&gt;El desierto del Sahara no es totalmente llano y arenoso. En el sur de Argelia y en el norte de Chad aparecen las montañas de Ahaggar y de Tibesti, respectivamente.
&lt;/html&gt;</text><image w="149" h="99">T165027A.jpg</image><imagerefid>42D969C4</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Panos Pictures/Sean Sprague</rewardcredits></quiz>