<?xml version="1.0"?><quiz type="multichoice" id="1173" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes gatos es un himalayo?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="149" h="149">T047371A.jpg</image><imagerefid>1B826C83</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T043365A.jpg</image><imagerefid>1B825DC3</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="149">T054577A.jpg</image><imagerefid>1B8284E0</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="153" h="136">T058593A.jpg</image><imagerefid>1B8288CA</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El himalayo es un gato de pelo largo, de color claro, con marcas más oscuras en la cabeza, las patas y la cola.&lt;/html&gt;</text><image w="149" h="132">T043365A.jpg</image><imagerefid>1B825DC3</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley&lt;br&gt;&lt;br&gt;Photo Researchers, Inc./Mary Eleanor Browning&lt;br&gt;&lt;br&gt;Animals Animals/Robert Pearcy&lt;br&gt;&lt;br&gt;Dorling Kindersley/Marc Henrie</credits><rewardcredits>Photo Researchers, Inc./Mary Eleanor Browning</rewardcredits></quiz>