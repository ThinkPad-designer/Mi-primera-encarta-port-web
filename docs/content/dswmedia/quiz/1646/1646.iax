<?xml version="1.0"?><quiz type="multichoice" id="1646" lang="E" hascredits="1"><question><text>&lt;html&gt;¿En qué especialidad atlética fue campeona del mundo en 2003 la mexicana Ana Gabriela Guevara?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En lanzamiento de jabalina con arco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En salto de altura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En los 400 m lisos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En decatlón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En los 400 m lisos. &lt;br&gt;&lt;br&gt;Guevara fue también subcampeona olímpica en esa distancia, en 2004. Por cierto, el lanzamiento de jabalina con arco no existe y el decatlón es una prueba exclusivamente masculina.&lt;/html&gt;</text><image w="99" h="149">00101976.jpg</image><imagerefid>42D951F7</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Tim de Waele/Photo and Co.</rewardcredits></quiz>