<?xml version="1.0"?><quiz type="multichoice" id="1205" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De dónde proceden las cobayas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;De América del Sur&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De Asia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De África&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Europa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De América del Sur. &lt;br&gt;&lt;br&gt;Las cobayas o conejillos de Indias son originarios de América del sur.
&lt;/html&gt;</text><image w="149" h="99">T050432A.jpg</image><imagerefid>1B8277A8</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Michael Leach</rewardcredits></quiz>