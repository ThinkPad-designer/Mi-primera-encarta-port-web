<?xml version="1.0"?><quiz type="multichoice" id="1184" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes perros es un pastor alemán?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text/><image w="149" h="148">T025346A.jpg</image><imagerefid>1B8236BD</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T043349A.jpg</image><imagerefid>1B82DF0E</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T025358A.jpg</image><imagerefid>1B8236C9</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T025307A.jpg</image><imagerefid>1B823697</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El pastor alemán ha sido utilizado para guardar y proteger los rebaños. Es un perro inteligente y valiente que también se ha adiestrado para guiar a los ciegos y para colaborar con la policía en la captura de delincuentes.&lt;/html&gt;</text><image w="149" h="148">T025346A.jpg</image><imagerefid>1B8236BD</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley&lt;br&gt;&lt;br&gt;Photo Researchers, Inc./Carolyn A. McKeone&lt;br&gt;&lt;br&gt;Dorling Kindersley&lt;br&gt;&lt;br&gt;Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>