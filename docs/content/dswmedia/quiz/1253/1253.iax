<?xml version="1.0"?><quiz type="multichoice" id="1253" lang="E" hascredits="1"><question><text>&lt;html&gt;Este animal deposita los huevos en pequeñas bolas de excrementos, que sirven de alimento a las crías al nacer. ¿De qué animal se trata?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La cucaracha&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El escarabajo pelotero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La hormiga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La abeja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El escarabajo pelotero. &lt;br&gt;&lt;br&gt;Los escarabajos del estiércol o escarabajos peloteros ponen sus huevos en bolas de estiércol.&lt;/html&gt;</text><image w="149" h="133">T046259A.jpg</image><imagerefid>1B82687D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Colin Milkins</rewardcredits></quiz>