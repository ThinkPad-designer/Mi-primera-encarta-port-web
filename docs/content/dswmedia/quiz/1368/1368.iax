<?xml version="1.0"?><quiz type="multichoice" id="1368" lang="E" hascredits="1"><question><text>&lt;html&gt;El río Níger nace en territorio de la República de Guinea. Este instrumento musical guineano se llama bala. ¿Sabes qué tipo de instrumento es?
&lt;/html&gt;</text><image/><imagerefid/><audio>T046567A.mp3</audio><audiorefid>1B8269AC</audiorefid></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Un instrumento de viento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un instrumento de cuerda&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un instrumento de percusión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un instrumento de percusión.&lt;br&gt;&lt;br&gt;El bala es de madera y similar al xilófono.&lt;/html&gt;</text><image/><imagerefid/><audio>T046567A.mp3</audio><audiorefid>1B8269AC</audiorefid></reward><credits>&quot;Xilófono&quot; de Instrumentos del mundo (Cat. # LDX 274 675) (p) 1990 Le Chant du Monde. Reservados todos los derechos.</credits><rewardcredits>&quot;Xilófono&quot; de Instrumentos del mundo (Cat. # LDX 274 675) (p) 1990 Le Chant du Monde. Reservados todos los derechos.</rewardcredits></quiz>