<?xml version="1.0"?><quiz type="multichoice" id="875" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué se mide cuando se toma el pulso?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Presión arterial&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Frecuencia cardiaca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Recuento de plaquetas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Actividad cerebral&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La frecuencia cardiaca.&lt;br&gt;&lt;br&gt;La frecuencia cardiaca es el número de veces que late el corazón en un minuto. La fuerza con la que el corazón empuja la sangre hacia las arterias se trasmite en forma de una presión que se percibe como un latido en las arterias. El pulso arterial se corresponde con los latidos de tu corazón.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>