<?xml version="1.0"?><quiz type="multichoice" id="1396" lang="E" hascredits="0"><question><text>&lt;html&gt;Al norte de la llamada costa swahili, el límite continental africano sobresale de forma afilada y se adentra en el océano Índico. Esa parte de África recibe normalmente un curioso nombre. ¿Sabes cuál?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Nariz de África&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Arco de África&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cuerno de África&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Costa Litoral Índica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cuerno de África.&lt;br&gt;&lt;br&gt;Los países que forman parte de esa región llamada Cuerno de África son Eritrea, Yibuti, Somalia y, tierra adentro, Etiopía.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>