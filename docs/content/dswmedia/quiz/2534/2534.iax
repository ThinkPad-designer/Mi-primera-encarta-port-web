<?xml version="1.0"?><quiz type="multichoice" id="2534" lang="E" hascredits="1"><question><text>&lt;html&gt;¿En qué ciudad nació el gran compositor y violinista barroco Antonio Vivaldi?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Venecia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Milán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Roma&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Venecia.&lt;br&gt;&lt;br&gt;Incluso si se viaja hoy a esta ciudad es fácil imaginar cómo debía ser en la época en que Vivaldi vivió allí.&lt;/html&gt;</text><image w="99" h="149">001ad621.jpg</image><imagerefid>42D9D7B0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Getty Images/Roger Viollet Collection</rewardcredits></quiz>