<?xml version="1.0"?><quiz type="multichoice" id="2315" lang="E" hascredits="1"><question><text>&lt;html&gt;Lied es un término alemán muy utilizado en música que significa:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Canción&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Coro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sonata&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Canción.&lt;br&gt;&lt;br&gt;Muchos de los grandes compositores han escrito Lieder (Lied en plural), entre ellos Schubert, Schumann, Brahms o Liszt.&lt;/html&gt;</text><image w="99" h="149">000a3c77.jpg</image><imagerefid>479D854A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Archivo Iconografico, S.A.</rewardcredits></quiz>