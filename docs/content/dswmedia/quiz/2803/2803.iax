<?xml version="1.0"?><quiz type="multichoice" id="2803" lang="E" hascredits="0"><question><text>&lt;html&gt;Le principal port fluvial rhénan est&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Cologne.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mannheim.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Strasbourg.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Duisbourg.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 4.&lt;br&gt;&lt;br&gt;Duisbourg (Allemagne) est le principal port fluvial rhénan avec un trafic annuel d&apos;environ 40&#38;nbsp;millions de tonnes.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>