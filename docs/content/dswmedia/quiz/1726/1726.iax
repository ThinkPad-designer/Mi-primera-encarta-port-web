<?xml version="1.0"?><quiz type="multichoice" id="1726" lang="E" hascredits="1"><question><text>&lt;html&gt;True or False: Antarctica is bigger than Europe.
&lt;/html&gt;</text><image w="149" h="149">001274d7.jpg</image><imagerefid>584EF8C7</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;Antarctica has an area of 5.4 million square miles (14 million square kilometers), compared to Europe’s 4 million square miles (10.4 million square kilometers).
&lt;/html&gt;</text><image w="149" h="149">001274d7.jpg</image><imagerefid>584EF8C7</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>