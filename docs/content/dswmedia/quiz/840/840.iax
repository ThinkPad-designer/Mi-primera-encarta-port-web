<?xml version="1.0"?><quiz type="multichoice" id="840" lang="E" hascredits="1"><question><text>&lt;html&gt;En tu intestino grueso viven microorganismos que ayudan a romper los alimentos. ¿Sabes cuales son?
&lt;/html&gt;</text><image w="149" h="132">T012905A.jpg</image><imagerefid>1B822F9E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Virus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bacterias&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Gusanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Escarabajos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Bacterias. &lt;br&gt;&lt;br&gt;Las bacterias que viven en el intestino grueso fragmentan los restos de alimentos y participan en la producción de vitamina K. &lt;/html&gt;</text><image w="149" h="132">T012905A.jpg</image><imagerefid>1B822F9E</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Omikron/Science Source</credits><rewardcredits>Photo Researchers, Inc./Omikron/Science Source</rewardcredits></quiz>