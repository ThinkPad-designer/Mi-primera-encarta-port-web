<?xml version="1.0"?><quiz type="multichoice" id="1749" lang="E" hascredits="1"><question><text>&lt;html&gt;What country has the largest population in South America?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Peru&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Colombia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Brazil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Argentina &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Brazil.&lt;br&gt;&lt;br&gt;Brazil’s population is more than four times larger than that of the second-place country, Colombia.
&lt;/html&gt;</text><image w="149" h="149">00123d63.jpg</image><imagerefid>29D26490</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>