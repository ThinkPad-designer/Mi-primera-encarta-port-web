<?xml version="1.0"?><quiz type="multichoice" id="1287" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué animales ayudan a los granjeros a guardar el ganado, para que esté a salvo de los animales salvajes?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Los cerdos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los lobos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los perros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los ratones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los perros. &lt;br&gt;&lt;br&gt;Muchos perros, como el pastor belga, el collie o el bouvier, son utilizados como perros pastores, encargados del cuidado y protección de los animales de granja. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>