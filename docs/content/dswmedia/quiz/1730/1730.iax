<?xml version="1.0"?><quiz type="multichoice" id="1730" lang="E" hascredits="1"><question><text>&lt;html&gt;The frigid, far northern region of Asia is called what?&lt;/html&gt;</text><image w="149" h="99">0005BC1D.jpg</image><imagerefid>289EDD81</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Anatolia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Caucasus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Kamchatka&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Siberia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Siberia.&lt;br&gt;&lt;br&gt;This wide, cold region is the northern part of Russia.&lt;/html&gt;</text><image w="149" h="99">0005BC1D.jpg</image><imagerefid>289EDD81</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Dean Conger</credits><rewardcredits>Corbis/Dean Conger</rewardcredits></quiz>