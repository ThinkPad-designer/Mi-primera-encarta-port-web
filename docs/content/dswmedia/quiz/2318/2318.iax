<?xml version="1.0"?><quiz type="multichoice" id="2318" lang="E" hascredits="1"><question><text>&lt;html&gt;Cuando vamos a una ópera sabemos que nos vamos a encontrar:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un grupo de rock que actúa junto con un coro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una representación teatral con cantantes y una orquesta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un cantante acompañado de un pianista&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Una representación teatral con cantantes y una orquesta.&lt;br&gt;&lt;br&gt;No obstante, bajo estas características también nos podemos encontrar un musical o incluso una zarzuela.&lt;/html&gt;</text><image w="149" h="132">T048313A.jpg</image><imagerefid>1B82700B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE/Ron Scherl</rewardcredits></quiz>