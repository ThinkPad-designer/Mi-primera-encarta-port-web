<?xml version="1.0"?><quiz type="multichoice" id="1328" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el nombre del sistema de escritura del antiguo Egipto?
&lt;/html&gt;</text><image w="149" h="99">T304159A.jpg</image><imagerefid>29D0222C</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El cuneiforme&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El papiro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los jerónimos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los jeroglíficos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los jeroglíficos.&lt;br&gt;&lt;br&gt;Esa escritura, propia entre otros de los antiguos egipcios, usaba dibujos que hacían la función de palabras.
&lt;/html&gt;</text><image w="149" h="99">T304159A.jpg</image><imagerefid>29D0222C</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Wolfgang Kaehler</credits><rewardcredits>Corbis/Wolfgang Kaehler</rewardcredits></quiz>