<?xml version="1.0"?><quiz type="multichoice" id="861" lang="E" hascredits="1"><question><text>&lt;html&gt;La artritis es una enfermedad que produce deformidad, inflamación y dolor. ¿Sabes a qué parte del cuerpo afecta?&lt;/html&gt;</text><image w="149" h="132">0019780b.jpg</image><imagerefid>29D41C50</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Músculos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Vasos sanguíneos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Articulaciones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Articulaciones. &lt;br&gt;&lt;br&gt;En la artritis se produce una inflamación de las articulaciones. Estas radiografías nos muestran unas manos sanas, &lt;i&gt;a la izquierda,&lt;/i&gt; y unas manos con artritis, &lt;i&gt;a la derecha.&lt;/i&gt;

&lt;/html&gt;</text><image w="149" h="132">0019780b.jpg</image><imagerefid>29D41C50</imagerefid><audio/><audiorefid/></reward><credits>Visuals Unlimited/Charles McRae, MD</credits><rewardcredits>Visuals Unlimited/Charles McRae, MD</rewardcredits></quiz>