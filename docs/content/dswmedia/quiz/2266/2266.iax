<?xml version="1.0"?><quiz type="multichoice" id="2266" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: los animales invertebrados son más numerosos que los vertebrados.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero.&lt;br&gt;&lt;br&gt;Más del 90% de los animales que pueblan nuestro planeta son invertebrados, animales que no poseen columna vertebral. &lt;/html&gt;</text><image w="149" h="99">T172813A.jpg</image><imagerefid>25A41215</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/Michael Fogden</rewardcredits></quiz>