<?xml version="1.0"?><quiz type="multichoice" id="2212" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se escapa la mofeta de sus enemigos?
&lt;/html&gt;</text><image w="149" h="99">T172707A.jpg</image><imagerefid>25A411BD</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Escupe un líquido venenoso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Segrega un líquido que huele mal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Les clava sus uñas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Trepa a la copa de los árboles&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Segrega un líquido que huele mal.&lt;br&gt;&lt;br&gt;Para escapar de sus enemigos la mofeta segrega un líquido de olor desagradable, que dispara en forma de chorro.&lt;/html&gt;</text><image w="149" h="99">T172707A.jpg</image><imagerefid>25A411BD</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./John R. MacGregor</credits><rewardcredits>Peter Arnold, Inc./John R. MacGregor</rewardcredits></quiz>