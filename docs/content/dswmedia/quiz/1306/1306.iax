<?xml version="1.0"?><quiz type="multichoice" id="1306" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal sudamericano es apreciado por su lana, más fuerte y suave que la de la oveja?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El cerdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La alpaca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El perezoso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La alpaca. &lt;br&gt;&lt;br&gt;La lana de la alpaca puede ser de varios colores, desde el blanco, hasta el castaño o el negro. Con la lana se fabrican prendas de vestir de gran calidad.&lt;/html&gt;</text><image w="153" h="102">18327.jpg</image><imagerefid>25A49CA7</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Shai Ginott</rewardcredits></quiz>