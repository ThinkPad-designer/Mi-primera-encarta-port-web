<?xml version="1.0"?><quiz type="multichoice" id="2519" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cómo se llaman los instrumentos musicales que pueden sonar sin la acción directa de un intérprete?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Instrumentos autodidactas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Instrumentos automáticos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Instrumentos autosonoros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Instrumentos automáticos.&lt;br&gt;&lt;br&gt;Algunos de estos instrumentos fueron muy elaborados, como las pianolas, que gracias a un mecanismo de cilindros con púas podían tocar solas (hoy en día esto se hace digitalmente).&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>