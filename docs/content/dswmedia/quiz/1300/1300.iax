<?xml version="1.0"?><quiz type="multichoice" id="1300" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama el macho de la oveja?
&lt;/html&gt;</text><image w="149" h="99">1e67a82f.jpg</image><imagerefid>42D9D9A2</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Novillo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cordero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Borrego&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Carnero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Carnero. &lt;br&gt;&lt;br&gt;El carnero es el macho de la oveja. El cordero es la cría de la oveja que no pasa de un año y el borrego es la cría de la oveja de uno a dos años. Un novillo es un macho vacuno que no ha cumplido los cuatro años. &lt;/html&gt;</text><image w="149" h="99">1e67a82f.jpg</image><imagerefid>42D9D9A2</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Derek Bromhall</credits><rewardcredits>Oxford Scientific Films/Derek Bromhall</rewardcredits></quiz>