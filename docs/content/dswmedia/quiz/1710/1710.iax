<?xml version="1.0"?><quiz type="multichoice" id="1710" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the longest river in Africa?
&lt;/html&gt;</text><image w="150" h="98">0018a642.jpg</image><imagerefid>42D982AB</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Congo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Niger&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Nile&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Zambezi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Nile.&lt;br&gt;&lt;br&gt;The Nile is the longest river in the world, at 4,160 miles (6,695 kilometers) in length.
&lt;/html&gt;</text><image w="150" h="98">0018a642.jpg</image><imagerefid>42D982AB</imagerefid><audio/><audiorefid/></reward><credits>4Corners Images/SIME/Zoom</credits><rewardcredits>4Corners Images/SIME/Zoom</rewardcredits></quiz>