<?xml version="1.0"?><quiz type="multichoice" id="826" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál es el nervio más largo de tu cuerpo?

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Vago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Frénico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Femoral&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ciático&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Ciático. &lt;br&gt;&lt;br&gt;El nervio ciático desciende desde la zona inferior de la espalda por los glúteos y continúa por la parte posterior del muslo y de la pierna hasta el pie.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>