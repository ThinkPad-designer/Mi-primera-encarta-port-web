<?xml version="1.0"?><quiz type="multichoice" id="123" lang="E" hascredits="0"><question><text>&lt;html&gt;El canto gregoriano es el canto oficial utilizado por la Iglesia Católica en las misas. ¿De dónde proviene su nombre?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Fue establecido por el papa Gregorio I a finales del siglo VI&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Fue cultivado por una orden de curas llamada “gregoriana”&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Fue denominado así en recuerdo de Gregorio IX, padre de la Inquisición&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Fue establecido por el papa Gregorio I a finales del siglo VI&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>