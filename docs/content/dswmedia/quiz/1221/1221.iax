<?xml version="1.0"?><quiz type="multichoice" id="1221" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal australiano se alimenta casi exclusivamente de las hojas de los eucaliptos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El canguro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El dodo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El koala&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El diablo de Tasmania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El koala. &lt;br&gt;&lt;br&gt;Durante los últimos 200 años, más del 80% de los bosques de eucaliptos australianos han sido talados para construir granjas y edificios. Como consecuencia, las poblaciones de koalas están disminuyendo.&lt;/html&gt;</text><image w="153" h="153">T172662A.jpg</image><imagerefid>25A4119A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Peter Arnold, Inc./John Cancalosi</rewardcredits></quiz>