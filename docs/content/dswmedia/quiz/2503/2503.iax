<?xml version="1.0"?><quiz type="multichoice" id="2503" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué magnífico violinista presentó a Johannes Brahms y a Robert Schumann, a mediados del siglo XIX?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Niccolò Paganini&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Joseph Joachim&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Franz Liszt&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Joseph Joachim.&lt;br&gt;&lt;br&gt;Tras este encuentro, Robert Schumann y su esposa Clara (también pianista) se convirtieron en muy buenos amigos de Brahms durante muchos años.
&lt;/html&gt;</text><image w="149" h="133">T012092A.jpg</image><imagerefid>1B822D3A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>