<?xml version="1.0"?><quiz type="multichoice" id="1374" lang="E" hascredits="1"><question><text>&lt;html&gt;En la costa occidental africana se encuentra el puerto de Dakar. ¿Sabrías decir de qué país es Dakar su capital?
&lt;/html&gt;</text><image w="149" h="132">T026066A.jpg</image><imagerefid>1B82391A</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;De Ghana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De la República de Guinea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De Malí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Senegal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De Senegal.&lt;br&gt;&lt;br&gt;Dakar, bañada por el océano Atlántico, se halla en el centro del extremo occidental de Senegal.&lt;/html&gt;</text><image w="149" h="132">T026066A.jpg</image><imagerefid>1B82391A</imagerefid><audio/><audiorefid/></reward><credits>Panos Pictures/Ron Giling</credits><rewardcredits>Panos Pictures/Ron Giling</rewardcredits></quiz>