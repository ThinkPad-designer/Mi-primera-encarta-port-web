<?xml version="1.0"?><quiz type="multichoice" id="1170" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el nombre científico del gato doméstico?&lt;/html&gt;</text><image w="149" h="132">T058563A.jpg</image><imagerefid>1B8288AC</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Acinonyx jubatus&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Felis catus&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Lynx rufus&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;&lt;i&gt;Panthera tigris&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Felis catus.&lt;/i&gt;&lt;br&gt;&lt;br&gt; &lt;i&gt;Acinonyx jubatus&lt;/i&gt; es el nombre científico del guepardo. &lt;i&gt;Lynx rufus&lt;/i&gt; es el del lince, y &lt;i&gt;Panthera tigris&lt;/i&gt; es el del tigre.&lt;/html&gt;</text><image w="149" h="132">T058563A.jpg</image><imagerefid>1B8288AC</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./M. Timothy O&apos; Keefe</credits><rewardcredits>Bruce Coleman, Inc./M. Timothy O&apos; Keefe</rewardcredits></quiz>