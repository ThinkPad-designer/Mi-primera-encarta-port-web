<?xml version="1.0"?><quiz type="multichoice" id="1722" lang="E" hascredits="1"><question><text>&lt;html&gt;Norway, in northern Europe, is known for its dramatic coastline, with many narrow inlets of the sea located between steep cliffs. What are these formations called?
&lt;/html&gt;</text><image w="153" h="136">T026307A.jpg</image><imagerefid>1B8239F2</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Fabios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Feebles&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Fjords&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Fnords&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Fjords.&lt;br&gt;&lt;br&gt;A fjord (also spelled fiord) is a narrow inlet of the sea situated between cliffs or steep slopes. 
&lt;/html&gt;</text><image w="153" h="136">T026307A.jpg</image><imagerefid>1B8239F2</imagerefid><audio/><audiorefid/></reward><credits>Leo de Wys, Inc./Jean-Paul Nacivet</credits><rewardcredits>Leo de Wys, Inc./Jean-Paul Nacivet</rewardcredits></quiz>