<?xml version="1.0"?><quiz type="multichoice" id="1361" lang="E" hascredits="0"><question><text>&lt;html&gt;Muchos ríos pequeños y muchas corrientes de agua desembocan en el río Níger a lo largo del curso de este. ¿Cómo llamamos a esos ríos y corrientes?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Fluorescentes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Afiliados&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Afluentes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Obras hidráulicas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Afluentes.&lt;br&gt;&lt;br&gt;Los afluentes aportan sus caudales a los ríos en los que desembocan. El río Benue es el principal afluente del Níger.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>