<?xml version="1.0"?><quiz type="multichoice" id="1455" lang="E" hascredits="1"><question><text>&lt;html&gt;El desierto de Kalahari recibe ese nombre de una palabra africana: &lt;i&gt;Kgalagadi&lt;/i&gt;. ¿Qué significa &lt;i&gt;Kgalagadi&lt;/i&gt;?
&lt;/html&gt;</text><image w="149" h="99">001ad5d5.jpg</image><imagerefid>42D9D7A9</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;&apos;Gran río&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&apos;País del ganado&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&apos;La gran sed&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;&apos;Colinas verdes&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&apos;La gran sed&apos;.&lt;br&gt;&lt;br&gt;Verdaderamente, sufrirás una tremenda sed si intentas atravesar el desierto de Kalahari... sin líquidos.
&lt;/html&gt;</text><image w="149" h="99">001ad5d5.jpg</image><imagerefid>42D9D7A9</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Martin Harvey</credits><rewardcredits>Corbis/Martin Harvey</rewardcredits></quiz>