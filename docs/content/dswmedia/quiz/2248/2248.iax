<?xml version="1.0"?><quiz type="multichoice" id="2248" lang="E" hascredits="1"><question><text>&lt;html&gt;La cría de las abejas para utilizar sus productos recibe el nombre de...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Avicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Apicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ganadería&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Piscicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Apicultura.&lt;br&gt;&lt;br&gt;Las abejas se crían para obtener su miel y su cera. Los apicultores emplean ropa protectora como sombreros, velos de rejilla de alambre y telas de color claro, para evitar picaduras al manipular a los insectos. &lt;/html&gt;</text><image w="149" h="132">T040591A.jpg</image><imagerefid>1B8254D9</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/Fred Whitehead</rewardcredits></quiz>