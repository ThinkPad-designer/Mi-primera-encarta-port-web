<?xml version="1.0"?><quiz type="multichoice" id="1783" lang="E" hascredits="0"><question><text>&lt;html&gt;The Gulf of California is in what North American country?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Canada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mexico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Nicaragua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mexico.&lt;br&gt;&lt;br&gt;The Gulf of California lies between the Mexican peninsula of Baja California and the rest of Mexico. &lt;i&gt;Baja&lt;/i&gt; means “Lower” in Spanish.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>