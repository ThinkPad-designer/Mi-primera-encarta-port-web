<?xml version="1.0"?><quiz type="multichoice" id="1339" lang="E" hascredits="0"><question><text>&lt;html&gt;Buena parte del desierto del Sahara se encuentra en territorio argelino. ¿Cuál es la capital de Argelia?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Niamey&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Argel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Trípoli&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rabat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Argel.&lt;br&gt;&lt;br&gt;Argel se encuentra en el litoral mediterráneo, en el centro septentrional de Argelia.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>