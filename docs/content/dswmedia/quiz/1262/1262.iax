<?xml version="1.0"?><quiz type="multichoice" id="1262" lang="E" hascredits="0"><question><text>&lt;html&gt;What brightly colored sea animal has an inflated bladder and very long, stinging tentacle?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Sea anemone&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bladderfish&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Portuguese man-of-war&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Puffer fish&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Portuguese man-of-war. &lt;br&gt;&lt;br&gt;The tentacles of this animal contain thousands of poisonous cells called nematocysts. These nematocysts produce a sting that paralyzes the small fish and other animals that are the Portuguese man-of-war&apos;s prey. 
&lt;/html&gt;</text><image w="153" h="136">T045840A.jpg</image><imagerefid>29D29662</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>