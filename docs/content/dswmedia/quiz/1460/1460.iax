<?xml version="1.0"?><quiz type="multichoice" id="1460" lang="E" hascredits="1"><question><text>&lt;html&gt;Los bosquimanos habitan en el desierto de Kalahari. En esta grabación, un bosquimano utiliza una herramienta de caza como si fuera un instrumento musical. ¿Qué herramienta?
&lt;/html&gt;</text><image/><imagerefid/><audio>T047894A.mp3</audio><audiorefid>1B826E72</audiorefid></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un boomerang&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un arco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un cuchillo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una lanza&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un arco.&lt;br&gt;&lt;br&gt;Este músico bosquimano usa una cuerda de su arco para producir notas musicales.
&lt;/html&gt;</text><image/><imagerefid/><audio>T047894A.mp3</audio><audiorefid>1B826E72</audiorefid></reward><credits>&quot;Gut hunting bow, solo&quot; de Instrumental Music of the Kalahari San (Cat. # Folkways FE 4315) (p) 1982 Smithsonian/Folkways Recordings. Reservados todos los derechos.</credits><rewardcredits>&quot;Gut hunting bow, solo&quot; de Instrumental Music of the Kalahari San (Cat. # Folkways FE 4315) (p) 1982 Smithsonian/Folkways Recordings. Reservados todos los derechos.</rewardcredits></quiz>