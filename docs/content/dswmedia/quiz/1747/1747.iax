<?xml version="1.0"?><quiz type="multichoice" id="1747" lang="E" hascredits="1"><question><text>&lt;html&gt;The first person to reach the South Pole was from what country?
&lt;/html&gt;</text><image w="153" h="136">T012761A.jpg</image><imagerefid>1B822F33</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Australia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Britain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Norway&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Norway.&lt;br&gt;&lt;br&gt;Norwegian explorer Roald Amundsen was the first person to reach the South Pole, in 1911.&lt;/html&gt;</text><image w="153" h="136">T012761A.jpg</image><imagerefid>1B822F33</imagerefid><audio/><audiorefid/></reward><credits>Culver Pictures</credits><rewardcredits>Culver Pictures</rewardcredits></quiz>