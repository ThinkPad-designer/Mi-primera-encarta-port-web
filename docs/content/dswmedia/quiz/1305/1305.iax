<?xml version="1.0"?><quiz type="multichoice" id="1305" lang="E" hascredits="1"><question><text>&lt;html&gt;Some of the names for this animal are doe, buck, and kid. What animal is it?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Pig&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Duck&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Goat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Cow&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Goat. &lt;br&gt;&lt;br&gt;A female goat is called a doe, or sometimes a nanny goat. A male goat is called a buck, or sometimes a billy goat. Young goats are called kids. 
&lt;/html&gt;</text><image w="149" h="133">T049755A.jpg</image><imagerefid>1B82750C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/G.I. Bernard</rewardcredits></quiz>