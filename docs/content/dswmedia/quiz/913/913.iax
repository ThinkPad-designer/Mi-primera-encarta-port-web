<?xml version="1.0"?><quiz type="multichoice" id="913" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes de qué está formado tu cerebro?
&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Músculo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hueso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Células nerviosas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Moco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Células nerviosas. &lt;br&gt;&lt;br&gt;Tu cerebro es una masa de tejido gris rosáceo que está formado por millones de células nerviosas. 

&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/London Scientific Films</credits><rewardcredits>Oxford Scientific Films/London Scientific Films</rewardcredits></quiz>