<?xml version="1.0"?><quiz type="multichoice" id="1213" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales es un macho?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text/><image w="149" h="149">00126ac9.jpg</image><imagerefid>29D29170</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="99">T167559A.jpg</image><imagerefid>42D96531</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T172666A.jpg</image><imagerefid>25A4119E</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Como sucede en la mayoría de las aves, el macho de pavo real tiene plumas vistosas, mientras que las hembras tienen plumas de colores más apagados.&lt;/html&gt;</text><image w="149" h="149">00126ac9.jpg</image><imagerefid>29D29170</imagerefid><audio/><audiorefid/></reward><credits>Corbis&lt;br&gt;&lt;br&gt;Stephen Krasemann&lt;br&gt;&lt;br&gt;Peter Arnold, Inc./Gerard Lacz</credits><rewardcredits>Corbis</rewardcredits></quiz>