<?xml version="1.0"?><quiz type="multichoice" id="1815" lang="E" hascredits="0"><question><text>&lt;html&gt;What city did Britain hand over to China in 1997?
&lt;/html&gt;</text><image w="153" h="136"/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Macao&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hong Kong&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Shanghai&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Liverpool&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hong Kong.&lt;br&gt;&lt;br&gt;Hong Kong had been a British dependency since 1842. In 1898 China leased a section of Hong Kong to Britain for 99 years.
&lt;/html&gt;</text><image w="153" h="136"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>