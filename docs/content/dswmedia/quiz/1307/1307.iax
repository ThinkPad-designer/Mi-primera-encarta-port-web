<?xml version="1.0"?><quiz type="multichoice" id="1307" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal, perteneciente a la familia del camello, se utiliza como animal de carga en la cordillera de los Andes, en Sudamérica?&lt;/html&gt;</text><image w="149" h="133">T049866A.jpg</image><imagerefid>1B827578</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El yak&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El caballo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El camello&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La llama&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La llama. &lt;br&gt;&lt;br&gt;La llama puede soportar pesos de 90 kg durante 12 horas seguidas.&lt;/html&gt;</text><image w="149" h="133">T049866A.jpg</image><imagerefid>1B827578</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Doug Allan</credits><rewardcredits>Oxford Scientific Films/Doug Allan</rewardcredits></quiz>