<?xml version="1.0"?><quiz type="multichoice" id="2257" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Sabes lo qué es el plancton?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un escarabajo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Invertebrados diminutos que flotan en el agua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una nube de libélulas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una colonia de hormigas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Invertebrados diminutos que flotan en el agua.&lt;br&gt;&lt;br&gt;El plancton está formado por multitud de invertebrados de pequeñísimo tamaño, que flotan en los mares y en los lagos, y que sirven de alimento a peces, ballenas y otros animales. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>