<?xml version="1.0"?><quiz type="multichoice" id="829" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué estructura del ojo es una lente que sirve para enfocar las imágenes sobre la retina?
&lt;/html&gt;</text><image w="149" h="149">0010225d.jpg</image><imagerefid>29D22C21</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Iris&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Pupila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cristalino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Conjuntiva&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cristalino. &lt;br&gt;&lt;br&gt;El cristalino es una lente que se aplana o se abomba para captar bien las imágenes que se proyectan sobre la retina.
&lt;/html&gt;</text><image w="149" h="149">0010225d.jpg</image><imagerefid>29D22C21</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>