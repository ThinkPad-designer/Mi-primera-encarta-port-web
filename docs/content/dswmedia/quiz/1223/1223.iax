<?xml version="1.0"?><quiz type="multichoice" id="1223" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales &lt;b&gt;no&lt;/b&gt; es un antílope?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El eland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El antílope saltador&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El antílope Áddax&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La cebra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La cebra. &lt;br&gt;&lt;br&gt;Las cebras pertenecen a la familia del caballo. El eland, el ñú, el Áddax o el duiquero son antílopes. Hay unas 100 especies de antílopes viviendo en África y Asia.&lt;/html&gt;</text><image w="149" h="99">T790546A.jpg</image><imagerefid>29D292E3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/G.I. Bernard</rewardcredits></quiz>