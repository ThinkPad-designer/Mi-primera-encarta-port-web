<?xml version="1.0"?><quiz type="multichoice" id="1800" lang="E" hascredits="1"><question><text>&lt;html&gt;What European city is shown here?
&lt;/html&gt;</text><image w="149" h="99">001aca54.jpg</image><imagerefid>42D9D7FC</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Athens&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Barcelona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Florence&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rome&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Athens.&lt;br&gt;&lt;br&gt;Athens is the capital of Greece. In this picture, you can see the Parthenon, an ancient Greek temple built on the Acropolis, a hill in the middle of the city.
&lt;/html&gt;</text><image w="149" h="99">001aca54.jpg</image><imagerefid>42D9D7FC</imagerefid><audio/><audiorefid/></reward><credits>4Corners Images/Reinhard Schmid/SIME</credits><rewardcredits>4Corners Images/Reinhard Schmid/SIME</rewardcredits></quiz>