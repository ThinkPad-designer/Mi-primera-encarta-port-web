<?xml version="1.0"?><quiz type="multichoice" id="1325" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál es el río más largo de Egipto?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El Nilo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El Congo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El Amazonas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El Jordán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El Nilo.&lt;br&gt;&lt;br&gt;El Nilo es el río más largo del mundo. Recorre 5.584 km, a través de Uganda, Sudán y Egipto.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>