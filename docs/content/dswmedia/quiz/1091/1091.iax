<?xml version="1.0"?><quiz type="multichoice" id="1091" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama el lugar abastecido de agua que podemos hallar en un desierto?
&lt;/html&gt;</text><image w="153" h="102">0c860440.jpg</image><imagerefid>479D7209</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Meseta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Oasis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Laguna&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Oasis. &lt;br&gt;&lt;br&gt;Los únicos lugares de los desiertos en los que se concentran las plantas son los oasis.
