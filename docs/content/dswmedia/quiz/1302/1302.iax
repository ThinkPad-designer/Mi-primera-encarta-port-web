<?xml version="1.0"?><quiz type="multichoice" id="1302" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animales se entrenan para que aprendan a buscar trufas, un tipo de hongos que crece bajo el suelo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Los caballos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los patos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los cerdos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las ovejas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los cerdos. &lt;br&gt;&lt;br&gt;Los cerdos tienen un buen sentido del olfato y pueden ser entrenados para localizar trufas, hongos que crecen por debajo de la tierra y tienen un aroma fuerte y característico. &lt;/html&gt;</text><image w="149" h="132">t044849a.jpg</image><imagerefid>1B826356</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Woodfin Camp and Associates, Inc./Adam Woolfitt</rewardcredits></quiz>