<?xml version="1.0"?><quiz type="multichoice" id="1261" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué hace el lagarto cornudo cuando es atacado?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Escupir&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gritar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hacerse el muerto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lanzar chorros de sangre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lanzar chorros de sangre. &lt;br&gt;&lt;br&gt;El lagarto cornudo lanza chorros de sangre desde las comisuras de los ojos.
