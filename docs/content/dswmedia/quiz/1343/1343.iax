<?xml version="1.0"?><quiz type="multichoice" id="1343" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué es lo que desplaza y modela las dunas arenosas del Sahara?
&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La lluvia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El viento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los animales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los terremotos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El viento.&lt;br&gt;&lt;br&gt;Los vientos que soplan en el desierto trasladan los granos de arena, de forma que las dunas se mueven muy lentamente y modifican así su peculiar modelado.
&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></reward><credits>Reuters/David Rouge (MAURITANIA)</credits><rewardcredits>Reuters/David Rouge (MAURITANIA)</rewardcredits></quiz>