<?xml version="1.0"?><quiz type="multichoice" id="1454" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué país está cubierto casi en su totalidad por el desierto de Kalahari?
&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Botsuana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mozambique&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Namibia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sudáfrica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Botsuana&lt;br&gt;&lt;br&gt;De ello da muestra el hecho de que aunque Botsuana es solo un poco más grande que España, sin embargo tiene una población 26 veces más pequeña.
&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>