<?xml version="1.0"?><quiz type="multichoice" id="2507" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué tipo de instrumento musical es una ocarina?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un tipo de tambor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un tipo de flauta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una especie de violín de seis cuerdas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un tipo de flauta.&lt;br&gt;&lt;br&gt;Suelen construirse con metal, cerámica o plástico, y es un tipo de flauta muy difundido por todo el mundo.
&lt;/html&gt;</text><image w="149" h="99">T047789A.jpg</image><imagerefid>1B82461B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>