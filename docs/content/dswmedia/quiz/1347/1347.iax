<?xml version="1.0"?><quiz type="multichoice" id="1347" lang="E" hascredits="0"><question><text>&lt;html&gt;La más alta temperatura registrada jamás por un aparato se obtuvo en el desierto del Sahara un día de 1922. ¿Hasta cuántos grados centígrados subieron los termómetros en aquella ocasión en el Sahara?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;43,8 °C&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;49,4 °C&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;57,7 °C&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;66,6 °C&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;57,7 °C.&lt;br&gt;&lt;br&gt;Esa temperatura se tomó en 1922, en Libia.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>