<?xml version="1.0"?><quiz type="multichoice" id="1709" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the longest river in Asia?
&lt;/html&gt;</text><image w="153" h="102">182CF.jpg</image><imagerefid>25A49C4F</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Irtysh&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Yangtze&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Yellow&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Yenisey&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Yangtze.&lt;br&gt;&lt;br&gt;The Yangtze, in China, is 3,900 miles (6,300 kilometers) long. It is the third longest river in the world.
&lt;/html&gt;</text><image w="153" h="102">182CF.jpg</image><imagerefid>25A49C4F</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Dean Conger</credits><rewardcredits>Corbis/Dean Conger</rewardcredits></quiz>