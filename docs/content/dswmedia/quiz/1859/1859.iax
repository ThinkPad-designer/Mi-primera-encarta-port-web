<?xml version="1.0"?><quiz type="multichoice" id="1859" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué instrumento fue el antecesor directo del gran piano que tenemos hoy en día?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;La cítara.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La pianola.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El clavicémbalo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>