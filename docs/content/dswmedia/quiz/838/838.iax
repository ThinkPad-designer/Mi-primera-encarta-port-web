<?xml version="1.0"?><quiz type="multichoice" id="838" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánto tiempo permanecen los alimentos en el estómago?

&lt;/html&gt;</text><image w="153" h="153">0007760e.jpg</image><imagerefid>29D02595</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;10 a 20 minutos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1 a 2 horas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;2 a 4 horas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;6 a 8 horas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;2 a 4 horas. &lt;br&gt;&lt;br&gt;El estómago produce un jugo ácido que fragmenta los alimentos. Entre dos y cuatro horas después de la comida, los alimentos procesados por el estómago pasan al intestino delgado.
&lt;/html&gt;</text><image w="153" h="153">0007760e.jpg</image><imagerefid>29D02595</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>