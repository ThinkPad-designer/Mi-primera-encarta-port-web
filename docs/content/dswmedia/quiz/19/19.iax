<?xml version="1.0"?><quiz type="multichoice" id="19" lang="E" hascredits="1"><question><text>&lt;html&gt;El pueblo masai dio nombre en su lengua al Serengeti, que quiere decir algo así como...&lt;/html&gt;</text><image w="153" h="153">T628323A.jpg</image><imagerefid>1B82A5A7</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;&apos;vegetación exhuberante&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&apos;llanura interminable&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&apos;valle de la felicidad&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;&apos;pozos de petróleo&apos;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&apos;llanura interminable&apos;.&lt;br&gt;&lt;br&gt;Eso es el Serengeti, una llanura aparentemente interminable.&lt;/html&gt;</text><image w="153" h="153">T628323A.jpg</image><imagerefid>1B82A5A7</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Bildarchiv Okapia</credits><rewardcredits>Photo Researchers, Inc./Bildarchiv Okapia</rewardcredits></quiz>