<?xml version="1.0"?><quiz type="multichoice" id="1291" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué ave se cría en Sudáfrica y otros países para obtener sus plumas, su carne y su piel?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El águila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El pelícano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El flamenco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El avestruz. &lt;br&gt;&lt;br&gt;La cría de avestruz se ha extendido por todo el mundo en los últimos años.
&lt;/html&gt;</text><image w="149" h="132">T049910A.jpg</image><imagerefid>1B8275A2</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Stan Osolinski</rewardcredits></quiz>