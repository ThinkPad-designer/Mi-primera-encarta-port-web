<?xml version="1.0"?><quiz type="multichoice" id="1190" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Por qué es importante esterilizar a tu mascota?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Para evitar que sea estéril.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Para evitar que tenga muchas crías.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Para impedir la aparición de caries.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Para no contaminar la atmósfera.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Para impedir el incremento del número de mascotas. &lt;br&gt;&lt;br&gt;Los animales castrados o esterilizados no pueden tener crías. Si no los esterilizas, seguramente acabarás teniendo demasiadas mascotas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>