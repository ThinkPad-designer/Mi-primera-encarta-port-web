<?xml version="1.0"?><quiz type="multichoice" id="126" lang="E" hascredits="0"><question><text>&lt;html&gt;En el siglo XIX surgió el nacionalismo musical, que se basaba en componer piezas que reflejaban melodías y ritmos populares.  ¿En qué países europeos se desarrolló con más fuerza?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Rusia, Checoslovaquia, Noruega y España&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Francia, España e Italia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Polonia, Francia y Rusia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>