<?xml version="1.0"?><quiz type="multichoice" id="2523" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llaman los fragmentos de una ópera en los que los cantantes expresan mejor las emociones de los personajes a quienes interpretan?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Tuttis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Recitativos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Arias&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Arias.&lt;br&gt;&lt;br&gt;Hay arias especialmente famosas, como la “Muerte de amor de Isolda”, de &lt;i&gt;Tristán e Isolda&lt;/i&gt; (Wagner), o la segunda aria de la “Reina de la noche” de &lt;i&gt;La flauta mágica&lt;/i&gt; (Mozart).&lt;/html&gt;</text><image w="149" h="99">T050954B.jpg</image><imagerefid>1B8279AE</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE/Ron Scherl</rewardcredits></quiz>