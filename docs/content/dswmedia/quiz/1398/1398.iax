<?xml version="1.0"?><quiz type="multichoice" id="1398" lang="E" hascredits="1"><question><text>&lt;html&gt;La costa swahili se encuentra en el océano Índico. ¿Qué océano es todavía más pequeño que el Índico?&lt;/html&gt;</text><image w="149" h="99">T166138A.jpg</image><imagerefid>25A440FB</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El océano Atlántico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El océano Glacial Ártico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El océano Pacífico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El océano Glacial Antártico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El océano Glacial Ártico.&lt;br&gt;&lt;br&gt;Algunos expertos consideran al Ártico un brazo rodeado de tierra del océano Atlántico.&lt;/html&gt;</text><image w="149" h="99">T166138A.jpg</image><imagerefid>25A440FB</imagerefid><audio/><audiorefid/></reward><credits>Christine Osborne Pictures</credits><rewardcredits>Christine Osborne Pictures</rewardcredits></quiz>