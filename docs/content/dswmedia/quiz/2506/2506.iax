<?xml version="1.0"?><quiz type="multichoice" id="2506" lang="E" hascredits="1"><question><text>&lt;html&gt;La voz humana se divide en cuatro grandes grupos, que son:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Suave, fuerte, dulce y potente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bajo, tenor, contralto y soprano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Bajo, mediano, alto y altísimo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Bajo, tenor, contralto y soprano.&lt;br&gt;&lt;br&gt;También existen otros tipos de voz más específicos, como el barítono o el contratenor.
&lt;/html&gt;</text><image w="149" h="132">T974668A.jpg</image><imagerefid>1B82B898</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Grazia Neri/E. Lodi</rewardcredits></quiz>