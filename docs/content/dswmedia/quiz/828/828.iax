<?xml version="1.0"?><quiz type="multichoice" id="828" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánto pesa  aproximadamente el cerebro de un adulto?
&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;1,3 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;2,3 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;3 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;4,5 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;1,3 kilogramos. &lt;br&gt;&lt;br&gt;El cerebro es el órgano más grande del encéfalo. Cuando nacemos, su peso es de unos 350 gramos, al crecer puede pesar algo más de un kilo.

&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/London Scientific Films</credits><rewardcredits>Oxford Scientific Films/London Scientific Films</rewardcredits></quiz>