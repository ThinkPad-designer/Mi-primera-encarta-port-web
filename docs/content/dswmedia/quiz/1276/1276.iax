<?xml version="1.0"?><quiz type="multichoice" id="1276" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un animal con pezuñas y cuernos. Vivo en terrenos montañosos y puedo saltar de roca en roca. ¿Sabes quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El cerdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El ganso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El caballo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La cabra.&lt;br&gt;&lt;br&gt;Las cabras nos proporcionan productos de valor como la leche, la lana y la carne.&lt;/html&gt;</text><image w="149" h="133">T049755A.jpg</image><imagerefid>1B82750C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/G.I. Bernard</rewardcredits></quiz>