<?xml version="1.0"?><quiz type="multichoice" id="1365" lang="E" hascredits="0"><question><text>&lt;html&gt;Uno de los países atravesados por el curso del río Níger es Malí. ¿Qué imperio dominó el área del río Níger hace unos 800 años? (La primera frase tal vez sea una pista)
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El Imperio Tukolor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El Imperio Mahdi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El Imperio de Malí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Songay&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El Imperio de Malí.&lt;br&gt;&lt;br&gt;El actual país llamado Malí recibe ese nombre del imperio que dominó una gran extensión de territorio en el occidente africano, especialmente durante los siglos XIII y XIV.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>