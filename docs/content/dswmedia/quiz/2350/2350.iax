<?xml version="1.0"?><quiz type="multichoice" id="2350" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes dónde se forma el quimo?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Intestino delgado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Boca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Páncreas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Estómago. &lt;br&gt;&lt;br&gt;El quimo es la papilla que se forma en el estómago como resultado de la digestión química y mecánica de los alimentos.
&lt;/html&gt;</text><image w="149" h="132">T053035A.jpg</image><imagerefid>42D970D9</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>