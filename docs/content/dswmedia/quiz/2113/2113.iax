<?xml version="1.0"?><quiz type="multichoice" id="2113" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes en qué cuento un gato muy astuto ayuda a su humilde amo a convertirse en un gran señor?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Alicia en el país de las maravillas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El gato Moisy&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El gato y el ruiseñor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El gato con botas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El gato con botas. &lt;br&gt;&lt;br&gt;Este gato consigue que su amo, muy pobre, se haga dueño de una gran fortuna. &lt;/html&gt;</text><image w="99" h="149">001a95ce.jpg</image><imagerefid>42D9D80D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Art Resource, NY/The Pierpont Morgan Library</rewardcredits></quiz>