<?xml version="1.0"?><quiz type="multichoice" id="1697" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the tallest mountain in Australia?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Mauna Kea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mount Cook&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mount Kosciusko&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mount Taranaki&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mount Kosciusko.&lt;br&gt;&lt;br&gt;Located in southeastern Australia, Mount Kosciusko is 7,310 feet (2,228 meters) tall. 
