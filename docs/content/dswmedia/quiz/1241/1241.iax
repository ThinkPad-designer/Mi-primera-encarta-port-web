<?xml version="1.0"?><quiz type="multichoice" id="1241" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el insecto que más pesa?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El gorgojo hamburguesa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La mosca elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El escarabajo Goliat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La mariposa monarca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El escarabajo Goliat. &lt;br&gt;&lt;br&gt;Este escarabajo, que vive en África, pesa unos 85 gramos, ¡más de lo que pesan algunos pájaros!&lt;/html&gt;</text><image w="153" h="102">T025260B.jpg</image><imagerefid>42D95D28</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>