<?xml version="1.0"?><quiz type="multichoice" id="1402" lang="E" hascredits="1"><question><text>&lt;html&gt;Uno de los tradicionales centros comerciales del norte de la costa swahili es en la actualidad la capital de Somalia. ¿Qué nombre tiene esa ciudad?
&lt;/html&gt;</text><image w="149" h="99">T166788A.jpg</image><imagerefid>25A44216</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Marka&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mogadiscio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mombasa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mtwara &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mogadiscio.&lt;br&gt;&lt;br&gt;Mogadiscio está situada en la costa del océano Índico, en el sur de Somalia, muy cerca de la línea del ecuador.&lt;/html&gt;</text><image w="149" h="99">T166788A.jpg</image><imagerefid>25A44216</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Hubertus Kanus</credits><rewardcredits>Photo Researchers, Inc./Hubertus Kanus</rewardcredits></quiz>