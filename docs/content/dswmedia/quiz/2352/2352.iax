<?xml version="1.0"?><quiz type="multichoice" id="2352" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Con qué sentido está relacionado el gusto?
&lt;/html&gt;</text><image w="149" h="132">T013498A.jpg</image><imagerefid>42D956A5</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Vista&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Oído&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tacto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Olfato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Olfato. &lt;br&gt;&lt;br&gt;El olfato y el gusto están muy relacionados. El sabor de los alimentos es en parte una combinación de su gusto y de su olor.
&lt;/html&gt;</text><image w="149" h="149">00102253.jpg</image><imagerefid>29D22C1F   </imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>