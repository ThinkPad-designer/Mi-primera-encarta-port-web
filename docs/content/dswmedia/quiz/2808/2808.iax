<?xml version="1.0"?><quiz type="multichoice" id="2808" lang="E" hascredits="0"><question><text>&lt;html&gt;La mégalopole japonaise rassemble&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;30&#38;nbsp;millions d&apos;habitants.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;80&#38;nbsp;% de la population japonaise.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;un tiers des Japonais.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Avec environ 100&#38;nbsp;millions d&apos;habitants, la mégalopole japonaise comprend 80&#38;nbsp;% de la population du pays. L&apos;agglomération de Tokyo compte 30&#38;nbsp;millions de personnes, soit le tiers de la mégalopole.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>