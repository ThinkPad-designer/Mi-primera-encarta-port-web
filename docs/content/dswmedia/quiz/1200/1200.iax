<?xml version="1.0"?><quiz type="multichoice" id="1200" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes mascotas es un conejillo de Indias?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="149" h="99">T051150A.jpg</image><imagerefid>1B827A3A</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T013516A.jpg</image><imagerefid>1B823176</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T050432A.jpg</image><imagerefid>1B8277A8</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los conejillos de Indias o cobayas, de cuerpo rechoncho y cabeza mofletuda, son más grandes que los hámsters y los ratones.&lt;/html&gt;</text><image w="149" h="99">T050432A.jpg</image><imagerefid>1B8277A8</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./J.M. Loubat/Jacana&lt;br&gt;&lt;br&gt;Dorling Kindersley&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Michael Leach&lt;br&gt;&lt;br&gt;Bruce Coleman, Inc./H. Reinhard</credits><rewardcredits>Oxford Scientific Films/Michael Leach</rewardcredits></quiz>