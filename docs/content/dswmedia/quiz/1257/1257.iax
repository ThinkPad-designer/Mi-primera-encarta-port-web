<?xml version="1.0"?><quiz type="multichoice" id="1257" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué insectos son capaces de producir energía luminosa?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El pez lámpara&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los pulgones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las luciérnagas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las chinchillas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las luciérnagas.&lt;br&gt;&lt;br&gt;Tanto los machos como las hembras son capaces de generar luz, que les sirve para reconocerse.&lt;/html&gt;</text><image w="149" h="132">T012725A.jpg</image><imagerefid>1B822F18</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Gregory Scott</rewardcredits></quiz>