<?xml version="1.0"?><quiz type="multichoice" id="870" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el órgano principal del sistema circulatorio?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Pulmones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hígado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Apéndice&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Corazón. &lt;br&gt;&lt;br&gt;El corazón está formado por el músculo cardiaco. Este órgano actúa como una bomba muy potente que empuja la sangre hacia los vasos sanguíneos. &lt;/html&gt;</text><image w="149" h="149">00102565.jpg</image><imagerefid>29D22C2C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>