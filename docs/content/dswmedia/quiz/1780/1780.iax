<?xml version="1.0"?><quiz type="multichoice" id="1780" lang="E" hascredits="0"><question><text>&lt;html&gt;Which of these African countries is &lt;i&gt;landlocked,&lt;/i&gt; meaning that it does not touch an ocean?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Kenya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Sudan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tanzania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Uganda&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Uganda.&lt;br&gt;&lt;br&gt;Uganda is separated from the Indian Ocean by Kenya and Tanzania.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>