<?xml version="1.0"?><quiz type="multichoice" id="1413" lang="E" hascredits="1"><question><text>&lt;html&gt;La isla de Zanzíbar es tradicionalmente una gran productora de una especia muy usada como condimento en la cocina. Su nombre es...&lt;/html&gt;</text><image w="149" h="132">T642861A.jpg</image><imagerefid>1B82B3ED</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La pimienta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La mostaza&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El clavo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El martillo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El clavo.&lt;br&gt;&lt;br&gt;Del árbol del clavo se obtiene, además de un condimento gastronómico, un aceite usado para conservar los alimentos con el que también se hacen perfumes y jabones. Zanzíbar produce la mayoría del clavo que se consume en todo el mundo.
&lt;/html&gt;</text><image w="149" h="132">T013366A.jpg</image><imagerefid>1B82310a</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Wolfgang Kaehler</credits><rewardcredits>Phototake NYC/Yoav Levy</rewardcredits></quiz>