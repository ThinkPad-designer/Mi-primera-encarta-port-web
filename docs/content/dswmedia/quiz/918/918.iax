<?xml version="1.0"?><quiz type="multichoice" id="918" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: el lado izquierdo de tu cerebro controla tu mano izquierda, y el lado derecho, controla tu mano derecha.

&lt;/html&gt;</text><image w="149" h="132">T012861A.jpg</image><imagerefid>1B822F80</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso. &lt;br&gt;&lt;br&gt;El lado izquierdo de tu cerebro controla tu mano derecha, y el lado derecho, tu mano izquierda.

