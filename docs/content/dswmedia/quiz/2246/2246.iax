<?xml version="1.0"?><quiz type="multichoice" id="2246" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo producen los grillos su característico canto?&lt;/html&gt;</text><image w="149" h="99">T013677A.jpg</image><imagerefid>1B8231F5</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Con la boca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Frotando sus patas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Frotando las alas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Con una trompeta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Frotando las alas.&lt;br&gt;&lt;br&gt;Los grillos producen su característico canto frotando sus alas. Este canto atrae a las hembras.&lt;/html&gt;</text><image w="149" h="99">T013677A.jpg</image><imagerefid>1B8231F5</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/G.I. Bernard</credits><rewardcredits>Oxford Scientific Films/G.I. Bernard</rewardcredits></quiz>