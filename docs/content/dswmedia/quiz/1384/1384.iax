<?xml version="1.0"?><quiz type="multichoice" id="1384" lang="E" hascredits="0"><question><text>&lt;html&gt;Los comerciantes europeos denominaron a una parte del litoral occidental africano Costa de Oro, la actual Ghana. ¿Qué cultivo produce todavía más riqueza que el oro, en Ghana?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El cultivo de arroz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cultivo de trigo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El cultivo de maíz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El cultivo de cacao&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El cultivo de cacao.&lt;br&gt;&lt;br&gt;Dos terceras partes del abastecimiento mundial de cacao provienen de África, la mayoría de Ghana, que es el tercer país productor. Por cierto, con el cacao se elabora el chocolate.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>