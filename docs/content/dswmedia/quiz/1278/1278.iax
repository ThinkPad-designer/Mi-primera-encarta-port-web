<?xml version="1.0"?><quiz type="multichoice" id="1278" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales duerme de pie?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El cerdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La vaca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El caballo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La oveja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El caballo. &lt;br&gt;&lt;br&gt;Pero si se siente seguro, puede tumbarse para dormir.&lt;/html&gt;</text><image w="153" h="136">T058532A.jpg</image><imagerefid>1B82888D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/Robert Maier</rewardcredits></quiz>