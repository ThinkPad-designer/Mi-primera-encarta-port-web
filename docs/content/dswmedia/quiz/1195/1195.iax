<?xml version="1.0"?><quiz type="multichoice" id="1195" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes peces es un pez ángel?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="149" h="132">T285405A.jpg</image><imagerefid>1B8295F9</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T013772A.jpg</image><imagerefid>1B823238</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T010578A.jpg</image><imagerefid>1B8227E4</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T010324A.jpg</image><imagerefid>1B822753</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El pez ángel tiene el cuerpo aplastado y con enormes aletas. Es una especie frecuente en los acuarios por su belleza.
&lt;/html&gt;</text><image w="149" h="132">T010324A.jpg</image><imagerefid>1B822753</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/E.R. Degginger&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Max Gibbs&lt;br&gt;&lt;br&gt;Oxford Scientific Films/G. H. Thompson&lt;br&gt;&lt;br&gt;Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>