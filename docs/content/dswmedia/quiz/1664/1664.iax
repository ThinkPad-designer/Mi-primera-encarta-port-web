<?xml version="1.0"?><quiz type="multichoice" id="1664" lang="E" hascredits="1"><question><text>&lt;html&gt;Uno de estos nombres pertenece a un gran jugador de béisbol. ¿Cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Michael Schumacher&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Wilt Chamberlain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Emilio Buscató&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Andrés Galarraga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Andrés Galarraga. &lt;br&gt;&lt;br&gt;El beisbolista venezolano Andrés Galarraga destacó en la principal competición del mundo, la que se disputa regularmente en Estados Unidos. &lt;/html&gt;</text><image w="99" h="149">T287644A.jpg</image><imagerefid>0C047373</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>AFP/Doug Collier</rewardcredits></quiz>