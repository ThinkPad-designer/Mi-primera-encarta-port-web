<?xml version="1.0"?><quiz type="multichoice" id="882" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el recorrido del aire antes de llegar a los pulmones?&lt;/html&gt;</text><image w="149" h="149">0010224f.jpg</image><imagerefid>29D22C1E</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Conducto auditivo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cerebro y cerebelo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Esófago, estómago, intestino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Faringe, laringe, tráquea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Faringe, laringe y tráquea. &lt;br&gt;&lt;br&gt;El aire entra a través de la nariz o de la boca, atraviesa la faringe y la laringe y llega a la tráquea. La tráquea antes de entrar en los pulmones se divide en dos bronquios.
&lt;/html&gt;</text><image w="149" h="149">0010224f.jpg</image><imagerefid>29D22C1E</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>