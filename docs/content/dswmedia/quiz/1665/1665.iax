<?xml version="1.0"?><quiz type="multichoice" id="1665" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama el grupo de deportes al que pertenecen el patinaje de velocidad, el hochey sobre hielo y el patinaje artístico?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Ajedrez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Patinaje sobre hielo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Helenismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Patinaje gélido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Patinaje sobre hielo. &lt;br&gt;&lt;br&gt;El patinaje de velocidad, el hochey sobre hielo y el patinaje artístico se disputan sobre una misma superficie. Seguro que sabes cuál.&lt;/html&gt;</text><image w="149" h="133">T048114A.jpg</image><imagerefid>1B826F48</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Gerard Vandystadt/Agence Vandystadt</rewardcredits></quiz>