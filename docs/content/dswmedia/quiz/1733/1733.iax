<?xml version="1.0"?><quiz type="multichoice" id="1733" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the latitude of the South Pole?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;0° south&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;45° south&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;66° south&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;90° south&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;90° south.&lt;br&gt;&lt;br&gt;The South Pole is the southernmost point on Earth. Southern latitude is measured from the equator (0°) to the South Pole (90°).
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>