<?xml version="1.0"?><quiz type="multichoice" id="1652" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: el baloncesto debe su nombre al hecho de que en un principio los jugadores tenían que meter la pelota en cestas para melocotones.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero. &lt;br&gt;&lt;br&gt;El baloncesto (o básquetbol) fue creado en Massachusetts (Estados Unidos), en 1891, por el profesor canadiense de educación física James Naismith.&lt;/html&gt;</text><image w="149" h="133">T012056A.jpg</image><imagerefid>1B822D17</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Archive Photos</rewardcredits></quiz>