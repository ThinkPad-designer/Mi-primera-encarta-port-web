<?xml version="1.0"?><quiz type="multichoice" id="1364" lang="E" hascredits="1"><question><text>&lt;html&gt;A lo largo de la historia, muchas han sido las ciudades fundadas a orillas del río Níger. Una de ellas es la capital del país de igual nombre que el río (Níger). ¿Sabes cómo se llama esa ciudad?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Abuja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Accra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Bamako&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Niamey&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Niamey.&lt;br&gt;&lt;br&gt;La ciudad de Niamey está en el suroeste de Níger, a orillas del río también denominado Níger, cerca de la frontera con Burkina Faso.&lt;/html&gt;</text><image w="149" h="99">T173375A.jpg</image><imagerefid>25a41304</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./George Holton</rewardcredits></quiz>