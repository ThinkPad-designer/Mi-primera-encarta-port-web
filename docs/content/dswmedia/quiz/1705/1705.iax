<?xml version="1.0"?><quiz type="multichoice" id="1705" lang="E" hascredits="1"><question><text>&lt;html&gt;What mountain range crosses the continent of Antarctica?
&lt;/html&gt;</text><image w="150" h="98">0018a7c2.jpg</image><imagerefid>42D986E0</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Interantarctic Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Postantarctic Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Pseudoantarctic Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Transantarctic Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Transantarctic Mountains.&lt;br&gt;&lt;br&gt;The Transantarctic Mountains separate eastern and western Antarctica.
&lt;/html&gt;</text><image w="150" h="98">0018a7c2.jpg</image><imagerefid>42D986E0</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Galen Rowell</credits><rewardcredits>Corbis/Galen Rowell</rewardcredits></quiz>