<?xml version="1.0"?><quiz type="multichoice" id="1824" lang="E" hascredits="1"><question><text>&lt;html&gt;What was the name of Antarctic explorer Ernest Shackleton’s ship (which got stuck in floating ice for 10 months)?
&lt;/html&gt;</text><image w="99" h="149">001ad6d5.jpg</image><imagerefid>42D9D793</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Endeavor&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Endurance&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Enterprise&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;&lt;i&gt;Pinta&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Endurance.&lt;/i&gt;&lt;br&gt;&lt;br&gt;Was it a fitting name? The ice eventually crushed the ship and sank it, but Shackleton and his entire crew survived the harrowing adventure.
&lt;/html&gt;</text><image w="99" h="149">001ad6d5.jpg</image><imagerefid>42D9D793</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Underwood &#38; Underwood</credits><rewardcredits>Corbis/Underwood &#38; Underwood</rewardcredits></quiz>