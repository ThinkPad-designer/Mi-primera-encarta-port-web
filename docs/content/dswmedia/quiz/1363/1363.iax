<?xml version="1.0"?><quiz type="multichoice" id="1363" lang="E" hascredits="1"><question><text>&lt;html&gt;A orillas del río Níger, en Malí, una pequeña ciudad tiene un nombre que todavía hoy se utiliza para mencionar un lugar lejano e impredecible. ¿De qué ciudad hablamos?
&lt;/html&gt;</text><image w="149" h="132">T001249A.jpg</image><imagerefid>1B821FF4</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;De Tammanghasset&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De Tenkodogo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De Tomoylomo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Tombuctú&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De Tombuctú.&lt;br&gt;&lt;br&gt;Suele relacionarse a esta ciudad con algo que se halla en medio de ninguna parte pero, en realidad, Tombuctú fue un gran y poderoso centro comercial hace unos 500 años y hoy es Patrimonio cultural de la Humanidad. Es también conocida como Tombouctou o Timbuktu.
&lt;/html&gt;</text><image w="149" h="132">T001249A.jpg</image><imagerefid>1B821FF4</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./George Holton</credits><rewardcredits>Photo Researchers, Inc./George Holton</rewardcredits></quiz>