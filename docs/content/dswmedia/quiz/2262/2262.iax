<?xml version="1.0"?><quiz type="multichoice" id="2262" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se mueven las esponjas?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Agitando los tentáculos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Deslizándose con un hilo mucoso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Con sus patas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;No se mueven&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;No se mueven.&lt;br&gt;&lt;br&gt;Las esponjas son animales marinos que permanecen pegados al fondo de los océanos.&lt;/html&gt;</text><image w="149" h="132">T014306A.jpg</image><imagerefid>42D95D0C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Joe Dorsey</rewardcredits></quiz>