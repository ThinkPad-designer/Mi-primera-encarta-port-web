<?xml version="1.0"?><quiz type="multichoice" id="1294" lang="E" hascredits="1"><question><text>&lt;html&gt;What U.S. state considers itself the Poultry Capital of the World?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;California&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Maine&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Georgia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Alaska&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Georgia. &lt;br&gt;&lt;br&gt;So many chickens, turkeys, ducks, and geese are produced in Georgia that if this state was a country, it would be one of the leading poultry producers in the world.
&lt;/html&gt;</text><image w="149" h="133">T050446A.jpg</image><imagerefid>1B8277B6</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>