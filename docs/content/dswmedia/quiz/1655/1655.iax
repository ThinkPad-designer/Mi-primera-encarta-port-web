<?xml version="1.0"?><quiz type="multichoice" id="1655" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En qué país tuvieron lugar los primeros Juegos Olímpicos, 2.000 años después de los que se celebraban en la antigüedad?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;En Estados Unidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En Alemania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Egipto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En Grecia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Grecia. &lt;br&gt;&lt;br&gt;Los juegos olímpicos de la antigüedad se disputaron desde el siglo VIII a.C. hasta el IV d.C. En Atenas se llevaron a cabo, en 1896, los primeros de la era moderna.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>