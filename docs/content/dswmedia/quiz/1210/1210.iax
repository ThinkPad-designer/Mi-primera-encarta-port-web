<?xml version="1.0"?><quiz type="multichoice" id="1210" lang="E" hascredits="1"><question><text>&lt;html&gt;No tengo brazos pero tengo algo, formado por unos 150.000 músculos, que utilizo para agarrar la hierba, arrancar las ramas y absorber el agua y expulsarla sobre mi cuerpo como si fuera una ducha. ¿Sabes quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La ballena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La boa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El elefante. &lt;br&gt;&lt;br&gt;Mi trompa es muy útil: es tan fuerte que me permite tirar un árbol al suelo, pero también tan delicada que me permite coger un fruto del suelo.&lt;/html&gt;</text><image w="149" h="132">T047979A.jpg</image><imagerefid>1B826EC5</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Leonard Rue</rewardcredits></quiz>