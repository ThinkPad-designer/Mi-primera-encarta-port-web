<?xml version="1.0"?><quiz type="multichoice" id="1227" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes aves es un flamenco?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="99" h="149">T167605A.jpg</image><imagerefid>25A40887</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T049684A.jpg</image><imagerefid>1B8274C6</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T172753A.jpg</image><imagerefid>25A411E2</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="133">T049922A.jpg</image><imagerefid>1B8275AE</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El flamenco es una especie fácil de reconocer por su cuello y patas extremadamente largos. Para alimentarse hunde la cabeza en el agua y recoge los pequeños invertebrados y las plantas de las que se alimenta.
&lt;/html&gt;</text><image w="149" h="99">T172753A.jpg</image><imagerefid>25A411E2</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Alan G. Nelson&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Philippe Henry&lt;br&gt;&lt;br&gt;Minden Pictures/Frans Lanting&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Stan Osolinski</credits><rewardcredits>Minden Pictures/Frans Lanting</rewardcredits></quiz>