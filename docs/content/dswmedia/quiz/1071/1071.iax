<?xml version="1.0"?><quiz type="multichoice" id="1071" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un pez conocido por mi gran apetito. A veces pierdo algunos dientes cuando como pero, afortunadamente, los reemplazo por otros nuevos. ¿Sabes quien soy?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Una ballena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un delfín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una raya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un tiburón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un tiburón. &lt;br&gt;&lt;br&gt;Tengo varias filas de dientes nuevos detrás de los que utilizo para masticar. Si pierdo un diente, lo reemplazo por otro de los nuevos.
&lt;/html&gt;</text><image w="149" h="99">T310099A.jpg</image><imagerefid>1B829B73</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>University of Cape Town/C. Velasquez, Zoology Department</rewardcredits></quiz>