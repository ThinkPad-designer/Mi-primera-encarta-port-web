<?xml version="1.0"?><quiz type="multichoice" id="841" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabrías decir cuál es la sustancia más dura de tu cuerpo?

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Esmalte dental&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Huesos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Articulaciones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Uñas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Esmalte dental. &lt;br&gt;&lt;br&gt;El esmalte cubre la dentina de la corona de tus dientes y es la sustancia más dura que hay en tu organismo.
&lt;/html&gt;</text><image w="149" h="132">T012501A.jpg</image><imagerefid>1B822E7D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>