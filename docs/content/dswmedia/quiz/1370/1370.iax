<?xml version="1.0"?><quiz type="textAnswer" id="1370" lang="E" hascredits="0"><question><text>&lt;html&gt;El río Níger da nombre a dos países africanos. Escribe el nombre de uno de ellos.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers><answer>niger</answer><answer>nigeria</answer><answer>níger</answer><answer/></answers><reward><text>&lt;html&gt;El río Níger da nombre a dos países: a &lt;b&gt;Níger&lt;/b&gt; y a &lt;b&gt;Nigeria.&lt;/b&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>