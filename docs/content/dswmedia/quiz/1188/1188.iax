<?xml version="1.0"?><quiz type="multichoice" id="1188" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De dónde proceden los canarios?
&lt;/html&gt;</text><image w="149" h="132">T049621A.jpg</image><imagerefid>42D95D5E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;De México&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De Canarias&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Zamora&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De Canarias.&lt;br&gt;&lt;br&gt;Estos pájaros, criados por su belleza y su canto, son nativos de las islas Canarias, las Azores y la isla de Madeira.&lt;/html&gt;</text><image w="149" h="132">T049621A.jpg</image><imagerefid>42D95D5E</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Tony Tilford</credits><rewardcredits>Oxford Scientific Films/Tony Tilford</rewardcredits></quiz>