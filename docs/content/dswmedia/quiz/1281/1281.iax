<?xml version="1.0"?><quiz type="multichoice" id="1281" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llaman las personas que curan a los animales cuando están enfermos?&lt;/html&gt;</text><image w="149" h="132">T040696A.jpg</image><imagerefid>1B825542</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Cirujanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Zoólogos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Endocrinólogos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Veterinarios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Veterinarios. &lt;br&gt;&lt;br&gt;Los veterinarios diagnostican y tratan las enfermedades y lesiones de las mascotas, los animales que viven en zoológicos, los animales de granja y los animales salvajes.&lt;/html&gt;</text><image w="149" h="132">T040696A.jpg</image><imagerefid>1B825542</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Larry Cameron</credits><rewardcredits>Photo Researchers, Inc./Larry Cameron</rewardcredits></quiz>