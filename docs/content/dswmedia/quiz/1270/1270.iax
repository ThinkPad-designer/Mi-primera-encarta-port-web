<?xml version="1.0"?><quiz type="multichoice" id="1270" lang="E" hascredits="1"><question><text>&lt;html&gt;Las babosas y caracoles de tierra son hermafroditas. Un animal hermafrodita es aquel que…&lt;/html&gt;</text><image w="149" h="149">T025753A.jpg</image><imagerefid>1B8237E9</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Solo come carne&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tiene órganos reproductores masculinos y femeninos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Le gustan los cangrejos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ninguna de las anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tiene órganos reproductores masculinos y femeninos. &lt;br&gt;&lt;br&gt;Algunos invertebrados son hermafroditas.&lt;/html&gt;</text><image w="149" h="149">T025753A.jpg</image><imagerefid>1B8237E9</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>