<?xml version="1.0"?><quiz type="multichoice" id="1823" lang="E" hascredits="0"><question><text>&lt;html&gt;The native peoples of the islands of the South Pacific are collectively called what?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Politburos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Polonius&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Polynesians&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Polynomials&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Polynesians.&lt;br&gt;&lt;br&gt;The native peoples of the South Pacific are all descended from early Polynesians. These seafaring people explored and settled the islands hundreds of years ago.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>