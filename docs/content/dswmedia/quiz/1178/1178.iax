<?xml version="1.0"?><quiz type="multichoice" id="1178" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes perros ha sido muy utilizado para encontrar personas perdidas en la nieve?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El cocker&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El chihuahua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El San Bernardo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El chow chow&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El San Bernardo. &lt;br&gt;&lt;br&gt;Es un perro grande y fuerte. Su agudo sentido del olfato le permite encontrar personas perdidas o enterradas en la nieve.&lt;/html&gt;</text><image w="149" h="99">T025353A.jpg</image><imagerefid>1B8236C4</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>