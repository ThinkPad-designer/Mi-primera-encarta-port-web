<?xml version="1.0"?><quiz type="multichoice" id="1411" lang="E" hascredits="1"><question><text>&lt;html&gt;La isla de Zanzíbar estuvo gobernada por el sultanato de Omán durante los siglos XVIII y XIX. ¿Dónde está Omán?
&lt;/html&gt;</text><image w="153" h="136">T642861A.jpg</image><imagerefid>1B82B3ED</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;En el continente africano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En Arabia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Europa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En India&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Arabia.&lt;br&gt;&lt;br&gt;Los sultanes omaníes rivalizaron con los europeos muchos años por la supremacía en la costa oriental africana y trasladaron a ella la influencia árabe.&lt;/html&gt;</text><image w="153" h="136">T642861A.jpg</image><imagerefid>1B82B3ED</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Wolfgang Kaehler</credits><rewardcredits>Corbis/Wolfgang Kaehler</rewardcredits></quiz>