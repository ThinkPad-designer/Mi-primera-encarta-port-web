<?xml version="1.0"?><quiz type="multichoice" id="2515" lang="E" hascredits="1"><question><text>&lt;html&gt;Las pequeñas divisiones que hay a lo largo del mástil de una guitarra se llaman:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Trastes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Clavijas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Teclas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Trastes.&lt;br&gt;&lt;br&gt;Los trastes no son todos iguales, sino que se van ensanchando conforme se acercan desde el clavijero (el extremo del mástil) hacia la caja de resonancia.&lt;/html&gt;</text><image w="149" h="99">T287538A.jpg</image><imagerefid>073FDC3C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>