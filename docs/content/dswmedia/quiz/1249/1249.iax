<?xml version="1.0"?><quiz type="multichoice" id="1249" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: las tortugas no tienen dientes.
&lt;/html&gt;</text><image w="149" h="99">001275e9.jpg</image><imagerefid>29D294E8</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero. &lt;br&gt;&lt;br&gt;No tienen dientes, sino una especie de pico afilado, que les sirve para desgarrar los alimentos.&lt;/html&gt;</text><image w="149" h="99">001275e9.jpg</image><imagerefid>29D294E8</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Jim Foster</credits><rewardcredits>Corbis/Jim Foster</rewardcredits></quiz>