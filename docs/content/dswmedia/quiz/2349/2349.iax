<?xml version="1.0"?><quiz type="multichoice" id="2349" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de estas sustancias &lt;b&gt;no&lt;/b&gt; participa en la digestión química de los alimentos?

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Jugo gástrico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Saliva&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sangre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Jugo intestinal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sangre. &lt;br&gt;&lt;br&gt;La saliva, el jugo gástrico, la bilis, el jugo pancreático y los jugos intestinales participan en la digestión química de los alimentos.
&lt;/html&gt;</text><image w="149" h="149">001020e8.jpg</image><imagerefid>29D22A25</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>