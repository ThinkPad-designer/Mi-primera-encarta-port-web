<?xml version="1.0"?><quiz type="multichoice" id="1245" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales pasa la mayor parte de su vida en el agua?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El oso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La serpiente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La rana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El mono&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La rana. &lt;br&gt;&lt;br&gt;Las ranas comienzan su vida en el agua. Las larvas que nacen de los huevos tienen forma de pez y reciben el nombre de renacuajos. Los adultos viven en el medio terrestre.
&lt;/html&gt;</text><image w="149" h="132">T027967A.jpg</image><imagerefid>1B823B42</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bruce Coleman, Inc./Joe McDonald</rewardcredits></quiz>