<?xml version="1.0"?><quiz type="multichoice" id="1810" lang="E" hascredits="1"><question><text>&lt;html&gt;Descendants of the original inhabitants of Australia are called what?
&lt;/html&gt;</text><image w="153" h="136">T012822A.jpg</image><imagerefid>29D2944F</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Aboriginal people&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Abolitionists&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Maori&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Molokai&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Aboriginal people.&lt;br&gt;&lt;br&gt;Aboriginal people have lived in Australia for at least 50,000 years. 
&lt;/html&gt;</text><image w="153" h="136">T012822A.jpg</image><imagerefid>29D2944F</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Gordon Gahan</credits><rewardcredits>Photo Researchers, Inc./Gordon Gahan</rewardcredits></quiz>