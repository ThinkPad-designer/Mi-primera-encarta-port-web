<?xml version="1.0"?><quiz type="multichoice" id="2329" lang="E" hascredits="1"><question><text>&lt;html&gt;La marimba es un instrumento musical, pero ¿de qué tipo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Instrumento de cuerda &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Instumento de viento madera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Instrumento de percusión &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Instrumento de percusión.&lt;br&gt;&lt;br&gt;Se trata de un instrumento parecido a un xilófono, con placas de madera, y que se golpea con unas baquetas que terminan en bolas de goma.&lt;/html&gt;</text><image w="149" h="132">T047820A.jpg</image><imagerefid>1B82E9D9</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Arvind Garg</rewardcredits></quiz>