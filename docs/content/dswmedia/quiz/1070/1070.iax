<?xml version="1.0"?><quiz type="multichoice" id="1070" lang="E" hascredits="1"><question><text>&lt;html&gt;El pez de la izquierda es el héroe de la película de Disney &lt;i&gt;Buscando a Nemo&lt;/i&gt;. ¿Sabes qué tipo de pez es?&lt;/html&gt;</text><image w="149" h="99">000fb6a9.jpg</image><imagerefid>29D1E48F</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un carpín dorado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un pez payaso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un pez ángel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un pez espada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un pez payaso. &lt;br&gt;&lt;br&gt;El pez payaso tiene el cuerpo de colores brillantes, generalmente amarillo o anaranjado, con rayas blancas. Vive en los arrecifes coralinos. &lt;/html&gt;</text><image w="149" h="99">T172855A.jpg</image><imagerefid>42D96508</imagerefid><audio/><audiorefid/></reward><credits>Cortesía de The Everett Collection, Inc.</credits><rewardcredits>Peter Arnold, Inc./Fred Bavendam</rewardcredits></quiz>