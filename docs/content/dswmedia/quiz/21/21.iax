<?xml version="1.0"?><quiz type="multichoice" id="21" lang="E" hascredits="1"><question><text>&lt;html&gt;Esta espectacular montaña está en el noreste de Tanzania, cerca de la frontera con Kenia. Es la más alta de África y se llama...&lt;/html&gt;</text><image w="149" h="132">T054758A.jpg</image><imagerefid>1B828594</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Kilimanjaro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Fujiyama&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Everest&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Kilimanjaro.&lt;br&gt;&lt;br&gt;También se le llama Uhuru. Mide 5.895 metros.&lt;/html&gt;</text><image w="149" h="132">T054758A.jpg</image><imagerefid>1B828594</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Renee Lynn</credits><rewardcredits>Photo Researchers, Inc./Renee Lynn</rewardcredits></quiz>