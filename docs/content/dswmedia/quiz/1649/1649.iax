<?xml version="1.0"?><quiz type="multichoice" id="1649" lang="E" hascredits="0"><question><text>&lt;html&gt;Ángel Nieto, Álex Crivillé, Carlos Lavado y Johnny Cecotto practicaban un mismo deporte, el...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Badminton&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Ciclismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Motociclismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Escepticismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Motociclismo. &lt;br&gt;&lt;br&gt;Los españoles Ángel Nieto y  Álex Crivillé lograron respectivamente 13 y 2 títulos mundiales. Por su parte, los venezolanos Carlos Lavado y Johnny Cecotto ganaron 2 campeonatos del mundo cada uno. Por cierto, Cecotto compitió también en Fórmula 1.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>