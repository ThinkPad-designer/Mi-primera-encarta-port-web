<?xml version="1.0"?><quiz type="multichoice" id="1230" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuáles son las únicas aves capaces de volar hacia atrás?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Los papamoscas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los colibríes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los chochines&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los flamencos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los colibríes. &lt;br&gt;&lt;br&gt;Estas aves mueven sus alas muy rápidamente y vuelan hacia delante y hacia atrás. 
&lt;/html&gt;</text><image w="149" h="149">T040674A.jpg</image><imagerefid>1B82552C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tom Stack and Associates/Wendy Shattil-Bob Rozinski</rewardcredits></quiz>