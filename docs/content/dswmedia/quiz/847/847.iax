<?xml version="1.0"?><quiz type="multichoice" id="847" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Sabes en qué órgano se almacena la orina?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Vejiga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Riñones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Intestino grueso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La vejiga &lt;br&gt;&lt;br&gt;Desde los riñones, la orina desciende por los uréteres y se almacena en la vejiga. La vejiga es como una bolsa redondeada. La mayor parte de su pared está formada por músculo, lo que permite que se distienda o se contraiga.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>