<?xml version="1.0"?><quiz type="multichoice" id="1248" lang="E" hascredits="1"><question><text>&lt;html&gt;La serpiente que más pesa es….&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;La anaconda&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La boa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La serpiente real&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La cobra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La anaconda. &lt;br&gt;&lt;br&gt;Un adulto puede pesar unos 107 kilogramos y alcanzar 6 metros de longitud.
