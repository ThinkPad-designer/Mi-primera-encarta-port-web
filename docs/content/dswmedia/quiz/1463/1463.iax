<?xml version="1.0"?><quiz type="multichoice" id="1463" lang="E" hascredits="1"><question><text>&lt;html&gt;Ningún europeo había cruzado el desierto de Kalahari hasta el siglo XIX. El primero que lo hizo fue uno de los más famosos e importantes exploradores de África. ¿Cuál era su nombre?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Diogo Cam&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Vasco da Gama&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;David Livingstone&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;No se conoce su nombre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;David Livingstone.&lt;br&gt;&lt;br&gt;En 1849, el británico cruzó el desierto de Kalahari, en cuyo límite, en la actual Botsuana, descubrió el lago Ngami.&lt;/html&gt;</text><image w="149" h="133">T011369A.jpg</image><imagerefid>1b822a92</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>