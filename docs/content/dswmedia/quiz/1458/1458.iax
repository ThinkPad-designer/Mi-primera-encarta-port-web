<?xml version="1.0"?><quiz type="multichoice" id="1458" lang="E" hascredits="1"><question><text>&lt;html&gt;En el desierto de Kalahari viven muchas especies de antílopes. ¿Cuál de los siguientes animales &lt;b&gt;no&lt;/b&gt; es un antílope? &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="149" h="149">T040711A.jpg</image><imagerefid>1B825551</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T013912A.jpg</image><imagerefid>1B82329B</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T172706B.jpg</image><imagerefid>25A411BC</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T172711A.jpg</image><imagerefid>25A411C1</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Es una hiena. De hecho, las hienas no solo son carroñeras, ya que también cazan antílopes y otros animales. 
&lt;/html&gt;</text><image w="149" h="99">T172706B.jpg</image><imagerefid>25A411BC</imagerefid><audio/><audiorefid/></reward><credits>/Photo Researchers, Inc./S.R. Maglione&lt;br&gt;&lt;br&gt;/Oxford Scientific Films/Rafi Ben-Shahar&lt;br&gt;&lt;br&gt;/Bruce Coleman, Inc./Martin W. Grosnick&lt;br&gt;&lt;br&gt;/Minden Pictures/Frans Lanting</credits><rewardcredits>/Bruce Coleman, Inc./Martin W. Grosnick</rewardcredits></quiz>