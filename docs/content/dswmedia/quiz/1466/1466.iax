<?xml version="1.0"?><quiz type="multichoice" id="1466" lang="E" hascredits="1"><question><text>&lt;html&gt;El río Okavango discurre por el límite del desierto de Kalahari y se extiende a lo largo de un impresionante delta interior o pantano. A uno de estos animales  &lt;b&gt;no&lt;/b&gt; podrás encontrártelo si visitas el delta del Okavango. ¿A cuál?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="153" h="137">T049814A.jpg</image><imagerefid>1B827544</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="102" h="153">0016feb2.jpg</image><imagerefid>29D320D2</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">001275e5.jpg</image><imagerefid>29D2927C</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T049694A.jpg</image><imagerefid>1B8274D0</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Este animal es un guepardo. El entorno habitual del guepardo es muy distinto al propio de los pantanos. Los guepardos viven en las llanuras abiertas del África tropical.&lt;/html&gt;</text><image w="149" h="99">001275e5.jpg</image><imagerefid>29D2927C</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Mark Hamblin&lt;br&gt;&lt;br&gt;Corbis/Roger Tidman&lt;br&gt;&lt;br&gt;Corbis/David A. Northcott&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Stan Osolinski</credits><rewardcredits>Corbis/David A. Northcott</rewardcredits></quiz>