<?xml version="1.0"?><quiz type="multichoice" id="1651" lang="E" hascredits="1"><question><text>&lt;html&gt;El chileno Marcelo Ríos se mantuvo en un altísimo nivel mundial entre 1994 y 2004. ¿Qué deporte practicaba?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El fútbol&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El tenis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El remo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La halterofilia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El tenis. &lt;br&gt;&lt;br&gt;En 1998, Ríos se convirtió en el primer sudamericano que encabezaba la clasificación de la Asociación de Tenistas Profesionales (ATP).&lt;/html&gt;</text><image w="149" h="132">T285497A.jpg</image><imagerefid>1B829605</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>TempSport/Corbis/Franck Seguin</rewardcredits></quiz>