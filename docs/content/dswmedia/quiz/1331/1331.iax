<?xml version="1.0"?><quiz type="multichoice" id="1331" lang="E" hascredits="1"><question><text>&lt;html&gt;Este faraón gobernó el antiguo Egipto en la segunda mitad del siglo XIV a.C. ¿Cuál era su nombre?&lt;/html&gt;</text><image w="99" h="149">T014547A.jpg</image><imagerefid>1B823463</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Tutuola&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tut Anj Amón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tutaklomin&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tutankimo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tut Anj Amón.&lt;br&gt;&lt;br&gt;También conocido como Tutankamón, Tut Anj Amón no fue en realidad un destacado faraón, pero su popularidad viene dada porque su tumba fue encontrada casi intacta en 1922, junto con sus magníficos tesoros.&lt;/html&gt;</text><image w="99" h="149">T014547A.jpg</image><imagerefid>1B823463</imagerefid><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York</credits><rewardcredits>Bridgeman Art Library, London/New York</rewardcredits></quiz>