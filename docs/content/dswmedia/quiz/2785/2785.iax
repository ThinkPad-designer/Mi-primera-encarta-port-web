<?xml version="1.0"?><quiz type="multichoice" id="2785" lang="E" hascredits="0"><question><text>&lt;html&gt;Le protocole de Kyoto (1997) est&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;un accord sur la limitation des armements nucléaires.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;un accord sur la réduction des émissions de gaz à effet de serre.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Dans le protocole de Kyoto de 1997, 38&#38;nbsp;pays industrialisés ont accepté de réduire, entre 2008 et 2012, leurs émissions de gaz à effet de serre à des niveaux inférieurs de 5&#38;nbsp;% à ceux de 1990. Les États-Unis ont refusé de le ratifier.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>