<?xml version="1.0"?><quiz type="multichoice" id="1297" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánta leche puede dar una vaca al cabo de un año?
&lt;/html&gt;</text><image w="149" h="99">00102c47.jpg</image><imagerefid>29D22CCF</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;2.000 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;6.000 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;9.000 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;13.000 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Unos 6.000 litros. &lt;br&gt;&lt;br&gt;La leche de la vaca también produce unos 240 kg de mantequilla al año.
&lt;/html&gt;</text><image w="149" h="99">00102c47.jpg</image><imagerefid>29D22CCF</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Lester Lefkowitz</credits><rewardcredits>Corbis/Lester Lefkowitz</rewardcredits></quiz>