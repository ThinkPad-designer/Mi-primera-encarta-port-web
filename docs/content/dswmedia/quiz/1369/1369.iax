<?xml version="1.0"?><quiz type="multichoice" id="1369" lang="E" hascredits="1"><question><text>&lt;html&gt;En el sur del curso del río Níger, el paisaje es una peculiar pradera poblada de arbustos y árboles dispersos. ¿Cuál es el nombre de ese ecosistema?
&lt;/html&gt;</text><image w="149" h="132">T040974A.jpg</image><imagerefid>1B825658</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Bosque&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Pantano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sabana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Desierto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sabana.&lt;br&gt;&lt;br&gt;Es el hogar del leopardo, del hipopótamo o del antílope.
&lt;/html&gt;</text><image w="149" h="132">T040974A.jpg</image><imagerefid>1B825658</imagerefid><audio/><audiorefid/></reward><credits>Panos Pictures/David Reed</credits><rewardcredits>Panos Pictures/David Reed</rewardcredits></quiz>