<?xml version="1.0"?><quiz type="multichoice" id="1214" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal, perteneciente a la familia del gato y que habita en las sabanas africanas, hace este rugido?&lt;/html&gt;</text><image/><imagerefid/><audio>T050076B.mp3</audio><audiorefid>1B827648</audiorefid></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El león&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El tigre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El gato de Cheshire&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El puma&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El león.&lt;br&gt;&lt;br&gt;Los leones tienen cuerpos musculosos, con extremidades relativamente cortas, cabezas grandes y garras provistas de uñas. El rugido del león puede ser escuchado desde nueve kilómetros de distancia.
&lt;/html&gt;</text><image w="149" h="149">00157cd9.jpg</image><imagerefid>29D29375</imagerefid><audio>T050076B.mp3</audio><audiorefid>1B827648</audiorefid></reward><credits>Library of Natural Sounds, Cornell Laboratory of Ornithology.  Reservados todos los derechos.</credits><rewardcredits>Corbis/Chase Swift&lt;br&gt;Library of Natural Sounds, Cornell Laboratory of Ornithology.  Reservados todos los derechos.</rewardcredits></quiz>