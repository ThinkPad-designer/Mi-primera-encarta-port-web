<?xml version="1.0"?><quiz type="multichoice" id="1791" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Nicaragua?
&lt;/html&gt;</text><image w="149" h="132">T054853A.jpg</image><imagerefid>1B8285F3</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Puerto Cabezas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Managua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;San Juan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tegucigalpa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Managua.&lt;br&gt;&lt;br&gt;Managua is located on Lake Managua, in western Nicaragua.&lt;/html&gt;</text><image w="149" h="132">T054853A.jpg</image><imagerefid>1B8285F3</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Carl Frank</credits><rewardcredits>Photo Researchers, Inc./Carl Frank</rewardcredits></quiz>