<?xml version="1.0"?><quiz type="multichoice" id="2346" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué compositor escribió &lt;i&gt;Las cuatro estaciones&lt;/i&gt;?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Robert Schumann&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Johannes Brahms&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Antonio Vivaldi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Antonio Vivaldi.&lt;br&gt;&lt;br&gt;Es una obra para orquesta de cuerda con violín solista, y representa el paso de las estaciones.&lt;/html&gt;</text><image w="99" h="149">001ad621.jpg</image><imagerefid>42D9D7B1</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Getty Images/Roger Viollet Collection</rewardcredits></quiz>