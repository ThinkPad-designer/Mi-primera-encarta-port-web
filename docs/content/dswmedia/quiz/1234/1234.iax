<?xml version="1.0"?><quiz type="multichoice" id="1234" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué ave recorre más de 30.000 kilómetros cada año, volando desde el Ártico hasta la Antártida y regresando de nuevo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El colibrí de garganta rubí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El charrán ártico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El chorlito del Pacífico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El albatros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El charrán ártico. &lt;br&gt;&lt;br&gt;Los charranes árticos realizan grandes migraciones. En los treinta años que pueden vivir ¡vuelan más de un millón de kilómetros!
&lt;/html&gt;</text><image w="149" h="99">T050017A.jpg</image><imagerefid>1B82760D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Mark Hamblin</rewardcredits></quiz>