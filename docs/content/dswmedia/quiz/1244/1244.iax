<?xml version="1.0"?><quiz type="multichoice" id="1244" lang="E" hascredits="1"><question><text>&lt;html&gt;No tengo párpados y, por eso, mis ojos están siempre abiertos. ¿Quién soy?
&lt;/html&gt;</text><image w="153" h="102"/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Un caballo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una rana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una serpiente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una tortuga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Una serpiente. &lt;br&gt;&lt;br&gt;Muchos animales tienen párpados móviles que cierran y humedecen los ojos. Las serpientes carecen de párpados móviles y, por eso, sus ojos permanecen constantemente abiertos. 
&lt;/html&gt;</text><image w="149" h="99">00123ecb.jpg</image><imagerefid>29D2653F</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/George McCarthy</rewardcredits></quiz>