<?xml version="1.0"?><quiz type="multichoice" id="1409" lang="E" hascredits="1"><question><text>&lt;html&gt;Es tradicional que a lo largo de la zona que llamamos costa swahili se viaje en  &lt;i&gt;dhow&lt;/i&gt;. ¿Qué es lo que crees que es eso?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Un jeep&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una especie de patines&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una embarcación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un submarino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Una embarcación.&lt;br&gt;&lt;br&gt;Un &lt;i&gt;dhow&lt;/i&gt; es una pequeña embarcación árabe de vela triangular.&lt;/html&gt;</text><image w="149" h="99">T166138A.jpg</image><imagerefid>25A440FB</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Christine Osborne Pictures</rewardcredits></quiz>