<?xml version="1.0"?><quiz type="multichoice" id="1729" lang="E" hascredits="0"><question><text>&lt;html&gt;A narrow waterway separates Europe and Africa at the western end of the Mediterranean Sea. What is the name of this waterway?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;English Channel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Strait of Gibraltar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Strait of Juan de Fuca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Suez Canal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Strait of Gibraltar.&lt;br&gt;&lt;br&gt;The Strait of Gibraltar separates Spain (in Europe) from Morocco (in Africa).
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>