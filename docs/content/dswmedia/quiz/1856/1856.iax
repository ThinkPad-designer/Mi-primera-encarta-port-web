<?xml version="1.0"?><quiz type="multichoice" id="1856" lang="E" hascredits="0"><question><text>&lt;html&gt;El compositor Franz Schubert, a pesar de fallecer muy joven, compuso gran cantidad de obras maestras,  pero de todas ellas destacaron sobre todo:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Los “lieder” o canciones y las piezas para piano, instrumento del que era un gran virtuoso.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los septetos de viento.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las sonatas para instrumentos de percusión.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>