<?xml version="1.0"?><quiz type="multichoice" id="2524" lang="E" hascredits="1"><question><text>&lt;html&gt;De las siguientes óperas, ¿cuáles pertenecen al compositor austriaco Wolfgang Amadeus Mozart?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Las bodas de Fígaro, Don Giovanni, La flauta mágica&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt; La Traviata, Aida, Otello&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;La Bohème, Tosca, Madame Butterfly&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Las bodas de Fígaro, Don Giovanni, La flauta mágica&lt;/i&gt;.&lt;br&gt;&lt;br&gt;Las óperas de Mozart se encuentran entre lo mejor de su producción musical.&lt;/html&gt;</text><image w="149" h="133">T012153A.jpg</image><imagerefid>42D95BA0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>