<?xml version="1.0"?><quiz type="multichoice" id="1216" lang="E" hascredits="1"><question><text>&lt;html&gt;Vivo en los bosques de China y me alimento solo de bambú. ¿Sabes quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El oso tibetano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La cucaracha asiática&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El ciervo chino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El oso panda &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El oso panda. &lt;br&gt;&lt;br&gt;El oso panda es un animal herbívoro que se alimenta casi exclusivamente de bambú.
&lt;/html&gt;</text><image w="99" h="149">T054599A.jpg</image><imagerefid>1B8284F6</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>ALLSTOCK, INC./Art Wolfe</rewardcredits></quiz>