<?xml version="1.0"?><quiz type="multichoice" id="112" lang="E" hascredits="0"><question><text>&lt;html&gt;Durante el romanticismo musical surgió la figura del virtuoso, que se caracterizaba por:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Tocar muchos instrumentos distintos con gran soltura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Dominar a la perfección la técnica de un instrumento determinado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Dedicarse a la composición de piezas musicales muy difíciles de interpretar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Dominar a la perfección la técnica de un instrumento determinado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>