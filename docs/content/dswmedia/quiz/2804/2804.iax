<?xml version="1.0"?><quiz type="multichoice" id="2804" lang="E" hascredits="0"><question><text>&lt;html&gt;L&apos;Asie orientale...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;se définit par l&apos;influence chinoise.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;se caractérise par des densités de population élevées.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;correspond à l&apos;aire d&apos;influence du Japon.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;L&apos;Asie orientale est un espace mal défini. Si le Japon et la Chine y sont les deux États les plus influents, aucun des deux ne peut à lui seul prétendre définir cette région du monde, tant les rivalités sont complexes. L&apos;Asie orientale se caractérise d&apos;abord par son poids démographique et ses densités de population élevées.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>