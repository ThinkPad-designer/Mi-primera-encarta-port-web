<?xml version="1.0"?><quiz type="multichoice" id="2267" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuántos huevos puede poner una abeja reina al día?&lt;/html&gt;</text><image w="149" h="133">T014057A.jpg</image><imagerefid>0C048C4A</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;10&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;100&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;500&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;1.500&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;1.500.&lt;br&gt;&lt;br&gt;La abeja reina es la única mamá de la colmena y puede poner 1.500 huevos al día.&lt;/html&gt;</text><image w="149" h="133">T014057A.jpg</image><imagerefid>0C048C4A</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Larry Crowhurst</credits><rewardcredits>Oxford Scientific Films/Larry Crowhurst</rewardcredits></quiz>