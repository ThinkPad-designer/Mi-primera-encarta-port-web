<?xml version="1.0"?><quiz type="multichoice" id="1269" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal se comporta como una especie de Tarzán pegajoso que desciende de los árboles utilizando una especie de hilo de moco? &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El orangután&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La babosa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La lombriz de tierra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La caracola&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La babosa.&lt;br&gt;&lt;br&gt;Las babosas se alimentan de vegetación y a menudo suben a los árboles en busca de alimento, descendiendo después de ellos por medio de un hilo mucoso segregado por una glándula que se abre en el borde anterior del pie.&lt;/html&gt;</text><image w="149" h="132">T013130A.jpg</image><imagerefid>42D95D11</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Frithjof Skibbe</rewardcredits></quiz>