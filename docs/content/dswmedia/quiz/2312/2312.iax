<?xml version="1.0"?><quiz type="multichoice" id="2312" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de estas zonas no forma parte del intestino grueso?

&lt;/html&gt;</text><image w="149" h="149">001020e8.jpg</image><imagerefid>29D22A25</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Colon ascendente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Recto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Duodeno&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Colon transverso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Duodeno. &lt;br&gt;&lt;br&gt; El duodeno forma parte del intestino delgado. El intestino grueso está formado por el colon ascendente, el colon transverso, el colon descendente y el recto.
&lt;/html&gt;</text><image w="149" h="149">001020e8.jpg</image><imagerefid>29D22A25</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>