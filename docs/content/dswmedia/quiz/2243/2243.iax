<?xml version="1.0"?><quiz type="multichoice" id="2243" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: las arañas son un tipo de insectos.&lt;/html&gt;</text><image w="149" h="132">T025030A.jpg</image><imagerefid>1B82C70E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso.&lt;br&gt;&lt;br&gt;Las arañas son arácnidos, no insectos. Las arañas tienen ocho patas y no tienen antenas ni alas. Por el contrario, los insectos tienen seis patas, dos antenas y, generalmente, cuatro alas.&lt;/html&gt;</text><image w="149" h="132">T025030A.jpg</image><imagerefid>1B82C70E</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>