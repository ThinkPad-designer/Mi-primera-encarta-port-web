<?xml version="1.0"?><quiz type="multichoice" id="1072" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué altura pueden alcanzar las jirafas?
&lt;/html&gt;</text><image w="149" h="99">T172654A.jpg</image><imagerefid>42D957FB</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Un metro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tres metros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Seis metros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Treinta metros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Seis metros. &lt;br&gt;&lt;br&gt;Las jirafas pueden llegar a medir casi seis metros. Tienen patas largas y delgadas y un cuello largo, que les permiten alcanzar las hojas más altas de los árboles. 
&lt;/html&gt;</text><image w="149" h="99">T172654A.jpg</image><imagerefid>42D957FB</imagerefid><audio/><audiorefid/></reward><credits>Minden Pictures/Frans Lanting</credits><rewardcredits>Minden Pictures/Frans Lanting</rewardcredits></quiz>