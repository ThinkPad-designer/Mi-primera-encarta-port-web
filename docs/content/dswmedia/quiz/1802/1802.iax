<?xml version="1.0"?><quiz type="multichoice" id="1802" lang="E" hascredits="1"><question><text>&lt;html&gt;In Central Africa, two capital cities lie across the Congo River from one another. They are Brazzaville and what other capital city?
&lt;/html&gt;</text><image w="99" h="149">182E0.jpg</image><imagerefid>25A49C60</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Khartoum&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kinshasa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Luanda&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lusaka&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Kinshasa.&lt;br&gt;&lt;br&gt;Kinshasa is the capital of the Democratic Republic of the Congo, and Brazzaville is the capital of the Republic of the Congo.
&lt;/html&gt;</text><image w="99" h="149">182E0.jpg</image><imagerefid>25A49C60</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Georg Gerster</credits><rewardcredits>Photo Researchers, Inc./Georg Gerster</rewardcredits></quiz>