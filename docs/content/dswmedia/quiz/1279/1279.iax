<?xml version="1.0"?><quiz type="multichoice" id="1279" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el padre y la madre de la mula?&lt;/html&gt;</text><image w="153" h="136"/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Su padre es un caballo y su madre una vaca.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Su padre es un asno y su madre una yegua.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Su padre es un toro y su madre una yegua.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Su padre es un asno y su madre una cabra.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Su padre es un asno y su madre una yegua.&lt;br&gt;&lt;br&gt;Las mulas se utilizan como animales de carga.
&lt;/html&gt;</text><image w="149" h="133">T013119A.jpg</image><imagerefid>1B823040</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/M.J. Adams</rewardcredits></quiz>