<?xml version="1.0"?><quiz type="multichoice" id="1421" lang="E" hascredits="1"><question><text>&lt;html&gt;Diferentes especies de antílopes viven en el Parque nacional Serengeti. ¿Cuál de las siguientes &lt;b&gt;no&lt;/b&gt; es una especie de antílope?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La gacela&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La cebra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El impala&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El ñu&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La cebra.&lt;br&gt;&lt;br&gt;Los antílopes son mamíferos que pertenecen a la misma familia que las vacas, las cabras y las ovejas. Las cebras también son mamíferos pero pertenecen a la misma familia que los caballos. 
&lt;/html&gt;</text><image w="149" h="99">T790546A.jpg</image><imagerefid>29D292E3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/G.I. Bernard</rewardcredits></quiz>