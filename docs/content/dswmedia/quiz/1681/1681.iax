<?xml version="1.0"?><quiz type="multichoice" id="1681" lang="E" hascredits="1"><question><text>&lt;html&gt;Alexandr Popov fue entre 1991 y 2004 un extraordinario velocista. Rapidísimo, pero ¿en qué deporte?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;En atletismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En natación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En patinaje sobre hielo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En ciclismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En natación.&lt;br&gt;&lt;br&gt;El ruso Alexandr Popov obtuvo 19 medallas de oro individuales en Juegos Olímpicos (4), Campeonatos del Mundo (6) y Campeonatos de Europa (9). 
&lt;/html&gt;</text><image w="149" h="132">T642069A.jpg</image><imagerefid>073FF7C8</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Liaison Agency/J.O. Atlanta 96</rewardcredits></quiz>