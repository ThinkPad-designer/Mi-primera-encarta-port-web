<?xml version="1.0"?><quiz type="multichoice" id="1219" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánto puede llegar a pesar un hipopótamo?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;100 kg&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1.000 kg&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;2.000 kg&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;4.000 kg&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;4.000 kg.&lt;br&gt;&lt;br&gt;El hipopótamo pesa más de 4.000 kilogramos. Es casi lo que pesarían 45 hombres.
&lt;/html&gt;</text><image w="149" h="149">000a60b7.jpg</image><imagerefid>42D8D021</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Courtesy of Pilar Almazán Ceballos</rewardcredits></quiz>