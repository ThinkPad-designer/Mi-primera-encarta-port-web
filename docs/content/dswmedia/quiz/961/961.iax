<?xml version="1.0"?><quiz type="multichoice" id="961" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué resulta peligroso en esta rana de brillante colorido?
&lt;/html&gt;</text><image w="153" h="136">T038940A.jpg</image><imagerefid>1B824E93</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Sus patadas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Su mordedura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Su veneno&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Su horrible canto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Su veneno. &lt;br&gt;&lt;br&gt;La rana tiene un poderoso veneno en la piel. Si un animal come una de estas ranitas, puede quedar paralizado o, incluso, morir en el acto.&lt;/html&gt;</text><image w="153" h="136">T038940A.jpg</image><imagerefid>1B824E93</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./A. Kerstitch</credits><rewardcredits>Bruce Coleman, Inc./A. Kerstitch</rewardcredits></quiz>