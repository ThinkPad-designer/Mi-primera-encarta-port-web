<?xml version="1.0"?><quiz type="multichoice" id="848" lang="E" hascredits="1"><question><text>&lt;html&gt;En el intestino grueso hay un pequeño saquito que no realiza ninguna función, pero que si se infecta puede producir problemas graves. ¿Sabes a qué nos referimos?
&lt;/html&gt;</text><image w="153" h="102">T530451A.jpg</image><imagerefid>1B829F07</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Vesícula biliar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bazo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Páncreas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Apéndice&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Apéndice. &lt;br&gt;&lt;br&gt;Cuando el apéndice se infecta se produce una apendicitis. En muchos casos es necesario extirpar el apéndice mediante cirugía.
&lt;/html&gt;</text><image w="153" h="102">T530451A.jpg</image><imagerefid>1B829F07</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>