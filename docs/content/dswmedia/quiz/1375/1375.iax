<?xml version="1.0"?><quiz type="multichoice" id="1375" lang="E" hascredits="1"><question><text>&lt;html&gt;El puerto de Dakar está en la costa occidental de África. Verdadero o falso: Dakar es el punto geográfico más occidental del continente africano.
&lt;/html&gt;</text><image w="149" h="132">T026066A.jpg</image><imagerefid>1B82391A</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero.&lt;br&gt;&lt;br&gt;Dakar está situada en Cabo Verde, una península que sobresale y se interna ligeramente en el océano Atlántico hasta convertirse en el extremo occidental del continente africano.
&lt;/html&gt;</text><image w="149" h="132">T026066A.jpg</image><imagerefid>1B82391A</imagerefid><audio/><audiorefid/></reward><credits>Panos Pictures/Ron Giling</credits><rewardcredits>Panos Pictures/Ron Giling</rewardcredits></quiz>