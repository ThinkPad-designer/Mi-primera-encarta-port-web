<?xml version="1.0"?><quiz type="multichoice" id="1310" lang="E" hascredits="1"><question><text>&lt;html&gt;El arte de criar conejos para aprovechar su carne y su pelo se llama...&lt;/html&gt;</text><image w="149" h="132">T240444A.jpg</image><imagerefid>1B829313</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Cunicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Agricultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Avicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Piscicultura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cunicultura.&lt;br&gt;&lt;br&gt;La cría de conejos recibe el nombre de cunicultura. El conejo se cría para obtener su carne, su pelo y su piel.&lt;/html&gt;</text><image w="149" h="132">T240444A.jpg</image><imagerefid>1B829313</imagerefid><audio/><audiorefid/></reward><credits>PHOTOLIBRARY GROUP LTD</credits><rewardcredits>PHOTOLIBRARY GROUP LTD</rewardcredits></quiz>