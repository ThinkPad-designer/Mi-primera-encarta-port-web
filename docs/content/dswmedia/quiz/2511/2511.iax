<?xml version="1.0"?><quiz type="multichoice" id="2511" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes compositores se lesionó por culpa de un aparato que construyó para fortalecer el dedo anular y tocar mejor el piano?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Robert Schumann&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Wolfgang Amadeus Mozart&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Franz Liszt&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Robert Schumann.&lt;br&gt;&lt;br&gt;El dedo anular es el más difícil de trabajar y ejercitar para los pianistas, y tiene mucha menos fuerza que el resto.
&lt;/html&gt;</text><image w="149" h="132">T642009A.jpg</image><imagerefid>1B82B342</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Hulton-Deutsch Collection</rewardcredits></quiz>