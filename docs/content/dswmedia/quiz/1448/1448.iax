<?xml version="1.0"?><quiz type="multichoice" id="1448" lang="E" hascredits="1"><question><text>&lt;html&gt;Madagascar es conocida entre otras cosas por sus distintos tipos de lémures. ¿Cuál de estos simios &lt;b&gt;no&lt;/b&gt; es un lémur?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="102" h="153">T628215A.jpg</image><imagerefid>29D32169</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="153" h="136">T025666A.jpg</image><imagerefid>1B8237D5</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="102" h="153">T172624A.jpg</image><imagerefid>25A4117B</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="102" h="153">T044528A.jpg</image><imagerefid>1B826222</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Este es un mono capuchino. Los monos capuchinos, también llamados frailecillos, machines o caís, viven en los bosques tropicales de Centroamérica y Sudamérica.&lt;/html&gt;</text><image w="153" h="136">T025666A.jpg</image><imagerefid>1B8237D5</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Howard Uible&lt;br&gt;&lt;br&gt;Dorling Kindersley/Jerry Young&lt;br&gt;&lt;br&gt;Peter Arnold, Inc./David Haring&lt;br&gt;&lt;br&gt;Minden Pictures/Frans Lanting</credits><rewardcredits>Dorling Kindersley/Jerry Young</rewardcredits></quiz>