<?xml version="1.0"?><quiz type="multichoice" id="843" lang="E" hascredits="1"><question><text>&lt;html&gt;¿En qué órgano se produce la bilis?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Vesícula biliar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hígado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hígado. &lt;br&gt;&lt;br&gt;La bilis es un líquido amarillo verdoso que produce el hígado y que se almacena en la vesícula biliar. Después, pasa al intestino delgado donde participa en la digestión y absorción de las grasas.&lt;/html&gt;</text><image w="153" h="153">00077616.jpg</image><imagerefid>29D02598</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>