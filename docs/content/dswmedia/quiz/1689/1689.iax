<?xml version="1.0"?><quiz type="multichoice" id="1689" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the tallest mountain in South America?
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Aconcagua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cotopaxi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ojos del Salado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mount Fuji&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Aconcagua. &lt;br&gt;&lt;br&gt;Located in western Argentina, in the Andes Mountains, Aconcagua is 22,834 feet (6,960 meters) tall.
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></reward><credits>Redux Pictures/Miquel Gonzalez/laif</credits><rewardcredits>Redux Pictures/Miquel Gonzalez/laif</rewardcredits></quiz>