<?xml version="1.0"?><quiz type="multichoice" id="1724" lang="E" hascredits="1"><question><text>&lt;html&gt;The largest desert in the world is located in Africa. What is its name?&lt;/html&gt;</text><image w="149" h="99">T167031A.jpg</image><imagerefid>25A407A7</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Gobi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kalahari&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Namib&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sahara&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sahara.&lt;br&gt;&lt;br&gt;The desert extends across most of North Africa, covering parts of ten countries.
&lt;/html&gt;</text><image w="149" h="99">T167031A.jpg</image><imagerefid>25A407A7</imagerefid><audio/><audiorefid/></reward><credits>eStock Photo/Fridmar Damm</credits><rewardcredits>eStock Photo/Fridmar Damm</rewardcredits></quiz>