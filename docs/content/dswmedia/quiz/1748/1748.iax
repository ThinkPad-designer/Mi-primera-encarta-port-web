<?xml version="1.0"?><quiz type="multichoice" id="1748" lang="E" hascredits="1"><question><text>&lt;html&gt;What  country has the largest population in North America?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Canada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mexico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Guatemala&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;United States.&lt;br&gt;&lt;br&gt;The United States population is more than twice that of Canada and Mexico combined.
&lt;/html&gt;</text><image w="149" h="149">00123d8b.jpg</image><imagerefid>29D264A4</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>