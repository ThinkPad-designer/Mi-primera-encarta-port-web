<?xml version="1.0"?><quiz type="multichoice" id="1714" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the largest lake in South America?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Lago Llanquihue (Chile)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Laguna Mar Chiquita (Argentina)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Maracaibo (Venezuela)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Titicaca (Peru/Bolivia)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Maracaibo (Venezuela).&lt;br&gt;&lt;br&gt;Located in Venezuela, Lake Maracaibo is the largest lake in South America, covering 5,140 square miles (13,300 square kilometers).
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>