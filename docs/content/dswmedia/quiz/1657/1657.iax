<?xml version="1.0"?><quiz type="multichoice" id="1657" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de los siguientes equipos no ha ganado nunca la Copa Libertadores?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El Peñarol de Montevideo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El Bayern de Munich&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El Gremio de Porto Alegre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El Once Caldas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El Bayern de Munich. &lt;br&gt;&lt;br&gt;Peñarol, Gremio y Once Caldas han ganado en alguna ocasión la Copa Libertadores de fútbol. El Bayern de Munich lo tiene más difícil, ya que es un equipo alemán... y ese torneo solo lo disputan clubes sudamericanos.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>