<?xml version="1.0"?><quiz type="multichoice" id="1309" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales &lt;b&gt;no&lt;/b&gt; pertenece a la familia del caballo?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La cebra&lt;/html&gt;</text><image w="149" h="99">T790546A.jpg</image><imagerefid>29D292E3</imagerefid><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El antílope Áddax&lt;/html&gt;</text><image w="149" h="132">T046945A.jpg</image><imagerefid>1B826AFA</imagerefid><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El mustang&lt;/html&gt;</text><image w="149" h="132">T040713A.jpg</image><imagerefid>1B825553</imagerefid><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El asno&lt;/html&gt;</text><image w="153" h="102">T172847A.jpg</image><imagerefid>25A4122D</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El antílope Áddax. &lt;br&gt;&lt;br&gt;La familia del caballo incluye a los caballos, las cebras y los asnos. El Áddax es un tipo de antílope, un grupo de mamíferos que pertenecen a la misma familia que las cabras y las ovejas.&lt;/html&gt;</text><image w="149" h="132">T046945A.jpg</image><imagerefid>1B826AFA</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/G.I. Bernard&lt;br&gt;&lt;br&gt;Bruce Coleman, Inc./J.C. Carton&lt;br&gt;&lt;br&gt;Animals Animals/Momatiuk-Eastcott&lt;br&gt;&lt;br&gt;Peter Arnold, Inc./Douglas T. Cheeseman Jr.</credits><rewardcredits>Bruce Coleman, Inc./J.C. Carton</rewardcredits></quiz>