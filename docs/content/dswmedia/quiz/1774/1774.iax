<?xml version="1.0"?><quiz type="multichoice" id="1774" lang="E" hascredits="0"><question><text>&lt;html&gt;Which of the following is &lt;b&gt;not&lt;/b&gt; an independent Pacific Island nation?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Fiji Islands&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Guam&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Samoa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tuvalu&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Guam.&lt;br&gt;&lt;br&gt;Guam is a Pacific Ocean territory of the United States. The Fiji Islands, Samoa, and Tuvalu are all independent Pacific Island nations. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>