<?xml version="1.0"?><quiz type="multichoice" id="1207" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un animal salvaje que vive en grupos o manadas. Mis rugidos pueden oírse a 9 km de distancia. ¿Sabes quién soy?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Un elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un loro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un león&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un león. &lt;br&gt;&lt;br&gt;Mi tamaño y mi fuerza han hecho que también se me conozca como ‘el rey de la selva’.
&lt;/html&gt;</text><image w="149" h="149">00157cd9.jpg</image><imagerefid>29D29375</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Chase Swift</rewardcredits></quiz>