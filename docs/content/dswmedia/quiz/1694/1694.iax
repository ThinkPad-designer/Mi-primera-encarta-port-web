<?xml version="1.0"?><quiz type="multichoice" id="1694" lang="E" hascredits="1"><question><text>&lt;html&gt;How tall is Mount Everest, the tallest mountain in Asia (and the world)?&lt;/html&gt;</text><image w="153" h="136">T026311A.jpg</image><imagerefid>42D966E9</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;24,599 feet (7,498 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;26,810 feet (8,172 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;29,035 feet (8,850 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;31,611 feet (9,635 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;29,035 feet (8,850 meters). &lt;br&gt;&lt;br&gt;That’s five and a half miles tall!&lt;/html&gt;</text><image w="153" h="136">T026311A.jpg</image><imagerefid>42D966E9</imagerefid><audio/><audiorefid/></reward><credits>Tony Stone Images/Keren Su</credits><rewardcredits>Tony Stone Images/Keren Su</rewardcredits></quiz>