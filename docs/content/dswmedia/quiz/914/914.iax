<?xml version="1.0"?><quiz type="multichoice" id="914" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes no es una parte del encéfalo?
&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Cerebelo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cerebro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tiroides&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tronco cerebral&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tiroides. &lt;br&gt;&lt;br&gt;El encéfalo esta formado por el cerebro, el cerebelo y el tronco cerebral. El tiroides es una glándula que está en el cuello y que produce las hormonas tiroideas.
&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/London Scientific Films</credits><rewardcredits>Oxford Scientific Films/London Scientific Films</rewardcredits></quiz>