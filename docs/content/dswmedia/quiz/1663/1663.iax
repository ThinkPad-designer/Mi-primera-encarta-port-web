<?xml version="1.0"?><quiz type="multichoice" id="1663" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: el snowboard es un deporte olímpico.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero. &lt;br&gt;&lt;br&gt;El snowboard fue por primera vez deporte oficial en los Juegos Olímpicos de Invierno de 1998, celebrados en la ciudad japonesa de Nagano.&lt;/html&gt;</text><image w="99" h="149">001aca3c.jpg</image><imagerefid>42D9D7D7</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Getty Images/Donald Miralle</rewardcredits></quiz>