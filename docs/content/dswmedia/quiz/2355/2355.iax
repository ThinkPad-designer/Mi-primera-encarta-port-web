<?xml version="1.0"?><quiz type="multichoice" id="2355" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama el instrumento utilizado por los médicos para escuchar el latido del corazón y otros sonidos del interior de tu cuerpo?&lt;/html&gt;</text><image w="149" h="149">T050434A.jpg</image><imagerefid>1B8277AA</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Auriculares&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Fonendoscopio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Laparoscopio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Oftalmoscopio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Fonendoscopio. &lt;br&gt;&lt;br&gt;El &lt;b&gt;fonendoscopio&lt;/b&gt; es un instrumento médico que se utiliza para escuchar el latido del corazón, la respiración y otros sonidos del organismo. Esta herramienta ayuda a los profesionales de la salud a detectar enfermedades.&lt;/html&gt;</text><image w="149" h="149">T050434A.jpg</image><imagerefid>1B8277AA</imagerefid><audio/><audiorefid/></reward><credits>Phototake NYC/Herbert Wagner</credits><rewardcredits>Phototake NYC/Herbert Wagner</rewardcredits></quiz>