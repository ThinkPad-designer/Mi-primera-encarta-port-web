<?xml version="1.0"?><quiz type="multichoice" id="2807" lang="E" hascredits="0"><question><text>&lt;html&gt;L&apos;Asie orientale rassemble environ&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;la moitié de l&apos;humanité.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;un quart de l&apos;humanité.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;un dixième de l&apos;humanité.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Avec environ 1,5&#38;nbsp;milliard d&apos;habitants (Chine, Taïwan, Corée du Sud, Japon, Singapour, etc.), l&apos;Asie orientale rassemble environ un quart de l&apos;humanité.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>