<?xml version="1.0"?><quiz type="multichoice" id="904" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el riesgo de consumir carne o leche que se ha dejado fuera de la nevera?
&lt;/html&gt;</text><image w="149" h="149">T013232A.jpg</image><imagerefid>1B82309A</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Alimentos con mal sabor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Enfermedad leve&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Enfermedad grave&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Todas las respuestas anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Todas las respuestas anteriores. &lt;br&gt;&lt;br&gt;Los alimentos  no refrigerados se contaminan con facilidad con gérmenes que pueden producir enfermedades. La carne y los productos lácteos se deben guardar en la nevera.
&#9;&lt;/html&gt;</text><image w="149" h="149"/><imagerefid/><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York</credits><rewardcredits/></quiz>