<?xml version="1.0"?><quiz type="multichoice" id="2332" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuántas líneas tiene un pentagrama?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;5&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;6&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;4&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;5.&lt;br&gt;&lt;br&gt;La palabra pentagrama tiene su origen en los términos griegos &lt;i&gt;penta&lt;/i&gt;, que significa &apos;cinco&apos;, y &lt;i&gt;grama&lt;/i&gt;, que significa &apos;registro&apos;.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>