<?xml version="1.0"?><quiz type="multichoice" id="1692" lang="E" hascredits="1"><question><text>&lt;html&gt;How tall is Mount El’brus, the tallest mountain in Europe?
&lt;/html&gt;</text><image w="153" h="136">T027992A.jpg</image><imagerefid>29D2BC1B</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;12,457 feet (3,797 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;15,771 feet (4,807 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;18,510 feet (5,642 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;20,320 feet (6,194 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;18,510 feet (5,642 meters). &lt;br&gt;&lt;br&gt;Mount El’brus is located in southwestern Russia, in the Caucasus Mountains.
&lt;/html&gt;</text><image w="153" h="136">T027992A.jpg</image><imagerefid>29D2BC1B</imagerefid><audio/><audiorefid/></reward><credits>National Geographic Society/Dean Conger</credits><rewardcredits>National Geographic Society/Dean Conger</rewardcredits></quiz>