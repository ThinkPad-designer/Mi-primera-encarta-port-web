<?xml version="1.0"?><quiz type="multichoice" id="1846" lang="E" hascredits="0"><question><text>&lt;html&gt;A continuación aparecen ordenadas cronológicamente, de más antigua a más moderna,  4 épocas históricas fundamentales en el desarrollo de la historia de la música occidental. ¿Cuál de las opciones es la correcta?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Clasicismo, Renacimiento, Barroco y Romanticismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Renacimiento, Barroco, Clasicismo y Romanticismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Romanticismo, Clasicismo, Barroco y Renacimiento.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Renacimiento, Barroco, Clasicismo y Romanticismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>