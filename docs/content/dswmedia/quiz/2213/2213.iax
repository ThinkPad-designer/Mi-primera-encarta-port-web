<?xml version="1.0"?><quiz type="multichoice" id="2213" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué hace el erizo cuándo se siente amenazado?&lt;/html&gt;</text><image w="149" h="132">T047233A.jpg</image><imagerefid>1B826C01</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Lanza sus espinas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Muerde&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hace una bola con su cuerpo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Se esconde bajo tierra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hace una bola con su cuerpo.&lt;br&gt;&lt;br&gt;Cuando se siente amenazado el erizo se contrae hasta parecer una pelota. En esta posición, las espinas están dirigidas en todas direcciones constituyendo una protección eficaz.&lt;/html&gt;</text><image w="149" h="132">T047233A.jpg</image><imagerefid>1B826C01</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Robert Maier</credits><rewardcredits>Animals Animals/Robert Maier</rewardcredits></quiz>