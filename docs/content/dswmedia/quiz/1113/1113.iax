<?xml version="1.0"?><quiz type="multichoice" id="1113" lang="E" hascredits="1"><question><text>&lt;html&gt;This mountain range in North America forms part of the Continental Divide, which separates rivers draining into the Atlantic or Arctic oceans from those flowing toward the Pacific Ocean. What is it?
&lt;/html&gt;</text><image w="149" h="132">T000075A.jpg</image><imagerefid>1B821B61</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Appalachians&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Rockies&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cascades &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Andes &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Rockies. &lt;br&gt;&lt;br&gt;The Rocky Mountains extend from central New Mexico to northeastern British Columbia in Canada, a distance of about 2,000 miles (3,220 kilometers). 
&lt;/html&gt;</text><image w="149" h="132">T000075A.jpg</image><imagerefid>1B821B61</imagerefid><audio/><audiorefid/></reward><credits>National Park Service</credits><rewardcredits>National Park Service</rewardcredits></quiz>