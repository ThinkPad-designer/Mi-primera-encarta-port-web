<?xml version="1.0"?><quiz type="multichoice" id="1840" lang="E" hascredits="0"><question><text>&lt;html&gt;Cuando vamos a una ópera sabemos que nos vamos a encontrar:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Un grupo de rock que actúa junto con un coro.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una representación teatral con cantantes y una orquesta.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un cantante acompañado de un pianista.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>