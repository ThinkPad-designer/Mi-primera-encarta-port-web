<?xml version="1.0"?><quiz type="multichoice" id="1793" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Norway?
&lt;/html&gt;</text><image w="149" h="132">T001046B.jpg</image><imagerefid>1B821F2A</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Copenhagen&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Helsinki&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Oslo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Stockholm&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Oslo.&lt;br&gt;&lt;br&gt;Oslo is located in southeastern Norway.
&lt;/html&gt;</text><image w="149" h="132">T001046B.jpg</image><imagerefid>1B821F2A</imagerefid><audio/><audiorefid/></reward><credits>Robert Harding Picture Library/Richard G. Elliott</credits><rewardcredits>Robert Harding Picture Library/Richard G. Elliott</rewardcredits></quiz>