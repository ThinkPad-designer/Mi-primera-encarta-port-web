<?xml version="1.0"?><quiz type="multichoice" id="2265" lang="E" hascredits="1"><question><text>&lt;html&gt;El cangrejo ermitaño vive dentro de…&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Una concha&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un coco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una cabaña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un agujero subterráneo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Una concha.&lt;br&gt;&lt;br&gt;Los cangrejos ermitaños viven en el interior de las conchas de otros animales. A medida que crecen, tienen que cambiar de concha.&lt;/html&gt;</text><image w="149" h="132">T025194A.jpg</image><imagerefid>1B823650</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>