<?xml version="1.0"?><quiz type="multichoice" id="2797" lang="E" hascredits="0"><question><text>&lt;html&gt;L&apos;Europe rhénane correspond à&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;la dorsale européenne.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;la vallée du Rhin.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;une partie de la dorsale européenne.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 3.&lt;br&gt;&lt;br&gt;L&apos;Europe rhénane constitue la partie centrale de la dorsale européenne. Au nord se trouve la région de Londres et au sud l&apos;Italie du Nord. Ainsi, l&apos;Europe rhénane est un axe majeur de l&apos;Europe, qui déborde largement de la seule vallée du Rhin.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>