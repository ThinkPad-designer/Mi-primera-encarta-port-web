<?xml version="1.0"?><quiz type="multichoice" id="1327" lang="E" hascredits="1"><question><text>&lt;html&gt;Una de estas ciudades fue durante siglos capital del antiguo Egipto. ¿Sabrías decir cuál?&lt;/html&gt;</text><image w="153" h="136">T235275A.jpg</image><imagerefid>42D96B5E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El Cairo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tebas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Atenas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Jerusalén&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tebas.&lt;br&gt;&lt;br&gt;La que fuera capital egipcia durante decenas de años en la edad antigua, estaba situada a uno y otro lado del Nilo, a unos 700 km de la actual ciudad de El Cairo.&lt;/html&gt;</text><image w="153" h="136">T235275A.jpg</image><imagerefid>42D96B5E</imagerefid><audio/><audiorefid/></reward><credits>Leo de Wys, Inc./John Hicks</credits><rewardcredits>Leo de Wys, Inc./John Hicks</rewardcredits></quiz>