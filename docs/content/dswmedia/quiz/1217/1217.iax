<?xml version="1.0"?><quiz type="multichoice" id="1217" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal hace este sonido?&lt;/html&gt;</text><image/><imagerefid/><audio>05341.mp3</audio><audiorefid>25A41E42</audiorefid></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La hiena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cerdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El lobo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El gato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El lobo. &lt;br&gt;&lt;br&gt;Los lobos aúllan para comunicarse con otros lobos, delimitar su territorio o manifestar su alegría.
&lt;/html&gt;</text><image w="149" h="149">T050053A.jpg</image><imagerefid>1B827631</imagerefid><audio>05341.mp3</audio><audiorefid>25A41E42</audiorefid></reward><credits>BBC Natural History Sound Library. Reservados todos los derechos.</credits><rewardcredits>Oxford Scientific Films/F. Schneidermeyer&lt;br&gt;BBC Natural History Sound Library. Reservados todos los derechos.</rewardcredits></quiz>