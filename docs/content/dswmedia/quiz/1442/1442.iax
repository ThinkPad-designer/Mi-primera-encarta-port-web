<?xml version="1.0"?><quiz type="multichoice" id="1442" lang="E" hascredits="0"><question><text>&lt;html&gt;Madagascar es la cuarta isla más grande del mundo. ¿Cuál de las siguientes islas es más pequeña que Madagascar?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Groenlandia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gran Bretaña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Borneo &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Nueva Guinea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Gran Bretaña.&lt;br&gt;&lt;br&gt;De mayor a menor, las cuatro islas más grandes del mundo son Groenlandia, Nueva Guinea, Borneo y Madagascar. La quinta es Tierra de Baffin.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>