<?xml version="1.0"?><quiz type="multichoice" id="1286" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes aves es un pavo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="99" h="149">T289150A.jpg</image><imagerefid>42D95D54</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="99" h="149">T291846A.jpg</image><imagerefid>0C04779C</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T049952B.jpg</image><imagerefid>1B8275CC</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="148">T050031A.jpg</image><imagerefid>1B82761B</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los pavos se han criado extensamente debido a la excelente calidad de su carne y sus huevos.&lt;/html&gt;</text><image w="149" h="148">T050031A.jpg</image><imagerefid>1B82761B</imagerefid><audio/><audiorefid/></reward><credits>Rosa Elena Gómez de la Tone&lt;br&gt;&lt;br&gt;Corbis/Hans Dieter Brandl/Frank Lane Picture Agency&lt;br&gt;&lt;br&gt;Photo Researchers, Inc./Anthony Mercieca&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Judd Cooney</credits><rewardcredits>Oxford Scientific Films/Judd Cooney</rewardcredits></quiz>