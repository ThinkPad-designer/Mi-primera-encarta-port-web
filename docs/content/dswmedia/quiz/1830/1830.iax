<?xml version="1.0"?><quiz type="multichoice" id="1830" lang="E" hascredits="1"><question><text>&lt;html&gt;True or False: People live at the South Pole year-round.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;Amundsen-Scott Station is located at the South Pole, and a small number of people work there all year.
&lt;/html&gt;</text><image w="153" h="153">T038225A.jpg</image><imagerefid>25A403F3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Dr. David Millar</rewardcredits></quiz>