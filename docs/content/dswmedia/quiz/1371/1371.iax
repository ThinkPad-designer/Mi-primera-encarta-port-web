<?xml version="1.0"?><quiz type="multichoice" id="1371" lang="E" hascredits="1"><question><text>&lt;html&gt;La región del occidente de África situada entre el árido Sahara y las húmedas zonas tropicales meridionales recibe el nombre de Sahel. Esta región cada vez es más similar al vecino Sahara a causa de un proceso llamado...&lt;/html&gt;</text><image w="149" h="132">t029516a.jpg</image><imagerefid>1B824140</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Defenestración&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Desalinización&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Desertización&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Determinación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Desertización.&lt;br&gt;&lt;br&gt;Este fenómeno supone la degradación de las tierras en determinadas zonas secas, a causa sobre todo de la acción de los seres humanos.
