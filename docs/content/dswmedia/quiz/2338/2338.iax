<?xml version="1.0"?><quiz type="multichoice" id="2338" lang="E" hascredits="1"><question><text>&lt;html&gt;El violín es un instrumento:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;De cuerda frotada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De percusión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De viento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De cuerda frotada.&lt;br&gt;&lt;br&gt;Otros instrumentos de este tipo son la viola, el violonchelo y el contrabajo. En determinadas ocasiones, también se pulsan con los dedos si la pieza lo requiere.&lt;/html&gt;</text><image w="99" h="149">T025455B.jpg</image><imagerefid>1B82E9B0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>