<?xml version="1.0"?><quiz type="multichoice" id="2244" lang="E" hascredits="1"><question><text>&lt;html&gt;La viuda negra es una…&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Araña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Babosa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Caracola&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mosca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Araña.&lt;br&gt;&lt;br&gt;La viuda negra es una araña muy venenosa. Su veneno es 15 veces más potente que el de la serpiente de cascabel.&lt;/html&gt;</text><image w="99" h="149">T288058A.jpg</image><imagerefid>42D96D2D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/UPI</rewardcredits></quiz>