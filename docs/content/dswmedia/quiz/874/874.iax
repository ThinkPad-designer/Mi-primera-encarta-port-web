<?xml version="1.0"?><quiz type="multichoice" id="874" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué células de la sangre atacan y destruyen los gérmenes?
&lt;/html&gt;</text><image w="149" h="132">T027833A.jpg</image><imagerefid>1B823ABE</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Glóbulos rojos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Glóbulos blancos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Plasma&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Plaquetas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los glóbulos blancos. &lt;br&gt;&lt;br&gt;La función de los glóbulos blancos, también llamados leucocitos, es defendernos contra las infecciones.


