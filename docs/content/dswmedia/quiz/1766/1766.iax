<?xml version="1.0"?><quiz type="multichoice" id="1766" lang="E" hascredits="1"><question><text>&lt;html&gt;What African country is connected to Asia?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Egypt&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Libya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Morocco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sudan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Egypt.&lt;br&gt;&lt;br&gt;Egypt’s Sinai Peninsula serves as a land bridge between Africa and Asia.
