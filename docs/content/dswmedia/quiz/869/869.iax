<?xml version="1.0"?><quiz type="multichoice" id="869" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué científico del siglo diecinueve desarrolló la teoría de que los gérmenes eran la causa de las enfermedades infecciosas?
&lt;/html&gt;</text><image w="149" h="132">T012002A.jpg</image><imagerefid>42D959DA</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Albert Einstein&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Louis Pasteur&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Benjamin Spock&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Robert Koch&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Louis Pasteur. &lt;br&gt;&lt;br&gt;Pasteur descubrió que los gérmenes, como las bacterias, eran la causa de muchas enfermedades. Este descubrimiento condujo al desarrollo de los antibióticos y de otros medicamentos.
&lt;/html&gt;</text><image w="149" h="132">T012002A.jpg</image><imagerefid>42D959DA</imagerefid><audio/><audiorefid/></reward><credits>Culver Pictures</credits><rewardcredits>Culver Pictures</rewardcredits></quiz>