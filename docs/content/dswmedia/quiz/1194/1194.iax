<?xml version="1.0"?><quiz type="multichoice" id="1194" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué aves son capaces de imitar la voz humana?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Los flamencos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los loros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los colibríes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las avutardas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los loros.&lt;br&gt;&lt;br&gt;La capacidad de muchos loros para imitar la voz humana y otros sonidos es uno de los motivos de su popularidad como mascotas.&lt;/html&gt;</text><image w="149" h="99">T172786A.jpg</image><imagerefid>25A411FF</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Minden Pictures/Frans Lanting</rewardcredits></quiz>