<?xml version="1.0"?><quiz type="multichoice" id="2256" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De qué se alimenta este cangrejo?&lt;/html&gt;</text><image w="149" h="132">T048087A.jpg</image><imagerefid>1B826F26</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;De cocos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De gusanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De insectos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De madera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El cangrejo de los cocoteros se alimenta de cocos. Trepa a los cocoteros para arrancar los cocos y los rompe con sus gigantescas pinzas.&lt;/html&gt;</text><image w="149" h="132">T048087A.jpg</image><imagerefid>1B826F26</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Keith Gillett</credits><rewardcredits>Animals Animals/Keith Gillett</rewardcredits></quiz>