<?xml version="1.0"?><quiz type="multichoice" id="1197" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál fue el primer animal que viajó al espacio?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Un perro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un gato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un mono&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un periquito&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un perro. &lt;br&gt;&lt;br&gt;El primer viajero del espacio fue una perrita que se llamaba Laika. Fue lanzada en un satélite espacial el 3 de noviembre de 1957.
&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>