<?xml version="1.0"?><quiz type="multichoice" id="1397" lang="E" hascredits="0"><question><text>&lt;html&gt;Si te encuentras en el límite septentrional de la costa swahili, en la punta del llamado Cuerno de África ¿a qué país has llegado?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;A Etiopía&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;A Somalia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;A Uganda&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;A Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A Somalia.&lt;br&gt;&lt;br&gt;Ese hermoso país africano y costero sufrió a finales del siglo XX una cruenta guerra civil.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>