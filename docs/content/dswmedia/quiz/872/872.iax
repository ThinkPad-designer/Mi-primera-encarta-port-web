<?xml version="1.0"?><quiz type="multichoice" id="872" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué son las arterias, las venas y los capilares?

&lt;/html&gt;</text><image w="149" h="149">0010256c.jpg</image><imagerefid>29D22C2E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Músculos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Huesos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Vasos sanguíneos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Células nerviosas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Vasos sanguíneos. &lt;br&gt;&lt;br&gt;Las arterias, las venas y los capilares conducen la sangre por todos los tejidos de tu organismo.
&lt;/html&gt;</text><image w="149" h="149">0010256c.jpg</image><imagerefid>29D22C2E</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>