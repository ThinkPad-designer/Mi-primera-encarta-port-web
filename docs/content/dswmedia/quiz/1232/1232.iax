<?xml version="1.0"?><quiz type="multichoice" id="1232" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el ave más grande?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El colibrí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El águila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El pingüino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El avestruz. &lt;br&gt;&lt;br&gt;Los avestruces pueden alcanzar 2,4 metros de altura y un peso de 136 kilogramos.&lt;/html&gt;</text><image w="149" h="99">06A4F.jpg</image><imagerefid>25A41E8D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tony Stone Images/Paul Kenward</rewardcredits></quiz>