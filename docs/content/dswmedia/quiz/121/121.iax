<?xml version="1.0"?><quiz type="multichoice" id="121" lang="E" hascredits="0"><question><text>&lt;html&gt;Cuando se quiere escribir música, se necesita un tipo de hojas especiales donde se colocan las notas musicales y otros símbolos. Este tipo de hojas se llama:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Papel alineado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Papel pautado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Papel clavificado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Papel pautado
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>