<?xml version="1.0"?><quiz type="multichoice" id="1211" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un animal terrestre, grande y pesado, de cuerpo robusto y patas cortas. Mi vista no es muy buena y no puedo ver a una persona situada a 30 metros delante de mí. ¿Sabes quién soy?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La tortuga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El rinoceronte&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La jirafa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El rinoceronte. &lt;br&gt;&lt;br&gt;Mi vista no es muy buena. Sin embargo, tengo un olfato y un oído excelentes.&lt;/html&gt;</text><image w="149" h="99">T790543A.jpg</image><imagerefid>1B82B497</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Masterfile/Louise Murray</rewardcredits></quiz>