<?xml version="1.0"?><quiz type="multichoice" id="898" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Sabes qué ocurre cuando tu estómago expulsa gas hacia tu esófago? 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Vomitas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Eructas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tienes hipo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Explotas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Eructas. &lt;br&gt;&lt;br&gt;Cuando después de comer o beber hay mucho gas en tu estómago, este lo expulsa hacia el esófago y sale por la boca produciendo un ruido característico, el eructo. ¡Ya sabes, trata de eructar lo más silenciosamente que puedas!
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>