<?xml version="1.0"?><quiz type="multichoice" id="1464" lang="E" hascredits="0"><question><text>&lt;html&gt;El río Okavango discurre por el límite del desierto de Kalahari antes de finalizar bruscamente su recorrido. Entonces, ¿dónde van a parar sus aguas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Se canalizan hasta las granjas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Se filtran y evaporan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sigue siendo todavía hoy un misterio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Se filtran y evaporan.&lt;br&gt;&lt;br&gt;El Okavango, que fluye por Botsuana, no desemboca ni en el mar ni en otro río... Lo hace en un lugar desértico donde pierde el agua por infiltración y evaporación.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>