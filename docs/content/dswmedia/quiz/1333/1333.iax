<?xml version="1.0"?><quiz type="multichoice" id="1333" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de las siguientes palabras &lt;b&gt;no&lt;/b&gt; era el nombre de ningún faraón del antiguo Egipto?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Ramsés&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Amosis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tutmosis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sutmosis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sutmosis.&lt;br&gt;&lt;br&gt;Ramsés, Amosis y Tutmosis fueron algunos de los nombres por los que son conocidos varios faraones. De hecho, Amosis&#38;nbsp;I, Tutmosis I, Tutmosis III y Ramsés II son algunos de los más famosos gobernantes del antiguo Egipto.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>