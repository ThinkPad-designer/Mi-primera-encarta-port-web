<?xml version="1.0"?><quiz type="multichoice" id="1175" lang="E" hascredits="1"><question><text>&lt;html&gt;El Manx es un gato poco corriente porque…&lt;/html&gt;</text><image w="149" h="149">T047372A.jpg</image><imagerefid>1B826C84</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;No tiene cola.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;No tiene uñas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;No tiene bigotes.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;No tiene pelo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;No tiene cola.&lt;br&gt;&lt;br&gt;Los gatos de esta raza nacen así.&lt;/html&gt;</text><image w="149" h="149">T047372A.jpg</image><imagerefid>1B826C84</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>