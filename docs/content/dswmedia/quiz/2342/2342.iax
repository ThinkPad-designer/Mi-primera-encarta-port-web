<?xml version="1.0"?><quiz type="multichoice" id="2342" lang="E" hascredits="1"><question><text>&lt;html&gt;Ludwig van Beethoven sufrió una discapacidad que influyó mucho sobre su música y su carácter. ¿Cuál de las siguientes fue?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Era sordo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Era ciego&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Era mudo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Era sordo.&lt;br&gt;&lt;br&gt;Conforme aumentaba su sordera, tuvo que dejar de dar conciertos; el último lo ofreció en 1814, trece años antes de su muerte.&lt;/html&gt;</text><image w="149" h="133">T047357A.jpg</image><imagerefid>42D96A44</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Getty Picture Collection</rewardcredits></quiz>