<?xml version="1.0"?><quiz type="multichoice" id="879" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el órgano principal del sistema respiratorio?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Pulmones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hígado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vejiga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Pulmones. &lt;br&gt;&lt;br&gt;En los pulmones se produce el intercambio de gases entre la sangre y el aire. Cuando inspiras introduces aire en tus pulmones. Cuando espiras el aire sale de tus pulmones.

&lt;/html&gt;</text><image w="149" h="149">0010224f.jpg</image><imagerefid>29D22C1E</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>