<?xml version="1.0"?><quiz type="multichoice" id="2344" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama la vara que sostiene el director de una orquesta  para llevar el ritmo y hacer indicaciones a los músicos?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Triángulo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Batuta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Varilla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Batuta.&lt;br&gt;&lt;br&gt;Esta vara tiene un ensanchamiento en la base para que no se resbale y se sujete con firmeza.&lt;/html&gt;</text><image w="149" h="99">T012089A.jpg</image><imagerefid>1B822D36</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE/UPI</rewardcredits></quiz>