<?xml version="1.0"?><quiz type="multichoice" id="1721" lang="E" hascredits="1"><question><text>&lt;html&gt;The highest lake in the world is located in South America. What is its name?
&lt;/html&gt;</text><image w="149" h="132">T000249A.jpg</image><imagerefid>1B82BA74</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Lake Maracaibo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lake Titicaca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Nahuel Huapí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Buenos Aires&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Titicaca.&lt;br&gt;&lt;br&gt;This lake, shared by Peru and Bolivia, lies high in the Andes Mountains. It is located 12,500 feet (3,810 meters) above sea level.
&lt;/html&gt;</text><image w="149" h="132">T000249A.jpg</image><imagerefid>1B82BA74</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Ed Drews</credits><rewardcredits>Photo Researchers, Inc./Ed Drews</rewardcredits></quiz>