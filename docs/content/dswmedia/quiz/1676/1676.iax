<?xml version="1.0"?><quiz type="multichoice" id="1676" lang="E" hascredits="1"><question><text>&lt;html&gt;Uno de estos deportistas ha ganado varias ediciones del Tour de Francia. ¿Sabrías decir cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Raúl Alcalá&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Perico Delgado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lance Armstrong&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lucho Herrera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lance Armstrong. &lt;br&gt;&lt;br&gt;El estadounidense Lance Armstrong es el ciclista que más Tours ha ganado. El español Delgado lo ganó en una ocasión. El colombiano Lucho Herrera fue el mejor escalador en tres ediciones. El mexicano Alcalá fue el primer ciclista de su país que compitió en un Tour.&lt;/html&gt;</text><image w="149" h="132">0005b85b.jpg</image><imagerefid>67CF1C45</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>REUTERS/Stefano Rellandini</rewardcredits></quiz>