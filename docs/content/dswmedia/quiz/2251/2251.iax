&lt;/html&gt;</text><image w="149" h="149">00127c70.jpg</image><imagerefid>42D95537</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Moluscos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Crustáceos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Equinodermos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mamíferos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Equinodermos.&lt;br&gt;&lt;br&gt;Las estrellas de mar son animales invertebrados que viven en el mar. Las estrellas de mar, los pepinos de mar y los erizos de mar son equinodermos.&lt;/html&gt;</text><image w="149" h="149">00127c70.jpg</image><imagerefid>42D95537</imagerefid><audio/><audiorefid/></reward><credits>Getty Images/Ian Cartwright</credits><rewardcredits>Getty Images/Ian Cartwright</rewardcredits></quiz>