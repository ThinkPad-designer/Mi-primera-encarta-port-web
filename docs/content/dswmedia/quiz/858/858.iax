<?xml version="1.0"?><quiz type="multichoice" id="858" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué nombre reciben las células sexuales masculinas?
 
&lt;/html&gt;</text><image w="149" h="133">T012480A.jpg</image><imagerefid>42D959D7</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Óvulos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Espermatozoides&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Leucocitos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Macrófagos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Espermatozoides. &lt;br&gt;&lt;br&gt;Los espermatozoides son las células sexuales masculinas. Tienen una cabeza y una cola que les permite moverse. Los espermatozoides se forman en los testículos.


&lt;/html&gt;</text><image w="149" h="133">T012480A.jpg</image><imagerefid>42D959D7</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films</credits><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>