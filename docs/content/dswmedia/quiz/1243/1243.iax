<?xml version="1.0"?><quiz type="multichoice" id="1243" lang="E" hascredits="1"><question><text>&lt;html&gt;Which of these is &lt;b&gt;not&lt;/b&gt; a way that a frog is different from a toad?
&lt;/html&gt;</text><image w="149" h="132">T010281A.jpg</image><imagerefid>1B822741</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Frogs are amphibians; toads are reptiles&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Frogs have smooth skin; toads have warty skin&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Adult frogs live near water; adult toads can live in drier areas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Frogs have teeth; toads have no teeth&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Frogs are amphibians; toads are reptiles. &lt;br&gt;&lt;br&gt;Frogs and toads are very similar animals that together make up a group of amphibians called anurans. 
&lt;/html&gt;</text><image w="149" h="132">T010281A.jpg</image><imagerefid>1B822741</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley/Jerry Young</credits><rewardcredits>Dorling Kindersley/Jerry Young</rewardcredits></quiz>