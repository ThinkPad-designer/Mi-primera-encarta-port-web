<?xml version="1.0"?><quiz type="multichoice" id="1725" lang="E" hascredits="0"><question><text>&lt;html&gt;The interior of Australia, with a harsh climate and small population, is popularly referred to as what?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Outback&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Outhouse&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Outkast&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Texas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Outback.&lt;br&gt;&lt;br&gt;The outback takes up most of the area of Australia but only a small fraction of Australia’s population lives there. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>