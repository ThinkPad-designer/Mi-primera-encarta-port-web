<?xml version="1.0"?><quiz type="multichoice" id="1164" lang="E" hascredits="1"><question><text>&lt;html&gt;Un gato puede detectar los objetos que tiene cerca gracias a sus bigotes, que son muy sensibles a...&lt;/html&gt;</text><image w="149" h="132">T058589A.jpg</image><imagerefid>1B8288C6</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Los olores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los cambios de temperatura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las corrientes de aire&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los sonidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las corrientes de aire.&lt;br&gt;&lt;br&gt;Los bigotes son capaces de captar los movimientos de aire provocados por otros animales. Gracias a sus bigotes, pueden saber dónde están situados los objetos que se encuentran a su alrededor, incluso en la oscuridad.
&lt;/html&gt;</text><image w="149" h="132">T058589A.jpg</image><imagerefid>1B8288C6</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals</credits><rewardcredits>Animals Animals</rewardcredits></quiz>