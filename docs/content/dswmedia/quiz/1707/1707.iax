<?xml version="1.0"?><quiz type="multichoice" id="1707" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the longest river in South America?
&lt;/html&gt;</text><image w="154" h="137">T026303A.jpg</image><imagerefid>29D29416</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Amazon&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Paraguay&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Paraná&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Uruguay&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Amazon.&lt;br&gt;&lt;br&gt;At 4,000 miles (6,400 kilometers) long, the Amazon is the world’s second longest river. It is also the largest river in the world, in terms of both the area of its basin and the amount of water it carries.
&lt;/html&gt;</text><image w="154" h="137">T026303A.jpg</image><imagerefid>29D29416</imagerefid><audio/><audiorefid/></reward><credits>The Stock Market/Claudia Parks</credits><rewardcredits>The Stock Market/Claudia Parks</rewardcredits></quiz>