<?xml version="1.0"?><quiz type="multichoice" id="1753" lang="E" hascredits="0"><question><text>&lt;html&gt;Which of the following is &lt;b&gt;not&lt;/b&gt; a Pacific Island nation?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Tonga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kiribati&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Bahamas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vanuatu&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Bahamas.&lt;br&gt;&lt;br&gt;The Bahamas are in the Atlantic Ocean, not the Pacific Ocean.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>