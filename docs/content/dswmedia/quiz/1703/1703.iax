<?xml version="1.0"?><quiz type="multichoice" id="1703" lang="E" hascredits="1"><question><text>&lt;html&gt;A North African mountain range is named for a legendary figure who held Earth on his back. What is the name of this range?
&lt;/html&gt;</text><image w="149" h="132">T071247A.jpg</image><imagerefid>073FC46E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Zeus Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mountains of Mars&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Atlas Mountains&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Achilles Range&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Atlas Mountains.&lt;br&gt;&lt;br&gt;The Atlas Mountains lie in Morocco, Algeria, and Tunisia, in northwestern Africa.
&lt;/html&gt;</text><image w="149" h="132">T071247A.jpg</image><imagerefid>073FC46E</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Robert Gill/Papillo</credits><rewardcredits>Corbis/Robert Gill/Papillo</rewardcredits></quiz>