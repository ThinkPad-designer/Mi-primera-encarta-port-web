<?xml version="1.0"?><quiz type="multichoice" id="1192" lang="E" hascredits="1"><question><text>&lt;html&gt;Si deseas tener una iguana como mascota, debes saber que es un animal…&lt;/html&gt;</text><image w="149" h="99">T291863A.jpg</image><imagerefid>0C1379F2</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Carnívoro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Herbívoro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Herbívoro. &lt;br&gt;&lt;br&gt;Las iguanas solo toman productos de origen vegetal. Puedes darles zanahorias, tomates, manzanas, plátanos, etc.&lt;/html&gt;</text><image w="149" h="99">T291863A.jpg</image><imagerefid>0C1379F2</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Joe McDonald</credits><rewardcredits>Corbis/Joe McDonald</rewardcredits></quiz>