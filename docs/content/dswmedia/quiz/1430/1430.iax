<?xml version="1.0"?><quiz type="multichoice" id="1430" lang="E" hascredits="1"><question><text>&lt;html&gt;El Kilimanjaro es un volcán, además del monte más alto de África. En sus cumbres hay nieves perpetuas. ¿Qué significa esto último?
&lt;/html&gt;</text><image w="149" h="132">T054758A.jpg</image><imagerefid>1B828594</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Que está siempre en erupción&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Que siempre tiene nieve en sus cumbres&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Que carece por completo de nieve&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Que es un volcán extinguido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Que siempre tiene nieve en sus cumbres.&lt;br&gt;&lt;br&gt;Además de presentar nieves perpetuas es un volcán activo, es decir, que puede entrar en erupción en cualquier momento.
&lt;/html&gt;</text><image w="149" h="132">T054758A.jpg</image><imagerefid>1B828594</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Renee Lynn</credits><rewardcredits>Photo Researchers, Inc./Renee Lynn</rewardcredits></quiz>