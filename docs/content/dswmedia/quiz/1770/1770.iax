<?xml version="1.0"?><quiz type="multichoice" id="1770" lang="E" hascredits="1"><question><text>&lt;html&gt;The Amazon River is mostly in what South American country?&lt;/html&gt;</text><image w="154" h="137">T026303A.jpg</image><imagerefid>29D29416</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Argentina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Brazil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Bolivia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Peru&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Brazil.&lt;br&gt;&lt;br&gt;The Amazon basin takes up most of northern Brazil.
&lt;/html&gt;</text><image w="154" h="137">T026303A.jpg</image><imagerefid>29D29416</imagerefid><audio/><audiorefid/></reward><credits>The Stock Market/Claudia Parks</credits><rewardcredits>The Stock Market/Claudia Parks</rewardcredits></quiz>