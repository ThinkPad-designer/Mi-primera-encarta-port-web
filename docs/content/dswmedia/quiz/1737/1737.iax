<?xml version="1.0"?><quiz type="multichoice" id="1737" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the biggest country in Asia (by land area, and not counting Russia)?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;India&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Kazakhstan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Saudi Arabia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;China.&lt;br&gt;&lt;br&gt;China is the fourth largest country in the world (by land area). Russia is in both Europe and Asia, and is the biggest country of both (by land area).
&lt;/html&gt;</text><image w="149" h="149">00123d67.jpg</image><imagerefid>29D26492</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>