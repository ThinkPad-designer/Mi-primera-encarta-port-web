<?xml version="1.0"?><quiz type="multichoice" id="1817" lang="E" hascredits="0"><question><text>&lt;html&gt;Many of the early explorers of the Antarctic were people looking for what?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Atlantis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Gold&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Northwest Passage&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Whales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Whales.&lt;br&gt;&lt;br&gt;Whaling was a big industry in the 18th and 19th centuries. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>