<?xml version="1.0"?><quiz type="multichoice" id="1097" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales, propios del desierto, tiene una cola segmentada provista de un aguijón venenoso?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El jerbillo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La tarántula &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El escorpión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El crótalo cornudo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El escorpión. &lt;br&gt;&lt;br&gt;El escorpión clava su aguijón venenoso en la presa, dejándola paralizada.&lt;/html&gt;</text><image w="149" h="149">T025030B.jpg</image><imagerefid>1B82C8B1</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>