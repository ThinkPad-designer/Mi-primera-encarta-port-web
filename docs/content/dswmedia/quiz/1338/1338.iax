<?xml version="1.0"?><quiz type="multichoice" id="1338" lang="E" hascredits="0"><question><text>&lt;html&gt;Parte del desierto del Sahara se encuentra en territorio libio. ¿Sabes cuál es la capital de Libia?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El Cairo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Túnez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Trípoli&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rabat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Trípoli.&lt;br&gt;&lt;br&gt;Trípoli se encuentra a orillas del mar Mediterráneo, en el noroeste de Libia.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>