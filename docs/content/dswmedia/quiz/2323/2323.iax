<?xml version="1.0"?><quiz type="multichoice" id="2323" lang="E" hascredits="0"><question><text>&lt;html&gt;El instrumento que más se utilizaba en la antigua Grecia se llamaba lira, y era parecido a:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un pequeño piano, pero sin las teclas negras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Un arpa pequeña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una flauta, pero hecha de hueso de carnero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un arpa pequeña.&lt;br&gt;&lt;br&gt;La lira es uno de los instrumentos más antiguos que existen. En la antigua Grecia se creía incluso que determinados dioses, como Apolo, la tocaban.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>