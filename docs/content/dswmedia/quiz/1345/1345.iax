<?xml version="1.0"?><quiz type="multichoice" id="1345" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es la principal característica de todos los desiertos?
&lt;/html&gt;</text><image w="149" h="99">T287808A.jpg</image><imagerefid>073FDCA6</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La arena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El calor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La escasez de lluvia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La nieve&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La escasez de lluvia.&lt;br&gt;&lt;br&gt;Algunos desiertos son rocosos, otros son muy fríos, pero todos son tremendamente secos.
&lt;/html&gt;</text><image w="149" h="99">T287808A.jpg</image><imagerefid>073FDCA6</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Charles O&apos;Rear</credits><rewardcredits>Corbis/Charles O&apos;Rear</rewardcredits></quiz>