<?xml version="1.0"?><quiz type="multichoice" id="114" lang="E" hascredits="0"><question><text>&lt;html&gt;La atonalidad es un sistema musical que nació en el siglo XX y se basó en:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Romper completamente las relaciones que hasta entonces existían entre los sonidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Amoldarse a los lenguajes musicales que se utilizaron en tiempos antiguos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Fundir en un mismo estilo todas las tendencias musicales que se dieron durante el silo XIX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Romper completamente las relaciones que hasta entonces existían entre los sonidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>