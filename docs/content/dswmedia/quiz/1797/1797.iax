<?xml version="1.0"?><quiz type="multichoice" id="1797" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the name of the biggest scientific station in Antarctica?
&lt;/html&gt;</text><image w="149" h="99">T165002A.jpg</image><imagerefid>25A403ED</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Amundsen-Scott&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mawson&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;McMurdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vostok&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;McMurdo.&lt;br&gt;&lt;br&gt;McMurdo Station is located at the farthest south bit of land that is accessible by ships. The population of McMurdo changes with the seasons: During the winter, it is about 250, but in summer, it can be over 1,000.&lt;/html&gt;</text><image w="149" h="99">T165002A.jpg</image><imagerefid>25A403ED</imagerefid><audio/><audiorefid/></reward><credits>ALLSTOCK, INC./Kevin Schafer</credits><rewardcredits>ALLSTOCK, INC./Kevin Schafer</rewardcredits></quiz>