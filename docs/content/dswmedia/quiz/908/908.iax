<?xml version="1.0"?><quiz type="multichoice" id="908" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes cuántas veces al día debes lavarte los dientes?
&lt;/html&gt;</text><image w="149" h="99">00176594.jpg</image><imagerefid>42D97811</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Después de tomar dulces&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Después de cada comida&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Después de dormir&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una vez al día&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Después de cada comida.&lt;br&gt;&lt;br&gt;Los restos de comida se depositan sobre los dientes y favorecen la destrucción del esmalte y la formación de caries.
&lt;/html&gt;</text><image w="149" h="99">00176594.jpg</image><imagerefid>42D97811</imagerefid><audio/><audiorefid/></reward><credits>Digital Vision Ltd.</credits><rewardcredits>Digital Vision Ltd.</rewardcredits></quiz>