<?xml version="1.0"?><quiz type="multichoice" id="2327" lang="E" hascredits="0"><question><text>&lt;html&gt;Tres de los grandes compositores del clasicismo musical fueron:
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Ludwig van Beethoven, Antonio Vivaldi y Piotr Ilich Chaikovski &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Wolfgang Amadeus Mozart, Ludwig van Beethoven y Joseph Haydn&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Joseph Haydn, Claude Debussy y Erik Satie&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Wolfgang Amadeus Mozart, Ludwig van Beethoven y Joseph Haydn.&lt;br&gt;&lt;br&gt;Recordemos que el clasicismo se sitúa, a grandes rasgos, entre el barroco y el romanticismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>