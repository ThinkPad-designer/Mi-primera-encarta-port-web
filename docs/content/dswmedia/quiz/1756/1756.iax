<?xml version="1.0"?><quiz type="multichoice" id="1756" lang="E" hascredits="0"><question><text>&lt;html&gt;The equator does &lt;b&gt;not&lt;/b&gt; pass through which of the following South American countries?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Brazil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Colombia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Ecuador&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Venezuela&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Venezuela.&lt;br&gt;&lt;br&gt;In South America, the equator passes through Ecuador, Colombia, and Brazil. It misses Peru by less than a mile.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>