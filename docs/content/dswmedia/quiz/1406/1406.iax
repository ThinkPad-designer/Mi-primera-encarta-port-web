<?xml version="1.0"?><quiz type="multichoice" id="1406" lang="E" hascredits="0"><question><text>&lt;html&gt;Seguramente habrás oído alguna vez una expresión de la lengua swahili:&lt;i&gt;¡Hakuna Matata!&lt;/i&gt; Pero, ¿sabrías decir qué significa esa frase?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;¡Hola!&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;¡Ningún problema!&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;¡Al ataque!&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;¡Adiós!&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;¡Ningún problema!&lt;br&gt;&lt;br&gt;&lt;i&gt;¡Hakuna Matata!&lt;/i&gt; es un dicho popular utilizado en el área oriental africano. Pretende recordarnos que de vez en cuando es bueno despreocuparnos de determinados asuntos... y disfrutar.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>