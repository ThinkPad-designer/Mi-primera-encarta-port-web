<?xml version="1.0"?><quiz type="multichoice" id="2509" lang="E" hascredits="0"><question><text>&lt;html&gt;El compositor madrileño Francisco Barbieri fue el primero que diferenció entre dos tipos de zarzuela. ¿Cuáles?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Género cómico y género dramático&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Género romántico y género de aventuras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Género chico y género grande&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Género chico y género grande.&lt;br&gt;&lt;br&gt;Además de compositor y musicólogo, Barbieri fue cantante, pianista y clarinetista. También fue profesor en el Conservatorio de Madrid.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>