<?xml version="1.0"?><quiz type="multichoice" id="1853" lang="E" hascredits="0"><question><text>&lt;html&gt;El orden que necesitan las notas musicales para formar una escala podría ser uno de los siguientes ejemplos, pero… ¿Cuál de ellos?:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Mi, sol, si, re, fa, la, do.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Si, fa, do, sol, re, la, mi.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Do, re, mi, fa sol, la, si.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>