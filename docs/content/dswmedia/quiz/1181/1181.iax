<?xml version="1.0"?><quiz type="multichoice" id="1181" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes perros tiene la lengua de color azul?
&lt;/html&gt;</text><image w="153" h="136"/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El mastín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El caniche&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El chow chow&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El cocker&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El chow chow. &lt;br&gt;&lt;br&gt;Es un perro originario de China. Tiene la cabeza grande y ancha y la lengua de color azul.
&lt;/html&gt;</text><image w="149" h="149">T025332A.jpg</image><imagerefid>1B8236B0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>