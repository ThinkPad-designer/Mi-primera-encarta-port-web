<?xml version="1.0"?><quiz type="multichoice" id="1186" lang="E" hascredits="1"><question><text>&lt;html&gt;El bullmastiff surgió como resultado del cruce entre el mastín y ¿qué otra raza de perro?
&lt;/html&gt;</text><image w="149" h="149">T025342A.jpg</image><imagerefid>1B8236B9</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El bulldog&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El bull terrier&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El pit bull&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El bóxer&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El bulldog. &lt;br&gt;&lt;br&gt;El bulldog es pequeño y agresivo. El mastín es grande y noble. Por tanto, el bullmastiff es un perro de tamaño medio con fuerza y valentía, y fácil de adiestrar.&lt;/html&gt;</text><image w="149" h="149">T025342A.jpg</image><imagerefid>1B8236B9</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>