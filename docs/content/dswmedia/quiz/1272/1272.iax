<?xml version="1.0"?><quiz type="multichoice" id="1272" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo consiguen los pulpos distraer a los depredadores y así poder escapar?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Haciendo mucho ruido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Echando un chorro de tinta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Moviendo los tentáculos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Escupiendo veneno&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Echando un chorro de tinta. &lt;br&gt;&lt;br&gt;Cuando se sienten amenazados, los pulpos echan un chorro de tinta que distrae al predador y permite al pulpo escapar.
&lt;/html&gt;</text><image w="153" h="136">T047849A.jpg</image><imagerefid>1B826E46</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/F. Stuart Westmorland</rewardcredits></quiz>