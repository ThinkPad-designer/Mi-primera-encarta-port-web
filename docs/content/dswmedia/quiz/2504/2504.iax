<?xml version="1.0"?><quiz type="multichoice" id="2504" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De qué nacionalidad era el compositor Johannes Brahms?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Húngaro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Francés&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Alemán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Alemán.&lt;br&gt;&lt;br&gt;Varios de los grandes compositores de música clásica, como Johann Sebastian Bach, Richard Wagner o Robert Schumann también fueron alemanes.
&lt;/html&gt;</text><image w="149" h="133">T012092A.jpg</image><imagerefid>1B822D3A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>