<?xml version="1.0"?><quiz type="multichoice" id="1183" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes &lt;b&gt;no&lt;/b&gt; es una raza de perro?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El chihuahua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El bulldog&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El mapache&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El collie&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El mapache. &lt;br&gt;&lt;br&gt;El mapache es un  mamífero carnívoro que tiene la cabeza ancha, con un hocico corto y apuntado. Tiene el cuerpo rechoncho, cubierto por un pelaje denso y largo y una cola peluda con una especie de bandas o anillos de color oscuro.&lt;/html&gt;</text><image w="99" h="149">T172690A.jpg</image><imagerefid>25A411AE</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Peter Arnold, Inc./S. J. Krasemann</rewardcredits></quiz>