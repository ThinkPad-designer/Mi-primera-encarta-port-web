<?xml version="1.0"?><quiz type="multichoice" id="1784" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Canada?
&lt;/html&gt;</text><image w="153" h="136">T001048A.jpg</image><imagerefid>42D9685B</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Montréal &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Ottawa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Toronto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vancouver&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Ottawa.&lt;br&gt;&lt;br&gt;Ottawa is located in the southeastern part of the Canadian province of Ontario.
&lt;/html&gt;</text><image w="153" h="136">T001048A.jpg</image><imagerefid>42D9685B</imagerefid><audio/><audiorefid/></reward><credits>Canadian Consulate General</credits><rewardcredits>Canadian Consulate General</rewardcredits></quiz>