<?xml version="1.0"?><quiz type="multichoice" id="1312" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De qué animales dependen los masai (pueblo de África oriental) para ganarse la vida?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;De las jirafas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De los ñúes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De las vacas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De las cebras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De las vacas. &lt;br&gt;&lt;br&gt;Los masai utilizan del ganado vacuno su leche, su carne y su piel para vestirse. La riqueza de una familia depende del número de vacas que posean. 
&lt;/html&gt;</text><image w="149" h="149">T628323A.jpg</image><imagerefid>1B82A5A7</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Bildarchiv Okapia</rewardcredits></quiz>