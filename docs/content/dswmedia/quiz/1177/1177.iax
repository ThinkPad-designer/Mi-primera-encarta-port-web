<?xml version="1.0"?><quiz type="multichoice" id="1177" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes perros es un dálmata?
&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="149" h="132">T040433A.jpg</image><imagerefid>1B82543B</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T040543A.jpg</image><imagerefid>1B8254A9</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="99" h="149">T025331A.jpg</image><imagerefid>1B8236AF</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="149">T025317A.jpg</image><imagerefid>1B8236A1</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los dálmatas son completamente blancos cuando nacen pero, en pocas semanas, aparecen varias manchas negras por todo su cuerpo.
&lt;/html&gt;</text><image w="149" h="132">T040543A.jpg</image><imagerefid>1B8254A9</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Charles Palek&lt;br&gt;&lt;br&gt;Animals Animals/Robert Pearcy&lt;br&gt;&lt;br&gt;Dorling Kindersley&lt;br&gt;&lt;br&gt;Dorling Kindersley</credits><rewardcredits>Animals Animals/Robert Pearcy</rewardcredits></quiz>