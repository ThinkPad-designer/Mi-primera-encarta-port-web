<?xml version="1.0"?><quiz type="multichoice" id="1776" lang="E" hascredits="0"><question><text>&lt;html&gt;Which of these North American countries does &lt;b&gt;not&lt;/b&gt; touch the Gulf of Mexico?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Cuba&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Guatemala&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mexico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Guatemala.&lt;br&gt;&lt;br&gt;Guatemala lies south of Mexico on the Pacific Ocean.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>