<?xml version="1.0"?><quiz type="multichoice" id="1693" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the tallest mountain in Asia?
&lt;/html&gt;</text><image w="153" h="136">T026311A.jpg</image><imagerefid>42D966E9</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Mount Everest&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;K2&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Kanchenjunga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Dhaulagiri&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mount Everest. &lt;br&gt;&lt;br&gt;Mount Everest is the tallest mountain in the whole world. It is located on the Nepal-China border in the Himalayas. Everest is 29,035 feet (8,850 meters) tall. Nine of the ten tallest mountains in the world are in the Himalayas.
&lt;/html&gt;</text><image w="153" h="136">T026311A.jpg</image><imagerefid>42D966E9</imagerefid><audio/><audiorefid/></reward><credits>Tony Stone Images/Keren Su</credits><rewardcredits>Tony Stone Images/Keren Su</rewardcredits></quiz>