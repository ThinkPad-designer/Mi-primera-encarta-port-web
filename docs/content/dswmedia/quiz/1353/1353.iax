<?xml version="1.0"?><quiz type="multichoice" id="1353" lang="E" hascredits="1"><question><text>&lt;html&gt;Algunas zonas del sur del Sahara son rocosas. ¿Qué es lo que modela esas piedras hasta formar tan extrañas figuras?
&lt;/html&gt;</text><image w="99" h="149">T645997A.jpg</image><imagerefid>073FFB57</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La lluvia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El viento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los animales&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La gente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El viento.&lt;br&gt;&lt;br&gt;Los vientos del desierto transportan arena y de esa manera enarenan las rocas hasta crear tan extrañas formaciones.&lt;/html&gt;</text><image w="99" h="149">T645997A.jpg</image><imagerefid>073FFB57</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Sylvain Grandadam</credits><rewardcredits>Photo Researchers, Inc./Sylvain Grandadam</rewardcredits></quiz>