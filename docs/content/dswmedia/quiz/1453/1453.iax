<?xml version="1.0"?><quiz type="multichoice" id="1453" lang="E" hascredits="0"><question><text>&lt;html&gt;El desierto de Kalahari se extiende a lo largo de tres países. Uno de los siguientes &lt;b&gt;no&lt;/b&gt; es uno de ellos. ¿Cuál?
&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Botsuana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Namibia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sudáfrica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Kenia.&lt;br&gt;&lt;br&gt;Kenia se encuentra en el este africano, a cientos de kilómteros del Kalahari.
&lt;/html&gt;</text><image w="102" h="153"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>