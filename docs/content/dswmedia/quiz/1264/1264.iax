<?xml version="1.0"?><quiz type="multichoice" id="1264" lang="E" hascredits="1"><question><text>&lt;html&gt;When a predator gets too close, what animal oozes slime that surrounds and suffocates the predator?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Slug &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lamprey&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hagfish&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mud puppy&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hagfish. &lt;br&gt;&lt;br&gt;When the hagfish has escaped from its predator, it ties itself in knots to rub off any extra slime. 
&lt;/html&gt;</text><image w="149" h="99">T013517A.jpg</image><imagerefid>1B823177</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Tom McHugh/Steinhart Aquarium</rewardcredits></quiz>