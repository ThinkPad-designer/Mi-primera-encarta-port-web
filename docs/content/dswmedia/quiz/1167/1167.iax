<?xml version="1.0"?><quiz type="multichoice" id="1167" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuántos días dura el embarazo de los gatos?
&lt;/html&gt;</text><image w="149" h="132">T049992A.jpg</image><imagerefid>42D959ED</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;25 días&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;65 días&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;105 días&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;145 días&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;65 días. &lt;br&gt;&lt;br&gt;¡El embarazo de tu mama duró muchos días más!
&lt;/html&gt;</text><image w="149" h="132">T049992A.jpg</image><imagerefid>42D959ED</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>