<?xml version="1.0"?><quiz type="multichoice" id="884" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Sabes cuál es la función de los pelos de tu nariz?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Producir moco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hacerte cosquillas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Humedecer&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Limpiar el aire&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Limpiar el aire. &lt;br&gt;&lt;br&gt;En los orificios nasales hay pelos que impiden el paso de sustancias extrañas, como el polvo o insectos pequeños.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>