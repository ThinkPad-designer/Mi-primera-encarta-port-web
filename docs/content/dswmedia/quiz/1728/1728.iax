<?xml version="1.0"?><quiz type="multichoice" id="1728" lang="E" hascredits="0"><question><text>&lt;html&gt;At the southern end of South America is…
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Cabo San Lucas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cape Hattaras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cape Horn&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Cape of Good Hope&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Cape Horn.&lt;br&gt;&lt;br&gt;Old nautical sayings and songs refer to “sailing around the Horn,” meaning Cape Horn.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>