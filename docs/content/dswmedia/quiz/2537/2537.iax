<?xml version="1.0"?><quiz type="multichoice" id="2537" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Durante qué siglo nació el neoclasicismo musical?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Siglo XVIII&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Siglo XIX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Siglo XX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Siglo XX.&lt;br&gt;&lt;br&gt;Fue solo una de las numerosas tendencias musicales que surgieron durante todo el siglo XX, ya que estas evolucionaban tan rápido que enseguida daban paso a otras.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>