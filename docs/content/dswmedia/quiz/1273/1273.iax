<?xml version="1.0"?><quiz type="multichoice" id="1273" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuántos dientes tienen los caracoles de tierra?
&lt;/html&gt;</text><image w="149" h="149">T025753A.jpg</image><imagerefid>1B8237E9</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Diez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Unos cincuenta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Cientos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Miles&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Miles.&lt;br&gt;&lt;br&gt;Los caracoles de tierra tienen una lengua que contiene miles de dientes. Utilizan los dientes para raspar el alimento de las rocas. Algunos usan sus dientes para hacer agujeros en las conchas de caracoles y almejas. 
&lt;/html&gt;</text><image w="149" h="149">T025753A.jpg</image><imagerefid>1B8237E9</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>