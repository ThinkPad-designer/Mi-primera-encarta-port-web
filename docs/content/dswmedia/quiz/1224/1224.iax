<?xml version="1.0"?><quiz type="multichoice" id="1224" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal hace este sonido?
&lt;/html&gt;</text><image/><imagerefid/><audio>05346.mp3</audio><audiorefid>25A41E46</audiorefid></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La hiena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La cucaburra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El chacal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La hiena. &lt;br&gt;&lt;br&gt;Las hienas son animales cazadores y carroñeros. Tienen mandíbulas y dientes fuertes, con los que pueden triturar los huesos con facilidad.
&lt;/html&gt;</text><image w="149" h="149">T049830A.jpg</image><imagerefid>1B827554</imagerefid><audio>05346.mp3</audio><audiorefid>25A41E46</audiorefid></reward><credits>BBC Natural History Sound Library. Reservados todos los derechos.</credits><rewardcredits>Oxford Scientific Films/Stan Osolinski&lt;br&gt;BBC Natural History Sound Library. Reservados todos los derechos.</rewardcredits></quiz>