<?xml version="1.0"?><quiz type="multichoice" id="2322" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué es un compositor?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Es la persona encargada de interpretar una partitura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Es la persona que crea y escribe una pieza musical&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Es la persona que contrata a los músicos de una orquesta&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Es la persona que crea y escribe una pieza musical.&lt;br&gt;&lt;br&gt;Muchos de los compositores de la historia también han interpretado sus propias obras, e incluso las han estrenado en muchas ocasiones, de forma que también se han convertido en intérpretes.&lt;/html&gt;</text><image w="149" h="133">T047357A.jpg</image><imagerefid>1B826C77</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Getty Picture Collection</rewardcredits></quiz>