<?xml version="1.0"?><quiz type="multichoice" id="868" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué nombre recibe la célula sexual femenina?
&lt;/html&gt;</text><image w="149" h="133">T012481A.jpg</image><imagerefid>1B822E6F</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Histiocito&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hepatocito&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Espermatozoide&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Óvulo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Óvulo. &lt;br&gt;&lt;br&gt;El óvulo es la célula sexual femenina. A partir de la pubertad, cada mes un óvulo madura y sale del ovario. &lt;/html&gt;</text><image w="149" h="133">T012481A.jpg</image><imagerefid>1B822E6F</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films</credits><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>