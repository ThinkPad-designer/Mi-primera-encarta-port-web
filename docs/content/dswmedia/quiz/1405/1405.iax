<?xml version="1.0"?><quiz type="multichoice" id="1405" lang="E" hascredits="0"><question><text>&lt;html&gt;La lengua swahili es una de las más habladas en África. En uno de estos países no se habla swahili. ¿Sabrías decir en cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En Mozambique&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En Tanzania&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Argelia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En Kenia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Argelia.&lt;br&gt;&lt;br&gt;La lengua swahili es oficial en Tanzania y en Kenia, y es bastante utilizada en Mozambique, así como en otros países de la zona. En Argelia, por el contrario, donde también se hablan dialectos bereberes y el francés, la lengua oficial es el árabe. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>