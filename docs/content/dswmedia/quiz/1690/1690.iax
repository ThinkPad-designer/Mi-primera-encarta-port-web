<?xml version="1.0"?><quiz type="multichoice" id="1690" lang="E" hascredits="1"><question><text>&lt;html&gt;How tall is Aconcagua, the tallest mountain in South America?
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;14,494 feet (4,418 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;16,427 feet (5,007 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;19,347 feet (5,897 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;22,834 feet (6,960 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;22,834 feet (6,960 meters). &lt;br&gt;&lt;br&gt;Aconcagua is located in western Argentina, in the Andes Mountains.
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></reward><credits>Redux Pictures/Miquel Gonzalez/laif</credits><rewardcredits>Redux Pictures/Miquel Gonzalez/laif</rewardcredits></quiz>