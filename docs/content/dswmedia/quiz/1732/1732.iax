<?xml version="1.0"?><quiz type="multichoice" id="1732" lang="E" hascredits="1"><question><text>&lt;html&gt;In the Australian outback is a place called Uluru, which is spiritually important to the Aboriginal people of Australia. What is Uluru?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;A dense forest&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;A huge rock&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;A big geyser&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;A volcano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A huge rock.&lt;br&gt;&lt;br&gt;Uluru, also called Ayers Rock, is a massive rock formation. It juts dramatically out of the surrounding flat land.
&lt;/html&gt;</text><image w="153" h="136">T026315A.jpg</image><imagerefid>1B8239F9</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tony Stone Images/Art Wolfe</rewardcredits></quiz>