<?xml version="1.0"?><quiz type="multichoice" id="1172" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes gatos es un siamés? &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="149" h="99">T047367A.jpg</image><imagerefid>1B826C81</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="149">T054577A.jpg</image><imagerefid>1B8284E0</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="149">T045827A.jpg</image><imagerefid>1B8266E9</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="149">T047371A.jpg</image><imagerefid>1B826C83</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los siameses tienen el cuerpo de color claro y más oscuro en la cara, las orejas, la cola y la parte inferior de las patas.&lt;/html&gt;</text><image w="149" h="149">T047371A.jpg</image><imagerefid>1B826C83</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley/Jerry Young&lt;br&gt;&lt;br&gt;Animals Animals/Robert Pearcy&lt;br&gt;&lt;br&gt;Dorling Kindersley&lt;br&gt;&lt;br&gt;Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>