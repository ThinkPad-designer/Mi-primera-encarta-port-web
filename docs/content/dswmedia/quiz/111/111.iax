<?xml version="1.0"?><quiz type="multichoice" id="111" lang="E" hascredits="0"><question><text>&lt;html&gt;El compositor polaco Frédéric Chopin pasó una temporada de descanso en una isla española para curarse de una enfermedad. ¿De qué isla se trata?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Ibiza&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tenerife&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mallorca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mallorca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>