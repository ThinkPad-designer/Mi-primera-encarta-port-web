<?xml version="1.0"?><quiz type="multichoice" id="2264" lang="E" hascredits="1"><question><text>&lt;html&gt;Los arrecifes de coral están formados por animales diminutos llamados…&lt;/html&gt;</text><image w="149" h="133">T014037A.jpg</image><imagerefid>42D95D0E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Lirios de mar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Pólipos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Pepinos de mar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Erizos de mar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Pólipos.&lt;br&gt;&lt;br&gt;Los arrecifes de coral están compuestos por pólipos. El pólipo produce un caparazón duro para proteger su cuerpo. Cuando los pólipos mueren, sus caparazones permanecen, y encima se sitúan nuevos pólipos, que continúan agrandando el coral.&lt;/html&gt;</text><image w="149" h="133">T014037A.jpg</image><imagerefid>42D95D0E</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Laurence Gould</credits><rewardcredits>Oxford Scientific Films/Laurence Gould</rewardcredits></quiz>