<?xml version="1.0"?><quiz type="multichoice" id="1" lang="E" hascredits="1"><question><text>&lt;html&gt;Para los antiguos egipcios, el ibis sagrado encarnaba el aprendizaje y el conocimiento. El dios egipcio Thot solía ser representado con la cabeza de un ibis sagrado. Thot era el dios de...&lt;/html&gt;</text><image w="153" h="153">0016fea6.jpg</image><imagerefid>29D320CF</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Los cultivos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La sabiduría&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El amor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La muerte&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La sabiduría.&lt;br&gt;&lt;br&gt;El dios Thot era, además de dios de la sabiduría, dios de la Luna y la medida del tiempo, así como escriba de los dioses y señor de la magia.&lt;/html&gt;</text><image w="153" h="153">0016fea6.jpg</image><imagerefid>29D320CF</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Roger Wood</credits><rewardcredits>Corbis/Roger Wood</rewardcredits></quiz>