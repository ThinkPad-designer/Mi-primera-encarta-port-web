<?xml version="1.0"?><quiz type="multichoice" id="1798" lang="E" hascredits="1"><question><text>&lt;html&gt;In what North American city would you find the Liberty Bell?
&lt;/html&gt;</text><image w="153" h="136">T054532A.jpg</image><imagerefid>1B8284B3</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Boston&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;New York&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Philadelphia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Richmond&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Philadelphia.&lt;br&gt;&lt;br&gt;Philadelphia is in Pennsylvania, United States. The Liberty Bell was rung in Philadelphia on July 8, 1776, after the first public reading of the Declaration of Independence.
&lt;/html&gt;</text><image w="153" h="136">T054532A.jpg</image><imagerefid>1B8284B3</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Joseph Nettis</credits><rewardcredits>Photo Researchers, Inc./Joseph Nettis</rewardcredits></quiz>