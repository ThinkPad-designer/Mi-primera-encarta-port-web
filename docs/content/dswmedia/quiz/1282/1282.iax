<?xml version="1.0"?><quiz type="multichoice" id="1282" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal hace este sonido?
&lt;/html&gt;</text><image w="149" h="132"/><imagerefid>1B8277A1</imagerefid><audio>T050425A.mp3</audio><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La vaca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La oveja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El camello&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La oveja. &lt;br&gt;&lt;br&gt;La oveja es uno de los primeros animales que domesticaron los seres humanos. De ella se utiliza su lana, su carne y su leche.
&lt;/html&gt;</text><image w="149" h="132">T050424A.jpg</image><imagerefid>1B8277A0</imagerefid><audio>T050425A.mp3</audio><audiorefid/></reward><credits>Hollywood Edge</credits><rewardcredits>Photo Researchers, Inc./K.G. Vock/Okapia</rewardcredits></quiz>