<?xml version="1.0"?><quiz type="multichoice" id="2320" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Durante qué época histórica vivió el compositor Frédéric Chopin?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Romanticismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Clasicismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Barroco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Romanticismo.&lt;br&gt;&lt;br&gt;Su música refleja perfectamente las características de este movimiento artístico, con todos sus contrastes y pasiones.&lt;/html&gt;</text><image w="149" h="132">T037467A.jpg</image><imagerefid>42D9752D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Library of Congress</rewardcredits></quiz>