<?xml version="1.0"?><quiz type="multichoice" id="1451" lang="E" hascredits="1"><question><text>&lt;html&gt;En Madagascar conviven numerosos tipos distintos de animales y de plantas. ¿Qué palabra se utiliza para referirse a la gama de organismos que viven en un mismo lugar?
&lt;/html&gt;</text><image w="153" h="136">T642850A.jpg</image><imagerefid>1B82B3E7</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Biodiversidad&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bioluminiscencia &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Biorritmo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Biotelemetría&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Biodiversidad.&lt;br&gt;&lt;br&gt;&lt;i&gt;Bio-&lt;/i&gt; quiere decir &apos;vida&apos;, y &lt;i&gt;diversidad&lt;/i&gt; significa &apos;variedad&apos;.
&lt;/html&gt;</text><image w="153" h="136">T642850A.jpg</image><imagerefid>1B82B3E7</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Nigel J. Dennis; ABPL</credits><rewardcredits>Corbis/Nigel J. Dennis; ABPL</rewardcredits></quiz>