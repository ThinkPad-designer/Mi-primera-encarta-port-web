<?xml version="1.0"?><quiz type="multichoice" id="1381" lang="E" hascredits="1"><question><text>&lt;html&gt;Costa de Marfil es un país situado en el occidente africano. ¿De dónde procede el marfil que da nombre a ese Estado?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;De los colmillos de los elefantes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De los picos de las aves&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De las conchas de las tortugas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De los cocos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De los colmillos de los elefantes.&lt;br&gt;&lt;br&gt;Muchísimos elefantes murieron abatidos debido a la riqueza que prometían sus colmillos, hasta que en 1989 se firmó un tratado internacional que prohibía el comercio de marfil.
&lt;/html&gt;</text><image w="153" h="137">T050444A.jpg</image><imagerefid>1B8277B4</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>