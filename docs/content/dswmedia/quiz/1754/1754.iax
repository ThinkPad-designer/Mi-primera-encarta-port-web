<?xml version="1.0"?><quiz type="multichoice" id="1754" lang="E" hascredits="0"><question><text>&lt;html&gt;True or False: No one is a citizen of Antarctica.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;Antarctica is not a country, nor does it belong to any country. Some scientists and workers live in Antarctica year-round, but they are not citizens of Antarctica.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>