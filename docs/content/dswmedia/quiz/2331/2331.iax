<?xml version="1.0"?><quiz type="multichoice" id="2331" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál es el orden correcto de las notas musicales en la escala de clave de sol?:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Mi, sol, si, re, fa, la, do&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Si, fa, do, sol, re, la, mi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Do, re, mi, fa sol, la, si&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Do, re, mi, fa sol, la, si.&lt;br&gt;&lt;br&gt;De todas formas, una escala puede comenzar por cualquiera de las notas, no necesariamente por el do. Así, otro ejemplo podría ser fa, sol, la, si, do, re, mi.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>