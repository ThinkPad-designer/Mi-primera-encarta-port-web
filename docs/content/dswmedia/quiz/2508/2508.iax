<?xml version="1.0"?><quiz type="multichoice" id="2508" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama el tipo de flauta más frecuente en las orquestas y más utilizado en la música clásica?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Flauta travesera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Flauta de pico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Flauta de Pan&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Flauta travesera.&lt;br&gt;&lt;br&gt;La flauta travesera también se utiliza mucho en otros tipos de música, como la celta.
&lt;/html&gt;</text><image w="149" h="132">T025451A.jpg</image><imagerefid>1B823724</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>