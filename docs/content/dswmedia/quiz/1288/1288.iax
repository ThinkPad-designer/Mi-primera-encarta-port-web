<?xml version="1.0"?><quiz type="multichoice" id="1288" lang="E" hascredits="0"><question><text>&lt;html&gt;El pavo doméstico desciende de una especie salvaje que vive en...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;China&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;México&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;España&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Marruecos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;México.&lt;br&gt;&lt;br&gt;El pavo doméstico es el descendiente de una especie salvaje, denominada pavo común o guajolote, nativa del norte de México.
