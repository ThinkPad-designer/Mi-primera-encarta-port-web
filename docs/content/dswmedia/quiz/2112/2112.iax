<?xml version="1.0"?><quiz type="multichoice" id="2112" lang="E" hascredits="0"><question><text>&lt;html&gt;Cuando un gato mueve la cola, significa que está...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;contento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;nervioso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;hambriento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;enfadado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Nervioso. &lt;br&gt;&lt;br&gt;Cuando los gatos mueven la cola significa que están inquietos y es mejor dejarlos tranquilos.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>