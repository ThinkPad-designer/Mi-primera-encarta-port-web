<?xml version="1.0"?><quiz type="multichoice" id="1718" lang="E" hascredits="0"><question><text>&lt;html&gt;True or False: The largest freshwater lakes in Australia are artificial.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;There are several saltwater lakes in the Australian outback. However, the largest freshwater lakes, such as Lake Argyle in northern Australia, are reservoirs created by damming rivers.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>