<?xml version="1.0"?><quiz type="multichoice" id="1698" lang="E" hascredits="0"><question><text>&lt;html&gt;How tall is Mount Kosciusko, the tallest mountain in Australia?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;7,310 feet (2,228 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;10,023 feet (3,055 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;13,680 feet (4,170 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;16,066 feet (4,897 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;7,310 feet (2,228 meters).&lt;br&gt;&lt;br&gt;Of all the high points of the seven continents, Mount Kosciusko is the shortest.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>