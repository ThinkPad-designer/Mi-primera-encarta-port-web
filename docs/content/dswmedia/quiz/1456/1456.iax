<?xml version="1.0"?><quiz type="multichoice" id="1456" lang="E" hascredits="1"><question><text>&lt;html&gt;En el desierto de Kalahari viven muchas especies de antílopes. Una de las siguientes frases relacionadas con los antílopes es falsa. ¿Cuál?
&lt;/html&gt;</text><image w="149" h="149">T040711A.jpg</image><imagerefid>1B825551</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Los antílopes pertenecen a la familia de los Bóvidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los antílopes son rumiantes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los elands son los antílopes más grandes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los antílopes son carnívoros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los antílopes son carnívoros.&lt;br&gt;&lt;br&gt;Los antílopes son herbívoros, es decir, comen solo vegetales. No comen carne.
&lt;/html&gt;</text><image w="149" h="149">T040711A.jpg</image><imagerefid>1B825551</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./S.R. Maglione</credits><rewardcredits>Photo Researchers, Inc./S.R. Maglione</rewardcredits></quiz>