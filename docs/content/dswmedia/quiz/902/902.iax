<?xml version="1.0"?><quiz type="multichoice" id="902" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Qué cantidad de agua necesita tu organismo cada día? 

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;10 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;6 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;4 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;2 litros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;2 litros. &lt;br&gt;&lt;br&gt;Tu cuerpo necesita unos 2 litros de agua diarios. Además de beber agua y otros líquidos, el agua está presente también en muchos alimentos, como las frutas y las verduras.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>