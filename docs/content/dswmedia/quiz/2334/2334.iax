<?xml version="1.0"?><quiz type="multichoice" id="2334" lang="E" hascredits="1"><question><text>&lt;html&gt;El compositor Franz Schubert, a pesar de fallecer muy joven, compuso gran cantidad de obras maestras. De todas ellas, destacan sobre todo:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Los Lieder (canciones) y las piezas para piano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los septetos de viento&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las sonatas para instrumentos de percusión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los Lieder (canciones) y las piezas para piano.&lt;br&gt;&lt;br&gt;No obstante, también compuso obras orquestales y obras de música de cámara que también fueron obras maestras.&lt;/html&gt;</text><image w="99" h="149">000a3c77.jpg</image><imagerefid>479D854A</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Archivo Iconografico, S.A.</rewardcredits></quiz>