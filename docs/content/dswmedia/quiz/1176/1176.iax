<?xml version="1.0"?><quiz type="multichoice" id="1176" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De qué animales salvajes descienden los perros?&lt;/html&gt;</text><image w="149" h="99">0017043f.jpg</image><imagerefid>29D3211B</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;De los tigres&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De los conejos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De los lobos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De los cocodrilos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De los lobos. &lt;br&gt;&lt;br&gt;Los perros descienden de los lobos.
&lt;/html&gt;</text><image w="149" h="99">0017043f.jpg</image><imagerefid>29D3211B</imagerefid><audio/><audiorefid/></reward><credits>Courtesy of Jim Oker</credits><rewardcredits>Courtesy of Jim Oker</rewardcredits></quiz>