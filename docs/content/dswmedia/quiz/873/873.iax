<?xml version="1.0"?><quiz type="multichoice" id="873" lang="E" hascredits="1"><question><text>&lt;html&gt;Tu corazón bombea sangre hacia los pulmones. Allí, la sangre capta el oxígeno y cede otro gas ¿Sabrías decir cuál es?

&lt;/html&gt;</text><image w="149" h="149">T012333A.jpg</image><imagerefid>42D9648A</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Hidrógeno&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Helio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Dióxido de carbono&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Óxido nitroso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Dióxido de carbono. &lt;br&gt;&lt;br&gt;En los pulmones se produce un intercambio de gases entre la sangre y el aire. La sangre capta el oxígeno del aire y cede el dióxido de carbono.&lt;/html&gt;</text><image w="149" h="149">T012333A.jpg</image><imagerefid>42D9648A</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>