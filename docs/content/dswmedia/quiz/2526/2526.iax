<?xml version="1.0"?><quiz type="multichoice" id="2526" lang="E" hascredits="1"><question><text>&lt;html&gt;Sviatoslav Richter, Vladimir Horowitz, Arthur Rubinstein y Arturo Benedetti Michelangeli fueron grandes instrumentistas del siglo XX, pero ¿qué instrumento tocaban?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El violín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El oboe&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El piano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El piano.&lt;br&gt;&lt;br&gt;Aunque cada uno tenía su propia personalidad y su propia forma de tocar, todos ellos se han convertido en grandes mitos del piano.&lt;/html&gt;</text><image w="149" h="149">T631141A.jpg</image><imagerefid>1B82AECD</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Michael Boys</rewardcredits></quiz>