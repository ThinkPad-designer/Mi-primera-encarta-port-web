<?xml version="1.0"?><quiz type="multichoice" id="2813" lang="E" hascredits="0"><question><text>&lt;html&gt;Le littoral dynamique de la mégalopole japonaise est situé&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;dans le nord du pays.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;dans le nord-ouest du pays.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;dans le sud-est du pays.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 3.&lt;br&gt;&lt;br&gt;Le littoral de la mégalopole japonaise se trouve dans le sud-est du pays et regroupe l&apos;essentiel de ses ports (Tokyo, Yokohama) et de ses activités économiques les plus dynamiques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>