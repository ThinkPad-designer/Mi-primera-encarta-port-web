<?xml version="1.0"?><quiz type="multichoice" id="1255" lang="E" hascredits="1"><question><text>&lt;html&gt;True or False: A female black widow spider eats the male after mating.
&lt;/html&gt;</text><image w="149" h="132">T013720A.jpg</image><imagerefid>1B823215</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;False. &lt;br&gt;&lt;br&gt;Contrary to popular belief, male black widow spiders are not harmed after mating.  
&lt;/html&gt;</text><image w="149" h="132">T013720A.jpg</image><imagerefid>1B823215</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/J.A.L. Cooke</credits><rewardcredits>Oxford Scientific Films/J.A.L. Cooke</rewardcredits></quiz>