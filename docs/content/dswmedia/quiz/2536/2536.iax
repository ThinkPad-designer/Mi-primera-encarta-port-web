<?xml version="1.0"?><quiz type="multichoice" id="2536" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En qué año, que coincide con el final del periodo barroco, murió el gran compositor alemán Johann Sebastian Bach?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;1750&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1800&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;1700&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;1750.&lt;br&gt;&lt;br&gt;Solamente seis años más tarde nacería Wolfgang Amadeus Mozart, ya perteneciente al clasicismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>