<?xml version="1.0"?><quiz type="multichoice" id="852" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes cuántos huesos hay en el cuerpo de un adulto?
&lt;/html&gt;</text><image w="153" h="153">000a4ceb.jpg</image><imagerefid>29D02C25</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;12&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;70&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;150&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;206&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;206. &lt;br&gt;&lt;br&gt;Los huesos forman el esqueleto que da forma a tu cuerpo y te permite, con ayuda de los músculos, moverte. Además, sostiene y protege los órganos y sirve como almacén de muchos minerales.
&lt;/html&gt;</text><image w="153" h="153">000a4ceb.jpg</image><imagerefid>29D02C25</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>