<?xml version="1.0"?><quiz type="multichoice" id="1293" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal hace este sonido?
&lt;/html&gt;</text><image w="149" h="132"/><imagerefid>1B827546</imagerefid><audio>T049817A.mp3</audio><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El pavo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cerdo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La cabra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El conejo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El cerdo. &lt;br&gt;&lt;br&gt;Se cree que los cerdos se domesticaron en China. El cerdo tiene un cuerpo pesado, hocico largo y flexible y patas cortas con pezuñas.&lt;/html&gt;</text><image w="149" h="132">T049816A.jpg</image><imagerefid>1B827546</imagerefid><audio>T049817A.mp3</audio><audiorefid/></reward><credits>Oxford Scientific Films/Mark Hamblin</credits><rewardcredits>Oxford Scientific Films/Mark Hamblin</rewardcredits></quiz>