<?xml version="1.0"?><quiz type="multichoice" id="1308" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué es esto?
&lt;/html&gt;</text><image w="149" h="132">T012503A.jpg</image><imagerefid>1B822E7E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La concha de un berberecho.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los dientes de un caballo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los dientes de una persona.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La concha de un mejillón.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los dientes de un caballo. &lt;br&gt;&lt;br&gt;Los caballos son animales herbívoros y utilizan los dientes para cortar la hierba. Su inclinación hacia fuera se incrementa con la edad del caballo, lo que permite determinar su edad.
&lt;/html&gt;</text><image w="149" h="132">T012503A.jpg</image><imagerefid>1B822E7E</imagerefid><audio/><audiorefid/></reward><credits>Phototake NYC/James Hayden</credits><rewardcredits>Phototake NYC/James Hayden</rewardcredits></quiz>