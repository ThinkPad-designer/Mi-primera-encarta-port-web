<?xml version="1.0"?><quiz type="multichoice" id="1231" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes aves puede alcanzar velocidades de 320 kilómetros por hora cuando se lanza en picado para capturar a sus presas?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El águila calva&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El canario&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El halcón peregrino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El frailecillo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El halcón peregrino. &lt;br&gt;&lt;br&gt;Para cazar, el halcón peregrino vuela muy rápido y se lanza en picado para capturar aves pequeñas. También puede alimentarse de pequeños mamíferos que captura en el suelo.
&lt;/html&gt;</text><image w="99" h="149">001ad5f9.jpg</image><imagerefid>42D9D7AC</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Eric and David Hosking</rewardcredits></quiz>