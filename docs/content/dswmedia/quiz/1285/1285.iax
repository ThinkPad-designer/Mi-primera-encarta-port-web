<?xml version="1.0"?><quiz type="multichoice" id="1285" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un ave, aunque no puedo volar. Vivo en África y con mis dos metros de altura, soy la más grande de todas las aves.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El pingüino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El águila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La cigüeña&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El avestruz. &lt;br&gt;&lt;br&gt;Es un ave no voladora, que se cría para obtener su carne, sus plumas y su piel.&lt;/html&gt;</text><image w="149" h="132">T049910A.jpg</image><imagerefid>1B8275A2</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Stan Osolinski</rewardcredits></quiz>