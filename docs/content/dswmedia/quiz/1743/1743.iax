<?xml version="1.0"?><quiz type="multichoice" id="1743" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the smallest country in Europe (by land area)?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Monaco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Liechtenstein&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;San Marino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vatican City&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Vatican City.&lt;br&gt;&lt;br&gt;Vatican City is the smallest country in the world (by land area). It’s just a little bigger than the Mall of America in Bloomington, Minnesota. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>