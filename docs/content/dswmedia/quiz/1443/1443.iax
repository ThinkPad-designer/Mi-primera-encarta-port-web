<?xml version="1.0"?><quiz type="multichoice" id="1443" lang="E" hascredits="1"><question><text>&lt;html&gt;A Madagascar se le suele llamar en ocasiones &apos;la gran isla roja&apos; por el color de su tierra. ¿Qué es lo que da ese color rojizo a las tierras malgaches?
&lt;/html&gt;</text><image w="150" h="98">0018a6c6.jpg</image><imagerefid>42D982D9</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El calcio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La sal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El hierro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El plomo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El hierro.&lt;br&gt;&lt;br&gt;Ese suelo rojo se debe a la presencia de hierro en la isla, combinado con otras tierras asimismo rojizas.
&lt;/html&gt;</text><image w="150" h="98">0018a6c6.jpg</image><imagerefid>42D982D9</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Frans Lanting</credits><rewardcredits>Corbis/Frans Lanting</rewardcredits></quiz>