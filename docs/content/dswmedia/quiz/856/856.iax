<?xml version="1.0"?><quiz type="multichoice" id="856" lang="E" hascredits="1"><question><text>&lt;html&gt;A veces, con la edad, los huesos se vuelven porosos y se fracturan con facilidad. ¿Sabes cuál es el nombre de esta enfermedad?

&lt;/html&gt;</text><image w="148" h="130">T242298A.jpg</image><imagerefid>1B8294EB</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Varicela&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Alzheimer&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Osteoporosis&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Esclerosis múltiple&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Osteroporosis.&lt;br&gt;&lt;br&gt;Cuando se produce esta enfermedad los huesos se debilitan y se rompen con facilidad. 
&lt;/html&gt;</text><image w="148" h="130">T242298A.jpg</image><imagerefid>1B8294EB</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./Michael Klein</credits><rewardcredits>Peter Arnold, Inc./Michael Klein</rewardcredits></quiz>