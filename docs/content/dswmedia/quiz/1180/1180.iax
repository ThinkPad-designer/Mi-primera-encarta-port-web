<?xml version="1.0"?><quiz type="multichoice" id="1180" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Por qué el perro mueve la cola?
&lt;/html&gt;</text><image w="149" h="132">T043377A.jpg</image><imagerefid>1B825DCF</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Para espantar a las moscas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Para mostrar su alegría.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Para avisar de un peligro.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Para que le arrasques.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Para mostrar su alegría. &lt;br&gt;&lt;br&gt;El perro mueve la cola delante de ti para ‘decirte’ que está contento.&lt;/html&gt;</text><image w="149" h="132">T043377A.jpg</image><imagerefid>1B825DCF</imagerefid><audio/><audiorefid/></reward><credits>Animals Animals/Robert and Eunice Pearcy</credits><rewardcredits>Animals Animals/Robert and Eunice Pearcy</rewardcredits></quiz>