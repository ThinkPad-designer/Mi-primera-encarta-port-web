<?xml version="1.0"?><quiz type="multichoice" id="2812" lang="E" hascredits="0"><question><text>&lt;html&gt;La mégalopole japonaise s&apos;étend principalement sur&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;l&apos;île d&apos;Honshu.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;l&apos;île d&apos;Hokkaido.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;l&apos;île de Shikoku.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 1.&lt;br&gt;&lt;br&gt;La mégalopole japonaise s&apos;étend principalement sur l&apos;île d&apos;Honshu, de Tokyo à Kitakyushu.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>