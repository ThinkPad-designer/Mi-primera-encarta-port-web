<?xml version="1.0"?><quiz type="multichoice" id="1385" lang="E" hascredits="0"><question><text>&lt;html&gt;En la costa occidental africana se encuentra Ghana. ¿Cuál es su capital?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Abiyán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Abuja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Accra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Argel&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Accra.&lt;br&gt;&lt;br&gt;La ciudad de Accra era ya capital de la colonia británica de Costa de Oro desde la segunda mitad del siglo XIX, y siguió siéndolo a partir de 1957 del ya independiente país llamado Ghana.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>