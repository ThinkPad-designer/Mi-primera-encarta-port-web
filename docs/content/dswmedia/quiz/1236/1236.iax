<?xml version="1.0"?><quiz type="multichoice" id="1236" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un ave incapaz de volar y vivo en Nueva Zelanda. Mi nombre también es el de una fruta. ¿Sabes quién soy?
&lt;/html&gt;</text><image w="153" h="102">T172853A.jpg</image><imagerefid>25A41230</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El kiwi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El pájaro banana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El chochín manzana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El halcón pera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El kiwi. &lt;br&gt;&lt;br&gt;Su visión no es buena y buscan la comida por medio del olfato, algo poco común en las aves.
&lt;/html&gt;</text><image w="153" h="102">T172853A.jpg</image><imagerefid>25A41230</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./Clyde H. Smith</credits><rewardcredits>Peter Arnold, Inc./Clyde H. Smith</rewardcredits></quiz>