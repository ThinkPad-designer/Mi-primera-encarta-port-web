<?xml version="1.0"?><quiz type="multichoice" id="1467" lang="E" hascredits="1"><question><text>&lt;html&gt;Al oeste del Kalahari se halla otro desierto: el desierto de Namibia. ¿Por qué país se extiende principalmente esta inhóspita y enorme región desértica?
&lt;/html&gt;</text><image w="149" h="132">T002492A.jpg</image><imagerefid>1B8224CC</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Por Nam&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Por Namibia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Por Namibilandia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Por Namistán&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Por Namibia.&lt;br&gt;&lt;br&gt;El desierto de Namibia ocupa toda la costa de Namibia y parte del norte occidental de Sudáfrica.
&lt;/html&gt;</text><image w="149" h="132">T002492A.jpg</image><imagerefid>1B8224CC</imagerefid><audio/><audiorefid/></reward><credits>James G. Teer</credits><rewardcredits>James G. Teer</rewardcredits></quiz>