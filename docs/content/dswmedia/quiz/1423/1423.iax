<?xml version="1.0"?><quiz type="multichoice" id="1423" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En qué año fue creado el Parque nacional Serengeti?&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;En 1941&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En 1900&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En 1234&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En el 300 a.C.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En 1941.&lt;br&gt;&lt;br&gt;El primer parque nacional de la historia, el Parque nacional Yellowstone, no fue fundado hasta 1872. En África hubo que esperar a que avanzara unas cuantas décadas el siglo XX para asistir a la fundación de los primeros parques nacionales.
&lt;/html&gt;</text><image w="0" h="0"/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>