<?xml version="1.0"?><quiz type="multichoice" id="846" lang="E" hascredits="1"><question><text>&lt;html&gt;Una de las causas de que se acumule mucho azúcar en la sangre es que nuestro organismo fabrica muy poca o ninguna cantidad de una hormona llamada...

&lt;/html&gt;</text><image w="149" h="149">T013544A.jpg</image><imagerefid>42D95CFF</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Estrógenos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Progesterona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Testosterona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Insulina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Insulina. &lt;br&gt;&lt;br&gt;La insulina es una hormona que se produce en el páncreas y que ayuda a que la glucosa entre en todas las células del organismo. La falta de insulina produce una enfermedad llamada diabetes.
&lt;/html&gt;</text><image w="149" h="149">T013544A.jpg</image><imagerefid>42D95CFF</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>