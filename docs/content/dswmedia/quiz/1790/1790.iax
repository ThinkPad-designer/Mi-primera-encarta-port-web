<?xml version="1.0"?><quiz type="multichoice" id="1790" lang="E" hascredits="1"><question><text>&lt;html&gt;There are no cities in Antarctica, but there are...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Military bases&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Oil wells&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Scientific stations&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;All of the above&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Scientific stations.&lt;br&gt;&lt;br&gt;The international Antarctic Treaty forbids military operations and mining in Antarctica.
&lt;/html&gt;</text><image w="153" h="153">T038225A.jpg</image><imagerefid>25A403F3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Dr. David Millar</rewardcredits></quiz>