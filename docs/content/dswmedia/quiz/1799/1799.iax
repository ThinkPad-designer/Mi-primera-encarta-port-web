&lt;/html&gt;</text><image w="153" h="136">T041058A.jpg</image><imagerefid>07400FF9</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Buenos Aires&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Montevideo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Rio de Janeiro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;São Paulo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Rio de Janeiro.&lt;br&gt;&lt;br&gt;Rio de Janeiro is in Brazil. Rio’s dramatic natural setting makes for stunning travel photos!
