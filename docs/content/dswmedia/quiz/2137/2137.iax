<?xml version="1.0"?><quiz type="multichoice" id="2137" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el animal más grande?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;La ballena azul&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El hipopótamo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La orca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La ballena azul. &lt;br&gt;&lt;br&gt;Esta ballena puede alcanzar 24 metros de longitud y un peso de 150 toneladas.&lt;/html&gt;</text><image w="149" h="132">T025799A.jpg</image><imagerefid>1B823810</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Minden Pictures/Flip Nicklin</rewardcredits></quiz>