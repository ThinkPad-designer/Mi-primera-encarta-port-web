<?xml version="1.0"?><quiz type="multichoice" id="2111" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes peces es un carpín dorado?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="149" h="132">T013772A.jpg</image><imagerefid>1B823238</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T285405A.jpg</image><imagerefid>1B8295F9</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T014021A.jpg</image><imagerefid>1B8232F0</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T010578A.jpg</image><imagerefid>1B8227E4</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los carpines dorados se han criado en cautividad durante muchos siglos, en particular en Japón y China, y están adaptados a las aguas dulces de todo el mundo. Son muy populares como mascotas. &lt;/html&gt;</text><image w="149" h="132">T014021A.jpg</image><imagerefid>1B8232F0</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Max Gibbs&lt;br&gt;&lt;br&gt;Animals Animals/E.R. Degginger&lt;br&gt;&lt;br&gt;Phototake NYC/Mitch Kezar&lt;br&gt;&lt;br&gt;Oxford Scientific Films/G. H. Thompson</credits><rewardcredits>Phototake NYC/Mitch Kezar</rewardcredits></quiz>