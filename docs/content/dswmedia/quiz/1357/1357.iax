<?xml version="1.0"?><quiz type="multichoice" id="1357" lang="E" hascredits="1"><question><text>&lt;html&gt;¿En qué país discurre el curso del río Níger cuando desemboca en el océano Atlántico?&lt;/html&gt;</text><image w="149" h="132">T054859A.jpg</image><imagerefid>1B8285F8</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;En Níger&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En Nigeria&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En Malí&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En Benín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En Nigeria.&lt;br&gt;&lt;br&gt;El río Níger forma un delta en su desembocadura, ya en el sur de Nigeria.
&lt;/html&gt;</text><image w="149" h="132">T054859A.jpg</image><imagerefid>1B8285F8</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./M. Bertinetti</credits><rewardcredits>Photo Researchers, Inc./M. Bertinetti</rewardcredits></quiz>