<?xml version="1.0"?><quiz type="multichoice" id="1256" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un insecto pequeño, sin alas, que pone los huevos en el pelo de las personas. Las crías se alimentan de sangre humana. ¿Quién soy?&lt;/html&gt;</text><image w="149" h="132">T013787A.jpg</image><imagerefid>1B823245</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Un ácaro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una termita&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un escorpión&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Un piojo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un piojo. &lt;br&gt;&lt;br&gt;Los piojos son blanquecinos cuando nacen. Cuando empiezan a alimentarse de sangre, adquieren un color pardo rojizo.&lt;/html&gt;</text><image w="149" h="132">T013787A.jpg</image><imagerefid>1B823245</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/J.A.L. Cooke</credits><rewardcredits>Oxford Scientific Films/J.A.L. Cooke</rewardcredits></quiz>