<?xml version="1.0"?><quiz type="multichoice" id="905" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes cuál de estos nutrientes utiliza nuestro organismo para construir los tejidos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Hidratos de carbono&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Minerales &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Proteínas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vitaminas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Proteínas. &lt;br&gt;&lt;br&gt;Las proteínas son nutrientes imprescindibles para formar los tejidos. Los alimentos como la carne, el pescado, los huevos, los productos lácteos y las legumbres son muy ricos en proteínas.
&lt;/html&gt;</text><image w="149" h="132">T014283A.jpg</image><imagerefid>1B8233B0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>