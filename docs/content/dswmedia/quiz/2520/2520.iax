<?xml version="1.0"?><quiz type="multichoice" id="2520" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuáles de los siguientes instrumentos pertenecen al grupo de instrumentos de cuerda?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Flauta, clarinete, oboe y fagot&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Metalófono, crótalos, triángulo y gong&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Violín, viola, violonchelo y contrabajo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Violín, viola, violonchelo y contrabajo.&lt;br&gt;&lt;br&gt;Estos forman el grupo principal de cuerda en las orquestas, aunque además pueden aparecer el piano y el arpa.&lt;/html&gt;</text><image w="149" h="132">T974867A.jpg</image><imagerefid>1B82B8A4</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Performing Arts Library/Clive Barda</rewardcredits></quiz>