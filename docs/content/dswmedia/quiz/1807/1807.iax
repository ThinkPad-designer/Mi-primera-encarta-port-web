<?xml version="1.0"?><quiz type="multichoice" id="1807" lang="E" hascredits="1"><question><text>&lt;html&gt;This cathedral is in what European city?
&lt;/html&gt;</text><image w="153" h="102">T050655A.jpg</image><imagerefid>1B82EFCA</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;London&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Madrid&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Paris&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Rome&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Paris.&lt;br&gt;&lt;br&gt;This is Notre Dame Cathedral, possibly the best-known Gothic cathedral in the world.
&lt;/html&gt;</text><image w="153" h="102">T050655A.jpg</image><imagerefid>1B82EFCA</imagerefid><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York/Giraudon</credits><rewardcredits>Bridgeman Art Library, London/New York/Giraudon</rewardcredits></quiz>