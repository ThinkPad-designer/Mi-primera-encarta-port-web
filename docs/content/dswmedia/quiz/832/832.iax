<?xml version="1.0"?><quiz type="multichoice" id="832" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué sabor distingues con la punta de la lengua?

&lt;/html&gt;</text><image w="149" h="132">T013498A.jpg</image><imagerefid>42D956A5</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Dulce&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Amargo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Agrio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Salado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Dulce. &lt;br&gt;&lt;br&gt; Las papilas gustativas diferencian cuatro sabores: dulce, salado, agrio y amargo.
