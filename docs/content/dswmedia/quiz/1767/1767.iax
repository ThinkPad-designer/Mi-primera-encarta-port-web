<?xml version="1.0"?><quiz type="multichoice" id="1767" lang="E" hascredits="1"><question><text>&lt;html&gt;True or False: The country of Australia is the only country on the continent of Australia.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;The country of Australia occupies the entire continent of Australia.&lt;/html&gt;</text><image w="149" h="149">00123d61.jpg</image><imagerefid>29D2648F</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>