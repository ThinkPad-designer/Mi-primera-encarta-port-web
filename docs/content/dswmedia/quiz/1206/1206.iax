<?xml version="1.0"?><quiz type="multichoice" id="1206" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué animal salvaje es el que está más emparentado con los seres humanos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El babuino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La hiena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El chimpancé&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El gibón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El chimpancé.&lt;br&gt;&lt;br&gt;El chimpancé, que vive en África, está considerado el animal más estrechamente emparentado con el ser humano. &lt;/html&gt;</text><image w="153" h="136">T049656A.jpg</image><imagerefid>1B8274AC</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Mike Birkhead</rewardcredits></quiz>