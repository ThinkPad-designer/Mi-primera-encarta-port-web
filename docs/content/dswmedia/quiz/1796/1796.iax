<?xml version="1.0"?><quiz type="multichoice" id="1796" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of New Zealand?
&lt;/html&gt;</text><image w="149" h="99">T054847A.jpg</image><imagerefid>1B8285ED</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Auckland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Christchurch&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Queenstown&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Wellington&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Wellington.&lt;br&gt;&lt;br&gt;Wellington is located at the southern end of New Zealand’s North Island.
&lt;/html&gt;</text><image w="149" h="99">T054847A.jpg</image><imagerefid>1B8285ED</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Carroll Seghers</credits><rewardcredits>Photo Researchers, Inc./Carroll Seghers</rewardcredits></quiz>