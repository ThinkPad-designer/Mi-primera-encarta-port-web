<?xml version="1.0"?><quiz type="multichoice" id="2802" lang="E" hascredits="0"><question><text>&lt;html&gt;La vallée du Rhin est une voie navigable à grand gabarit&#38;nbsp;:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;en amont de Bâle.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;en aval de Bâle.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;uniquement de Duisbourg à Bâle.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Réponse&#38;nbsp;: 2.&lt;br&gt;&lt;br&gt;Le Rhin est accessible à la navigation à grand gabarit de Rotterdam (Pays-Bas) à Bâle (Suisse), soit en aval de Bâle.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>