<?xml version="1.0"?><quiz type="multichoice" id="1715" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the largest lake in Europe?
&lt;/html&gt;</text><image w="149" h="99">0005BC09.jpg</image><imagerefid>289EDD77</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Lake Balaton (Hungary)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lake Como (Italy)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Geneva (Switzerland)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Ladoga (Russia)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Ladoga (Russia).&lt;br&gt;&lt;br&gt;Lake Ladoga, near Saint Petersburg in northwestern Russia, is the largest lake in Europe. It covers 7,100 square miles (18,390 square kilometers).
&lt;/html&gt;</text><image w="149" h="99">0005BC09.jpg</image><imagerefid>289EDD77</imagerefid><audio/><audiorefid/></reward><credits>Boris Kuznetsov/BorisKuznetsov.com</credits><rewardcredits>Boris Kuznetsov/BorisKuznetsov.com</rewardcredits></quiz>