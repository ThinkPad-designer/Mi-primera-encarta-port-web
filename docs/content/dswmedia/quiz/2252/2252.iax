<?xml version="1.0"?><quiz type="multichoice" id="2252" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes gusanos es una sanguijuela?&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="149" h="133">T050852A.jpg</image><imagerefid>1B82794B</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T045339A.jpg</image><imagerefid>1B82652C</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T037573A.jpg</image><imagerefid>1B82494A</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="132">T067725A.jpg</image><imagerefid>061E1D4B</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sanguijuela.&lt;br&gt;&lt;br&gt;Las sanguijuelas son gusanos aplanados que poseen una ventosa en cada extremo de su cuerpo. Se alimentan de la sangre de numerosos vertebrados.&lt;/html&gt;</text><image w="149" h="132">T067725A.jpg</image><imagerefid>061E1D4B</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Michael Fogden&lt;br&gt;&lt;br&gt;Oxford Scientific Films/David Thompson&lt;br&gt;&lt;br&gt;Animals Animals/E. R. Degginger&lt;br&gt;&lt;br&gt;Animals Animals/Robert Maier</credits><rewardcredits>Animals Animals/Robert Maier</rewardcredits></quiz>