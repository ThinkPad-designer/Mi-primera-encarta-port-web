<?xml version="1.0"?><quiz type="multichoice" id="127" lang="E" hascredits="0"><question><text>&lt;html&gt;La electrónica y los ordenadores han desempeñado un papel muy importante en la música clásica de los últimos tiempos. Su instrumento fundamental ha sido el sintetizador. ¿Puede un sintetizador crear sonidos nuevos?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;No; solo puede reproducir sonidos de instrumentos musicales conocidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Sí, pero sólo un número reducido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sí, y prácticamente sin límite&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>