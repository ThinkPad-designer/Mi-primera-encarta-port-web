<?xml version="1.0"?><quiz type="multichoice" id="2513" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cómo se llama a la distancia que existe entre dos notas musicales?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Distancia armónica&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Intervalo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Apertura &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Intervalo.&lt;br&gt;&lt;br&gt;Los intervalos, según su amplitud, están acompañados de un número que indica la distancia entre las dos notas. Cuanto mayor es el número, mayor es el intervalo y la distancia (intervalo de cuarta, intervalo de sexta, etc.…)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>