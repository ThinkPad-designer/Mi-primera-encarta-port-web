<?xml version="1.0"?><quiz type="multichoice" id="1818" lang="E" hascredits="0"><question><text>&lt;html&gt;True or False: Canada has two official languages.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;True&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;False&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;True.&lt;br&gt;&lt;br&gt;Both English and French are official languages of Canada. &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>