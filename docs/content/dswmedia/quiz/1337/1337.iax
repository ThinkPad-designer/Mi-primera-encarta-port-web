<?xml version="1.0"?><quiz type="multichoice" id="1337" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de estas pirámides &lt;b&gt;no&lt;/b&gt; está en Egipto?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text/><image w="149" h="132">T010378A.jpg</image><imagerefid>1B82276D</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T010406A.jpg</image><imagerefid>1B82277E</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T041256A.jpg</image><imagerefid>1B82DC95</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T373717A.jpg</image><imagerefid>1B829CB5</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Esta pirámide de vidrio se encuentra en el Museo del Louvre, situado en la capital de Francia, París.&lt;/html&gt;</text><image w="149" h="132">T041256A.jpg</image><imagerefid>1B82DC95</imagerefid><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York/Bernard Cox&lt;br&gt;&lt;br&gt;Bridgeman Art Library, London/New York/Giraudon&lt;br&gt;&lt;br&gt;Liaison Agency/Charles Nes&lt;br&gt;&lt;br&gt;Woodfin Camp and Associates, Inc./Barry Iverson</credits><rewardcredits>Liaison Agency/Charles Nes</rewardcredits></quiz>