<?xml version="1.0"?><quiz type="multichoice" id="1344" lang="E" hascredits="1"><question><text>&lt;html&gt;El desierto del Sahara es enorme. ¿Sabes cómo es de grande?
&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Tiene unos 600 km de norte a sur y unos 100 km de este a oeste&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tiene unos 1.000 km de norte a sur y unos 20 km de este a oeste&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tiene unos 10.000 km de norte a sur y unos 10.000 km de este a oeste&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Tiene unos 1.600 km de norte a sur y unos 5.100 km de este a oeste&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tiene unos 1.600 km de norte a sur y unos 5.100 km de este a oeste.&lt;br&gt;&lt;br&gt;¡Es más extenso que todo el territorio de Estados Unidos!
&lt;/html&gt;</text><image w="153" h="102">T166443A.jpg</image><imagerefid>42D9D883</imagerefid><audio/><audiorefid/></reward><credits>Reuters/David Rouge (MAURITANIA)</credits><rewardcredits>Reuters/David Rouge (MAURITANIA)</rewardcredits></quiz>