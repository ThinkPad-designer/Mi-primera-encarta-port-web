<?xml version="1.0"?><quiz type="multichoice" id="1813" lang="E" hascredits="1"><question><text>&lt;html&gt;This is Machu Picchu, an ancient Incan city. What country is it in?
&lt;/html&gt;</text><image w="153" h="102">T374125A.jpg</image><imagerefid>1B829E2C</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Colombia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Ecuador&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Peru&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Venezuela&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Peru.&lt;br&gt;&lt;br&gt;Hidden high in the mountains, Machu Picchu’s history is mysterious. No one knows when it was occupied.
&lt;/html&gt;</text><image w="153" h="102">T374125A.jpg</image><imagerefid>1B829E2C</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Jeremy Horner</credits><rewardcredits>Corbis/Jeremy Horner</rewardcredits></quiz>