<?xml version="1.0"?><quiz type="multichoice" id="2255" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuáles son los animales que más patas tienen?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Los gusanos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los milpiés&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las arañas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los pulpos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los milpiés.&lt;br&gt;&lt;br&gt;Los milpiés tienen el cuerpo formado por entre 25 y 100 segmentos, con cuatro patas en cada uno. Los ciempiés también tienen muchas patas.&lt;/html&gt;</text><image w="149" h="99">00127c40.jpg</image><imagerefid>42D97579</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/David Aubrey</rewardcredits></quiz>