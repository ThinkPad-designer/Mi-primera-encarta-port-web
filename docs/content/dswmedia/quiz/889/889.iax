<?xml version="1.0"?><quiz type="multichoice" id="889" lang="E" hascredits="1"><question><text>&lt;html&gt;Los médicos utilizan los rayos X para obtener imágenes del interior del cuerpo. ¿A qué parte del cuerpo crees que pertenece esta radiografía?
&lt;/html&gt;</text><image w="153" h="136">T012897A.jpg</image><imagerefid>29D2984C</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Huesos de la rodilla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Huesos de los dedos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Dientes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Costillas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Dientes. &lt;br&gt;&lt;br&gt;Esta es una radiografía dental.&lt;/html&gt;</text><image w="153" h="136">T012897A.jpg</image><imagerefid>29D2984C</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Vanessa Vicki</credits><rewardcredits>Photo Researchers, Inc./Vanessa Vicki</rewardcredits></quiz>