<?xml version="1.0"?><quiz type="multichoice" id="825" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de estas funciones está controlada por el cerebelo?&lt;/html&gt;</text><image w="149" h="133">T012859C.jpg</image><imagerefid>1B822F7E</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Lenguaje&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Temperatura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Equilibrio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Respiración&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El equilibrio. &lt;br&gt;&lt;br&gt;Las funciones más importantes del cerebelo son participar en la coordinación de los movimientos y en el control del equilibrio.
&lt;/html&gt;</text><image w="149" h="149"/><imagerefid/><audio/><audiorefid/></reward><credits>Oxford Scientific Films/London Scientific Films</credits><rewardcredits/></quiz>