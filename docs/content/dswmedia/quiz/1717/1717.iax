<?xml version="1.0"?><quiz type="multichoice" id="1717" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the largest lake in Africa?
&lt;/html&gt;</text><image w="149" h="99">T167088A.jpg</image><imagerefid>25A407C9</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Lake Chad (several countries)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lake Nasser (Egypt)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Tanganyika (several countries)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Victoria (several countries )&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Victoria (several countries).&lt;br&gt;&lt;br&gt;Lake Victoria, in east central Africa, is the second largest freshwater lake in the world.
&lt;/html&gt;</text><image w="149" h="99">T167088A.jpg</image><imagerefid>25A407C9</imagerefid><audio/><audiorefid/></reward><credits>Panos Pictures/J. Holmes</credits><rewardcredits>Panos Pictures/J. Holmes</rewardcredits></quiz>