<?xml version="1.0"?><quiz type="multichoice" id="911" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes &lt;b&gt;no&lt;/b&gt; es un efecto del ejercicio físico?
&lt;/html&gt;</text><image w="149" h="132">T235768a.jpg</image><imagerefid>073FCB8E</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Disminución de la tensión arterial&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Aumento de las respiraciones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sudoración&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Aumento de los latidos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Disminución de la tensión arterial. &lt;br&gt;&lt;br&gt;Al hacer ejercicio tu corazón late más deprisa, aumenta el número de respiraciones, la tensión arterial se eleva y sudas para perder calor.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits>COLORSPORT</credits><rewardcredits/></quiz>