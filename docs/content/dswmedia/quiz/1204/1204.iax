<?xml version="1.0"?><quiz type="multichoice" id="1204" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes mascotas es &quot;nocturna&quot;, es decir, es activa durante la noche y duerme durante el día?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El perro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El hámster&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El conejillo de Indias&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El periquito&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El hámster. &lt;br&gt;&lt;br&gt;Estos pequeños animales suelen dormir durante gran parte del día y comienzan su actividad al atardecer. &lt;/html&gt;</text><image w="153" h="136">T071051A.jpg</image><imagerefid>1B829071</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bruce Coleman, Inc./H. Reinhard</rewardcredits></quiz>