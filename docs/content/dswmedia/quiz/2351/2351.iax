<?xml version="1.0"?><quiz type="multichoice" id="2351" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: las lágrimas bañan tus ojos solo cuando lloras.
&lt;/html&gt;</text><image w="153" h="136">T047631A.jpg</image><imagerefid>1B82E963</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso. &lt;br&gt;&lt;br&gt;Las lágrimas se producen en las glándulas lagrimales. Cada vez que parpadeas bañan la conjuntiva y la córnea del ojo.&lt;/html&gt;</text><image w="153" h="136">T047631A.jpg</image><imagerefid>1B82E963</imagerefid><audio/><audiorefid/></reward><credits>Phototake NYC/David Wagner</credits><rewardcredits>Phototake NYC/David Wagner</rewardcredits></quiz>