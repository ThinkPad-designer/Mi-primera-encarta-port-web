<?xml version="1.0"?><quiz type="multichoice" id="1292" lang="E" hascredits="1"><question><text>&lt;html&gt;Este animal fue introducido en Australia alrededor de 1850. Desde entonces, sus poblaciones aumentaron mucho y estos animales llegaron a ser considerados una plaga. ¿Sabes de qué animal se trata?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El canguro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La marmota&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El conejo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El conejo. &lt;br&gt;&lt;br&gt;Los granjeros han intentado reducir la población de conejos en Australia introduciendo un virus que solo afecta a los conejos.&lt;/html&gt;</text><image w="149" h="132">T240444A.jpg</image><imagerefid>42D959E3</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>PHOTOLIBRARY GROUP LTD</rewardcredits></quiz>