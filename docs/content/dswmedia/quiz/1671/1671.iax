<?xml version="1.0"?><quiz type="multichoice" id="1671" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En qué deporte es obligatorio que todos y cada uno de los jugadores tenga un apellido de tres sílabas?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En softball&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En baloncesto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En ninguno&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En petanca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En ninguno. &lt;br&gt;&lt;br&gt;No existe ningún deporte en el mundo en el que sea obligatorio que todos los jugadores tengan un apellido de tres sílabas. Que se sepa.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>