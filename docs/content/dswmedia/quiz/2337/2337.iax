<?xml version="1.0"?><quiz type="multichoice" id="2337" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué instrumento fue el antecesor directo del gran piano que tenemos hoy en día?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La cítara&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La pianola&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El clavicémbalo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El clavicémbalo.&lt;br&gt;&lt;br&gt;En lugar de tener unos macillos que golpeaban las cuerdas, estas se pellizcaban al pulsar las teclas. Su sonido era más tenue y tenía menos capacidad expresiva.&lt;/html&gt;</text><image w="149" h="132">T047774A.jpg</image><imagerefid>1B826DFE</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>The New York Public Library</rewardcredits></quiz>