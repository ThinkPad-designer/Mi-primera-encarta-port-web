<?xml version="1.0"?><quiz type="multichoice" id="1637" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué esquiador sueco ganó o fue segundo en la Copa del Mundo, entre 1975 y 1984?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Joe DiMaggio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Ingemar Stenmark&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Norberto Bobbio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Solomon Burke&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Ingemar Stenmark. &lt;br&gt;&lt;br&gt;El esquiador sueco Ingemar Stenmark ganó la Copa del Mundo durante tres años consecutivos, desde 1976 hasta 1978. Obtuvo también dos medallas de oro en los Juegos Olímpicos de Invierno celebrados en 1980 en Lake Placid.&lt;/html&gt;</text><image w="149" h="132">T031598A.jpg</image><imagerefid>42D95E76</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Allsport/David Cannon</rewardcredits></quiz>