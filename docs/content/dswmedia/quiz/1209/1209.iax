<?xml version="1.0"?><quiz type="multichoice" id="1209" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuánta comida puede tomar un elefante adulto al día?&lt;/html&gt;</text><image w="153" h="137">T050444A.jpg</image><imagerefid>1B8277B4</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Entre 45 y 70 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Entre 90 y 135 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Entre 200 y 285 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Entre 340 y 360 kilogramos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Entre 200 y 285 kilogramos. &lt;br&gt;&lt;br&gt;En estado salvaje, los elefantes pasan casi todo el día alimentándose. Comen hojas, ramas, cortezas, frutas, flores y raíces de unos 80 tipos de plantas.&lt;/html&gt;</text><image w="153" h="137">T050444A.jpg</image><imagerefid>1B8277B4</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films</credits><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>