<?xml version="1.0"?><quiz type="multichoice" id="1468" lang="E" hascredits="1"><question><text>&lt;html&gt;Al oeste del Kalahari se halla otro desierto, el de Namibia, paralelo a la costa. Precisamente, parte de esa costa es muy peligrosa para la navegación. ¿Cómo se llama?
&lt;/html&gt;</text><image w="149" h="99">001aca2c.jpg</image><imagerefid>42D9D7EC</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Costa del Grano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Costa Malabar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Costa de los Esqueletos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Costa Feliz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Costa de los Esqueletos.&lt;br&gt;&lt;br&gt;No es extraño avistar los restos de navíos a lo largo del litoral namibio. 
&lt;/html&gt;</text><image w="149" h="99">001aca2c.jpg</image><imagerefid>42D9D7EC</imagerefid><audio/><audiorefid/></reward><credits>Redux Pictures/Reiner Harscher/laif</credits><rewardcredits>Redux Pictures/Reiner Harscher/laif</rewardcredits></quiz>