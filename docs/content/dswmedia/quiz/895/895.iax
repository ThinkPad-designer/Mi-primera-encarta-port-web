<?xml version="1.0"?><quiz type="multichoice" id="895" lang="E" hascredits="0"><question><text>&lt;html&gt;Si una persona padece una enfermedad llamada diabetes, su organismo tiene problemas para procesar…
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Calcio&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Sal&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Azúcar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Agua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Azúcar. &lt;br&gt;&lt;br&gt;El organismo de las personas diabéticas tiene problemas para que la glucosa, un azúcar, pueda entrar en las células. Esto produce un aumento de la cantidad de glucosa que hay en la sangre.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>