<?xml version="1.0"?><quiz type="multichoice" id="1426" lang="E" hascredits="0"><question><text>&lt;html&gt;En torno al área del Serengeti, los científicos han hecho destacados descubrimientos, como los de restos de distintos australopitecinos. ¡Menuda palabra! ¿A qué se referirá? ¿Lo sabes tú?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;A unos pájaros similares a los dinosaurios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;A las primeras especies humanas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;A templos prehistóricos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;A pedagogos australianos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A las primeras especies humanas.&lt;br&gt;&lt;br&gt;Los especialistas aseguran que descendemos de los australopitecinos, quienes a su vez provienen de la misma rama evolutiva que los simios.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>