<?xml version="1.0"?><quiz type="multichoice" id="1739" lang="E" hascredits="1"><question><text>&lt;html&gt;Australia used to be a colony of what country?
&lt;/html&gt;</text><image w="149" h="149">00123d61.jpg</image><imagerefid>29D2648F</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;France&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Britain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Spain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Britain.&lt;br&gt;&lt;br&gt;Britain claimed and colonized Australia in the late 18th century. Australia became independent in 1901.
&lt;/html&gt;</text><image w="149" h="149">00123d61.jpg</image><imagerefid>29D2648F</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>