<?xml version="1.0"?><quiz type="multichoice" id="2328" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Durante qué siglo se desarrolló principalmente el romanticismo?:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;XV&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;XX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;XIX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;XIX.&lt;br&gt;&lt;br&gt;A finales del siglo XIX comenzó a evolucionar hacia otras tendencias musicales, como el nacionalismo o el impresionismo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>