<?xml version="1.0"?><quiz type="multichoice" id="1187" lang="E" hascredits="1"><question><text>&lt;html&gt;El sabueso de San Huberto tiene un excelente sentido…

&lt;/html&gt;</text><image w="149" h="149">T025298A.jpg</image><imagerefid>1B82368E</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;De la vista.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Del olfato.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Del oído.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Del gusto.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Del olfato. &lt;br&gt;&lt;br&gt;El sabueso de San Huberto tiene un extraordinario sentido del olfato y, por eso, es un perro utilizado por la policía para encontrar a gente desaparecida o localizar a prisioneros que se han escapado.&lt;/html&gt;</text><image w="149" h="149">T025298A.jpg</image><imagerefid>1B82368E</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>