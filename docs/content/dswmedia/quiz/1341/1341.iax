<?xml version="1.0"?><quiz type="multichoice" id="1341" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el nombre de la religión que practica la mayoría de los norteafricanos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El cristianismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El islam&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El judaísmo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El hinduismo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El islam.&lt;br&gt;&lt;br&gt;Los musulmanes se expandieron por el norte de África a comienzos del siglo VII. La mayoría más poderosa de ellos eran árabes. Su religión, el islam, dominó la región desde entonces.
&lt;/html&gt;</text><image w="149" h="99">T631150A.jpg</image><imagerefid>1B82AED6</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Bojan Brecelj</rewardcredits></quiz>