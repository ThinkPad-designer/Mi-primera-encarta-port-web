<?xml version="1.0"?><quiz type="multichoice" id="1084" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué almacena el camello en sus jorobas?

&lt;/html&gt;</text><image w="149" h="149">T044525A.jpg</image><imagerefid>1B82621F</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Agua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hueso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Grasa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Comida&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Grasa. &lt;br&gt;&lt;br&gt;Las jorobas del camello almacenan grasa, que utilizan para obtener nutrientes y energía cuando la comida escasea.&lt;/html&gt;</text><image w="149" h="149">T044525A.jpg</image><imagerefid>1B82621F</imagerefid><audio/><audiorefid/></reward><credits>Peter Arnold, Inc./Norman Benton</credits><rewardcredits>Peter Arnold, Inc./Norman Benton</rewardcredits></quiz>