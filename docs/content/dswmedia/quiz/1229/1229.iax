<?xml version="1.0"?><quiz type="multichoice" id="1229" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué utilizan las aves para protegerse del agua y del frío? 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Los pelos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Las aletas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las plumas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Los huesos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las plumas. &lt;br&gt;&lt;br&gt;Las plumas mantienen a las aves calientes y también les ayudan a volar. En ocasiones, las plumas permiten distinguir al macho, con plumas de colores brillantes, de la hembra, con plumas de colores apagados.&lt;/html&gt;</text><image w="149" h="149">00126ac9.jpg</image><imagerefid>29D29170</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis</rewardcredits></quiz>