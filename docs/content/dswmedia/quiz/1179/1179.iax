<?xml version="1.0"?><quiz type="multichoice" id="1179" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Por qué jadean los perros?
&lt;/html&gt;</text><image w="149" h="132">T058565A.jpg</image><imagerefid>1B8288AE</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Porque tienen calor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Porque están cansados&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Porque tienen hambre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Porque están felices&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Porque tienen calor. &lt;br&gt;&lt;br&gt;Los perros respiran muy deprisa cuando tienen calor, para disminuir su temperatura corporal y refrescarse.&lt;/html&gt;</text><image w="149" h="132">T058565A.jpg</image><imagerefid>1B8288AE</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Robert Dowling</credits><rewardcredits>Corbis/Robert Dowling</rewardcredits></quiz>