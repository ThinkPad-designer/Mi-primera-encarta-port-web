<?xml version="1.0"?><quiz type="multichoice" id="1336" lang="E" hascredits="1"><question><text>&lt;html&gt;Los antiguos egipcios creían que, tras la muerte, los dioses les juzgarían pesando una parte de su cuerpo. ¿Sabrías decir qué parte?&lt;/html&gt;</text><image w="153" h="137">T045164A.jpg</image><imagerefid>42D97805</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El corazón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cerebro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El estómago&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El hígado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El corazón.&lt;br&gt;&lt;br&gt;Según la mitología egipcia, en el juicio de las almas Anubis contrapesaba el corazón de los muertos con la llamada pluma de la verdad. Si el corazón pesaba más que la pluma, el alma no tendría una nueva vida.&lt;/html&gt;</text><image w="153" h="137">T045164A.jpg</image><imagerefid>42D97805</imagerefid><audio/><audiorefid/></reward><credits>Bridgeman Art Library, London/New York</credits><rewardcredits>Bridgeman Art Library, London/New York</rewardcredits></quiz>