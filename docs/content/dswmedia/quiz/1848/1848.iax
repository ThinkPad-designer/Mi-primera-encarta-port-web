<?xml version="1.0"?><quiz type="multichoice" id="1848" lang="E" hascredits="0"><question><text>&lt;html&gt;Tres de los compositores de habla castellana más importantes de los siglos XIX y XX han sido:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Wolfgang Amadeus Mozart, Robert Schumann y Franz Schubert.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Manuel de Falla, Isaac Albéniz y Carlos Chávez.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Claude Debussy, Antonio Vivaldi y Ludwig van Beethoven.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>