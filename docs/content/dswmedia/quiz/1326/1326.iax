<?xml version="1.0"?><quiz type="multichoice" id="1326" lang="E" hascredits="1"><question><text>&lt;html&gt;Estás contemplando unos de los monumentos más famosos del mundo. Pero, ¿sabrías decir cuándo fueron erigidas estas pirámides?&lt;/html&gt;</text><image w="149" h="132">T002234A.jpg</image><imagerefid>42D96C44</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Hace unos 2.500 años&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Hace unos 500 años&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hace unos 4.500 años&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Hace unos 10.500 años&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hace unos 4.500 años.&lt;br&gt;&lt;br&gt;Muy cerca de la ciudad de El Cairo, en Gizeh, se pueden admirar estas maravillas: las pirámides de los faraones Keops, Kefrén y Mikerinos.&lt;/html&gt;</text><image w="149" h="132">T002234A.jpg</image><imagerefid>42D96C44</imagerefid><audio/><audiorefid/></reward><credits>Karen Petersen</credits><rewardcredits>Karen Petersen</rewardcredits></quiz>