<?xml version="1.0"?><quiz type="multichoice" id="1317" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cómo se llama la cría de la yegua?
&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Ternero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Cordero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Jabato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Potro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Potro. &lt;br&gt;&lt;br&gt;La yegua tiene uno o dos potros cada año. Al poco de nacer, los potros ya son capaces de ponerse de pie.&lt;/html&gt;</text><image w="149" h="132">T058547A.jpg</image><imagerefid>1B82889C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/Prenzel Photo</rewardcredits></quiz>