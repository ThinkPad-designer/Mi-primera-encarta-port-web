<?xml version="1.0"?><quiz type="multichoice" id="1226" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un ave, pero no puedo volar. Cuando me persiguen, corro para escapar de mis enemigos. ¿Sabes quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El loro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El pingüino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El avestruz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El águila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El avestruz. &lt;br&gt;&lt;br&gt;El avestruz es un corredor rápido que puede alcanzar velocidades de hasta 65 kilómetros por hora.&lt;/html&gt;</text><image w="149" h="99">06A4F.jpg</image><imagerefid>25A41E8D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Tony Stone Images/Paul Kenward</rewardcredits></quiz>