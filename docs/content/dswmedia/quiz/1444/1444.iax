<?xml version="1.0"?><quiz type="multichoice" id="1444" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De dónde provenían los primeros seres humanos que se asentaron en la isla de Madagascar?&lt;/html&gt;</text><image w="149" h="99">T166227A.jpg</image><imagerefid>25A44119</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Del sur de África&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De Arabia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De India&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Indonesia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De Indonesia.&lt;br&gt;&lt;br&gt;Navegantes indonesios llegaron en el siglo X a Madagascar. No se sabe a ciencia cierta de qué manera y por qué cruzaron el océano Índico para arribar a la isla.&lt;/html&gt;</text><image w="149" h="99">T166227A.jpg</image><imagerefid>25A44119</imagerefid><audio/><audiorefid/></reward><credits>Jack Stein Grove</credits><rewardcredits>Jack Stein Grove</rewardcredits></quiz>