<?xml version="1.0"?><quiz type="multichoice" id="2314" lang="E" hascredits="1"><question><text>&lt;html&gt;Si buscamos a uno de los más grandes compositores del barroco musical, no tendremos más remedio que referirnos a:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Franz Schubert&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Johann Sebastian Bach&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Wolfgang Amadeus Mozart&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Johann Sebastian Bach.&lt;br&gt;&lt;br&gt;Bach se considera el compositor más grande entre los grandes, el padre de todo lo que musicalmente se hizo siglos más tarde.&lt;/html&gt;</text><image w="149" h="133">T012078A.jpg</image><imagerefid>1B822D2B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Deutsch</rewardcredits></quiz>