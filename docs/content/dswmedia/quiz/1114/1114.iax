<?xml version="1.0"?><quiz type="multichoice" id="1114" lang="E" hascredits="1"><question><text>&lt;html&gt;This mountain range in South America is the longest mountain range on Earth. What is it?
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Andes&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Rockies&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Black Hills&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Alps&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Andes. &lt;br&gt;&lt;br&gt;The Andes Mountains in South America extend for more than 5,000 miles (8,000 kilometers) from the coast of the Caribbean Sea in the north to the islands of Tierra del Fuego in the south. 
&lt;/html&gt;</text><image w="149" h="99">001acaec.jpg</image><imagerefid>42D9D7FD</imagerefid><audio/><audiorefid/></reward><credits>Redux Pictures/Miquel Gonzalez/laif</credits><rewardcredits>Redux Pictures/Miquel Gonzalez/laif</rewardcredits></quiz>