<?xml version="1.0"?><quiz type="multichoice" id="1695" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the tallest mountain in Africa?
&lt;/html&gt;</text><image w="153" h="136">T029358A.jpg</image><imagerefid>29D29858</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Mount Kenya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kilimanjaro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mount Meru&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mount Fuji&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Kilimanjaro. &lt;br&gt;&lt;br&gt;Located in Tanzania in East Africa, Kilimanjaro is 19,341 feet (5,895 meters) tall.
&lt;/html&gt;</text><image w="153" h="136">T029358A.jpg</image><imagerefid>29D29858</imagerefid><audio/><audiorefid/></reward><credits>Leo de Wys, Inc./Fridmar Damm</credits><rewardcredits>Leo de Wys, Inc./Fridmar Damm</rewardcredits></quiz>