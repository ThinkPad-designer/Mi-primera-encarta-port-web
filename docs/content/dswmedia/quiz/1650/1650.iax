<?xml version="1.0"?><quiz type="multichoice" id="1650" lang="E" hascredits="1"><question><text>&lt;html&gt;Atleta etíope. Poseedor de récords mundiales, campeón del mundo y olímpico. Especialista en carreras de fondo. ¿De quién estamos hablando?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;De Paul Tergat&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De Fernando Torres&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De Frank Sinatra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De Hailé Gebreselassie&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De Hailé Gebreselassie. &lt;br&gt;&lt;br&gt;El fondista etíope Hailé Gebreselassie corrió su primer maratón en 2002, tras dominar las carreras de fondo durante casi toda la década de 1990.&lt;/html&gt;</text><image w="99" h="149">001aca80.jpg</image><imagerefid>42D9D801</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Christophe Paucellier/Photo &#38; Co.</rewardcredits></quiz>