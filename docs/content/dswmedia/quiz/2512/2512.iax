<?xml version="1.0"?><quiz type="multichoice" id="2512" lang="E" hascredits="1"><question><text>&lt;html&gt;El compositor romántico Robert Schumann compuso una obra para piano en la que, a través de distintas piezas cortas, describe a los personajes de un baile de carnaval. ¿Cómo se llama esta obra?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;&lt;i&gt;El Baile&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Carnaval&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Máscaras&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Carnaval&lt;/i&gt;.&lt;br&gt;&lt;br&gt;&lt;i&gt;Carnaval&lt;/i&gt; describe, entre otros, a personajes imaginarios como Pierrot y Arlequín y a seres reales como Chopin o Paganini.&lt;/html&gt;</text><image w="149" h="132">T642009A.jpg</image><imagerefid>1B82B342</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Hulton-Deutsch Collection</rewardcredits></quiz>