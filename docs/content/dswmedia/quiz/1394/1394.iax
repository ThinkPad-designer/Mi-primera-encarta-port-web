<?xml version="1.0"?><quiz type="multichoice" id="1394" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Cuál de los siguientes grupos étnicos &lt;b&gt;no&lt;/b&gt; es uno de los más importantes de Nigeria?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El hausa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El ibo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El persa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El fulani&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El persa.&lt;br&gt;&lt;br&gt;Los cuatro grupos étnicos principales de Nigeria son el hausa, el fulani, el ibo y el yoruba. Los persas habitaban lo que hoy se llama Irán.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>