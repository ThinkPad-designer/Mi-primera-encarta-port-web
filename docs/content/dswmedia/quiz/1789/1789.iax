<?xml version="1.0"?><quiz type="multichoice" id="1789" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Australia?
&lt;/html&gt;</text><image w="149" h="99">T041507A.jpg</image><imagerefid>1B82DD7A</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Adelaide&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Canberra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Melbourne&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Sydney&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Canberra.&lt;br&gt;&lt;br&gt;Canberra is located in southeastern Australia, about halfway between Sydney and Melbourne. 
&lt;/html&gt;</text><image w="149" h="99">T041507A.jpg</image><imagerefid>1B82DD7A</imagerefid><audio/><audiorefid/></reward><credits>ALLSTOCK, INC./John Ibbotson</credits><rewardcredits>ALLSTOCK, INC./John Ibbotson</rewardcredits></quiz>