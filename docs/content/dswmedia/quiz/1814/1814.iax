<?xml version="1.0"?><quiz type="multichoice" id="1814" lang="E" hascredits="1"><question><text>&lt;html&gt;Where is the headquarters of the European Union?
&lt;/html&gt;</text><image w="153" h="102">T373706A.jpg</image><imagerefid>29D31FD7</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Brussels, Belgium&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Copenhagen, Denmark&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Geneva, Switzerland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Maastricht, The Netherlands&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Brussels, Belgium.&lt;br&gt;&lt;br&gt;Belgium was one of the 12 founding countries of the European Union in 1991.
&lt;/html&gt;</text><image w="153" h="102">T373706A.jpg</image><imagerefid>29D31FD7</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Marc Garanger</credits><rewardcredits>Corbis/Marc Garanger</rewardcredits></quiz>