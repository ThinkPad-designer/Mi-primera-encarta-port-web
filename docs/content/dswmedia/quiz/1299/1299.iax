<?xml version="1.0"?><quiz type="multichoice" id="1299" lang="E" hascredits="1"><question><text>&lt;html&gt;Cuando una vaca está rumiando, ¿qué es lo que mastica?
&lt;/html&gt;</text><image w="149" h="99">00102c47.jpg</image><imagerefid>29D22CCF</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Trigo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Alimento parcialmente digerido&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Copos de avena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pescado&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Alimento parcialmente digerido. &lt;br&gt;&lt;br&gt;Cuando la vaca traga la hierba, las bacterias rompen el material vegetal y lo convierten en una pasta semidigerida. La pasta vuelve de nuevo a la boca y la vaca la mastica por segunda vez. &lt;/html&gt;</text><image w="149" h="99">00102c47.jpg</image><imagerefid>29D22CCF</imagerefid><audio/><audiorefid/></reward><credits>Corbis/Lester Lefkowitz</credits><rewardcredits>Corbis/Lester Lefkowitz</rewardcredits></quiz>