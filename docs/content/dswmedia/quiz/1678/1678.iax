<?xml version="1.0"?><quiz type="multichoice" id="1678" lang="E" hascredits="1"><question><text>&lt;html&gt;Javier Sotomayor batió en varias ocasiones el récord del mundo de su especialidad atlética, ...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El salto con pértiga de bronce&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El salto de altura&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Los 110 m vallas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El lanzamiento de peso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El salto de altura. &lt;br&gt;&lt;br&gt;El atleta cubano Javier Sotomayor batió el récord mundial de salto de altura en 1988. Cinco años más tarde, lo hizo por última vez: saltó 2,45 metros, dos centímetros más que en su primer mejor marca universal.
&lt;/html&gt;</text><image w="149" h="132">T239156A.jpg</image><imagerefid>073FCDEA</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>AP/Wide World Photos/Diether Endlicher</rewardcredits></quiz>