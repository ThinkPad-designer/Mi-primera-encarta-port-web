<?xml version="1.0"?><quiz type="multichoice" id="2348" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué es una partitura?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Un libro que contiene música escrita&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una parte de una canción&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Un instrumento de percusión andino&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Un libro que contiene música escrita.&lt;br&gt;&lt;br&gt;Se publican como libros comunes, solo que suelen ser más grandes, y el lenguaje que contienen está destinado a los músicos, ya sea para interpretar la música que está escrita o para estudiar cómo la elaboró el compositor.&lt;/html&gt;</text><image w="149" h="99">T631132A.jpg</image><imagerefid>42D95B72</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>SuperStock/University Library of Leipzig, A.K.G., Berlin</rewardcredits></quiz>