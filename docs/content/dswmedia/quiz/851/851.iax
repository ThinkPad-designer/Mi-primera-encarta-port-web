<?xml version="1.0"?><quiz type="multichoice" id="851" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: los huesos de los niños son más flexibles que los de los adultos.&lt;/html&gt;</text><image w="149" h="149">0010210f.jpg</image><imagerefid>29D22A29</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Verdadero.&lt;br&gt;&lt;br&gt;El proceso de formación y endurecimiento de los huesos se llama osificación. La osificación se completa hacia los 25 años de edad.
&lt;/html&gt;</text><image w="153" h="136"/><imagerefid/><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits/></quiz>