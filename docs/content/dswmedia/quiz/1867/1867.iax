<?xml version="1.0"?><quiz type="multichoice" id="1867" lang="E" hascredits="0"><question><text>&lt;html&gt;El gran compositor Wolfgang Amadeus Mozart dejó sin terminar una obra para coro y orquesta que le encargó el conde Walsegg y que tuvo que acabar un alumno suyo tras su muerte. Esta obra se convirtió en una de las piezas más importantes de su producción. Se trata de:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El Réquiem.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El concierto nº 32 para coro y orquesta.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La ópera “El anillo del nibelungo”.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>