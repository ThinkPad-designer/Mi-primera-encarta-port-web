<?xml version="1.0"?><quiz type="multichoice" id="1640" lang="E" hascredits="0"><question><text>&lt;html&gt;En fútbol, ¿qué parte del cuerpo puede ser usada en exclusiva por el portero, además de en los saques de banda?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;El cerebro&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El pie&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las manos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La cabeza&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las manos. &lt;br&gt;&lt;br&gt;El portero, llamado asimismo arquero o guardavallas, puede jugar con las manos, pero solo dentro del área de castigo o en los saques de banda.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>