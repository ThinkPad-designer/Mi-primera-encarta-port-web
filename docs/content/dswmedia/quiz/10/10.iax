<?xml version="1.0"?><quiz type="multichoice" id="10" lang="E" hascredits="1"><question><text>&lt;html&gt;Este es el templo de Hatshepsut. Se trata de un caso único en el Valle de los Reyes, y es que Hatshepsut ...&lt;/html&gt;</text><image w="149" h="99">0018a592.jpg</image><imagerefid>42D98740</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Era en realidad una reina, no un rey o faraón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Nunca fue momificada&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;No era egipcia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Era en realidad una reina, no un rey o faraón.&lt;br&gt;&lt;br&gt;Hatshepsut es la única reina enterrada en el Valle de los Reyes. Las esposas reales están enterradas más al sur, en el llamado Valle de las Reinas.&lt;/html&gt;</text><image w="149" h="99">0018a592.jpg</image><imagerefid>42D98740</imagerefid><audio/><audiorefid/></reward><credits>age fotostock/MedioImages</credits><rewardcredits>age fotostock/MedioImages</rewardcredits></quiz>