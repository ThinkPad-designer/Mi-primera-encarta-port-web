<?xml version="1.0"?><quiz type="multichoice" id="1199" lang="E" hascredits="1"><question><text>&lt;html&gt;Verdadero o falso: una tarántula es demasiado peligrosa para tenerla como mascota.
&lt;/html&gt;</text><image w="153" h="136">T241035A.jpg</image><imagerefid>1B82939B</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Verdadero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Falso&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Falso. &lt;br&gt;&lt;br&gt;En los últimos años, las tarántulas se han popularizado como mascotas. Estas arañas, grandes y peludas, no requieren cuidados excesivos, ni necesitan mucho espacio.&lt;/html&gt;</text><image w="153" h="136">T241035A.jpg</image><imagerefid>1B82939B</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./John Mitchelli</credits><rewardcredits>Photo Researchers, Inc./John Mitchelli</rewardcredits></quiz>