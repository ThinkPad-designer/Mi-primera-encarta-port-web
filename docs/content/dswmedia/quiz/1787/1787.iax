<?xml version="1.0"?><quiz type="multichoice" id="1787" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of India?
&lt;/html&gt;</text><image w="153" h="136">T040978A.jpg</image><imagerefid>1B82565C</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Bangalore&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Kolkata (Calcutta)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mumbai (Bombay)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;New Delhi&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;New Delhi.&lt;br&gt;&lt;br&gt;New Delhi is located in northern India, right next to the older city of Delhi.
&lt;/html&gt;</text><image w="153" h="136">T040978A.jpg</image><imagerefid>1B82565C</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Porterfield-Chickering</credits><rewardcredits>Photo Researchers, Inc./Porterfield-Chickering</rewardcredits></quiz>