<?xml version="1.0"?><quiz type="multichoice" id="1673" lang="E" hascredits="0"><question><text>&lt;html&gt;¿En cuál de estos deportes el balón con el que se juega no es redondo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;En baloncesto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;En balonmano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;En rugby&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;En talasoterapia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;En rugby. &lt;br&gt;&lt;br&gt;La pelota o balón de rugby es ovalada. Por cierto, la talasoterapia no es un deporte.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>