<?xml version="1.0"?><quiz type="multichoice" id="1638" lang="E" hascredits="0"><question><text>&lt;html&gt;La extensión oficial de un campo de fútbol ha de ser de entre 90 y 120 m de largo y...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Entre 5 y 20 m de ancho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Entre 45 y 90 m de ancho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Entre 12 y 50 m de ancho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Entre 100 y 120 m de ancho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Entre 45 y 90 m de ancho. &lt;br&gt;&lt;br&gt;Y la portería, por su parte, ha de tener  7,32 m de poste a poste y 2,44 m de altura.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>