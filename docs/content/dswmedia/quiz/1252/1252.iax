<?xml version="1.0"?><quiz type="multichoice" id="1252" lang="E" hascredits="1"><question><text>&lt;html&gt;Soy un anfibio y cuando soy adulto conservo una larga cola. ¿Quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Un lagarto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Una salamandra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una serpiente&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Una rana&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las salamandras son anfibios con cola. La salamandra común es de color negro con manchas amarillas y es activa por la noche.&lt;/html&gt;</text><image w="149" h="99">127b5c39.jpg</image><imagerefid>0206CC83</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Fernando Camino Mart&#38;iacute;n</rewardcredits></quiz>