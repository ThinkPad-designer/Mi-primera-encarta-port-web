<?xml version="1.0"?><quiz type="multichoice" id="2146" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de las siguientes aves es una rapaz nocturna, es decir, vuela y caza por la noche?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;El buitre&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El águila&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El halcón&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El búho&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El búho.&lt;br&gt;&lt;br&gt;El búho es un rapaz nocturna, que caza a sus presas por la noche, por lo que poseen un excelente sentido del oído.
&lt;/html&gt;</text><image w="149" h="99">T172766A.jpg</image><imagerefid>25A411ED</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bruce Coleman, Inc./Joe McDonald</rewardcredits></quiz>