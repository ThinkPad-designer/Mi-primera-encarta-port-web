<?xml version="1.0"?><quiz type="multichoice" id="1687" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the tallest mountain in North America?
&lt;/html&gt;</text><image w="153" h="136">T041037A.jpg</image><imagerefid>42D966E7</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Mount Everest&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mount Rainier&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mount McKinley&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Pico de Orizaba&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mount McKinley.&lt;br&gt;&lt;br&gt;Located in Alaska, Mount McKinley is 20,320 feet (6,194 meters) tall. The mountain is also called Denali.
&lt;/html&gt;</text><image w="153" h="136">T041037A.jpg</image><imagerefid>42D966E7</imagerefid><audio/><audiorefid/></reward><credits>ALLSTOCK, INC./Ken Graham</credits><rewardcredits>ALLSTOCK, INC./Ken Graham</rewardcredits></quiz>