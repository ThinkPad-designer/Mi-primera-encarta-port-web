<?xml version="1.0"?><quiz type="multichoice" id="1736" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the biggest country in Europe (by land area, and not counting Russia)?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;France&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Spain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Sweden&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ukraine&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Ukraine.&lt;br&gt;&lt;br&gt;In Europe, Ukraine is second only to Russia in terms of land area. Russia is in both Europe and Asia, and is the biggest country of both (by land area). 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>