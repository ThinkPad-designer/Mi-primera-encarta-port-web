<?xml version="1.0"?><quiz type="multichoice" id="1193" lang="E" hascredits="1"><question><text>&lt;html&gt;Los hámsters tienen unas bolsas en cada mejilla. ¿Sabes para qué las utilizan?&lt;/html&gt;</text><image w="149" h="149">T025515A.jpg</image><imagerefid>1B823764</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Para almacenar comida.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Para llenarlas de aire.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Para impresionar a las hembras.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Para escalar por las ramas.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Para almacenar comida. &lt;br&gt;&lt;br&gt;Los hámsters almacenan comida en las bolsas que poseen en las mejillas, también llamadas abazones.&lt;/html&gt;</text><image w="149" h="149">T025515A.jpg</image><imagerefid>1B823764</imagerefid><audio/><audiorefid/></reward><credits>Dorling Kindersley</credits><rewardcredits>Dorling Kindersley</rewardcredits></quiz>