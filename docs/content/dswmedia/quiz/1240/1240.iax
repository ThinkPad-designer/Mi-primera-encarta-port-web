<?xml version="1.0"?><quiz type="multichoice" id="1240" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Qué longitud alcanza este insecto, el más largo que existe?
&lt;/html&gt;</text><image w="99" h="149">T172796A.jpg</image><imagerefid>25A41206</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;5 centímetros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;25 centímetros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;50 centímetros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;90 centímetros&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;50 centímetros.&lt;br&gt;&lt;br&gt;El insecto palo del Sureste asiático mide unos 50 centímetros de longitud.&lt;/html&gt;</text><image w="99" h="149">T172796A.jpg</image><imagerefid>25A41206</imagerefid><audio/><audiorefid/></reward><credits>Minden Pictures/Jim Brandenburg</credits><rewardcredits>Minden Pictures/Jim Brandenburg</rewardcredits></quiz>