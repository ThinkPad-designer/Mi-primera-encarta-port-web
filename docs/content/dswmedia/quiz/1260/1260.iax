<?xml version="1.0"?><quiz type="multichoice" id="1260" lang="E" hascredits="1"><question><text>&lt;html&gt;El cuerpo de los insectos se divide en….

&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Dos partes: cefalotórax y abdomen&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Tres partes: cabeza, tórax y abdomen&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Una parte, llamada tórax&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Ninguna de las anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Tres partes: cabeza, tórax y abdomen. &lt;br&gt;&lt;br&gt;En la cabeza se encuentran los órganos sensoriales, el cerebro y la boca. Las alas y las patas se sitúan en el tórax. &lt;/html&gt;</text><image w="149" h="99">00126cb4.jpg</image><imagerefid>29D29195</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>