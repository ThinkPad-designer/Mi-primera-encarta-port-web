<?xml version="1.0"?><quiz type="multichoice" id="1376" lang="E" hascredits="0"><question><text>&lt;html&gt;En la costa occidental africana se halla Senegal. Este país rodea casi en su totalidad a un pequeño Estado. ¿Sabes a cuál?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;A Mónaco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;A Nigeria&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;A Sierra Leona&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;A Gambia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;A Gambia.&lt;br&gt;&lt;br&gt;Se trata de una pequeña nación atravesada por buena parte del río del mismo nombre (Gambia), que nace en la República de Guinea y discurre también por Senegal.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>