<?xml version="1.0"?><quiz type="multichoice" id="1360" lang="E" hascredits="1"><question><text>&lt;html&gt;Durante siglos, los campesinos han trasladado agua procedente del río Níger para cultivar las cercanas tierras secas. ¿Cómo se llama ese proceso?
&lt;/html&gt;</text><image w="149" h="149">T038180A.jpg</image><imagerefid>1B824BA5</imagerefid><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Irradiación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Insurrección&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Irrigación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Irritación&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Irrigación.&lt;br&gt;&lt;br&gt;El río Níger ha sido tradicionalmente el verdadero alma de la región a la que baña, al permitir a sus gentes obtener cosechas en lugares áridos.&lt;/html&gt;</text><image w="149" h="149">T038180A.jpg</image><imagerefid>1B824BA5</imagerefid><audio/><audiorefid/></reward><credits>Woodfin Camp and Associates, Inc./Wendy V. Watriss</credits><rewardcredits>Woodfin Camp and Associates, Inc./Wendy V. Watriss</rewardcredits></quiz>