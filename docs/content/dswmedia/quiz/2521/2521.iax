<?xml version="1.0"?><quiz type="multichoice" id="2521" lang="E" hascredits="1"><question><text>&lt;html&gt;Ludwig van Beethoven vivió a caballo entre dos siglos. ¿Cuáles?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;XVII y XVIII&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;XVIII y XIX&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;XIII y XIV&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;XVIII y XIX.&lt;br&gt;&lt;br&gt;De hecho, comenzó su trayectoria en el clasicismo, y sus últimas obras se pueden considerar ya parte del romanticismo.&lt;/html&gt;</text><image w="149" h="133">T047357A.jpg</image><imagerefid>42D96A44</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Getty Picture Collection</rewardcredits></quiz>