<?xml version="1.0"?><quiz type="multichoice" id="1777" lang="E" hascredits="1"><question><text>&lt;html&gt;The desert region of Patagonia lies in what South American country?&lt;/html&gt;</text><image w="149" h="99">T093018A.jpg</image><imagerefid>25A43503</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Argentina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Brazil&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Chile&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Uruguay&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Argentina.&lt;br&gt;&lt;br&gt;Patagonia is a vast region of desert plateaus in southern Argentina.
&lt;/html&gt;</text><image w="149" h="99">T093018A.jpg</image><imagerefid>25A43503</imagerefid><audio/><audiorefid/></reward><credits>OMNH/M.A. Mares</credits><rewardcredits>OMNH/M.A. Mares</rewardcredits></quiz>