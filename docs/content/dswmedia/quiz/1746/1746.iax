<?xml version="1.0"?><quiz type="multichoice" id="1746" lang="E" hascredits="0"><question><text>&lt;html&gt;What is Australia’s closest neighboring country?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;East Timor&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Indonesia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;New Zealand&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Papua New Guinea&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Papua New Guinea.&lt;br&gt;&lt;br&gt;Papua New Guinea, is less than 100 miles (160 kilometers) off the northern tip of Queensland, in northeastern Australia. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>