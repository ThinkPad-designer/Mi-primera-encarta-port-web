<?xml version="1.0"?><quiz type="multichoice" id="1238" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuáles son los insectos más numerosos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Las hormigas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Los escarabajos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Las moscas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Las mariposas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Los escarabajos. &lt;br&gt;&lt;br&gt;Se han descubierto unas 35.000 especies de escarabajos. Viven en casi todas las regiones, excepto en los océanos, el Ártico y la Antártida.&lt;/html&gt;</text><image w="149" h="149">000ed354.jpg</image><imagerefid>29D1BA12</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Charles L. Bellamy</rewardcredits></quiz>