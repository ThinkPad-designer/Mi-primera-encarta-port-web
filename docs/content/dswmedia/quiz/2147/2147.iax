<?xml version="1.0"?><quiz type="multichoice" id="2147" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué ave hace este sonido?&lt;/html&gt;</text><image/><imagerefid/><audio>T049704A.mp3</audio><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El pato&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El cuco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El jilguero&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La perdiz&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El cuco.&lt;br&gt;&lt;br&gt;El macho del cuco emite este característico canto al inicio de la primavera. Los llamados ‘relojes de cuco’ tratan de copiar este sonido. &lt;/html&gt;</text><image w="149" h="132">T049703A.jpg</image><imagerefid>1B8274D9</imagerefid><audio>T049704A.mp3</audio><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/Mark Hamblin</rewardcredits></quiz>