<?xml version="1.0"?><quiz type="multichoice" id="1750" lang="E" hascredits="1"><question><text>&lt;html&gt;What country has the largest population in Europe?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Britain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;France &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Germany&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Russia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Russia.&lt;br&gt;&lt;br&gt;Russia, which is in both Europe and Asia, has the largest population of any European country. The next largest population is Germany’s.
&lt;/html&gt;</text><image w="149" h="149">00123d7f.jpg</image><imagerefid>29D2649E</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>