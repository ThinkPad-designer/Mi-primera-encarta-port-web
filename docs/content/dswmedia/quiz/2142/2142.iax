<?xml version="1.0"?><quiz type="multichoice" id="2142" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál es el pez más grande?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;La ballena azul&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El tiburón ballena&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La raya&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El delfín&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El tiburón ballena.&lt;br&gt;&lt;br&gt; El tiburón ballena es el pez más grande y puede alcanzar una longitud de más de 15 m y un peso de más de 18 toneladas. Las ballenas y los delfines son mamíferos, no peces.&lt;/html&gt;</text><image w="149" h="132">T040706A.jpg</image><imagerefid>1B82554C</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Animals Animals/James D. Watt</rewardcredits></quiz>