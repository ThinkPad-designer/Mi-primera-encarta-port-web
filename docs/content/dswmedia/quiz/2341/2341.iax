<?xml version="1.0"?><quiz type="multichoice" id="2341" lang="E" hascredits="1"><question><text>&lt;html&gt;El compositor alemán Ludwig van Beethoven compuso, entre otras muchas obras, varias sinfonías. ¿Cuántas?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;12&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;5&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;9&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;9.&lt;br&gt;&lt;br&gt;De ellas, las más conocidas por el gran público son la 5ª, sobre todo su primer movimiento, y la 9ª, que contiene el “Himno a la Alegría”.&lt;/html&gt;</text><image w="149" h="133">T047357A.jpg</image><imagerefid>42D96A44</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Hulton Getty Picture Collection</rewardcredits></quiz>