<?xml version="1.0"?><quiz type="multichoice" id="1700" lang="E" hascredits="0"><question><text>&lt;html&gt;How tall is Vinson Massif, the tallest mountain in Antarctica?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;7,310 feet (2,228 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;10,023 feet (3,055 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;13,680 feet (4,170 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;16,066 feet (4,897 meters)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;16,066 feet (4,897 meters).&lt;br&gt;&lt;br&gt;Vinson Massif is a hard mountain to climb because of the extreme polar conditions.
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>