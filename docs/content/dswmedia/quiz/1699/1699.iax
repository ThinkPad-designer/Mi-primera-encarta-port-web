<?xml version="1.0"?><quiz type="multichoice" id="1699" lang="E" hascredits="0"><question><text>&lt;html&gt;What is the tallest mountain in Antarctica?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Mount Erebus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mount Fuji&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Mount Rainier&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Vinson Massif&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Vinson Massif.&lt;br&gt;&lt;br&gt;Vinson Massif is 16,066 feet (4,897 meters) tall. It was first climbed in 1966. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>