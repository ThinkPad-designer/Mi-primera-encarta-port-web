<?xml version="1.0"?><quiz type="multichoice" id="2326" lang="E" hascredits="0"><question><text>&lt;html&gt;Tres de los compositores de habla española más importantes de los siglos XIX y XX han sido:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Wolfgang Amadeus Mozart, Robert Schumann y Joaquín Turina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Manuel de Falla, Isaac Albéniz y Carlos Chávez&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Tomasso Albinoni, Antonio Vivaldi y Manuel de Falla&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Manuel de Falla, Isaac Albéniz y Carlos Chávez.&lt;br&gt;&lt;br&gt;Todos ellos componían siguiendo el estilo nacionalista, caracterizado por utilizar elementos de la música popular o folclórica.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>