<?xml version="1.0"?><quiz type="multichoice" id="1684" lang="E" hascredits="0"><question><text>&lt;html&gt;Uno de los siguientes deportes se juega en un campo de dimensiones iguales o similares a las del balonmano y con un balón más pequeño que el de fútbol. Se parece al fútbol, pero no es exactamente fútbol. ¿Sabrías decir de qué deporte hablamos?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Fútbol americano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Fútbol sobre ruedas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Gimnasia futbolística&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Fútbol sala&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Fútbol sala. &lt;br&gt;&lt;br&gt;España y Brasil son las principales potencias mundiales de este deporte.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>