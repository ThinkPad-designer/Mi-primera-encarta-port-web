<?xml version="1.0"?><quiz type="multichoice" id="1679" lang="E" hascredits="0"><question><text>&lt;html&gt;El juego de pelota que practicaban en la antigua Mesoamérica es conocido en lengua náhuatl como...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;&lt;i&gt;Tianquiztli&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;&lt;i&gt;Slalamitz&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;&lt;i&gt;Pelotztri&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;&lt;i&gt;Tlachtli&lt;/i&gt;&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;&lt;i&gt;Tlachtli&lt;/i&gt;.&lt;br&gt;&lt;br&gt;El &lt;i&gt;tlachtli&lt;/i&gt; era un deporte con un sentido religioso y ritual. La palabra &lt;i&gt;tianquiztli&lt;/i&gt; quiere decir, en nahuátl, &apos;mercado&apos;. Las otras dos palabras no existen en ninguna lengua del mundo, que se sepa.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>