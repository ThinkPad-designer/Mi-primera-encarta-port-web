<?xml version="1.0"?><quiz type="multichoice" id="1639" lang="E" hascredits="0"><question><text>&lt;html&gt;¿Sabrías cuál o cuáles de estos deportes es o son un deporte de equipo?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Balonmano&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Baloncesto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hockey sobre patines&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Todos los anteriores&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Todos los anteriores.&lt;br&gt;&lt;br&gt;Una forma de distinguir los deportes es hacerlo entre deportes individuales y deportes de equipo. Un ejemplo de deporte individual es el tenis (cuando no se juega a dobles).&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>