<?xml version="1.0"?><quiz type="multichoice" id="1289" lang="E" hascredits="1"><question><text>&lt;html&gt;El paté o foie gras, considerado por muchas personas como un manjar, se elabora a partir del hígado de unos animales de granja. ¿Sabes de qué animales se trata?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;De los caballos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;De los gansos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;De los cerdos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De las gallinas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;De los gansos. &lt;br&gt;&lt;br&gt;El paté se elabora a partir del hígado de los gansos. 
&lt;/html&gt;</text><image w="149" h="99">T288065A.jpg</image><imagerefid>073FDD2B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Corbis/Adam Woolfitt</rewardcredits></quiz>