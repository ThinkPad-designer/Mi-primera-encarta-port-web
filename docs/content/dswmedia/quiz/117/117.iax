<?xml version="1.0"?><quiz type="multichoice" id="117" lang="E" hascredits="0"><question><text>&lt;html&gt;Una característica muy importante de la llamada música folclórica es que:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Sus compositores suelen ser anónimos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Suele ser interpretada por los mejores músicos de cada país&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Solamente utiliza instrumentos musicales tecnológicamente avanzados&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Sus compositores suelen ser anónimos&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/></quiz>