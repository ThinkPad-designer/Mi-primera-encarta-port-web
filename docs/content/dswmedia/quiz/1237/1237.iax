<?xml version="1.0"?><quiz type="textAnswer" id="1237" lang="E" hascredits="1"><question><text>&lt;html&gt;Despite my name, I’m not a fly and I’m not made of butter. I have colorful wings that help me flutter. I am a...&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers><answer>butterfly</answer></answers><reward><text>&lt;html&gt;Butterfly.   &lt;br&gt;&lt;br&gt;This is a monarch butterfly.&lt;/html&gt;</text><image w="153" h="136">T051162A.jpg</image><imagerefid>1B82F12F</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/J.A.L. Cooke</rewardcredits></quiz>