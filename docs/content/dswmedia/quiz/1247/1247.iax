<?xml version="1.0"?><quiz type="multichoice" id="1247" lang="E" hascredits="0"><question><text>&lt;html&gt;When the eggs of this animal are ready to hatch, the young begin to croak softly within the egg. What animal is it?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Bird&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Snake&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Alligator&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Frog&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Alligator. &lt;br&gt;&lt;br&gt;A female alligator will help her young hatch from their eggs. The mother may remain near her young for a year or more until they can defend themselves from predators. 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>