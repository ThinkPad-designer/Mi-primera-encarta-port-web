<?xml version="1.0"?><quiz type="multichoice" id="1362" lang="E" hascredits="0"><question><text>&lt;html&gt;El río Níger fluye a través de varios países. Gran parte de su recorrido lo lleva a cabo en Malí. ¿Sabes cuál es la capital de Malí?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Abuja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Accra&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Bamako&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Niamey&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Bamako.&lt;br&gt;&lt;br&gt;La ciudad de Bamako fue un relevante centro islámico de enseñanza hace unos 900 años y hoy es un importante núcleo de comunicaciones, industrial y comercial del área del río Níger.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>