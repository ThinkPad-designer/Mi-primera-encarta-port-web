<?xml version="1.0"?><quiz type="multichoice" id="1836" lang="E" hascredits="0"><question><text>&lt;html&gt;Si buscamos a uno de los más grandes compositores del barroco musical no tendremos más remedio que referirnos a:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Franz Schubert.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Johann Sebastian Bach.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Wolfgang Amadeus Mozart.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>