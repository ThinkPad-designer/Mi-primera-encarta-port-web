<?xml version="1.0"?><quiz type="multichoice" id="1643" lang="E" hascredits="1"><question><text>&lt;html&gt;Existen varios tipos de hockey. Solo uno de los siguientes es un deporte practicado habitualmente en muchos lugares del mundo. ¿Sabes cuál?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El hochey sobre el agua&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El hockey sobre hielo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El hockey antártico&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El hockey lunar&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El hockey sobre hielo. &lt;br&gt;&lt;br&gt;Evidentemente, se trata del hockey jugado sobre... una pista de hielo. La Federación Internacional de Hockey sobre Hielo fue fundada en 1908. &lt;/html&gt;</text><image w="149" h="132">T048018B.jpg</image><imagerefid>1B826EEC</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>THE BETTMANN ARCHIVE/UPI</rewardcredits></quiz>