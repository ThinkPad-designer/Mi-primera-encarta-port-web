<?xml version="1.0"?><quiz type="multichoice" id="1716" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the largest freshwater lake in Asia?
&lt;/html&gt;</text><image w="153" h="136">T026310A.jpg</image><imagerefid>42D96738</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Dongting Hu (China)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Lake Baikal (Russia)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Lake Balqash (Kazakhstan)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Lake Urmia (Iran)&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Lake Baikal (Russia).&lt;br&gt;&lt;br&gt;Asia’s Caspian Sea is much bigger, but the Caspian Sea is a saltwater lake.
&lt;/html&gt;</text><image w="153" h="136">T026310A.jpg</image><imagerefid>42D96738</imagerefid><audio/><audiorefid/></reward><credits>Tony Stone Images/Jerry Kobalenko</credits><rewardcredits>Tony Stone Images/Jerry Kobalenko</rewardcredits></quiz>