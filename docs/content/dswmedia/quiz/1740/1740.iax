<?xml version="1.0"?><quiz type="multichoice" id="1740" lang="E" hascredits="1"><question><text>&lt;html&gt;Antarctica belongs to what country?
&lt;/html&gt;</text><image w="149" h="149">001274d7.jpg</image><imagerefid>584EF8C7</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;United States&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Australia&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Britain&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;No country&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;No country.&lt;br&gt;&lt;br&gt;A few countries have claims on Antarctic territory. But all have signed a treaty that prohibits further claiming of Antarctic territory. The treaty dedicates the entire continent to peaceful scientific research.
&lt;/html&gt;</text><image w="149" h="149">001274d7.jpg</image><imagerefid>584EF8C7</imagerefid><audio/><audiorefid/></reward><credits>© Microsoft Corporation. Reservados todos los derechos.</credits><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>