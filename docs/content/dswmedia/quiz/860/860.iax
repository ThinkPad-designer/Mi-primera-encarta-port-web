<?xml version="1.0"?><quiz type="multichoice" id="860" lang="E" hascredits="1"><question><text>&lt;html&gt;Unen dos huesos y nos permiten realizar muchos movimientos. ¿Sabes a qué partes del cuerpo nos referimos?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Nervios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Adenoides&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Articulaciones&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Músculo cardiaco&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Articulaciones.&lt;br&gt;&lt;br&gt;En cada articulación, además de los extremos de dos huesos, existen otros elementos que los unen, como los ligamentos o la cápsula articular. 

&lt;/html&gt;</text><image w="99" h="149">00174643.jpg</image><imagerefid>42D972F0</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>© Microsoft Corporation. Reservados todos los derechos.</rewardcredits></quiz>