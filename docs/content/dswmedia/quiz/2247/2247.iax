<?xml version="1.0"?><quiz type="multichoice" id="2247" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Sabes qué insecto es capaz de levantar 20 veces su propio peso?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;La abeja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El insecto palo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La mariquita&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La hormiga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La hormiga.&lt;br&gt;&lt;br&gt;Las hormigas tienen una gran fuerza: pueden levantar y transportar sobre su cabeza hasta 20 veces su peso.&lt;/html&gt;</text><image w="150" h="98">0018a3e6.jpg</image><imagerefid>42D986D1</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Photo Researchers, Inc./Gary Retherford</rewardcredits></quiz>