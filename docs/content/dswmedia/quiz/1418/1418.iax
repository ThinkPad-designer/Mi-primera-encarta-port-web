&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;Atmósferas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Batisferios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hemisferios&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Toposferas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Hemisferios.&lt;br&gt;&lt;br&gt;&lt;i&gt;Hemi-&lt;/i&gt; significa &apos;medio&apos; y &lt;i&gt;spherium&lt;/i&gt; quiere decir &apos;esfera&apos;. Por lo tanto, un hemisferio es &apos;la mitad de una esfera&apos;.
