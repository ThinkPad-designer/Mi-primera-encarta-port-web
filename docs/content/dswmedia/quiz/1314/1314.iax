<?xml version="1.0"?><quiz type="multichoice" id="1314" lang="E" hascredits="1"><question><text>&lt;html&gt;¿De qué animal dependen las personas que viven en el Tíbet para alimentarse y vestirse?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Del rinoceronte&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Del yak&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Del hipopótamo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;De la jirafa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Del yak. &lt;br&gt;&lt;br&gt;La leche del yak es muy nutritiva y con ella se fabrica una mantequilla excelente. La carne se come tanto seca como cocinada. El pelo se hila para fabricar cuerdas, se teje para confeccionar ropa y el pellejo se utiliza para elaborar artículos de piel.&lt;/html&gt;</text><image w="149" h="133">T050067A.jpg</image><imagerefid>1B82763F</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films/F. Schneidermeyer</rewardcredits></quiz>