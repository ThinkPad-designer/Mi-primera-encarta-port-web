<?xml version="1.0"?><quiz type="multichoice" id="1212" lang="E" hascredits="1"><question><text>&lt;html&gt;No tengo muchos enemigos, pero soy muy vulnerable cuando estoy bebiendo agua. ¿Sabes quién soy?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;La jirafa&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El león&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El hipopótamo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El cisne&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;La jirafa. &lt;br&gt;&lt;br&gt;Las jirafas se defienden bien de la mayoría de los depredadores. Sin embargo, para poder inclinarse a beber agua tienen que separar mucho sus patas delanteras y, en esta posición, pueden ser atacadas por otro animal.&lt;/html&gt;</text><image w="99" h="149">T790533A.jpg</image><imagerefid>1B82B48D</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Masterfile/Steve Bloom</rewardcredits></quiz>