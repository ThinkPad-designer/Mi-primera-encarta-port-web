<?xml version="1.0"?><quiz type="multichoice" id="2249" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales es un insecto?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="149" h="99">T172748A.jpg</image><imagerefid>42D95D08</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T051162A.jpg</image><imagerefid>1B827A46</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="132">T025675A.jpg</image><imagerefid>1B8237D8</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T291850A.jpg</image><imagerefid>0C0477A0</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las mariposas son unos de los insectos de mayor colorido. Las alas de las mariposas están cubiertas de escamas de brillantes colores.&lt;/html&gt;</text><image w="149" h="132">T051162A.jpg</image><imagerefid>1B827A46</imagerefid><audio/><audiorefid/></reward><credits>Bruce Coleman, Inc./W. Stoy&lt;br&gt;&lt;br&gt;Oxford Scientific Films/J.A.L. Cooke&lt;br&gt;&lt;br&gt;Dorling Kindersley/Jerry Young&lt;br&gt;&lt;br&gt;age fotostock</credits><rewardcredits>Oxford Scientific Films/J.A.L. Cooke</rewardcredits></quiz>