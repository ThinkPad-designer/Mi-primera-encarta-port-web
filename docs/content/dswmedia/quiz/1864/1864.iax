<?xml version="1.0"?><quiz type="multichoice" id="1864" lang="E" hascredits="0"><question><text>&lt;html&gt;Ludwig van Beethoven sufrió una discapacidad que influyó mucho sobre su música y su carácter. ¿Cuál de las siguientes fue?&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Era sordo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Era ciego.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Era mudo.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text/><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>