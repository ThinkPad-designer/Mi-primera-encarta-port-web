<?xml version="1.0"?><quiz type="multichoice" id="1805" lang="E" hascredits="1"><question><text>&lt;html&gt;This is the largest city in North America. What is it?
&lt;/html&gt;</text><image w="149" h="99">0018a84c.jpg</image><imagerefid>42D982D3</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Los Angeles&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mexico City&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;New York City&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Toronto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mexico City.&lt;br&gt;&lt;br&gt;Mexico City is one of the biggest cities in the world!&lt;/html&gt;</text><image w="149" h="99">0018a84c.jpg</image><imagerefid>42D982D3</imagerefid><audio/><audiorefid/></reward><credits>age fotostock/Jon Arnold</credits><rewardcredits>age fotostock/Jon Arnold</rewardcredits></quiz>