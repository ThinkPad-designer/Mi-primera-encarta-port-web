<?xml version="1.0"?><quiz type="multichoice" id="1691" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the tallest mountain in Europe?&lt;/html&gt;</text><image w="153" h="136">T027992A.jpg</image><imagerefid>29D2BC1B</imagerefid><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Mount El’brus&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Grossglockner&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Matterhorn &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Mont Blanc&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Mount El’brus. &lt;br&gt;&lt;br&gt;Mount El’brus, located in southwestern Russia, is the tallest mountain in Europe. It is 18,510 feet (5,642 meters) tall.
&lt;/html&gt;</text><image w="153" h="136">T027992A.jpg</image><imagerefid>29D2BC1B</imagerefid><audio/><audiorefid/></reward><credits>National Geographic Society/Dean Conger</credits><rewardcredits>National Geographic Society/Dean Conger</rewardcredits></quiz>