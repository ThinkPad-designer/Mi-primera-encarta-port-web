<?xml version="1.0"?><quiz type="multichoice" id="1704" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the name of the mountain range that divides eastern Australia?
&lt;/html&gt;</text><image w="149" h="132">t029316a.jpg</image><imagerefid>1B82407A</imagerefid><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Darling Range&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Great Dividing Range&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Hamersley Range&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Kimberley Plateau&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Great Dividing Range. &lt;br&gt;&lt;br&gt;The Great Dividing Range runs parallel to the east coast of Australia.
&lt;/html&gt;</text><image w="149" h="132">t029316a.jpg</image><imagerefid>1B82407A</imagerefid><audio/><audiorefid/></reward><credits>Australian Picture Library/Leo Meier</credits><rewardcredits>Australian Picture Library/Leo Meier</rewardcredits></quiz>