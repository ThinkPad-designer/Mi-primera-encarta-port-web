<?xml version="1.0"?><quiz type="multichoice" id="1304" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales es un asno?&lt;/html&gt;</text><image w="149" h="132"/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text/><image w="149" h="132">T013055A.jpg</image><imagerefid>1B82300E</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="132">T045543A.jpg</image><imagerefid>1B8265EE</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="133">T050073B.jpg</image><imagerefid>1B827645</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="149">T014023A.jpg</image><imagerefid>1B8232F2</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El asno, que también recibe el nombre de burro, es un animal de carga excelente.&lt;/html&gt;</text><image w="149" h="149">T014023A.jpg</image><imagerefid>1B8232F2</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Anthony Bannister&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Anna Walsh&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Michael Fogden&lt;br&gt;&lt;br&gt;Oxford Scientific Films/Ronald Toms</credits><rewardcredits>Oxford Scientific Films/Ronald Toms</rewardcredits></quiz>