<?xml version="1.0"?><quiz type="multichoice" id="1189" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes reptiles es más común como mascota?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text/><image w="149" h="132">T049694A.jpg</image><imagerefid>1B8274D0</imagerefid><audio/><audiorefid/></answer><answer id="2"><text/><image w="149" h="99">001275e9.jpg</image><imagerefid>29D294E8</imagerefid><audio/><audiorefid/></answer><answer id="3"><text/><image w="149" h="99">T172910A.jpg</image><imagerefid>25A41257</imagerefid><audio/><audiorefid/></answer><answer id="4"><text/><image w="149" h="99">T172830A.jpg</image><imagerefid>25A41221</imagerefid><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Las tortugas son los reptiles más populares como mascotas. La gigotea elegante o tortuga de orejas rojas es una tortuga acuática fácil de mantener en un acuario.&lt;/html&gt;</text><image w="149" h="99">001275e9.jpg</image><imagerefid>29D294E8</imagerefid><audio/><audiorefid/></reward><credits>Oxford Scientific Films/Stan Osolinski&lt;br&gt;&lt;br&gt;Corbis/Jim Foster&lt;br&gt;&lt;br&gt;Bruce Coleman, Inc./J. Markham&lt;br&gt;&lt;br&gt;Bruce Coleman, Inc./Jean-Claude Carton</credits><rewardcredits>Corbis/Jim Foster</rewardcredits></quiz>