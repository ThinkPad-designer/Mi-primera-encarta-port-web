<?xml version="1.0"?><quiz type="multichoice" id="892" lang="E" hascredits="1"><question><text>&lt;html&gt;Si te rompes la tibia, el médico colocará una escayola sobre tu…
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Brazo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Pierna&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Dedo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Cadera&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Pierna. &lt;br&gt;&lt;br&gt;Cuando un hueso se rompe decimos que hay una fractura. Para que los fragmentos rotos no se separen y puedan unirse, los médicos colocan una escayola. A veces, necesitan utilizar también tornillos, clavos o placas metálicas.
&lt;/html&gt;</text><image w="149" h="132">T242297A.jpg</image><imagerefid>1B8294EA</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Bruce Coleman, Inc./Scott Kolbaurne</rewardcredits></quiz>