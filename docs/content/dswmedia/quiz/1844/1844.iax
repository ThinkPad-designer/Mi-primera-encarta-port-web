<?xml version="1.0"?><quiz type="multichoice" id="1844" lang="E" hascredits="0"><question><text>&lt;html&gt;Un compositor:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;Es la persona encargada de interpretar una partirura.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Es la persona que crea y escribe una pieza musical.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Es la persona que contrata a los músicos de una orquesta.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Es la persona que crea y escribe una pieza musical.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>