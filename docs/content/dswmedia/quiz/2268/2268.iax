<?xml version="1.0"?><quiz type="multichoice" id="2268" lang="E" hascredits="0"><question><text>&lt;html&gt;Algunos mosquitos mueven las alas más de…&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;10 veces por minuto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;1.000 veces por minuto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;10.000 veces por minuto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;60.000 veces por minuto&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;60.000 veces por minuto.&lt;br&gt;&lt;br&gt;Los insectos pueden volar gracias al movimiento rápido de sus alas. ¡Algunos mosquitos mueven las alas más de 60.000 veces por minuto! &lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>