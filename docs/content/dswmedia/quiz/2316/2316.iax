<?xml version="1.0"?><quiz type="multichoice" id="2316" lang="E" hascredits="1"><question><text>&lt;html&gt;A las canciones populares que se transmiten oralmente de generación en generación se las llama:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;Canciones folclóricas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Bandas sonoras&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Canciones contemporáneas&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Canciones folclóricas.&lt;br&gt;&lt;br&gt;Muchas de estas canciones populares se remontan tanto tiempo atrás que ni siquiera se sabe cuál es su origen.&lt;/html&gt;</text><image w="149" h="132">T040742A.jpg</image><imagerefid>1B825570</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Culver Pictures</rewardcredits></quiz>