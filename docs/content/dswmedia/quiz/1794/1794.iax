<?xml version="1.0"?><quiz type="multichoice" id="1794" lang="E" hascredits="1"><question><text>&lt;html&gt;What is the capital of Saudi Arabia?
&lt;/html&gt;</text><image w="149" h="99">T166710A.jpg</image><imagerefid>25A441F7</imagerefid><audio/><audiorefid/></question><answers correct="4"><answer id="1"><text>&lt;html&gt;Jiddah&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;Mecca&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;Medina&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;Riyadh&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;Riyadh.&lt;br&gt;&lt;br&gt;Riyadh is located in central Saudi Arabia, in the barren plateau region called the Najd.
&lt;/html&gt;</text><image w="149" h="99">T166710A.jpg</image><imagerefid>25A441F7</imagerefid><audio/><audiorefid/></reward><credits>Photo Researchers, Inc./Ray Ellis</credits><rewardcredits>Photo Researchers, Inc./Ray Ellis</rewardcredits></quiz>