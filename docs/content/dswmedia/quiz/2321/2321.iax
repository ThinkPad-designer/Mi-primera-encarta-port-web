<?xml version="1.0"?><quiz type="multichoice" id="2321" lang="E" hascredits="0"><question><text>&lt;html&gt;Existen tres elementos fundamentales en la música. Estos son:&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="3"><answer id="1"><text>&lt;html&gt;La melodía, el timbre y la armonía&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;La armonía, el ritmo y la polifonía&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El ritmo, la melodía y la armonía&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El ritmo, la melodía y la armonía.&lt;br&gt;&lt;br&gt;Con la combinación de los tres se puede crear todo tipo de música.&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></reward><credits/><rewardcredits/></quiz>