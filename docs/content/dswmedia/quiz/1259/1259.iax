<?xml version="1.0"?><quiz type="multichoice" id="1259" lang="E" hascredits="1"><question><text>&lt;html&gt;¿Cuál de los siguientes animales no es un insecto?
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="1"><answer id="1"><text>&lt;html&gt;El milpiés&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El escarabajo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;La abeja&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;La hormiga&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El milpiés. &lt;br&gt;&lt;br&gt;Todos los insectos tienen seis patas. El milpiés es un tipo de artrópodo. Tiene el cuerpo dividido entre 25 y 100 segmentos, con cuatro patas en cada uno.
&lt;/html&gt;</text><image w="153" h="137">T025264A.jpg</image><imagerefid>1B82367B</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Dorling Kindersley</rewardcredits></quiz>