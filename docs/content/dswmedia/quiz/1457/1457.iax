<?xml version="1.0"?><quiz type="multichoice" id="1457" lang="E" hascredits="1"><question><text>&lt;html&gt;En el desierto de Kalahari viven muchas especies de antílopes. ¿Cuál de los siguientes animales &lt;b&gt;no&lt;/b&gt; es un antílope? 
&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></question><answers correct="2"><answer id="1"><text>&lt;html&gt;El eland&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="2"><text>&lt;html&gt;El elefante&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="3"><text>&lt;html&gt;El kudú&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer><answer id="4"><text>&lt;html&gt;El órix de El Cabo&lt;/html&gt;</text><image/><imagerefid/><audio/><audiorefid/></answer></answers><reward><text>&lt;html&gt;El elefante.&lt;br&gt;&lt;br&gt;En la foto, dos elefantes. Los antílopes tienen cuernos, no colmillos ni trompa.
&lt;/html&gt;</text><image w="153" h="137">T050444A.jpg</image><imagerefid>42D959E2</imagerefid><audio/><audiorefid/></reward><credits/><rewardcredits>Oxford Scientific Films</rewardcredits></quiz>