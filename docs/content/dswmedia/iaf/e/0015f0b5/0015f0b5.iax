<?xml version="1.0"?><iai friendlyname="Kids: Famous Paintings" id="0015f0b5" height="400" width="556" hascredits="1" lang="E" basecontroltype="MatchGame" outlinecolorid="1" skinstyle="standard" skinlib="standard"><slides><slide type="matchgame" sequence="1" slideid="1" topbuckettype="Image" bottombuckettype="Text" itemsperbucket="8" solvedimagepos="Top" solvedaudiopos="Top" solvedtextpos="Bottom"><standardslide><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Relaciona cada uno de los cuadros con un pintor.&lt;/html&gt;</body><title/></caption><items><item id="0"><topbucket><image height="0" width="0">T628300A.jpg</image><imagerefid>1B82A590</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;Creación de Adán&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Miguel Ángel</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T628300A.jpg</image><imagerefid>1B82A590</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>&lt;i&gt;Creación de Adán&lt;/i&gt; forma parte de una de las obras maestras de Miguel Ángel: la decoración de la bóveda de la Capilla Sixtina, en la Ciudad del Vaticano, Italia.
</body><title>&lt;i&gt;Creación de Adán&lt;/i&gt;, de Miguel Ángel</title><image/><imagerefid/></caption></solvedbucket></item><item id="1"><topbucket><image height="0" width="0">T014134A.jpg</image><imagerefid>42D95659</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;Mona Lisa&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Leonardo da Vinci</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T014134A.jpg</image><imagerefid>42D95659</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>La &lt;i&gt;Mona Lisa&lt;/i&gt;, quizá la pintura más famosa del mundo, se encuentra en el Museo del Louvre de París, en Francia.
</body><title>&lt;i&gt;Mona Lisa&lt;/i&gt;, de Leonardo da Vinci</title><image/><imagerefid/></caption></solvedbucket></item><item id="2"><topbucket><image height="0" width="0">T059165A.jpg</image><imagerefid>29D020CD</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;La libertada guiando al pueblo&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Eugène Delacroix</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T059165A.jpg</image><imagerefid>29D020CD</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>&lt;i&gt;La libertad guiando al pueblo&lt;/i&gt; está inspirado en la Revolución de julio de 1830. El cuadro se encuentra en el Museo del Louvre de París, en Francia.</body><title>&lt;i&gt;La libertad guiando al pueblo&lt;/i&gt;, de Eugène Delacroix</title><image/><imagerefid/></caption></solvedbucket></item><item id="3"><topbucket><image height="0" width="0">T049539A.jpg</image><imagerefid>1B827438</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;El grito&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Edvard Munch</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T049539A.jpg</image><imagerefid>1B827438</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>Como muchas de las obras de Munch, &lt;i&gt;El grito&lt;/i&gt; es una pintura de dolor y angustia.</body><title>&lt;i&gt;El grito&lt;/i&gt;, de Edvard Munch</title><image/><imagerefid/></caption></solvedbucket></item><item id="4"><topbucket><image height="0" width="0">T267680A.jpg</image><imagerefid>1B829559</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;Noche estrellada&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Vincent van Gogh</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T267680A.jpg</image><imagerefid>1B829559</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>&lt;i&gt;Noche estrellada&lt;/i&gt; es una pintura de gruesas y turbulentas pinceladas de colores brillantes. Se encuentra en el Museo de Arte Moderno de Nueva York.</body><title>&lt;i&gt;Noche estrellada&lt;/i&gt;, Vincent van Gogh</title><image/><imagerefid/></caption></solvedbucket></item><item id="5"><topbucket><image height="0" width="0">T047905A.jpg</image><imagerefid>1B826E7A</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;La civilización tarasca&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Diego Rivera</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T047905A.jpg</image><imagerefid>1B826E7A</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>El pintor mexicano Diego Rivera  realizó esta pintura mural donde cuenta las costumbres de la cultura tarasca.</body><title>&lt;i&gt;La civilización tarasca&lt;/i&gt;, de Diego Rivera</title><image/><imagerefid/></caption></solvedbucket></item><item id="6"><topbucket><image height="0" width="0">T013652A.jpg</image><imagerefid>1B8231E2</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;Las Meninas&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Diego de Silva Velázquez</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T013652A.jpg</image><imagerefid>1B8231E2</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>En esta famosa obra, el propio artista se ha pintado a sí mismo dentro del cuadro, a la izquierda, como mirando al espectador. &lt;i&gt;Las Meninas&lt;/i&gt; están en el Museo del Prado de Madrid, España.</body><title>&lt;i&gt;Las Meninas&lt;/i&gt;, de Velázquez</title><image/><imagerefid/></caption></solvedbucket></item><item id="7"><topbucket><image height="0" width="0">T010191A.jpg</image><imagerefid>1B822716</imagerefid><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body>&lt;i&gt;Lata de sopa Campbell&lt;/i&gt;</body><title/><image/><imagerefid/></caption></topbucket><bottombucket><image height="0" width="0"/><imagerefid/><audiofile/><audiorefid/><caption titlestyleid="3" bodystyleid="4"><body/><title>Andy Warhol</title><image/><imagerefid/></caption></bottombucket><solvedbucket><image height="0" width="0">T010191A.jpg</image><imagerefid>1B822716</imagerefid><audiofile/><audiorefid/><caption titlestyleid="5" bodystyleid="4"><body>Warhol pintaba cosas que la gente veía cada día, como objetos domésticos o productos de alimentación. &lt;i&gt;Lata de sopa Campbell&lt;/i&gt; se encuentra en la Galería Leo Castelli de la ciudad de Nueva York.
</body><title>&lt;i&gt;Lata de sopa Campbell&lt;/i&gt;, de Andy Warhol</title><image/><imagerefid/></caption></solvedbucket></item></items><rewards><reward><text textstyleid="6">&lt;html&gt;¡Enhorabuena, excelente puntuación!&lt;/html&gt;</text><imagefile>Circus1.swf</imagefile></reward><reward><text textstyleid="6">&lt;html&gt;Lo has hecho muy bien. ¿Quieres jugar de nuevo?&lt;/html&gt;</text><imagefile>Circus2.swf</imagefile></reward><reward><text textstyleid="6">&lt;html&gt;Seguro que puedes hacerlo mejor. ¿Quieres intentarlo de nuevo?&lt;/html&gt;</text><imagefile>Circus3.swf</imagefile></reward></rewards></standardslide></slide></slides><iaigame><strings><resetbuttontext textbuttonstyleid="1">&lt;html&gt;Nuevo intento&lt;/html&gt;</resetbuttontext><currentleveltext textstyleid="7">&lt;html&gt;Nivel #&lt;/html&gt;</currentleveltext><scorelabeltext textstyleid="7">&lt;html&gt;Puntuación:&lt;/html&gt;</scorelabeltext><matcheslabeltext textstyleid="8">&lt;html&gt;aciertos&lt;/html&gt;</matcheslabeltext><trieslabeltext textstyleid="8">&lt;html&gt;intentos&lt;/html&gt;</trieslabeltext></strings></iaigame><textstyles><textstyle size="16" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="2" align="left" id="1"/><textstyle size="16" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="2" align="center" id="2"/><textstyle size="18" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="3" align="center" id="3"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="2" align="left" id="4"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="2" align="left" id="5"/><textstyle size="20" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="4" align="center" id="6"/><textstyle size="16" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="1" align="center" id="7"/><textstyle size="12" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="1" align="center" i