bled="" qtimerenabled="" qdialog="" addentry="" delentry="62,63,64,65,66,67,68,69" addsuccess="" delsuccess="" addfail="" delfail="" addqgrp="" delqgrp="" altpips=""/></pipfx><labelfx><labelfct boardid="5" labelid="1" labelstate="invisible"/><labelfct boardid="5" labelid="2" labelstate="invisible"/><labelfct boardid="5" labelid="3" labelstate="invisible"/><labelfct boardid="5" labelid="4" labelstate="invisible"/><labelfct boardid="5" labelid="5" labelstate="invisible"/><labelfct boardid="5" labelid="6" labelstate="invisible"/><labelfct boardid="5" labelid="7" labelstate="invisible"/><labelfct boardid="5" labelid="8" labelstate="invisible"/></labelfx></event><event id="62" fname="Valley of Kings Dialog" score="0" keys="0" dialog="1" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="63" fname="Sahara dialog" score="0" keys="0" dialog="2" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="64" fname="Serengeti Dialog" score="0" keys="0" dialog="3" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="65" fname="Swahili dialog" score="0" keys="0" dialog="4" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="66" fname="Kalaharai dialog" score="0" keys="0" dialog="5" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="67" fname="Madagascar dialog" score="0" keys="0" dialog="6" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="68" fname="West Coast Dialog" score="0" keys="0" dialog="7" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="69" fname="Niger River Dialog" score="0" keys="0" dialog="8" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="70" fname="Retreat player" score="0" keys="0" dialog="" pgraphic="" newboard="" newpip="" retreat="1" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="71" fname="End Game" score="0" keys="0" dialog="" pgraphic="" newboard="" newpip="" retreat="0" endgame="1" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="72" fname="Turn off main instructions" score="0" keys="0" dialog="" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx><labelfct boardid="14" labelid="3" labelstate="invisible"/></labelfx></event><event id="73" fname="Make subboard instruction invisible." score="0" keys="0" dialog="" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx/><pipfx/><labelfx><labelfct boardid="5" labelid="18" labelstate="invisible"/></labelfx></event><event id="74" fname="Evaluate for Losing Animation" score="0" keys="0" dialog="" pgraphic="" newboard="" newpip="" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="1" item="keys" value="8" success="75" fail=""/><boardfx/><pipfx/><labelfx/></event><event id="75" fname="Move to Losing Animation" score="0" keys="0" dialog="" pgraphic="" newboard="15" newpip="1" retreat="0" endgame="0" audio="" audiorefid=""><eval enabled="0" item="score" value="0" success="" fail=""/><boardfx><boardfct boardid="15" image="" animin="" animout="" navframe="_Level4" imagerefid="" animationinrefid="" animationoutrefid=""/></boardfx><pipfx/><labelfx><labelfct boardid="15" labelid="6" labelstate="visible"/></labelfx></event></events><dialogs><dialog id="1" fname="Valle de los Reyes"><title textstyleid="1">&lt;html&gt;Valle de los Reyes&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;En este lugar se encuentra la necrópolis utilizada por los faraones del antiguo Egipto del periodo llamado Imperio Nuevo (hace entre 3.500 y 3.070 años). Está enclavado en la orilla occidental del río Nilo, en las proximidades de la antigua ciudad de Tebas y frente a la actual ciudad de Luxor.&lt;br&gt;Los antiguos egipcios creían que en la otra vida podrían usar aquellos útiles que los acompañaran en su último viaje. De este modo, los faraones fueron enterrados con sus magníficos tesoros.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="2" fname="Sahara"><title textstyleid="1">&lt;html&gt;Sahara&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;El Sahara es el desierto más grande del mundo. Se extiende arenoso a lo largo de buena parte del norte de África y ha supuesto una barrera natural para las culturas de esa parte del mundo.&lt;br&gt;&lt;br&gt;Los seres humanos, las escasas plantas y los animales que en él habitan han tenido que aprender a adaptarse a un medio ambiente frecuentemente hostil.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="3" fname="Serengeti"><title textstyleid="1">&lt;html&gt;Serengeti&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;Leones, guepardos, elefantes y jirafas recorren las llanuras del Parque nacional Serengeti. Muchas especies de antílopes viven en este espacio protegido y sus desplazamientos estacionales suponen un increíble espectáculo.&lt;br&gt;&lt;br&gt;El Serengeti limita con la Reserva nacional Masai Mara, donde vive uno de los más famosos pueblos africanos, el pueblo masai.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="4" fname="Costa swahili"><title textstyleid="1">&lt;html&gt;Costa swahili&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;En algunas ocasiones se suele denominar a la costa oriental africana costa swahili. La cultura del pueblo swahili tiene en su lengua su más interesante manifestación. El swahili es el idioma oficial de Tanzania y Kenia, y de hecho es una lengua empleada en todo el África oriental, muy influida por el árabe, a consecuencia de las tradicionales relaciones comerciales de la región, y con numerosos préstamos de la lengua inglesa.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="5" fname="Kalahari"><title textstyleid="1">&lt;html&gt;Kalahari&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;En una meseta del sur de África encontramos el desierto de Kalahari. Esta árida zona es el hogar del pueblo san, más conocido como bosquimano, y del pueblo khoikhoi. Pero, también habitan sus tierras los leones, los leopardos, las hienas y los chacales.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="6" fname="Madagascar"><title textstyleid="1">&lt;html&gt;Madagascar&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;La enorme isla frente a la costa del oriente africano es única. Numerosas especies de las plantas y animales que la pueblan son endémicas, es decir, solo se pueden encontrar en Madagascar. Ello incluye por ejemplo a los significativos lémures.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="7" fname="Costa occidental"><title textstyleid="1">&lt;html&gt;Costa occidental&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;Los comerciantes europeos dieron peculiares nombres a los distintos tramos del litoral occidental africano: Costa de Marfil, Costa de Oro y Costa de los Esclavos son algunos de los que más éxito tuvieron. No obstante, los traficantes no solo secuestraron africanos de esa llamada Costa de los Esclavos. Afortunadamente, aquellos tiempos hace muchos años que acabaron.&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog><dialog id="8" fname="Río Níger"><title textstyleid="1">&lt;html&gt;Río Níger&lt;/html&gt;</title><body textstyleid="2">&lt;html&gt;El río Níger es inevitablemente uno de los principales escenarios del occidente africano. Sus aguas han saciado la sed de los seres vivos, han regado las granjas y han servido para la navegación de embarcaciones a lo largo de los siglos. Fluye a través de junglas desde los confines del Sahara y forma un enorme delta ya en su desembocadura sobre el océano Atlántico, en Nigeria.&lt;br&gt;&lt;br&gt;Sucesivos imperios poderosos nacieron y murieron en su orilla, junto a la cual se edificaron ciudades fundamentales para el comercio y para la cultura de la zona.
&lt;/html&gt;</body><picon w="0" h="0"/><piconrefid/><audio/><audiorefid/><bgimage w="470" h="350">tourguideBGart.swf</bgimage><bgimagerefid/><creditstring/></dialog></dialogs><bgacontrol initiallocation="14,3" initialtokens="0" displaytokens="0" initialscore="0" displayscore="1" questionbodytextstyleid="2" questionitemtextstyleid="3" questionrewardtextstyleid="2" dialogtitletextstyleid="1" dialogbodytextstyleid="2" bodycreditstextstyleid="4" okbuttontextstyleid="5" bodycreditstitletextstyleid="6"><strings><multdialneeded>&lt;html&gt;Respuestas que necesitas acertar&lt;/html&gt;</multdialneeded><multdialgot>&lt;html&gt;Respuestas acertadas&lt;/html&gt;</multdialgot><tmrrem>&lt;html&gt;Tiempo&lt;/html&gt;</tmrrem><tmrneeded>&lt;html&gt;Respuestas&lt;BR&gt;que necesitas&lt;BR&gt;acertar&lt;/html&gt;</tmrneeded><ok>&lt;html&gt;Continuar&lt;/html&gt;</ok><credits>Créditos</credits><continue>&lt;html&gt;Aceptar&lt;/html&gt;</continue></strings><playergraphic h="0" w="0">001714abBoard.swf</playergraphic></bgacontrol><textstyles><textstyle size="24" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="2" align="left" id="1"/><textstyle size="16" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="2" align="left" id="2"/><textstyle size="16" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="2" align="left" id="3"/><textstyle size="10" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="3" align="left" id="4"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="2" align="left" id="5"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="3" align="left" id="6"/><textstyle size="20" font="Lucida Console" bold="1" italic="0" underline="0" colorid="4" align="center" id="7"/><textstyle size="10" font="Arial" bold="0" italic="0" underline="0" colorid="2" align="left" id="8"/><textstyle size="20" font="Impact" bold="0" italic="0" underline="0" colorid="5" align="left" id="9"/