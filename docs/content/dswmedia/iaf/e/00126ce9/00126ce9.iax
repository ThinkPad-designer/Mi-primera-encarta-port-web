<?xml version="1.0"?><iai friendlyname="Kids Butterfly Life Cycle" id="00126ce9" height="339" width="556" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="55"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Tras aparearse, las mariposas hembra ponen los huevos que, generalmente, están rodeados por una cáscara protectora.&lt;/html&gt;</body><title>&lt;html&gt;Mariposa poniendo huevos&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-1.swf</image><audiofile/><labels><label labelid="145" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="26" y="45"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Mariposa &lt;br&gt;hembra&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Mariposa &lt;br&gt;hembra&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="146" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="36" y="104"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Huevos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Huevos&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Mariposa poniendo huevos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="2" slideid="56"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La larva, que recibe el nombre de oruga, se desarrolla en el interior del huevo y luego se come la cáscara para salir.&lt;/html&gt;</body><title>&lt;html&gt;Oruga saliendo del huevo&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-2.swf</image><audiofile/><labels><label labelid="148" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="116" y="84"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Oruga&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Oruga&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="149" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="270" y="274"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Huevo abriéndose&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Huevo abriéndose&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Oruga saliendo del huevo&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="3" slideid="57"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La oruga pasa todo el tiempo comiendo. Va aumentando de tamaño y llega un momento que no cabe en su piel. Entonces, muda, se despoja de la piel y forma otra nueva más grande. Las mariposas mudan cuatro o cinco veces.&lt;/html&gt;</body><title>&lt;html&gt;Oruga mudando la piel&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-3.swf</image><audiofile/><labels/><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Oruga mudando la piel&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="4" slideid="59"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Cuando la oruga alcanza su tamaño final, deja de alimentarse. Forma una cubierta o capullo protector y se transforma en pupa o crisálida.&lt;/html&gt;</body><title>&lt;html&gt;Transformándose en crisálida&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-5.swf</image><audiofile/><labels><label labelid="150" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="277" y="113"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Piel vieja&lt;br&gt;de la oruga&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Piel vieja&lt;br&gt;de la oruga&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="151" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="276" y="234"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Crisálida&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Crisálida&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Transformándose en crisálida&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="5" slideid="60"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La pupa cambia poco a poco de forma y se va transformando en una mariposa adulta.&lt;/html&gt;</body><title>&lt;html&gt;Crisálida&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-6.swf</image><audiofile/><labels><label labelid="152" action="static" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="305" y="123"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Crisálida&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Crisálida&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Crisálida&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" sequence="6" slideid="63"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Cuando la mariposa alcanza la edad adulta, abandona el capullo. Bombea sangre a las alas arrugadas y las despliega antes de emprender el vuelo.&lt;/html&gt;</body><title>&lt;html&gt;Mariposa adulta&lt;/html&gt;</title><image/><imagerefid/></caption><image>T304335-9.swf</image><audiofile/><labels/><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>400</imagewidth><listtitle>&lt;html&gt;Mariposa adulta&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="2" resetbuttonstyleid="3" navbuttonstyleid="1" numbermenuitems="1" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="5" guttercolorid="5" graphiccolorid="3" outlinecolorid="5" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="6" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="6" displayoutlinecolorid="6" popbuttonstyleid="1"><scrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="9" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="9" align="left" id="2"/><textstyle size="11" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="9" align="left" id="3"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" align="left" id="4"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="9" align="left" id="5"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="11" align="left" id="6"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="1" colorid="11" align="left" id="7"/><textstyle size="11" font="Arial" bold="0" italic="0" underline="0" colorid="9" align="left" id="8"/><textstyle size="11" font="Arial" bold="0" italic="0" underline="0" colorid="3" align="left" id="9"/><textstyle size="10" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="3" align="center" id="10"/><textstyle size="20" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="5" align="left" id="11"/><textstyle size="11" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="5" align="left" id="12"/></textstyles><textbuttonstyles><textbuttonstyle showbg="0" showoutline="0" basestateid="1" rollstateid="2" downstateid="2" selectedstateid="2" disabledstateid="1" basestyleid="5" rollstyleid