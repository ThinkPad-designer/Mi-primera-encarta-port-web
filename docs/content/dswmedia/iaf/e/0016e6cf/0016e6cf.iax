9"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>520</x><y>227</y></point><point><x>562</x><y>227</y></point><point><x>557</x><y>33</y></point><point><x>526</x><y>33</y></point><point><x>520</x><y>227</y></point></hotarea><labeltarget>11</labeltarget><picon height="100" width="100" showwireframe="0" showimage="0" colorid="2"><pos x="65" y="239"/><altimage>taipei101_alt.jpg</altimage><altimagerefid/></picon><labeltext>&lt;html&gt;Taipei 101 &lt;/html&gt;</labeltext><audiorefid/><bgrct x="171" y="280" w="81" h="17"/></label><label labelid="17" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="6" y="353"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>1</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Haz clic en los rascacielos para obtener más información.&lt;/html&gt;</labeltext><audiorefid/><bgrct x="2" y="354" w="314" h="13"/></label><label labelid="10" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="6" y="244"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;metros&lt;/html&gt;</labeltext><audiorefid/><bgrct x="2" y="245" w="49" h="14"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>350</imageheight><imagewidth>572</imagewidth><listtitle>&lt;html&gt;Rascacielos&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="2" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;París, Francia&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1889&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;300 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;Se trata de uno de los edificios más famosos de París. El diseñador de la torre, Gustave Eiffel, diseñó también la Estatua de la Libertad en Nueva York.&lt;/html&gt;</body><title>&lt;html&gt;Torre Eiffel &lt;/html&gt;</title><image/><imagerefid/></caption><image>eiffeltower.jpg</image><audiofile/><labels/><keywords/><imagerefid>25A4057F</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>211</imagewidth><listtitle>&lt;html&gt;Torre Eiffel &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="3" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Nueva York, Estados Unidos&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1931&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;381 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;El Empire State Building es el icono más importante de la ciudad de Nueva York.&lt;/html&gt;</body><title>&lt;html&gt;Empire State Building&lt;/html&gt;</title><image/><imagerefid/></caption><image>empirestate.jpg</image><audiofile/><labels/><keywords/><imagerefid>1B8240E8</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>230</imagewidth><listtitle>&lt;html&gt;Empire State Building&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="4" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Chicago, Estados Unidos&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1974&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;442 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;La torre Sears fue el edificio más alto durante 20 años.&lt;/html&gt;</body><title>&lt;html&gt;Torre Sears &lt;/html&gt;</title><image/><imagerefid/></caption><image>searstwr.jpg</image><audiofile/><labels/><keywords/><imagerefid>29D29174</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>210</imagewidth><listtitle>&lt;html&gt;Torre Sears &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="5" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Toronto, Canadá&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1976&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;553 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;El edificio más alto del mundo fue declarado una de las siete maravillas del mundo moderno por la Sociedad Americana de Ingenieros Civiles en 1995.&lt;/html&gt;</body><title>&lt;html&gt;Torre CN &lt;/html&gt;</title><image/><imagerefid/></caption><image>cntower.jpg</image><audiofile/><labels/><keywords/><imagerefid>25A404FB</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>308</imagewidth><listtitle>&lt;html&gt;Torre CN &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="6" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Hong Kong, China&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1989&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;368 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;La torre del Banco de China fue diseñada por I. M. Pei. Se inspiró en el modelo de crecimiento de las cañas de bambú. Cambió su diseño original con forma de X por el de forma de diamante, ya que esa X simbolizaba para mucha gente en Hong Kong la muerte.&lt;/html&gt;</body><title>&lt;html&gt;Banco de China&lt;/html&gt;</title><image/><imagerefid/></caption><image>bankofchina.jpg</image><audiofile/><labels/><keywords/><imagerefid>584F1608</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>216</imagewidth><listtitle>&lt;html&gt;Banco de China&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="7" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Kuala Lumpur, Malaysia&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1998&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;452 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;El arquitecto argentino César Pelli se inspiró en las construcciones islámicas tradicionales de Malaysia para diseñar el edificio.&lt;/html&gt;</body><title>&lt;html&gt;Torres Petronas &lt;/html&gt;</title><image/><imagerefid/></caption><image>Petronas.jpg</image><audiofile/><labels/><keywords/><imagerefid>1B82A562</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>270</imagewidth><listtitle>&lt;html&gt;Torres Petronas &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="8" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Dubai, Emiratos Árabes Unidos&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;1998&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;321 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;Su diseño recuerda un barco de vela. Es el primer hotel de &quot;siete estrellas&quot; del mundo.&lt;/html&gt;</body><title>&lt;html&gt;Hotel Burj al-Arab &lt;/html&gt;</title><image/><imagerefid/></caption><image>burjalarab.jpg</image><audiofile/><labels/><keywords/><imagerefid>29D1E45A</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>217</imagewidth><listtitle>&lt;html&gt;Hotel Burj al Arab &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="9" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localizaciónn&lt;/b&gt;&lt;br&gt;Riad, Arabia Saudí&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;2002&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;302 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;Este edificio futurista destaca en el horizonte de la capital de Arabia Saudí.&lt;/html&gt;</body><title>&lt;html&gt;Centro Kingdom &lt;/html&gt;</title><image/><imagerefid/></caption><image>kingdomctr.jpg</image><audiofile/><labels/><keywords/><imagerefid>584F1616</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>282</imagewidth><listtitle>&lt;html&gt;Centro Kingdom &lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="10" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Londres, Reino Unido&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;2004&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;180 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;Apodado el &quot;pepinillo&quot;, este rascacielos de cristal con forma de espiral, fue diseñado después del ataque terrorista que destruyó la construcción anterior.&lt;/html&gt;</body><title>&lt;html&gt;Swiss Re’s St Mary Axe HQ&lt;/html&gt;</title><image/><imagerefid/></caption><image>swissre.jpg</image><audiofile/><labels/><keywords/><imagerefid>29D30081</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>201</imagewidth><listtitle>&lt;html&gt;Swiss Re’s St Mary Axe HQ&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="11" sequence="11"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;&lt;b&gt;Localización&lt;/b&gt;&lt;br&gt;Taipei, Taiwan&lt;br&gt;&lt;b&gt;Terminado en&lt;/b&gt;&lt;br&gt;2004&lt;br&gt;&lt;b&gt;Altura&lt;/b&gt;&lt;br&gt;508 metros&lt;br&gt;&lt;b&gt;Datos de interés&lt;/b&gt;&lt;br&gt;Actualmente se trata del edificio habitado más alto del mundo. Su diseño se inspira en la construcción tradicional de una pagoda.&lt;/html&gt;</body><title>&lt;html&gt;Taipei 101&lt;/html&gt;</title><image/><imagerefid/></caption><image>taipei101_use1.jpg</image><audiofile/><labels/><keywords/><imagerefid>29D29295</imagerefid><audiorefid/><imageheight>317</imageheight><imagewidth>214</imagewidth><listtitle>&lt;html&gt;Taipei 101&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="3" textdividerbarcolorid="3" creditsbuttonstyleid="4" resetbuttonstyleid="5" navbuttonstyleid="1" numbermenuitems="0" showpop="0" autoadvance="0" shownavarrows="0" bottombarheight="31"><audiocontrollerstyle bgcolorid="4" progresscolorid="3" guttercolorid="4" graphiccolorid="2" outlinecolorid="5" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="6" displaybgcolorid="2" listbgcolorid="2" listoutlinecolorid="6" displayoutlinecolorid="6" popbuttonstyleid="1"><scrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="6" thumbbasecolorid="7" thumbrollcolorid="8" thumbdowncolorid="8" buttonstyleid="1"/><creditsbuttontext>Credits</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="9" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic