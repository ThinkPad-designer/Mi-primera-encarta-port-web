or r="234" g="145" b="35" id="13"/><color r="73" g="67" b="57" id="14"/><color r="150" g="150" b="150" id="15"/><color r="207" g="207" b="207" id="16"/><color r="252" g="87" b="26" id="17"/><color r="255" g="151" b="0" id="18"/><color r="255" g="116" b="0" id="19"/><color r="250" g="208" b="54" id="20"/><color r="242" g="25" b="20" id="21"/><color r="182" g="51" b="204" id="22"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="6" bgcolorid="2" graphiccolorid="12" id="1"/><tcbuttonstate outlinecolorid="6" bgcolorid="2" graphiccolorid="13" id="2"/><tcbuttonstate outlinecolorid="6" bgcolorid="2" graphiccolorid="10" id="3"/><tcbuttonstate outlinecolorid="14" bgcolorid="15" graphiccolorid="10" id="4"/><tcbuttonstate outlinecolorid="14" bgcolorid="16" graphiccolorid="10" id="5"/><tcbuttonstate outlinecolorid="14" bgcolorid="16" graphiccolorid="2" id="6"/><tcbuttonstate outlinecolorid="17" bgcolorid="18" graphiccolorid="2" id="7"/><tcbuttonstate outlinecolorid="19" bgcolorid="20" graphiccolorid="2" id="8"/><tcbuttonstate outlinecolorid="21" bgcolorid="17" graphiccolorid="2" id="9"/><tcbuttonstate outlinecolorid="11" bgcolorid="22" graphiccolorid="2" id="10"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="1"/></twocolorbuttonstyles></iai>