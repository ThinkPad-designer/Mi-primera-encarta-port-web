<?xml version="1.0"?><iai friendlyname="Kids Clouds" id="00127507" height="343" width="628" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las nubes están compuestas por minúsculas partículas de agua suspendidas en el aire de la atmósfera, que se han condensado en torno a motas de polvo, polen, hielo o sal. Se forman cuando una masa de aire se eleva, se enfría y se expansiona. Las nubes presentan siluetas diferentes y se encuentran a distintas alturas.&lt;br&gt;Haz clic en las palabras en rojo para encontrar más información.

&lt;/html&gt;</body><title>&lt;html&gt;Las nubes&lt;/html&gt;</title><image/><imagerefid/></caption><image>T172254A-1.swf</image><audiofile/><labels><label labelid="1" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="286" y="79"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las nubes cumulonimbus son grises y están formadas por torres oscuras de cúmulos apilados. Alcanzan grandes alturas y están asociadas a fuertes lluvias, granizos, nevadas e, incluso, tornados.&lt;/html&gt;</body><title>&lt;html&gt;Cumulonimbus&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cumulonimbus&lt;/html&gt;</labeltext><audiorefid/><bgrct x="282" y="80" w="109" h="17"/></label><label labelid="2" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="199" y="107"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Esta nubes forman gruesas capas de color gris o blanco, y cubren todo el cielo por lo que ofrecen un día brumoso (¡difícilmente verás el Sol!). A veces producen nevisca o lloviznas, aunque como están tan altas las precipitaciones suelen evaporarse antes de llegar al suelo. &lt;/html&gt;</body><title>&lt;html&gt;Altoestratos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Altoestratos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="195" y="108" w="91" h="17"/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="401" y="4"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;10 km&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;10 km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="397" y="5" w="51" h="17"/></label><label labelid="4" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="408" y="59"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;8 km &lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;8 km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="404" y="60" w="43" h="17"/></label><label labelid="5" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="408" y="119"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;6 km &lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;6 km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="404" y="120" w="43" h="17"/></label><label labelid="6" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="408" y="184"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;4 km &lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;4 km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="404" y="185" w="43" h="17"/></label><label labelid="7" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="408" y="247"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;2 km &lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;2 km&lt;/html&gt;</labeltext><audiorefid/><bgrct x="404" y="248" w="43" h="17"/></label><label labelid="8" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="259" y="172"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los cúmulos son una nubes blancas y esponjosas que se forman a alturas bajas en los días soleados. Sus bases son aplanadas y sus cimas son aborregadas, con aspecto de coliflor. Normalmente indican que el buen tiempo va a continuar...&lt;/html&gt;</body><title>&lt;html&gt;Cúmulos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cúmulos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="255" y="173" w="67" h="17"/></label><label labelid="9" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="112" y="230"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Esta nubes se forman a baja altura y son como capas de color gris oscuro. Traen lluvias y también nieve cuando las temperaturas son frías. &lt;/html&gt;</body><title>&lt;html&gt;Nimboestratos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Nimboestratos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="108" y="231" w="107" h="17"/></label><label labelid="10" action="caption" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="10" y="5"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las nubes están compuestas por minúsculas partículas de agua suspendidas en el aire de la atmósfera, que se han condensado en torno a motas de polvo, polen, hielo o sal. Se forman cuando una masa de aire se eleva, se enfría y se expansiona. Las nubes presentan siluetas diferentes y se encuentran a distintas alturas.&lt;/html&gt;</body><title>&lt;html&gt;Las nubes&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Las nubes&lt;/html&gt;</labeltext><audiorefid/><bgrct x="6" y="6" w="96" h="22"/></label><label labelid="11" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="90" y="181"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los estratocúmulos son extensas capas de nubes grises y esponjosas que suelen cubrir casi todo el cielo. Suelen traer precipitaciones de todo tipo: desde lloviznas hasta nevadas. &lt;/html&gt;</body><title>&lt;html&gt;Estratocúmulos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Estratocúmulos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="86" y="182" w="113" h="17"/></label><label labelid="12" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="14" y="269"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los estratos son nubes bajas, grises y en forma de láminas. Suelen cubrir la mayor parte del cielo durante días y producen lloviznas, débiles nevadas, neblinas y niebla.&lt;/html&gt;</body><title>&lt;html&gt;Estratos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Estratos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="10" y="270" w="64" h="17"/></label><label labelid="13" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="272" y="19"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los cirros son nubes muy altas y parecen delicadas plumas o jirones de color blanco. Están formadas por cristales de hielo que empujan los fuertes vientos. Revelan la existencia de humedad y la posible llegada de lluvias.&lt;/html&gt;</body><title>&lt;html&gt;Cirros&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cirros&lt;/html&gt;</labeltext><audiorefid/><bgrct x="268" y="20" w="49" h="17"/></label><label labelid="14" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="102" y="28"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Son nubes altísimas y casi transparentes. Sus cristales de hielo dispersan la luz y crean un halo o fino velo en torno al Sol o la Luna. Suelen indicar que se acerca una tormenta o un periodo de tiempo cálido. &lt;/html&gt;</body><title>&lt;html&gt;Cirroestratos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cirroestratos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="98" y="29" w="97" h="17"/></label><label labelid="15" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="179" y="62"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Estas nubes blancas aparecen altas en el cielo. Parecen trocitos de cúmulos y anuncian un cambio de tiempo y la proximidad de una tormenta. &lt;/html&gt;</body><title>&lt;html&gt;Cirrocúmulos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cirrocúmulos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="175" y="63" w="99" h="17"/></label><label labelid="16" action="caption" usepicon="0" useleader="0" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="13" y="135"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los altocúmulos se forman a media altura y presentan un color gris en sus bases. Son como filas de cúmulos y aunque indican un cambio de tiempo eso no quiere decir que vaya a llover...&lt;/html&gt;</body><title>&lt;html&gt;Altocúmulos&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Altocúmulos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="9" y="136" w="92" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>312</imageheight><imagewidth>472</imagewidth><listtitle>&lt;html&gt;Las nubes&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="4" resetbuttonstyleid="5" navbuttonstyleid="1" numbermenuitems="1" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="4" guttercolorid="5" graphiccolorid="3" outlinecolorid="6" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="7" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="7" displayoutlinecolorid="7" popbuttonstyleid="1"><scrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="10" align="left" id="2"/><textstyle size="11" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="10" align="left" id="3"/><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="11" align="left" id="4"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="12" align="left" id="5"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="13" align="left" id="6"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="10" align="left" id="7"/><textstyle size="14" font="Trebuchet MS" bold="1" italic="0" underline="1" colorid="13" align="left" id="8"/><textstyle size="18" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="12" align="left" id="9"/><textstyle size="18" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="13" align="left" id="10"/><textstyle size="18" font="Trebuchet MS" bold="1" italic="0" underline="0" colorid="10" align="left" id="11"/><textstyle size="11" font="Arial" bold="0" italic="0" underline="0" colorid="10" align="left" id="12"/><textstyle size="11" font="Arial" bold="0" italic="0" underline="0" colorid="3" align="left" id="13"/><textstyle size="10" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="3" align="center" id="14"/><textstyle size="20" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="6" align="left" id="15"/><textstyle size="11" font="Trebuchet MS" bold="0" italic="0" underline="0" colorid="6" align="left" id="16"/></textstyles><textbuttonstyles><textbuttonstyle showbg="0" showoutline="0" basestateid="1" rollstateid="2" downstateid="2" selectedstateid="2" disabledstateid="3" basestyleid="5" rollstyleid="6" downstyleid="6" selectedstyleid="6" disabledstyleid="7" id="1"/><textbuttonstyle showbg="0" showoutline="0" basestateid="3" rollstateid="2" downstateid="2" selectedstateid="2" disabledstateid="3" basestyleid="7" rollstyleid="6" downstyleid="8" selectedstyleid="8" disabledstyleid="7" id="2"/><textbuttonstyle showbg="0" showoutline="0" basestateid="1" rollstateid="2" downstateid="2" selectedstateid="2" disabledstateid="3" basestyleid="9" rollstyleid="10" downstyleid="10" selectedstyleid="10" disabledstyleid="11" id="3"/><textbuttonstyle showbg="0" showoutline="0" basestyleid="12" rollstyleid="12" downstyleid="13" selectedstyleid="12" disabledstyleid="12" basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="4"/><textbuttonstyle showbg="1" showoutline="1" basestyleid="14" rollstyleid="14" downstyleid="14" selectedstyleid="14" disabledstyleid="14" basestateid="7" rollstateid="8" downstateid="9" selectedstateid="9" disabledstateid="10" id="5"/></textbuttonstyles><creditsdialogdata bodystyleid="16" titlestyleid="15"><dialogtitle>&lt;html&gt;Créditos&lt;/html&gt;</dialogtitle><text/></creditsdialogdata><colors><color r="137" g="51" b="204" id="1"/><color r="142" g="142" b="142" id="2"/><color r="255" g="255" b="255" id="3"/><color r="224" g="224" b="228" id="4"/><color r="160" g="160" b="164" id="5"/><color r="0" g="0" b="0" id="6"/><color r="227" g="227" b="227" id="7"/><color r="198" g="198" b="198" id="8"/><color r="128" g="128" b="128" id="9"/><color r="50" g="50" b="50" id="10"/><color r="90" g="16" b="148" id="11"/><color r="224" g="88" b="21" id="12"/><color r="234" g="145" b="35" id="13"/><color r="73" g="67" b="57" id="14"/><color r="150" g="150" b="150" id="15"/><color r="207" g="207" b="207" id="16"/><color r="252" g="87" b="26" id="17"/><color r="255" g="151" b="0" id="18"/><color r="255" g="116" b="0" id="19"/><color r="250" g="208" b="54" id="20"/><color r="242" g="25" b="20" id="21"/><color r="182" g="51" b="204" id="22"/></colors><twocolorbuttonstates><tcbuttonstate outlinecolorid="6" bgcolorid="3" graphiccolorid="12" id="1"/><tcbuttonstate outlinecolorid="6" bgcolorid="3" graphiccolorid="13" id="2"/><tcbuttonstate outlinecolorid="6" bgcolorid="3" graphiccolorid="10" id="3"/><tcbuttonstate outlinecolorid="14" bgcolorid="15" graphiccolorid="10" id="4"/><tcbuttonstate outlinecolorid="14" bgcolorid="16" graphiccolorid="10" id="5"/><tcbuttonstate outlinecolorid="14" bgcolorid="16" graphiccolorid="3" id="6"/><tcbuttonstate outlinecolorid="17" bgcolorid="18" graphiccolorid="3" id="7"/><tcbuttonstate outlinecolorid="19" bgcolorid="20" graphiccolorid="3" id="8"/><tcbuttonstate outlinecolorid="21" bgcolorid="17" graphiccolorid="3" id="9"/><tcbuttonstate outlinecolorid="11" bgcolorid="22" graphiccolorid="3" id="10"/></twocolorbuttonstates><twocolorbuttonstyles><tcbuttonstyle basestateid="4" rollstateid="5" downstateid="6" selectedstateid="4" disabledstateid="4" id="1"/></twocolorbuttonstyles></iai>