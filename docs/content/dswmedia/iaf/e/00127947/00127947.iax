ta del&lt;br&gt;invierno&lt;/html&gt;</title><image/><imagerefid/></caption><image>172238-4.swf</image><audiofile/><labels><label labelid="253" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="201" y="126"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;India&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;India&lt;/html&gt;</labeltext><audiorefid/><bgrct x="197" y="127" w="43" h="17"/></label><label labelid="254" action="static" usepicon="0" useleader="0" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="175" y="162"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Bombay/Mumbay&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Bombay/Mumbay&lt;/html&gt;</labeltext><audiorefid/><bgrct x="171" y="163" w="124" h="17"/></label><label labelid="255" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="52" y="217"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title>&lt;html&gt;Océano Índico&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano Índico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="48" y="218" w="112" h="18"/></label></labels><keywords/><imagerefid/><audiorefid/><i