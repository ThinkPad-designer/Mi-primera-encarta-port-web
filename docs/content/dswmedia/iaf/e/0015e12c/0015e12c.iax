<?xml version="1.0"?><iai friendlyname="Kids Inside a pyramid" id="0015e12c" height="411" width="574" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Haz clic sobre el texto en rojo para conocer las partes de esta pirámide.&lt;/html&gt;</body><title>&lt;html&gt;En el interior de una pirámide&lt;/html&gt;</title><image/><imagerefid/></caption><image>T240926A.swf</image><audiofile/><labels><label labelid="0" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="12" y="127"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>16</x><y>0</y></point></points><origin><x>104</x><y>145</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los estrechos huecos que llevan hasta las dos cámaras funerarias pueden ser conductos de ventilación, aunque también podían tener finalidad religiosa.
&lt;/html&gt;</body><title>&lt;html&gt;Conducto de ventilación&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Conducto de&lt;br&gt;ventilación&lt;/html&gt;</labeltext><audiorefid/><bgrct x="2" y="128" w="102" h="33"/></label><label labelid="1" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="18" y="222"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>53</x><y>0</y></point></points><origin><x>153</x><y>232</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La sala conocida como cámara de la Reina albergaba originalmente el cuerpo momificado del faraón.&lt;/html&gt;</body><title>&lt;html&gt;Cámara de la Reina&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cámara de la Reina&lt;/html&gt;</labeltext><audiorefid/><bgrct x="14" y="223" w="139" h="17"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="3" usehotarea="0" locklabel="0"><pos x="18" y="270"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Nivel del suelo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="14" y="271" w="109" h="17"/></label><label labelid="3" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="22" y="330"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>29</x><y>-23</y></point></points><origin><x>164</x><y>340</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La cámara subterránea nunca fue terminada. El pasillo sin fin conducía probablemente a otra cámara que tampoco fue terminada.
&lt;/html&gt;</body><title>&lt;html&gt;Cámara subterránea&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cámara subterránea&lt;/html&gt;</labeltext><audiorefid/><bgrct x="18" y="331" w="146" h="17"/></label><label labelid="4" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="306" y="135"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-18</x><y>0</y></point></points><origin><x>302</x><y>153</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los estrechos huecos que llevan hasta las dos cámaras funerarias pueden ser conductos de ventilación, aunque también podían tener finalidad religiosa.
&lt;/html&gt;</body><title>&lt;html&gt;Conducto de ventilación&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Conducto de&lt;br&gt;ventilación&lt;/html&gt;</labeltext><audiorefid/><bgrct x="302" y="136" w="102" h="33"/></label><label labelid="5" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="313" y="205"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-74</x><y>0</y></point></points><origin><x>309</x><y>215</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La gran galería, que conducía a la cámara del Rey, tiene 47 metros de largo y 8,5 metros de altura. Está construida con bloques pulidos de piedra caliza.
&lt;/html&gt;</body><title>&lt;html&gt;Gran galería&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Gran galería&lt;/html&gt;</labeltext><audiorefid/><bgrct x="309" y="206" w="92" h="17"/></label><label labelid="6" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="303" y="293"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>-59</y></point></points><origin><x>361</x><y>303</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La entrada a la pirámide se encuentra a 18 metros sobre el nivel del suelo. Seguramente fue sellada con piedra para ocultarla.
&lt;/html&gt;</body><title>&lt;html&gt;Entrada&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Entrada&lt;/html&gt;</labeltext><audiorefid/><bgrct x="299" y="294" w="62" h="17"/></label><label labelid="7" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="272" y="330"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-36</x><y>-30</y></point></points><origin><x>268</x><y>340</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Cuando el entierro terminaba, se sellaba con piedra la gran galería en el punto donde se cruzaba con la galería de entrada. Los pasillos de escape eran solo un truco para confundir a los ladrones.&lt;/html&gt;</body><title>&lt;html&gt;Pasillos de escape&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Pasillos de escape&lt;/html&gt;</labeltext><audiorefid/><bgrct x="268" y="331" w="131" h="17"/></label><label labelid="8" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="18" y="191"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>60</x><y>0</y></point></points><origin><x>128</x><y>201</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La cámara del Rey contiene un sarcófago de granito que una vez albergó el cuerpo momificado del faraón. El techo está diseñado de una manera especial para soportar el peso de toda la construcción.&lt;/html&gt;</body><title>&lt;html&gt;Cámara del Rey&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cámara del Rey&lt;/html&gt;</labeltext><audiorefid/><bgrct x="14" y="192" w="114" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;En el interior de una pirámide&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="4" resetbuttonstyleid="5" navbuttonstyleid="1" numbermenuitems="1" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="4" guttercolorid="5" graphiccolorid="3" outlinecolorid="6" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="7" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="7" displayoutlinecolorid="7" popbuttonstyleid="1"><scrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/html&gt;</text></currentslidetext></slideshowcontrol><textstyles><textstyle size="15" font="Trebuchet MS" bold="1" italic="1" underline="0" colorid="10" align="left" id="1"/><textstyle size="13" font="Trebuchet MS" bold="0" italic="0" underline="0