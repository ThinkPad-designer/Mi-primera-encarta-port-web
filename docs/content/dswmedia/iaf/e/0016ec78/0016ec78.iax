e="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Un cúmulo de estrellas es un grupo de estrellas que se mantienen juntas por gravedad.&lt;/html&gt;</body><title>&lt;html&gt;Cúmulo de estrellas&lt;/html&gt;</title><image/><imagerefid/></caption><image>0016ec78_slide4.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="0" locklabel="0"><pos x="205" y="12"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>4</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Proxima Centauri&lt;br&gt;(la estrella más cercana al Sol)&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="1" action="static" usepicon="0" useleader="1" textbuttonstyleid="4" usehotarea="0" locklabel="0"><pos x="279" y="54"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>47</y></point></points><origin><x>328</x><y>70</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Sistema&lt;br&gt;Solar&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="0" locklabel="0"><pos x="206" y="174"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Distancia media de&lt;br&gt;Proxima Centauri al Sol:&lt;br&gt;4,23 años luz&lt;br&gt;(equivalentes a 40 billones de&lt;br&gt;kilómetros)&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>332</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Cúmulo de estrellas&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="5" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La Vía Láctea es nuestra galaxia. Está formada por muchos millones de estrellas, incluido nuestro Sol.&lt;/html&gt;</body><title>&lt;html&gt;Vía Láctea&lt;/html&gt;</title><image/><imagerefid/></caption><image>0016ec78_slide5.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="6" usehotarea="0" locklabel="0"><pos x="248" y="22"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>5</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Sistema Solar&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="7" usehotarea="0" locklabel="0"><pos x="218" y="265"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Radio de la Vía Láctea: &lt;br&gt;50.000 años luz&lt;br&gt;(equivalentes a 500.000 billones&lt;br&gt;de kilómetros)&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="2" action="static" usepicon="0" useleader="1" textbuttonstyleid="7" usehotarea="0" locklabel="0"><pos x="217" y="50"/><leaderline forecolorid="3" bgcolorid="2"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>95</y></point></points><origin><x>286</x><y>64</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Centro de la&lt;br&gt;Vía Láctea&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="7" usehotarea="0" locklabel="0"><pos x="308" y="225"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="20" width="20" showwireframe="0" showimage="0" colorid="2"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Brazos de la&lt;br&gt;galaxia espiral&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>332</imageheight><imagewidth>393</imagewidth><listtitle>&lt;html&gt;Vía Láctea&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" slideid="6" sequence="6"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El Grupo Local es un cúmulo de galaxias, una agrupación de galaxias que se mantienen unidas por gravedad. Nuestra Vía Láctea es un miembro del Grupo Local.&lt;/html&gt;</body><title>&lt;html&gt;Grupo Local&lt;/html&gt;</title><image/><imagerefid/></caption><image>0016ec78