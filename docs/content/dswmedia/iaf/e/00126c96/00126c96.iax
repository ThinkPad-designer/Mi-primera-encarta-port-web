otarea><point><x>139</x><y>101</y></point><point><x>174</x><y>82</y></point><point><x>186</x><y>85</y></point><point><x>187</x><y>108</y></point><point><x>176</x><y>127</y></point><point><x>135</x><y>125</y></point><point><x>129</x><y>132</y></point><point><x>123</x><y>132</y></point><point><x>119</x><y>123</y></point><point><x>134</x><y>120</y></point><point><x>139</x><y>101</y></point></hotarea><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Níger&lt;/html&gt;</labeltext><audiorefid/><bgrct x="108" y="5" w="45" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Mapa político&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="2" sequence="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Este es un mapa físico. Muestra el relieve y los ríos de África.&lt;br&gt;&lt;br&gt;Las líneas azules reflejan el curso de los ríos más importantes del continente. Los lagos, mares y océanos aparecen coloreados en azul.&lt;br&gt;&lt;br&gt;Los colores verdes, amarillos y marrones se han utilizado para diferenciar los cambios de altitud (altura sobre el nivel del mar). La leyenda del mapa te ayudará a saber qué altitudes representa cada color. Las curvas de nivel señalan los límites de cada color.&lt;br&gt;&lt;br&gt;Haz clic sobre los recuadros naranjas para ver con más detalle la pequeña altitud del delta del Nilo que contrasta con la elevada altitud del monte Kilimanjaro.&lt;/html&gt;</body><title>&lt;html&gt;Mapa físico&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126c96_slide_