labeltext><audiorefid/><bgrct x="346" y="358" w="57" h="11"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Mapa de vegetación&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="6" sequence="4"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Este es un mapa de climas. También es un mapa temático. Muestra cómo suele ser el tiempo atmosférico más característico en cada una de las diferentes regiones de África, es decir, aquel que se repite más a menudo.&lt;br&gt;&lt;br&gt;En este continente predomina el clima cálido, pues está atravesado por el ecuador y las altitudes son elevadas en muy poco lugares.&lt;br&gt;&lt;br&gt;Compara este mapa con el de vegetación para comprender mejor las relaciones que existen entre el crecimiento de las plantas y el clima.&lt;/html&gt;</body><title>&lt;html&gt;Mapa climático&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126c96_slide_4.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="11" usehotarea="0" locklabel="0"><pos x="10" y="257"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Regiones climáticas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="6" y="258" w="112" h="13"/></label><label labelid="1" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="25" y="273"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Caluroso y muy seco, casi no llueve&lt;/html&gt;</labeltext><audiorefid/><bgrct x="21" y="274" w="172" h="12"/></label><label labelid="2" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="25" y="290"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Caluroso y seco, llueve bastante poco&lt;/html&gt;</labeltext><audiorefid/><bgrct x="21" y="291" w="183" h="12"/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="24" y="306"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Caluroso y húmedo, llueve solo unas semanas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="20" y="307" w="218" h="12"/></label><label labelid="4" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="25" y="322"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Caluroso y muy húmedo, llueve a lo largo de todo el año&lt;/html&gt;</labeltext><audiorefid/><bgrct x="21" y="323" w="269" h="12"/></label><label labelid="5" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="25" y="338"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Veranos cálidos y lluviosos&lt;/html&gt;</labeltext><audiorefid/><bgrct x="21" y="339" w="130" h="12"/></label><label labelid="6" action="static" usepicon="0" useleader="0" textbuttonstyleid="12" usehotarea="0" locklabel="0"><pos x="25" y="355"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Veranos frescos y llueve todos los meses&lt;/html&gt;</labeltext><audiorefid/><bgrct x="21" y="356" w="195" h="12"/></label><label labelid="7" action="static" usepicon="0" useleader="0" textbuttonstyleid="10" usehotarea="0" locklabel="0"><pos x="299" y="357"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;500&lt;/html&gt;</labeltext><audiorefid/><bgrct x="295" y="358" w="26" h="11"/></label><label labelid="9" action="static" usepicon="0" useleader="0" textbuttonstyleid="10" usehotarea="0" locklabel="0"><pos x="350" y="357"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>6</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;kilómetros&lt;/html&gt;</labeltext><audiorefid/><bgrct x="346" y="358" w="57" h="11"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Mapa climático&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="standard" slideid="7" sequence="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Este mapa muestra las líneas de latitud y las líneas de longitud. Es un mapa muy útil para localizar un lugar cualquiera de África.&lt;br&gt;&lt;br&gt;Observa cómo el ecuador atraviesa este continente. El ecuador es el paralelo cero a partir del cual se trazan las líneas de latitud hacia el norte y hacia el sur. También el meridiano de Greenwich pasa por África: es el meridiano cero que sirve para medir la longitud hacia el este o hacia el oeste.&lt;br&gt;&lt;br&gt;Las líneas de longitud y de latitud sirven para localizar lugares. Estas líneas se cruzan en cada lugar del mundo: una línea de longitud se entrecruza siempre con otra u otras de latitud, aunque no aparezca en los mapas.&lt;br&gt;&lt;br&gt;Haz clic sobre el recuadro naranja para comparar las líneas de latitud y longitud de dos ciudades del sur de África (localizadas en el hemisferio sur).&lt;/html&gt;</body><title>&lt;html&gt;Mapa de localización&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126c96_slide_5.swf</image><audiofile/><labels><label labelid="0" action="static" usepicon="0" useleader="0" textbuttonstyleid="9" usehotarea="0" locklabel="0"><pos x="200" y="145"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Á F R I C A&lt;/html&gt;</labeltext><audiorefid/><bgrct x="196" y="146" w="85" h="18"/></label><label labelid="3" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="0" locklabel="0"><pos x="357" y="218"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano&lt;br&gt;Índico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="353" y="219" w="56" h="31"/></label><label labelid="4" action="static" usepicon="0" useleader="0" textbuttonstyleid="4" usehotarea="0" locklabel="0"><pos x="48" y="218"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Océano&lt;br&gt;Atlántico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="44" y="219" w="68" h="31"/></label><label labelid="5" action="static" usepicon="0" useleader="0" textbuttonstyleid="10" usehotarea="0" locklabel="0"><pos x="299" y="357"/><leaderline/><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget>7</labeltarget><picon height="20" width="20" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;500 &lt;/html&gt;</labeltext><audiorefid/><bgrct x="295" y="358" w="26" h="11"/></label><label labelid="7" action="static"