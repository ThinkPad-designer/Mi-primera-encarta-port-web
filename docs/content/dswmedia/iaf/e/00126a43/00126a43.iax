<?xml version="1.0"?><iai friendlyname="Kids Roman Town" id="00126a43" height="411" width="574" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" slideid="1" sequence="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En esta ilustración puedes ver las principales partes de una ciudad romana.

Haz clic en las palabras en rojo y encontrarás más información.&lt;/html&gt;</body><title>&lt;html&gt;Una ciudad romana&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126a43.swf</image><audiofile/><labels><label labelid="0" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="161" y="350"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>-49</y></point></points><origin><x>222</x><y>360</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las ciudades romanas estaban protegidas por fuertes murallas que las rodeaban.&lt;/html&gt;</body><title>&lt;html&gt;Murallas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Murallas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="157" y="351" w="65" h="17"/></label><label labelid="1" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="22" y="42"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>111</y></point></points><origin><x>131</x><y>52</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En los arcos de triunfo estaban relatadas, en relieves, las victorias o éxitos del emperador o de algún gran personaje.&lt;/html&gt;</body><title>&lt;html&gt;Arco de triunfo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Arco de triunfo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="18" y="43" w="113" h="17"/></label><label labelid="2" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="335" y="70"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>31</y></point></points><origin><x>331</x><y>80</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Gracias a los acueductos, las ciudades disponían de agua. Estos grandes canales actuaban como nuestras actuales tuberías, pues transportaban el agua de los ríos y arroyos hasta las fuentes públicas.&lt;/html&gt;</body><title>&lt;html&gt;Acueducto&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Acueducto&lt;/html&gt;</labeltext><audiorefid/><bgrct x="331" y="71" w="81" h="17"/></label><label labelid="3" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="286" y="44"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>73</y></point></points><origin><x>282</x><y>54</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Al igual que en los teatros de hoy en día, en los teatros romanos se representaban obras dramáticas o musicales.&lt;/html&gt;</body><title>&lt;html&gt;Teatro&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Teatro&lt;/html&gt;</labeltext><audiorefid/><bgrct x="282" y="45" w="54" h="17"/></label><label labelid="4" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="217" y="26"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>65</y></point></points><origin><x>213</x><y>36</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;En los anfiteatros tenían lugar diversos espectáculos, como los combates de gladiadores que tantas veces habrás visto en las películas.&lt;/html&gt;</body><title>&lt;html&gt;Anfiteatro&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Anfiteatro&lt;/html&gt;</labeltext><audiorefid/><bgrct x="213" y="27" w="79" h="17"/></label><label labelid="5" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="369" y="100"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>96</y></point></points><origin><x>365</x><y>110</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los habitantes de la ciudad asistían al circo para contemplar espectáculos como las carreras de carros o las luchas entre gladiadores.&lt;/html&gt;</body><title>&lt;html&gt;Circo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Circo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="365" y="101" w="44" h="17"/></label><label labelid="6" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="137" y="26"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>122</y></point></points><origin><x>174</x><y>36</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El foro estaba situado en el centro de la ciudad. Su función era parecida a la de las actuales plazas. Era un espacio abierto en el que se situaban los mercados públicos y se desarrollaban los negocios.&lt;/html&gt;</body><title>&lt;html&gt;Foro&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Foro&lt;/html&gt;</labeltext><audiorefid/><bgrct x="133" y="27" w="41" h="17"/></label><label labelid="7" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="24" y="295"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>135</x><y>-129</y></point></points><origin><x>80</x><y>305</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;La función de las basílicas romanas no era religiosa. Eran edificios que se empleaban para la administración de justicia o para actividades comerciales.&lt;/html&gt;</body><title>&lt;html&gt;Basílica&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Basílica&lt;/html&gt;</labeltext><audiorefid/><bgrct x="20" y="296" w="60" h="17"/></label><label labelid="8" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="288" y="350"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>-90</y></point></points><origin><x>284</x><y>360</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los templos eran los edificios religiosos. Cada uno estaba dedicado a un dios, del que había una estatua en el interior.&lt;/html&gt;</body><title>&lt;html&gt;Templo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Templo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="284" y="351" w="60" h="17"/></label><label labelid="9" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="24" y="269"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>-34</y></point></points><origin><x>57</x><y>279</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Las carreteras y calles romanas se llamaban vías o calzadas.&lt;/html&gt;</body><title>&lt;html&gt;Vías&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Vías&lt;/html&gt;</labeltext><audiorefid/><bgrct x="20" y="270" w="37" h="17"/></label><label labelid="10" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="21" y="70"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>42</y></point></points><origin><x>74</x><y>80</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los romanos realizaron grandes obras de ingeniería; como los puentes, que servían como vías de paso para poder atravesar ríos o accidentes montañosos.&lt;/html&gt;</body><title>&lt;html&gt;Puente&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Puente&lt;/html&gt;</labeltext><audiorefid/><bgrct x="17" y="71" w="57" h="17"/></label><label labelid="11" action="caption" usepicon="0" useleader="1" textbuttonstyleid="2" usehotarea="0" locklabel="0"><pos x="22" y="348"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>101</x><y>-95</y></point></points><origin><x>77</x><y>358</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Una de las características de las ciudades romanas era la existencia de casas de baños que se llamaban termas.&lt;/html&gt;</body><title>&lt;html&gt;Termas&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Termas&lt;/html&gt;</labeltext><audiorefid/><bgrct x="18" y="349" w="59" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;Una ciudad romana&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="3" resetbuttonstyleid="4" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="4" progresscolorid="4" guttercolorid="4" graphiccolorid="4" outlinecolorid="4" buttonstyleid="2"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="4" displaybgcolorid="4" listbgcolorid="4" listoutlinecolorid="4" displayoutlinecolorid="4" popbuttonstyleid="3"><scrollbarstyle guttercolorid="4" thumbbasecolorid="5" thumbrollcolorid="5" thumbdowncolorid="5" buttonstyleid="3"/></popmenustyle><captionscrollbarsty