<?xml version="1.0"?><iai friendlyname="Kids - Desert" id="00126bc4" height="411" width="574" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Haz clic en las palabras en rojo y encontrarás más información.&lt;/html&gt;</body><title>&lt;html&gt;El desierto&lt;/html&gt;</title><image/><imagerefid/></caption><image>00126bc4_new.swf</image><audiofile/><labels><label labelid="2" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="256" y="20"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>52</y></point></points><origin><x>251</x><y>30</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Una meseta es una llanura elevada. Se puede formar por la erosión o por los movimientos de las placas tectónicas.&lt;/html&gt;</body><title>&lt;html&gt;Meseta&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Meseta&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="3" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="170" y="339"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>-121</y></point></points><origin><x>209</x><y>349</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Un oasis es un lugar en el desierto que tiene agua. El agua brota de un manantial, se saca de un pozo o llega de un río. En los oasis crecen las plantas y se asienta la población.&lt;/html&gt;</body><title>&lt;html&gt;Oasis&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Oasis&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="4" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="164" y="20"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>6</x><y>64</y></point></points><origin><x>202</x><y>30</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Una mesa es una superficie de cima aplanada y laderas en pendiente. Su extensión es menor que la de una meseta. Se forma cuando se erosiona una meseta y por eso sus altitudes, normalmente, son similares.&lt;/html&gt;</body><title>&lt;html&gt;Mesa&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Mesa&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="5" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="33" y="133"/><leaderline forecolorid="2" bgcolorid="3"><side>right</side><points><point><x>6</x><y>0</y></point><point><x>47</x><y>0</y></point></points><origin><x>72</x><y>143</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Una duna es una montaña de arena modelada por el viento.&lt;/html&gt;</body><title>&lt;html&gt;Duna&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Duna&lt;/html&gt;</labeltext><audiorefid/></label><label labelid="6" action="caption" usepicon="0" useleader="1" textbuttonstyleid="1" usehotarea="0" locklabel="0"><pos x="337" y="20"/><leaderline forecolorid="2" bgcolorid="3"><side>left</side><points><point><x>-6</x><y>0</y></point><point><x>-6</x><y>91</y></point></points><origin><x>332</x><y>30</y></origin></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Un cerro testigo es una colina de cima aplanada y rocosa, y laderas inclinadas. Se forma cuando se erosiona una mesa.  &lt;/html&gt;</body><title>&lt;html&gt;Cerro testigo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea/><labeltarget/><picon height="0" width="0" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Cerro&lt;br&gt;testigo&lt;/html&gt;</labeltext><audiorefid/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>380</imageheight><imagewidth>418</imagewidth><listtitle>&lt;html&gt;El desierto&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="4" textdividerbarcolorid="4" creditsbuttonstyleid="2" resetbuttonstyleid="3" navbuttonstyleid="1" numbermenuitems="1" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="5" progresscolorid="4" guttercolorid="5" graphiccolorid="3" outlinecolorid="6" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="7" displaybgcolorid="3" listbgcolorid="3" listoutlinecolorid="7" displayoutlinecolorid="7" popbuttonstyleid="1"><scrollbarstyle guttercolorid="7" thumbbasecolorid="8" thumbrollcolorid="9" thumbdowncolorid="9" buttonstyleid