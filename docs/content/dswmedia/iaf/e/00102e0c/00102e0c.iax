<?xml version="1.0"?><iai friendlyname="Kids: Alphabets and Writing" id="00102e0c" height="339" width="556" hasaudio="0" hascredits="0" lang="E" basecontroltype="SlideShowControl" outlinecolorid="1" skinstyle="Kids1" skinlib="kids1"><slides><slide type="standard" sequence="1" slideid="1"><standardslide locklabelson="1" showtextarea="0" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Haz clic en las imágenes para saber más sobre los distintos alfabetos y los diferentes sistemas de escritura.
&lt;/html&gt;</body><title>&lt;html&gt;Alfabetos y escritura&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102e0c_1.swf</image><audiofile/><labels><label labelid="1" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="69" y="264"/><leaderline forecolorid="2" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>9</x><y>163</y></point><point><x>266</x><y>163</y></point><point><x>271</x><y>300</y></point><point><x>7</x><y>299</y></point><point><x>9</x><y>163</y></point></hotarea><labeltarget>2</labeltarget><picon height="70" width="220" showwireframe="1" showimage="1" colorid="3"><pos x="31" y="190"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura alfabética&lt;/html&gt;</labeltext><audiorefid/><bgrct x="65" y="265" w="141" h="17"/></label><label labelid="2" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="167" y="52"/><leaderline forecolorid="2" bgcolorid="4"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>9</x><y>3</y></point><point><x>270</x><y>8</y></point><point><x>272</x><y>147</y></point><point><x>7</x><y>148</y></point><point><x>9</x><y>3</y></point></hotarea><labeltarget>3</labeltarget><picon height="140" width="140" showwireframe="1" showimage="1" colorid="4"><pos x="14" y="6"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura&lt;br&gt;pictográfica&lt;/html&gt;</labeltext><audiorefid/><bgrct x="163" y="53" w="89" h="33"/></label><label labelid="3" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="376" y="63"/><leaderline forecolorid="2" bgcolorid="4"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>288</x><y>8</y></point><point><x>545</x><y>9</y></point><point><x>550</x><y>145</y></point><point><x>284</x><y>148</y></point><point><x>288</x><y>8</y></point></hotarea><labeltarget>4</labeltarget><picon height="140" width="70" showwireframe="1" showimage="1" colorid="4"><pos x="302" y="7"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura ideográfica&lt;/html&gt;</labeltext><audiorefid/><bgrct x="372" y="64" w="149" h="17"/></label><label labelid="4" action="popUp" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="362" y="262"/><leaderline forecolorid="2" bgcolorid="4"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body/><title/><image/><imagerefid/></caption><audiofile/><hotarea><point><x>282</x><y>160</y></point><point><x>550</x><y>162</y></point><point><x>550</x><y>301</y></point><point><x>284</x><y>301</y></point><point><x>282</x><y>160</y></point></hotarea><labeltarget>5</labeltarget><picon height="60" width="230" showwireframe="1" showimage="1" colorid="4"><pos x="306" y="197"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura silábica&lt;/html&gt;</labeltext><audiorefid/><bgrct x="358" y="263" w="125" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>308</imageheight><imagewidth>556</imagewidth><listtitle>&lt;html&gt;Alfabetos y escritura&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="5" slideid="2"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Un alfabeto es un conjunto de símbolos, llamados letras, que utilizamos para comunicarnos. Cada letra corresponde a un sonido o grupo de sonidos. Con las letras del alfabeto se componen las palabras de una lengua. La mayoría de los alfabetos tienen entre 20 y 30 letras. El español utiliza el alfabeto romano o latino.

&lt;/html&gt;</body><title>&lt;html&gt;Escritura alfabética&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102e0c_4.swf</image><audiofile/><labels><label labelid="1" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="53" y="143"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El alfabeto romano procede del alfabeto griego. El español es una de las muchas lenguas que utiliza el alfabeto romano, que también se conoce como alfabeto latino, porque en su origen fue la base de la lengua latina. Cuando el latín se extendió por Europa propagó este alfabeto por todo el Occidente europeo.
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto romano&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>4</x><y>95</y></point><point><x>213</x><y>89</y></point><point><x>206</x><y>172</y></point><point><x>5</x><y>168</y></point><point><x>4</x><y>95</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto romano&lt;/html&gt;</labeltext><audiorefid/><bgrct x="49" y="144" w="122" h="17"/></label><label labelid="2" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="250" y="241"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El alfabeto griego consta de 24 símbolos, aunque algunos de sus dialectos cuentan con alguna letra más. El alfabeto romano que utilizamos cuando escribimos en español procede del alfabeto griego. La propia palabra &quot;alfabeto&quot; procede de sus dos primeras letras, &lt;i&gt;alfa&lt;/i&gt; y &lt;i&gt;beta&lt;/i&gt;.
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto griego&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>222</x><y>195</y></point><point><x>371</x><y>190</y></point><point><x>373</x><y>263</y></point><point><x>223</x><y>258</y></point><point><x>222</x><y>195</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto griego&lt;/html&gt;</labeltext><audiorefid/><bgrct x="246" y="242" w="112" h="17"/></label><label labelid="3" action="caption" useleader="0" textbuttonstyleid="2" usehotarea="1" usepicon="0" locklabel="0"><pos x="255" y="154"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Todos los sonidos que se puedan producir en cualquier lengua del mundo están recogidos en este alfabeto. Los símbolos fonéticos que se usan más frecuentemente son los adoptados por la Asociación Fonética Internacional en el alfabeto fonético internacional (AFI), y se escriben entre corchetes. 
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto fonético&lt;br&gt;   internacional&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>222</x><y>107</y></point><point><x>369</x><y>107</y></point><point><x>369</x><y>186</y></point><point><x>222</x><y>192</y></point><point><x>222</x><y>107</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto fonético&lt;br&gt;   internacional&lt;/html&gt;</labeltext><audiorefid/><bgrct x="251" y="155" w="107" h="26"/></label><label labelid="4" action="caption" useleader="0" textbuttonstyleid="2" usehotarea="1" usepicon="0" locklabel="0"><pos x="100" y="36"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El alfabeto hebreo se compone de 22 caracteres, y se escribe de derecha a izquierda. La escritura hebrea carece de representación para las vocales, que se pueden indicar mediante marcas especiales encima, debajo o al lado de las consonantes. 
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto hebreo&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>7</x><y>79</y></point><point><x>205</x><y>73</y></point><point><x>196</x><y>2</y></point><point><x>6</x><y>2</y></point><point><x>7</x><y>79</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto hebreo&lt;/html&gt;</labeltext><audiorefid/><bgrct x="96" y="37" w="94" h="13"/></label><label labelid="5" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="245" y="85"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El alfabeto árabe, o alifato, tiene 29 letras consonánticas, que se escriben de derecha a izquierda. Está basado en 18 figuras que varían según estén conectadas con la precedente o la siguiente. Existen también 3 vocales, que no se registran en la escritura.
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto árabe &lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>221</x><y>105</y></point><point><x>370</x><y>105</y></point><point><x>371</x><y>3</y></point><point><x>216</x><y>3</y></point><point><x>221</x><y>105</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto árabe &lt;/html&gt;</labeltext><audiorefid/><bgrct x="241" y="86" w="114" h="17"/></label><label labelid="6" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="61" y="240"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Tiene su origen en el alfabeto griego y está formado por 43 caracteres. En la actualidad, cuatro lenguas utilizan este alfabeto: el ruso moderno, que tiene 32 letras; el búlgaro con 30, lo mismo que el serbio, y el ucranio, que tiene 33.
&lt;/html&gt;</body><title>&lt;html&gt;Alfabeto cirílico&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>7</x><y>170</y></point><point><x>211</x><y>175</y></point><point><x>214</x><y>261</y></point><point><x>5</x><y>261</y></point><point><x>7</x><y>170</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Alfabeto cirílico&lt;/html&gt;</labeltext><audiorefid/><bgrct x="57" y="241" w="117" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Escritura alfabética&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="5" slideid="3"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Aparte de los alfabetos, existen otros tipos de escritura. Un ejemplo es el sistema pictográfico, que representa objetos por medio de dibujos, llamados pictogramas; por ejemplo, el dibujo de un sol significa la palabra ‘sol’. 
&lt;/html&gt;</body><title>&lt;html&gt;Escritura pictográfica&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102e0c_2.swf</image><audiofile/><labels><label labelid="1" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="28" y="236"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los aztecas (siglos XIV-XVI) utilizaron la escritura pictográfica grabada en papel o piel de animales. Solían abordar temas religiosos o acontecimientos históricos. También representaban los números con pictogramas.
&lt;/html&gt;</body><title>&lt;html&gt;Escritura pictográfica azteca&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>215</x><y>258</y></point><point><x>212</x><y>8</y></point><point><x>7</x><y>9</y></point><point><x>10</x><y>257</y></point><point><x>215</x><y>258</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura pictográfica azteca&lt;/html&gt;</labeltext><audiorefid/><bgrct x="24" y="237" w="203" h="17"/></label><label labelid="2" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="224" y="236"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Los pictogramas utilizados en el antiguo Egipto se denominan jeroglíficos. Algunos de ellos son ideogramas más que pictogramas, ya que lo que representan es una idea y no un objeto. En un principio, los jeroglíficos se utilizaban para dejar constancia de las posesiones de un rey; por ejemplo, se dibujaba una vaca junto a un número para representar las vacas que poseía. Posteriormente, los jeroglíficos se empezaron a utilizar en otras ocasiones y con diferentes fines, de forma que han llegado a recopilarse 750 pictogramas distintos.
&lt;/html&gt;</body><title>&lt;html&gt;Jeroglíficos egipcios&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>218</x><y>10</y></point><point><x>371</x><y>10</y></point><point><x>370</x><y>261</y></point><point><x>222</x><y>257</y></point><point><x>218</x><y>10</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Jeroglíficos egipcios&lt;/html&gt;</labeltext><audiorefid/><bgrct x="220" y="237" w="146" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Escritura pictográfica&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="5" slideid="4"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Se denomina escritura ideográfica al sistema que utiliza símbolos para representar ideas, no simplemente un sonido o un objeto. En lugar de letras, los símbolos que se utilizan son ideogramas. Es un sistema parecido al pictográfico, pero, en este caso, por ejemplo, el dibujo de un sol no significaría ‘sol’, sino más bien, ‘día’.
&lt;/html&gt;</body><title>&lt;html&gt;Escritura ideográfica&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102e0c_3.swf</image><audiofile/><labels><label labelid="1" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="161" y="170"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El japonés utiliza la escritura ideográfica y la silábica. Su escritura ideográfica se denomina &lt;i&gt;kanji&lt;/i&gt; y proviene del chino. Se compone de caracteres que representan conceptos, y son unos dibujos esquemáticos que se pueden escribir utilizando gran cantidad de estilos más o menos creativos o artísticos. El otro sistema de escritura japonesa es el silábico, y existen dos silabarios. En la actualidad, se utilizan cerca de 2.000 caracteres en la lengua escrita japonesa.&lt;/html&gt;</body><title>&lt;html&gt;Escritura ideográfica japonesa&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>153</x><y>56</y></point><point><x>157</x><y>199</y></point><point><x>368</x><y>200</y></point><point><x>369</x><y>62</y></point><point><x>153</x><y>56</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura ideográfica japonesa&lt;/html&gt;</labeltext><audiorefid/><bgrct x="157" y="171" w="214" h="17"/></label><label labelid="2" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="39" y="211"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Aunque existen muchos dialectos del chino diferentes, se utiliza el mismo sistema de escritura en todos ellos. Esto significa que los hablantes de distintos dialectos se pueden entender de forma escrita. La imagen muestra los ideogramas chinos utilizados para la palabra &lt;i&gt;Zhongwen&lt;/i&gt;, el término que los chinos utilizan para referirse a su lengua.

&lt;/html&gt;</body><title>&lt;html&gt;Escritura ideográfica china&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>34</x><y>16</y></point><point><x>36</x><y>252</y></point><point><x>196</x><y>249</y></point><point><x>162</x><y>207</y></point><point><x>136</x><y>201</y></point><point><x>122</x><y>21</y></point><point><x>34</x><y>16</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Escritura ideográfica china&lt;/html&gt;</labeltext><audiorefid/><bgrct x="35" y="212" w="190" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Escritura ideográfica&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide><slide type="popup" sequence="5" slideid="5"><standardslide locklabelson="1" showtextarea="1" useshowhidelabels="0" lockpicon="0" useswfctrl="0" vrslide="0"><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Otro tipo de escritura es el sistema silábico. En un silabario, cada símbolo corresponde a una sílaba. Una sílaba es el fonema (letra) o grupo de fonemas que se pronuncia en un solo golpe de voz. Las sílabas por sí solas carecen de significado: dio, ra, mi, trans, sor; pero con ellas bien unidas y ordenadas, los hablantes podemos formar palabras: ra-dio-trans-mi-sor.
&lt;/html&gt;</body><title>&lt;html&gt;Escritura silábica&lt;/html&gt;</title><image/><imagerefid/></caption><image>00102e0c_5.swf</image><audiofile/><labels><label labelid="1" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="130" y="98"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;Además de su sistema ideográfico, el japonés posee dos silabarios o &lt;i&gt;kana&lt;/i&gt;, nombre que significa ‘signo que representa una sílaba’. Estos silabarios son el &lt;i&gt;hiragana&lt;/i&gt; y el &lt;i&gt;katakana&lt;/i&gt;. En ellos, cada sílaba se representa por un símbolo que procede de varios símbolos complejos chinos. La imagen muestra los símbolos que representan las sílabas de la palabra &lt;i&gt;hiragana&lt;/i&gt;. El japonés se puede escribir de arriba abajo o de izquierda a derecha.
&lt;/html&gt;</body><title>&lt;html&gt;Silabario japonés&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>25</x><y>16</y></point><point><x>356</x><y>13</y></point><point><x>350</x><y>124</y></point><point><x>23</x><y>127</y></point><point><x>25</x><y>16</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="3"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Silabario japonés&lt;/html&gt;</labeltext><audiorefid/><bgrct x="126" y="99" w="125" h="17"/></label><label labelid="2" action="caption" useleader="0" textbuttonstyleid="1" usehotarea="1" usepicon="0" locklabel="0"><pos x="131" y="229"/><leaderline forecolorid="3" bgcolorid="3"><points/></leaderline><caption titlestyleid="1" bodystyleid="2"><body>&lt;html&gt;El alfabeto devanagari es el que se utiliza para escribir el sánscrito y muchas de las lenguas indias. Es una combinación entre silabario y alfabeto, y se escribe de izquierda a derecha.
&lt;/html&gt;</body><title>&lt;html&gt;Silabario devanagari&lt;/html&gt;</title><image/><imagerefid/></caption><audiofile/><hotarea><point><x>26</x><y>141</y></point><point><x>351</x><y>137</y></point><point><x>355</x><y>259</y></point><point><x>28</x><y>257</y></point><point><x>26</x><y>141</y></point></hotarea><labeltarget/><picon height="34" width="34" showwireframe="0" showimage="0" colorid="4"><pos x="0" y="0"/><altimage/><altimagerefid/></picon><labeltext>&lt;html&gt;Silabario devanagari&lt;/html&gt;</labeltext><audiorefid/><bgrct x="127" y="230" w="146" h="17"/></label></labels><keywords/><imagerefid/><audiorefid/><imageheight>266</imageheight><imagewidth>376</imagewidth><listtitle>&lt;html&gt;Escritura silábica&lt;/html&gt;</listtitle><hidelbltext>&lt;html&gt;Ocultar etiquetas&lt;/html&gt;</hidelbltext><showlbltext>&lt;html&gt;Mostrar etiquetas&lt;/html&gt;</showlbltext></standardslide></slide></slides><slideshowcontrol bottombarbgcolorid="5" textdividerbarcolorid="5" creditsbuttonstyleid="3" resetbuttonstyleid="4" navbuttonstyleid="1" numbermenuitems="0" showpop="1" autoadvance="0" shownavarrows="1" bottombarheight="31"><audiocontrollerstyle bgcolorid="6" progresscolorid="5" guttercolorid="6" graphiccolorid="4" outlinecolorid="7" buttonstyleid="1"/><popmenustyle listtextstyleid="3" displaytextstyleid="3" selectedlisttextstyleid="3" rolllisttextstyleid="3" downlisttextstyleid="3" rolloutlinecolorid="8" displaybgcolorid="4" listbgcolorid="4" listoutlinecolorid="8" displayoutlinecolorid="8" popbuttonstyleid="1"><scrollbarstyle guttercolorid="8" thumbbasecolorid="9" thumbrollcolorid="10" thumbdowncolorid="10" buttonstyleid="1"/></popmenustyle><captionscrollbarstyle guttercolorid="8" thumbbasecolorid="9" thumbrollcolorid="10" thumbdowncolorid="10" buttonstyleid="1"/><creditsbuttontext>&lt;html&gt;Credits&lt;/html&gt;</creditsbuttontext><resetbuttontext>&lt;html&gt;Reset&lt;/html&gt;</resetbuttontext><currentslidetext textstyleid="4"><text>&lt;html&gt;% de #&lt;/